.idea/
.vscode/

# Local git configuration
.gitconfig-local

# Claude Code settings (user-specific)
claude/settings.json

# Machine-local zellij layouts, which reference paths that only exist here.
# A layout naming no path can be shared, and is excepted by name.
config/zellij/layouts/*
!config/zellij/layouts/bare.kdl

# Machine-local mise settings, such as a work mirror that only some machines
# can reach. ~/.config/mise is a symlink to config/mise, so mise loads these.
config/mise/conf.d/

/bin/mc
/bin/amm
/bin/kubeseal
/bin/k9s
