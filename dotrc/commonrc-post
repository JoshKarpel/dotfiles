#!/usr/bin/env bash

# The tail of shell startup, shared by bashrc and zshrc. Source it last, with
# the shell's own name as the argument:
#
#   . "$HOME/.commonrc-post" bash
#
# This can't fold into commonrc-pre, which runs too early: mise has to activate
# before anything can find a mise-installed tool on PATH.
#
# The shell name is passed in rather than detected: each rc file already knows
# which shell it is, so injecting it keeps this file free of any dependency on
# detection working.

# Unguarded where the rest are not: a non-interactive `ssh <host> <command>`
# needs the tools this puts on PATH as much as an interactive shell does.
activate_if_available mise mise activate "$1"

activate_if_interactive starship starship init "$1"
activate_if_interactive gh gh completion -s "$1"

# exe-dev works out the shell for itself rather than taking it as an argument.
activate_if_interactive exe-dev exe-dev --show-completion

# The `xd` alias wants the same completion. Reuse the function just defined
# rather than emit a second copy under the alias's name: --show-completion is a
# Python start, and the second copy would look for a `_XD_COMPLETE` variable
# that only a binary called `xd` sets. zsh maps an alias to its target directly;
# bash has no equivalent, and the generated completer runs whichever word was
# typed, so the alias has to be swapped back out before handing over.
if [[ $- == *i* ]] && exists exe-dev; then
  case "$1" in
    zsh)
      compdef xd=exe-dev
      ;;
    bash)
      _xd_completion() {
        local COMP_WORDS=(exe-dev "${COMP_WORDS[@]:1}")
        _exe_dev_completion exe-dev
      }
      complete -o default -F _xd_completion xd
      ;;
  esac
fi

# Override some BSD utils with GNU utils from the brew findutils package. This
# has to come after commonrc-pre, which is where brew itself joins PATH, and
# nothing sourced during startup needs the GNU versions anyway. The prefix is
# probed rather than asked of `brew --prefix`, which would cost a subprocess on
# every shell start.
for prefix in /opt/homebrew /usr/local; do
  gnubin="$prefix/opt/findutils/libexec/gnubin"
  if [[ -d $gnubin ]]; then
    path_prefix "$gnubin"
    break
  fi
done
unset prefix gnubin

# rustup's own shell setup, written by mise's rust core plugin (which wraps
# rustup) the first time `mise install` resolves `rust` from config/mise/config.toml.
# A machine that hasn't reached that step yet (install.sh still running, or a
# `mise install` that failed) has no such file, and sourcing a missing one
# unconditionally would print a raw "No such file or directory" on every shell
# start rather than the kind of skip notice the rest of this file gives.
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# Keep last: this reports work that is already lost, so it wants to be the final
# thing on screen before the prompt rather than scrolled off by the rest of
# startup. Defined in sources/zellij.sh, and silent unless something is stranded.
if [[ $- == *i* ]]; then
  warn_stranded_zellij_servers
fi
