#!/usr/bin/env bash

# The tail of shell startup, shared by bashrc and zshrc. Source it last, with
# the shell's own name as the argument:
#
#   . "$HOME/.commonrc-post" bash
#
# This can't fold into commonrc-pre, which runs too early: mise has to activate
# before anything can find a mise-installed tool on PATH, and the zellij
# handoff has to come after everything because it replaces the shell.
#
# The shell name is passed in rather than detected: each rc file already knows
# which shell it is, so injecting it keeps this file free of any dependency on
# detection working.

# Unguarded where the rest are not: a non-interactive `ssh <host> <command>`
# needs the tools this puts on PATH as much as an interactive shell does.
activate_if_available mise mise activate "$1"

activate_if_interactive starship starship init "$1"
activate_if_interactive gh gh completion -s "$1"

# exe-dev works out the shell for itself rather than taking it as an argument.
activate_if_interactive exe-dev exe-dev --show-completion

. "$HOME/.cargo/env"

# Keep last: on exe.dev VMs this execs zellij, replacing the shell, so anything
# below it would never run. Defined in sources/exe.sh, absent everywhere else.
if exists start_zellij_session; then
  start_zellij_session
fi
