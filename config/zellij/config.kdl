// Only the deviations from zellij's defaults, so upgrades bring new defaults
// with them. Run `zellij setup --dump-config` to see the full set.

show_startup_tips false

// Sessions are created outside the web server, by the zellij-session unit at
// boot and by a login shell everywhere else. The default "off" only serves
// sessions the web server created itself, which is none of them, so the browser
// would show an empty list on a box with a session running in front of it.
web_sharing "on"

// The bottom of the range exe.dev forwards verbatim, so the work session sorts
// first in the port atlas. Set here rather than as a flag on the unit so that
// `zellij web --status` from a shell looks at the port the service actually
// bound, instead of reporting nothing on the 8082 default.
web_server_port 3000

keybinds {
    // Quit tears the session down along with everything running in it, and
    // recovery isn't guaranteed: a short-lived session that exits can vanish
    // outright rather than landing in the resurrectable list. Detach
    // (Ctrl+o d) is what's meant nearly every time, and `zellij
    // delete-session` covers the rest.
    shared_except "locked" {
        unbind "Ctrl q"
    }

    // The mode keys the browser takes for itself, given an Alt alternate. A web
    // client sees a keystroke only if the browser lets the page have it, and
    // Ctrl+T (new tab), Ctrl+N (new window), and Ctrl+P (print) are all claimed
    // above the page, so no configuration on this end makes them arrive. Alt is
    // left alone, so it carries the same modes with the same letter. The Ctrl
    // bindings stay for terminal clients, where they work and are what the
    // status bar advertises.
    //
    // Two of these letters are defaults in their own right, Alt+n for NewPane
    // and Alt+p for TogglePaneInGroup, and taking them gives those up. Both
    // still have a route through pane mode, `Ctrl+p n` and `Ctrl+p` then the
    // group keys.
    shared_except "tab" "locked" {
        bind "Alt t" { SwitchToMode "Tab"; }
    }

    tab {
        bind "Alt t" { SwitchToMode "Normal"; }
    }

    shared_except "resize" "locked" {
        bind "Alt n" { SwitchToMode "Resize"; }
    }

    resize {
        bind "Alt n" { SwitchToMode "Normal"; }
    }

    shared_except "pane" "locked" {
        bind "Alt p" { SwitchToMode "Pane"; }
    }

    pane {
        bind "Alt p" { SwitchToMode "Normal"; }
    }
}
