// Only the deviations from zellij's defaults, so upgrades bring new defaults
// with them. Run `zellij setup --dump-config` to see the full set.

show_startup_tips false

// The default "titles" draws only a title row above each pane, with no border.
// Toggling frames by hand lasts only as long as the server, so this is what
// every restart comes back to.
pane_frame_style "full"

// Sessions are created outside the web server, by the zellij-session unit at
// boot and by a login shell everywhere else. The default "off" only serves
// sessions the web server created itself, which is none of them, so the browser
// would show an empty list on a box with a session running in front of it.
web_sharing "on"

// The bottom of the range exe.dev forwards verbatim, so the work session sorts
// first in the port atlas. Set here rather than as a flag on the unit so that
// `zellij web --status` from a shell looks at the port the service actually
// bound, instead of reporting nothing on the 8082 default.
web_server_port 3000

// The browser draws the web client's text, so these name fonts installed where
// the browser runs, not on this box. Starship's default symbols are Nerd Font
// glyphs, which plain Fira Code lacks, so the patched family comes first.
// The value is a CSS font list: quote any name with a space in it.
// `zellij-web-font` rewrites the font line in this block, so keep it on one line.
web_client {
    font "'CaskaydiaMono Nerd Font Mono', monospace"
}

// Zellij is the terminal its panes run in, so it says which one. Panes inherit
// the server's environment rather than the attaching client's, so without this a
// server started by a unit gives every pane no TERM at all (Claude Code then
// falls back to TERM=dumb, and `less` complains the terminal is not fully
// functional), and one started by `za` hands on whatever the first client's
// terminal was, which may have no terminfo entry on this box. Only a CLI client
// applies this to the server it spawns; `zellij web` does not, so
// zellij-web.service in install.sh pins the same value itself.
env {
    TERM "xterm-256color"
}

// No `post_command_discovery_hook "true"`, though it would stop resurrection
// offering to re-run each pane's command: zellij 0.45 serializes a floating
// pane's cwd only as part of its command, so a floating pane resurrected as a
// bare shell comes back in the session root instead of where it was.

keybinds {
    // Quit tears the session down along with everything running in it, and
    // recovery isn't guaranteed: a short-lived session that exits can vanish
    // outright rather than landing in the resurrectable list. Detach
    // (Ctrl+o d) is what's meant nearly every time, and `zellij
    // delete-session` covers the rest.
    shared_except "locked" {
        unbind "Ctrl q"
    }

    // The mode keys the browser takes for itself, given an Alt alternate. A web
    // client sees a keystroke only if the browser lets the page have it, and
    // Ctrl+T (new tab), Ctrl+N (new window), and Ctrl+P (print) are all claimed
    // above the page, so no configuration on this end makes them arrive. Alt is
    // left alone, so it carries the same modes with the same letter. The Ctrl
    // bindings stay for terminal clients, where they work and are what the
    // status bar advertises.
    //
    // Two of these letters are defaults in their own right, Alt+n for NewPane
    // and Alt+p for TogglePaneInGroup, and taking them gives those up. Both
    // still have a route through pane mode, `Ctrl+p n` and `Ctrl+p` then the
    // group keys.
    shared_except "tab" "locked" {
        bind "Alt t" { SwitchToMode "Tab"; }
    }

    tab {
        bind "Alt t" { SwitchToMode "Normal"; }
    }

    shared_except "resize" "locked" {
        bind "Alt n" { SwitchToMode "Resize"; }
    }

    resize {
        bind "Alt n" { SwitchToMode "Normal"; }
    }

    shared_except "pane" "locked" {
        bind "Alt p" { SwitchToMode "Pane"; }
    }

    pane {
        bind "Alt p" { SwitchToMode "Normal"; }
    }

    // The web client delivers a bare Esc to the pane as an empty write, so
    // nothing arrives in a pane not using the kitty keyboard protocol
    // (zellij-org/zellij#5190, from 0.44.2). A binding matches the parsed key
    // rather than the raw bytes, so writing the byte here gets it through.
    // Normal and locked are the only modes where Esc has no default binding;
    // drop this once the upstream fix ships.
    shared_among "normal" "locked" {
        bind "Esc" { Write 27; }
    }

    // Tab picker; bin/pick-tab says which keys do what. Alt rather
    // than Ctrl+e, which every pane would lose as end-of-line. In place
    // rather than floating: opening a floating pane reveals any hidden
    // floating panes in the tab and leaves them showing after it exits.
    // Back to normal mode so that, from tab mode, typing reaches the picker
    // instead of tab mode's own bindings.
    shared_except "locked" {
        bind "Alt e" {
            Run "pick-tab" {
                in_place true
                close_on_exit true
                name "tabs"
            }
            SwitchToMode "normal"
        }

        // Worktree picker, manage-worktrees with no command, by name rather
        // than the `wt` alias, which bash -c never defines. In place and back
        // to normal mode for the tab picker's reasons. close_on_exit would
        // close the pane on an error before it could be read, so a failure
        // waits for a key first.
        bind "Alt E" {
            Run "bash" "-c" "manage-worktrees || read -rsn1 -p 'manage-worktrees failed; press any key to close'" {
                in_place true
                close_on_exit true
                name "worktrees"
            }
            SwitchToMode "normal"
        }

        // Recipe picker, pick-just, in place and back to normal mode for the
        // tab picker's reasons. A Run pane starts in the focused pane's
        // directory, which is where just looks for the justfile. --hold keeps
        // the recipe's output until a key, since the pane closes on exit.
        // Taking Alt+j gives up its default, moving focus down, which Alt+Down
        // still does.
        bind "Alt j" {
            Run "pick-just" "--hold" {
                in_place true
                close_on_exit true
                name "just"
            }
            SwitchToMode "normal"
        }

        // Branch cleanup, manage-git, for the same reasons as the worktree
        // picker. Tearing down the worktree of this tab closes the tab, picker
        // and all, which is why `manage-worktrees done` closes it after every
        // other.
        bind "Alt D" {
            Run "bash" "-c" "manage-git || read -rsn1 -p 'manage-git failed; press any key to close'" {
                in_place true
                close_on_exit true
                name "manage-git"
            }
            SwitchToMode "normal"
        }
    }
}
