#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.15"
# dependencies = ["counterweight==0.2.0"]
#
# [tool.uv]
# exclude-newer = "7 days"
# exclude-newer-package = { counterweight = false, evp = false, waxy = false, without-cli = false, without-logging = false, without-streams = false }
# ///
"""
See which processes are listening on TCP ports, copy a port's URL, and stop the process behind one.

The interactive counterpart to `port-user` and `port-kill`. Each row is a port, the command listening on it, and its
working directory. Type to narrow the rows to those containing the text, ignoring case; digits narrow too, since
ports are what you'd type, and a port typed whole comes first. Up, Down, Tab, Shift+Tab, Ctrl+N, Ctrl+P and Ctrl+K
move the highlight, and the query edits as a shell's line does (Left, Right, Ctrl+A, Ctrl+E, Ctrl+W, Ctrl+U and the
rest). Enter copies the highlighted port's URL with OSC 52, Ctrl+X sends its process
SIGTERM and a second Ctrl+X on the same row SIGKILL, and Escape or Ctrl+C leaves.

The URL is the one `exe-dev url` prints on an exe.dev VM, and http://localhost:<port>/ anywhere else.
The listing is read again every second, so a stopped process drops out and a new server appears, and the highlight
stays on its port while rows come and go around it. Only TCP listeners show, and only the current user's:
lsof sees no one else's sockets without root.
"""

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests (`_selftest`).
# This marker line is how `claude-hook-selftests` discovers participating scripts.

from __future__ import annotations

import asyncio
import os
import signal
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass
from dataclasses import replace
from datetime import timedelta
from functools import cache
from pathlib import Path
from typing import assert_never

from counterweight import app
from counterweight.components import component
from counterweight.controls import CopyToClipboard
from counterweight.controls import Quit
from counterweight.controls import ScrollIntoView
from counterweight.elements import Div
from counterweight.elements import Text
from counterweight.events import InputEvent
from counterweight.events import InputResponse
from counterweight.events import KeyPressed
from counterweight.events import Pasted
from counterweight.events import Receiver
from counterweight.events import response_controls
from counterweight.focus import ElementHandle
from counterweight.headless import Highlight
from counterweight.headless import TextInput
from counterweight.headless import substring_matches
from counterweight.headless import use_text_input
from counterweight.hooks import get_state
from counterweight.hooks import use_effect
from counterweight.hooks import use_state
from counterweight.keys import Key
from counterweight.styles import Style
from counterweight.styles.utilities import *

DOWN_KEYS = frozenset({Key.Down, Key.Tab, Key.ControlN})
UP_KEYS = frozenset({Key.Up, Key.BackTab, Key.ControlP, Key.ControlK})
LEAVE_KEYS = frozenset({Key.Escape, Key.ControlC})
POLL_INTERVAL = timedelta(seconds=1)

type ListenerKey = tuple[int, int]


@dataclass(frozen=True, slots=True)
class Listener:
    """A process listening on a TCP port."""

    port: int
    pid: int
    command: str
    cwd: str
    url: str | None



def listener_key(listener: Listener) -> ListenerKey:
    """What identifies a row across listings: one process can listen on several ports, and a port can be reused by a
    new process, which is a different row."""
    return (listener.pid, listener.port)


def searchable(listener: Listener) -> str:
    """The text a query matches a row by."""
    return f"{listener.port} {listener.command} {listener.cwd}"


def parse_lsof(fields: str) -> dict[int, list[str]]:
    """Each process's `n` fields from `lsof -F` output, where a `p` line starts the next process's lines.

    Other field lines (`f` for the descriptor, `c` for the command) are skipped, whichever lsof includes.
    """
    names: dict[int, list[str]] = {}
    pid = None
    for line in fields.splitlines():
        match line[:1], line[1:]:
            case "p", value:
                pid = int(value)
                names.setdefault(pid, [])
            case "n", value if pid is not None:
                names[pid].append(value)
            case _:
                pass
    return names


def listening_ports(fields: str) -> list[ListenerKey]:
    """The (pid, port) pairs in `lsof -iTCP -sTCP:LISTEN -Fpn` output, by port then pid.

    A server bound to both 127.0.0.1 and [::1] is listed once per address, so pairs are deduplicated.
    """
    pairs = {
        (pid, int(address.rpartition(":")[2])) for pid, addresses in parse_lsof(fields).items() for address in addresses
    }
    return sorted(pairs, key=lambda pair: (pair[1], pair[0]))


def parse_ps(output: str) -> dict[int, str]:
    """Each process's full command line from `ps -o pid=,args=`, which lsof's `c` field truncates to 15 bytes."""
    commands = {}
    for line in output.splitlines():
        pid, _, args = line.strip().partition(" ")
        commands[int(pid)] = args.strip()
    return commands


def tilde(path: str) -> str:
    """PATH with the home directory written as ~."""
    home = str(Path.home())
    return "~" + path.removeprefix(home) if path == home or path.startswith(home + "/") else path


def lsof(*args: str) -> str:
    """lsof's stdout, where exit 1 means nothing matched rather than failure.

    Its stderr is captured because this runs while the picker owns the screen.
    """
    result = subprocess.run(["lsof", "-nP", *args], capture_output=True, text=True)
    if result.returncode not in (0, 1):
        raise RuntimeError(f"lsof {' '.join(args)} exited {result.returncode}: {result.stderr.strip()}")
    return result.stdout


def read_listeners(url: Callable[[int], str | None]) -> tuple[Listener, ...]:
    """The current user's TCP listeners, with each one's full command, working directory and URL."""
    ports = listening_ports(lsof("-iTCP", "-sTCP:LISTEN", "-Fpn"))
    if not ports:
        return ()
    pids = ",".join(sorted({str(pid) for pid, _ in ports}))
    cwds = {pid: names[0] for pid, names in parse_lsof(lsof("-a", "-d", "cwd", "-p", pids, "-Fn")).items() if names}
    # ps exits 1 when a pid exited since lsof listed it; the ones still running are printed either way.
    commands = parse_ps(subprocess.run(["ps", "-o", "pid=,args=", "-p", pids], capture_output=True, text=True).stdout)
    return tuple(
        Listener(port=port, pid=pid, command=commands.get(pid, "?"), cwd=tilde(cwds.get(pid, "?")), url=url(port))
        for pid, port in ports
        # A process that exited between the lsof and the ps is gone; the next listing drops its port too.
        if pid in commands
    )


def url_finder() -> Callable[[int], str | None]:
    """A function from a port to its URL, asking `exe-dev url` once per port on an exe.dev VM.

    `exe-dev url` holds which ports exe.dev forwards and which one the bare hostname reaches, so it is asked rather
    than repeating that here. A port it refuses has no URL.
    """
    if subprocess.run(["is-exe-dev"], capture_output=True).returncode != 0:
        return lambda port: f"http://localhost:{port}/"

    @cache
    def exe_dev_url(port: int) -> str | None:
        result = subprocess.run(["exe-dev", "url", str(port)], capture_output=True, text=True)
        return result.stdout.strip() if result.returncode == 0 else None

    return exe_dev_url


def matching(query: str, listeners: tuple[Listener, ...]) -> tuple[Listener, ...]:
    """The listeners whose port, command or working directory contains `query`, ignoring case."""
    return substring_matches(query, listeners, key=searchable)


@dataclass(frozen=True, slots=True)
class Copy:
    """Copy `text` to the clipboard."""

    text: str


@dataclass(frozen=True, slots=True)
class Signal:
    """Send `signum` to `pid`."""

    pid: int
    signum: signal.Signals


@dataclass(frozen=True, slots=True)
class Leave:
    """Leave the manager."""


type Action = Copy | Signal | Leave


@dataclass(frozen=True, slots=True)
class Refreshed:
    """A new listing arrived."""

    listeners: tuple[Listener, ...]


@dataclass(frozen=True, slots=True)
class Managing:
    """
    The listing, the query, the highlight, and the rows sent TERM.

    The highlight is held both by its row's key and by its position. The key keeps it on its port while the rows above
    come and go; the position is where it lands when its own row goes, so stopping a process leaves the highlight on
    its neighbour rather than at the top.
    """

    listeners: tuple[Listener, ...]
    query: str
    highlight: Highlight
    terminated: frozenset[ListenerKey]
    notice: str

    @property
    def shown(self) -> tuple[Listener, ...]:
        return matching(self.query, self.listeners)

    @property
    def highlighted(self) -> Listener | None:
        shown = self.shown
        index = self.highlight.index_in(shown, listener_key)
        return None if index is None else shown[index]

    def landed(self) -> Managing:
        """The highlight on the row it is on now, so it follows that row from here."""
        return replace(self, highlight=self.highlight.landed(self.shown, listener_key))

    def edited(self, query: str) -> Managing:
        """A changed query highlights its first match, as the other pickers' does."""
        return self if query == self.query else replace(self, query=query, highlight=Highlight()).landed()

    def acting(self, action: Action, notice: str) -> tuple[Managing, Action]:
        return replace(self, notice=notice), action


def opening(listeners: tuple[Listener, ...]) -> Managing:
    """An empty query highlighting the first port."""
    return Managing(listeners=listeners, query="", highlight=Highlight(), terminated=frozenset(), notice="").landed()


def received(manager: Managing, refreshed: Refreshed) -> Managing:
    """The manager showing a new listing, forgetting the TERMs sent to rows that are gone."""
    alive = {listener_key(listener) for listener in refreshed.listeners}
    return replace(manager, listeners=refreshed.listeners, terminated=manager.terminated & alive).landed()


def step(manager: Managing, event: InputEvent) -> tuple[Managing, Action | None] | None:
    """
    The manager after a key that acts rather than edits, and what it asks to be done, or `None` for an event the
    query's field handles.

    The component carries the action out, keeping this pure.
    """
    match event:
        case KeyPressed(key=key) if key in LEAVE_KEYS:
            return manager, Leave()
        # Enter typed ahead, before the terminal goes raw, has had its \r turned into \n (Ctrl+J) by the tty.
        case KeyPressed(key=Key.Enter | Key.ControlJ) if (listener := manager.highlighted) is not None:
            if listener.url is None:
                return replace(manager, notice=f"nothing outside this machine reaches port {listener.port}"), None
            return manager.acting(Copy(text=listener.url), f"copied {listener.url}")
        case KeyPressed(key=Key.ControlX) if (listener := manager.highlighted) is not None:
            if listener_key(listener) in manager.terminated:
                return manager.acting(Signal(pid=listener.pid, signum=signal.SIGKILL), f"sent KILL to {listener.pid}")
            terminated = replace(manager, terminated=manager.terminated | {listener_key(listener)})
            return terminated.acting(Signal(pid=listener.pid, signum=signal.SIGTERM), f"sent TERM to {listener.pid}")
        case KeyPressed(key=key) if key in DOWN_KEYS:
            return replace(manager, highlight=manager.highlight.moved(manager.shown, 1, listener_key)), None
        case KeyPressed(key=key) if key in UP_KEYS:
            return replace(manager, highlight=manager.highlight.moved(manager.shown, -1, listener_key)), None
        case _:
            return None


def trimmed(event: InputEvent) -> InputEvent:
    """A paste without the line break a copied line ends with, which the field would make a trailing space."""
    return Pasted(text=event.text.rstrip("\r\n")) if isinstance(event, Pasted) else event


def query_row(field: TextInput) -> Div:
    """The query after its prompt, with the cursor drawn over the cell it's in."""
    return Div(
        style=row | overflow_x_scroll | stick_to_end_x,
        children=(
            Text(content="> ", style=text_wrap_none | text_color("slate", 400)),
            Text(content=field.before_cursor, style=text_wrap_none),
            Text(
                content=field.at_cursor,
                handle=field.cursor_cell,
                style=text_wrap_none | text_color("slate", 900) | text_bg("sky", 300),
            ),
            Text(content=field.after_cursor, style=text_wrap_none),
        ),
    )


def send(action: Signal) -> str | None:
    """Send the signal, returning why it could not be sent, if it could not."""
    try:
        os.kill(action.pid, action.signum)
    except ProcessLookupError:
        return f"{action.pid} had already exited"
    except PermissionError:
        return f"not allowed to signal {action.pid}"
    return None


@component
def manager_view(
    listeners: tuple[Listener, ...],
    poll: Callable[[], tuple[Listener, ...]],
    signal_process: Callable[[Signal], str | None],
) -> Div:
    manager, set_manager = use_state(lambda: opening(listeners))
    row_handle, _ = use_state(ElementHandle)

    async def refresh() -> None:
        while True:
            await asyncio.sleep(POLL_INTERVAL.total_seconds())
            listing = await asyncio.to_thread(poll)
            set_manager(lambda latest: received(latest, Refreshed(listeners=listing)))

    use_effect(refresh, deps=())

    field = use_text_input(
        manager.query, lambda edit: set_manager(lambda latest: latest.edited(edit(latest.query))).query, auto_focus=True
    )

    def on_input(event: InputEvent, receiver: Receiver) -> InputResponse:
        scroll = ScrollIntoView(row_handle, block="nearest")
        if (handled := step(get_state(set_manager), event)) is None:
            if (controls := response_controls(field.on_input(trimmed(event), receiver))) is None:
                return None
            return (*controls, scroll)
        stepped, action = handled
        match action:
            case Leave():
                return Quit()
            case Copy(text=text):
                set_manager(stepped)
                return CopyToClipboard(text=text), scroll
            case Signal() as sent:
                failure = signal_process(sent)
                set_manager(stepped if failure is None else replace(stepped, notice=failure))
                return scroll
            case None:
                set_manager(stepped)
                return scroll
            case _ as unreachable:
                assert_never(unreachable)

    shown, highlighted = manager.shown, manager.highlighted

    def listener_row(listener: Listener) -> Div:
        is_highlighted = listener is highlighted
        command_color = text_color("amber", 300) if is_highlighted else text_color("slate", 300)
        weight = text_bold if is_highlighted else Style()
        return Div(
            style=row,
            handle=row_handle if is_highlighted else None,
            children=(
                Text(content=f"{listener.port:>5}  ", style=text_wrap_none | command_color | weight),
                Text(
                    content="TERM sent  " if listener_key(listener) in manager.terminated else "",
                    style=text_wrap_none | text_color("red", 400),
                ),
                Text(content=listener.command, style=text_wrap_none | command_color),
                Text(content=f"  {listener.cwd}", style=text_wrap_none | text_color("slate", 500)),
            ),
        )

    footer = highlighted.url if highlighted is not None and highlighted.url else ""
    return Div(
        style=full | col | border | border_lightrounded | border_color("slate", 500) | pad_x(1),
        on_input=on_input,
        children=(
            Text(
                content="Enter copies the URL, Ctrl+X stops the process (again to kill it), Esc leaves",
                style=text_wrap_none | text_color("slate", 400),
            ),
            query_row(field),
            Div(
                style=col | fill(1) | overflow_y_scroll,
                children=tuple(listener_row(listener) for listener in shown)
                or (
                    Text(
                        content="no port matches" if manager.listeners else "nothing is listening",
                        style=text_color("slate", 400),
                    ),
                ),
            ),
            Text(content=manager.notice or footer, style=text_wrap_none | text_color("sky", 300)),
        ),
    )


async def manage(
    listeners: tuple[Listener, ...],
    poll: Callable[[], tuple[Listener, ...]],
    signal_process: Callable[[Signal], str | None] = send,
    **app_options: object,
) -> None:
    """Run the manager until it is left."""
    await app(manager_view(listeners, poll, signal_process), **app_options)


def _selftest() -> int:
    from functools import reduce

    from counterweight.autopilot import typed
    from counterweight.controls import Screenshot
    from counterweight.paint import Frame

    fields = "p10\nfcwd\nn127.0.0.1:8000\nn[::1]:8000\np20\nccode\nn*:3001\np10\nn127.0.0.1:3000\n"
    web = Listener(port=3000, pid=10, command="zellij web", cwd="~", url="https://vm.exe.xyz:3000/")
    code = Listener(port=3001, pid=20, command="code serve-web", cwd="~/projects", url="https://vm.exe.xyz:3001/")
    atlas = Listener(port=8000, pid=30, command="exe-dev-atlas serve", cwd="~", url=None)
    listeners = (web, code, atlas)
    enter, ctrl_x = KeyPressed(key=Key.Enter), KeyPressed(key=Key.ControlX)
    down, up = KeyPressed(key=Key.Down), KeyPressed(key=Key.Up)

    def stepped(*inputs: InputEvent | Refreshed | str) -> tuple[Managing, tuple[Action, ...]]:
        """The manager after each input, and the actions they asked for, a string standing for the query typed onto."""
        manager = opening(listeners)
        actions: tuple[Action, ...] = ()
        for given in inputs:
            match given:
                case str():
                    manager = manager.edited(manager.query + given)
                case Refreshed():
                    manager = received(manager, given)
                case _ if (handled := step(manager, given)) is not None:
                    manager, action = handled
                    actions += (action,) if action is not None else ()
                case _:
                    pass
        return manager, actions

    def managing(*inputs: InputEvent | Refreshed | str) -> Managing:
        return stepped(*inputs)[0]

    def acted(*inputs: InputEvent | Refreshed | str) -> tuple[Action, ...]:
        return stepped(*inputs)[1]

    cases: list[tuple[str, bool]] = [
        (
            "lsof fields parse by process, skipping fields other than names",
            parse_lsof(fields) == {10: ["127.0.0.1:8000", "[::1]:8000", "127.0.0.1:3000"], 20: ["*:3001"]},
        ),
        ("listening ports are deduplicated across addresses and sorted by port", listening_ports(fields) == [(10, 3000), (20, 3001), (10, 8000)]),
        ("ps output parses each pid's whole command line", parse_ps("   10 zellij  web --port 3000\n 2001 ps -o\n") == {10: "zellij  web --port 3000", 2001: "ps -o"}),
        ("the home directory is written as ~", tilde(str(Path.home() / "x")) == "~/x"),
        ("a sibling of the home directory is not", tilde(str(Path.home()) + "-other") == str(Path.home()) + "-other"),
        ("digits narrow, matching the port", managing("3001").shown == (code,)),
        ("matching reaches the working directory, ignoring case", managing("PROJ").shown == (code,)),
        ("a port typed whole comes first", managing("8000").shown == (atlas,)),
        ("Enter copies the highlighted URL", acted(down, enter) == (Copy(text=code.url),)),
        ("Enter on a port nothing outside reaches copies nothing", acted(up, enter) == ()),
        ("Ctrl+X sends a TERM", acted(ctrl_x) == (Signal(pid=10, signum=signal.SIGTERM),)),
        (
            "a second Ctrl+X on the same row sends a KILL",
            acted(ctrl_x, ctrl_x) == (Signal(pid=10, signum=signal.SIGTERM), Signal(pid=10, signum=signal.SIGKILL)),
        ),
        ("Ctrl+X on another row sends that one TERM", acted(ctrl_x, down, ctrl_x)[-1] == Signal(pid=20, signum=signal.SIGTERM)),
        ("an action says what it did", managing(ctrl_x).notice == "sent TERM to 10"),
        ("the highlight stays on its port as a row above it goes", managing(down, down, Refreshed(listeners=(code, atlas))).highlighted == atlas),
        ("the highlight stays on its port as a row above it appears", managing(down, Refreshed(listeners=(atlas, web, code))).highlighted == code),
        ("when its own row goes, the highlight lands on the row that took its place", managing(down, Refreshed(listeners=(web, atlas))).highlighted == atlas),
        ("when the last row goes, the highlight lands on the new last", managing(up, Refreshed(listeners=(web, code))).highlighted == code),
        ("a port that stops listening is no longer marked as sent TERM", managing(ctrl_x, Refreshed(listeners=(code,))).terminated == frozenset()),
        (
            "a row that comes back on a new pid is a new row, not marked as sent TERM",
            managing(ctrl_x, Refreshed(listeners=(replace(web, pid=11), code))).terminated == frozenset(),
        ),
        ("Up from the top wraps to the last", managing(up).highlighted == atlas),
        ("Escape leaves", acted(KeyPressed(key=Key.Escape)) == (Leave(),)),
    ]

    sent: list[Signal] = []
    copied: list[str] = []
    frames: list[Frame] = []

    def run_headless(*steps: object, shown: tuple[Listener, ...] = listeners, failure: str | None = None) -> None:
        def signal_process(action: Signal) -> str | None:
            sent.append(action)
            return failure

        asyncio.run(
            asyncio.wait_for(
                manage(
                    shown, lambda: shown, signal_process, headless=True, dimensions=(80, 10),
                    clipboard_handler=copied.append, autopilot=[*steps, Quit()],
                ),
                timeout=timedelta(seconds=30).total_seconds(),
            )
        )

    run_headless(*typed("301"), KeyPressed(key=Key.Left), *typed("0"), ctrl_x, enter, KeyPressed(key=Key.Escape))
    cases += [
        ("the app sends the signals asked for, the query edited at the cursor", sent == [Signal(pid=20, signum=signal.SIGTERM)]),
        ("the app copies the URL asked for", copied == [code.url]),
    ]
    run_headless(ctrl_x, Screenshot(frames.append), failure="not allowed to signal 10")
    cases += [("a signal that fails says why", bool(frames) and "not allowed to signal 10" in frames[-1].text(ansi=False))]

    many = tuple(Listener(port=4000 + index, pid=100 + index, command=f"server-{index:02}", cwd="~", url=None) for index in range(30))
    frames.clear()
    run_headless(*(down for _ in range(20)), Screenshot(frames.append), shown=many)
    screen = frames[0].text(ansi=False) if frames else ""
    cases += [("moving past the rows shown scrolls the highlight into view", "server-20" in screen and "server-00" not in screen)]

    failures = [name for name, passed in cases if not passed]
    for name in failures:
        print(f"FAIL: {name}", file=sys.stderr)
    print(f"manage-ports: {len(cases) - len(failures)}/{len(cases)} passed")
    return 1 if failures else 0


def main() -> int:
    if os.environ.get("CLAUDE_HOOK_SELFTEST"):
        return _selftest()

    url = url_finder()
    asyncio.run(manage(read_listeners(url), lambda: read_listeners(url), title="ports"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
