#!/usr/bin/env bash
# Stage tracked changes and run pre-commit; on failure, re-stage any auto-fixes
# and run once more, then stage again. Exit 0 if pre-commit passes (possibly
# after auto-fixing), non-zero if it still fails. Arguments forward to
# `pre-commit run`.
#
# The first pass reports on stderr and the last on stdout, so a caller capturing stdout is handed the
# state the tree is actually in rather than that plus a list of failures a hook has since fixed. At a
# terminal the two are one stream, so a person still sees both runs, streamed, in order.
#
# No `-e`: a failing pre-commit run is expected and handled, not fatal.
set -uo pipefail

# The hooks only see what the index holds, so a new file nobody has staged passes by never being
# checked. Say so rather than staging it: whether it belongs in the repo is the caller's decision
# (`claude-stop-precommit` makes it one at stop time), and a silent `git add --all` would take it.
UNTRACKED=$(git ls-files --others --exclude-standard)
if [[ -n "$UNTRACKED" ]]; then
  {
    echo "pre-commit-autofix: these untracked files are not checked until they are staged (git add, or git add --intent-to-add):"
    printf '%s\n' "$UNTRACKED" | sed 's/^/  /'
  } >&2
fi

git add --update
pre-commit-run run "$@" >&2 && exit 0

git add --update
pre-commit-run run "$@" 2>&1
rc=$?
git add --update
exit "$rc"
