  .page { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding-block: 1.5rem 3rem; }
  .outline { position: static; max-height: none; overflow-y: visible; }
  .outline summary { display: list-item; cursor: pointer; font: 600 0.8rem/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); padding-block: 0.5rem; }
  .outline:not([open]) ol { display: none; }
