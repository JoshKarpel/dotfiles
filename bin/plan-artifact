FONTS = (
    "https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;600"
    "&family=Bricolage+Grotesque:opsz,wght@12..96,600..700&family=JetBrains+Mono:wght@400;600&display=swap"
)


@dataclass(frozen=True, slots=True)
class Heading:
    """A section the outline links to."""

    level: int
    anchor: str
    label: Markup


@dataclass(frozen=True, slots=True)
class Plan:
    """
    What the page is built from: the title, the outline, the rendered body, and its task counts.
    """

    title: str
    title_html: Markup
    title_anchor: str
    headings: tuple[Heading, ...]
    body: Markup
    tasks_done: int
    tasks_total: int
    wide: bool


# A table with at least this many columns gets the wide page layout.
WIDE_TABLE_COLUMNS = 5

# A figure opts into the wide page layout with a `wide` class, quoted either way.
WIDE_FIGURE = re.compile(r"""<figure\b[^>]*\bclass=(["'])(?:(?!\1).)*?(?<![\w-])wide(?![\w-])""", re.IGNORECASE)

# Elements that, starting a line, are one raw HTML block through their closing tag. CommonMark ends
# such a block at the first blank line, which would split a drawing or a figure's script mid-way and
# render the rest as paragraphs, so `join_raw_blocks` drops the blank lines inside them. A tag that
# closes itself on its line (`<svg .../>`) opens nothing, or the count would never return to zero.
RAW_BLOCK_OPEN = re.compile(r"<(svg|figure)(?=[\s/>]|$)(?![^<>]*/>)", re.IGNORECASE)
RAW_BLOCK_START = re.compile(r"^ {0,3}" + RAW_BLOCK_OPEN.pattern, re.IGNORECASE)
RAW_BLOCK_CLOSE = re.compile(r"</(svg|figure)\s*>", re.IGNORECASE)
FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")


def join_raw_blocks(lines: list[str]) -> list[str]:
    """
    The plan's lines with blank lines dropped inside each `<svg>` or `<figure>` that starts a line.

    Nesting is counted, so the block ends at the outer element's closing tag. Fenced code is left
    alone, so a fence showing an `<svg>` keeps its blank lines, and an element that opens mid-line
    stays inline HTML for markdown to handle. A `<figure>` whose opening line is followed by a blank
    line is left alone too: that is how markdown (a mermaid fence, an image) goes inside one, as with
    `<details>`.

    Raises `ValueError` on an element that is never closed, which would otherwise swallow every
    blank line after it and render the rest of the plan as one raw block.
    """
    kept: list[str] = []
    fence: str | None = None
    depth, opened_at = 0, 0
    for number, line in enumerate(lines, start=1):
        if depth == 0 and (match := FENCE.match(line)):
            marker, rest = match.groups()
            if fence is None:
                fence = marker
            # A closing fence carries no info string.
            elif marker[0] == fence[0] and len(marker) >= len(fence) and not rest.strip():
                fence = None
        elif fence is None and depth > 0:
            if not line.strip():
                continue
            depth = max(0, depth + len(RAW_BLOCK_OPEN.findall(line)) - len(RAW_BLOCK_CLOSE.findall(line)))
        elif fence is None and (start := RAW_BLOCK_START.match(line)):
            markdown_inside = start.group(1).lower() == "figure" and number < len(lines) and not lines[number].strip()
            if not markdown_inside:
                depth = max(0, len(RAW_BLOCK_OPEN.findall(line)) - len(RAW_BLOCK_CLOSE.findall(line)))
                opened_at = number
        kept.append(line)
    if depth > 0:
        raise ValueError(f"the <svg> or <figure> opened on line {opened_at} is never closed")
    return kept


def widest_table(tokens: list[Token]) -> int:
    """The column count of the plan's widest table, read from header cells; 0 when it has none."""
    widest, in_head, count = 0, False, 0
    for token in tokens:
        if token.type == "thead_open":
            in_head, count = True, 0
        elif token.type == "thead_close":
            in_head, widest = False, max(widest, count)
        elif in_head and token.type == "th_open":
            count += 1
    return widest


def markdown() -> MarkdownIt:
    """GitHub-flavored markdown with raw HTML, plus heading anchors and permalinks and mermaid fences."""
    # The plugin's own `permalink` appends the link to the heading's inline tokens, where it would
    # leak into outline labels, so it only sets ids and `heading_close` draws the link.
    # From `#` down, so the title's anchor and the sections' are deduplicated together.
    md = MarkdownIt("commonmark", {"html": True}).use(gfm_plugin).use(anchors_plugin, min_level=1, max_level=6, permalink=False)
    default_fence = md.renderer.rules["fence"]

    # Bound as a method of the renderer, hence `renderer` first.
    def fence(renderer: RendererHTML, tokens: list[Token], index: int, options: OptionsDict, env: dict[str, object]) -> str:
        token = tokens[index]
        if token.info.strip() == "mermaid":
            return f'<pre class="mermaid">{escape(token.content)}</pre>\n'
        return default_fence(tokens, index, options, env)

    def heading_close(renderer: RendererHTML, tokens: list[Token], index: int, options: OptionsDict, env: dict[str, object]) -> str:
        # A heading is always heading_open, inline, heading_close.
        anchor = tokens[index - 2].attrs.get("id")
        permalink = f'<a class="header-anchor" href="#{escape(anchor)}" aria-label="Link to this section">#</a>' if isinstance(anchor, str) else ""
        return permalink + renderer.renderToken(tokens, index, options, env)

    md.add_render_rule("fence", fence)
    md.add_render_rule("heading_close", heading_close)
    return md


def inline_html(md: MarkdownIt, inline: Token) -> Markup:
    """
    A heading's markdown rendered as HTML, so `code` in it reads as code rather than as backticks.

    Its links are unwrapped, since the outline puts each heading inside a link of its own.
    """
    children = [child for child in inline.children or [] if child.type not in ("link_open", "link_close")]
    return Markup(md.renderer.renderInline(children, md.options, {}))


def inline_text(inline: Token) -> str:
    """A heading's markdown as plain text, for `<title>`, which shows no markup."""
    return "".join(child.content for child in inline.children or [] if child.type in ("text", "code_inline"))


def parse_plan(source: str) -> Plan:
    """
    A plan from its markdown.

    The first `#` heading is the page's title and is lifted out of the body into the masthead; the
    `Artifact:` line is dropped wherever it sits. A plan with no `#` heading is titled "Plan".
    """
    lines = join_raw_blocks([line for line in source.splitlines() if not ARTIFACT_LINE.match(line)])
    md = markdown()
    tokens = md.parse("\n".join(lines))
    first_h1 = next((i for i, token in enumerate(tokens) if token.type == "heading_open" and token.tag == "h1"), None)
    if first_h1 is None:
        # Parsed with the rest rather than made up afterwards, so its anchor is deduplicated against theirs.
        tokens, first_h1 = md.parse("\n".join(["# Plan", "", *lines])), 0
    title_inline = tokens[first_h1 + 1]
    title_anchor = str(tokens[first_h1].attrs["id"])
    # heading_open, inline, heading_close: the masthead shows the title instead.
    tokens = tokens[:first_h1] + tokens[first_h1 + 3 :]
    headings = [
        Heading(level=int(token.tag[1]), anchor=anchor, label=inline_html(md, tokens[index + 1]))
        for index, token in enumerate(tokens)
        if token.type == "heading_open" and token.tag in ("h2", "h3") and isinstance(anchor := token.attrs.get("id"), str)
    ]
    body = md.renderer.render(tokens, md.options, {})
    # A wide table scrolls inside its own box rather than the page.
    body = body.replace("<table>", '<div class="table-wrap"><table>').replace("</table>", "</table></div>")
    # A task item is a list item whose meta carries `checked`; ordinary list items carry no such key.
    tasks = [token.meta["checked"] for token in tokens if token.type == "list_item_open" and "checked" in token.meta]
    done, total = sum(tasks), len(tasks)
    return Plan(
        title=inline_text(title_inline),
        title_html=inline_html(md, title_inline),
        title_anchor=title_anchor,
        headings=tuple(headings),
        body=Markup(body),
        tasks_done=done,
        tasks_total=total,
        wide=widest_table(tokens) >= WIDE_TABLE_COLUMNS
        or any(token.type == "html_block" and WIDE_FIGURE.search(token.content) for token in tokens),
    )


def page(plan: Plan) -> str:
    """The whole page, as the Artifact tool wants it: title and styles first, no html/head/body tags."""
    progress = None
    if plan.tasks_total:
        percent = round(100 * plan.tasks_done / plan.tasks_total)
        progress = div(
            cls="progress",
            children=[
                span(cls="chip", children=f"{plan.tasks_done} of {plan.tasks_total} done"),
                span(cls="bar", attrs={"aria-hidden": "true"}, children=span(attrs={"style": f"width: {percent}%"})),
            ],
        )
    # Links to the top go to the title's anchor, not the bare artifact URL: the viewer restores the
    # frame's scroll position when it reloads, so the bare URL lands wherever the reader already was.
    href = f"#{plan.title_anchor}"
    top = li(children=a(attrs={"href": href}, children=plan.title_html))
    title_link = f'<a class="header-anchor" href="{escape(href)}" aria-label="Link to this plan">#</a>'
    outline = details(
        cls="outline",
        attrs={"open": True},
        children=[
            summary(children="Contents"),
            nav(
                attrs={"aria-label": "Contents"},
                children=ol(
                    children=[
                        top,
                        *(
                            li(cls="sub" if heading.level == 3 else None, children=a(attrs={"href": f"#{heading.anchor}"}, children=heading.label))
                            for heading in plan.headings
                        ),
                    ]
                ),
            ),
        ],
    )
    return render(
        [
            title(children=plan.title),
            meta(attrs={"name": "claude:viewport-fit-sides", "content": "cover"}),
            meta(attrs={"name": "generator", "content": "plan-artifact"}),
            link(attrs={"rel": "stylesheet", "href": FONTS}),
            style(children=Markup(STYLESHEET)),
            div(
                cls="page wide" if plan.wide else "page",
                children=[
                    header(
                        cls="masthead",
                        children=[Markup(f'<h1 id="{escape(plan.title_anchor)}">{plan.title_html}{title_link}</h1>'), progress],
                    ),
                    outline if plan.headings else div(),
                    article(cls="plan", children=plan.body),
                ],
            ),
        ]
    )


def overwrite_refusal(out: Path, existing: str | None) -> str | None:
    """
    Why writing a page to `out` is refused, or `None` when it may go ahead.

    `existing` is the text already at `out`, `None` when nothing is there. Only an `.html` path is
    written, and an existing file only when it carries the `GENERATOR` mark.
    """
    if out.suffix != ".html":
        return f"{out} is not an .html path"
    if existing is not None and GENERATOR not in existing:
        return f"{out} exists and is not a page plan-artifact wrote, so it is not overwritten"
    return None


def raises(call: Callable[[], object]) -> BaseException | None:
    """The exception `call` raises, or `None`, so a self-test can compare it like any other value."""
    try:
        call()
    except Exception as error:
        return error
    return None


def selftest() -> int:
    """The parse, against a small plan, without touching the filesystem."""
    source = """# Ship the `thing`

Artifact: https://claude.ai/code/artifact/abc

## Steps

- [x] write it
- [ ] test it
- [X] doc it

### Detail on `Query` and [links](https://example.com)

#### Fine print

```mermaid
graph TD; A-->B
```

```python
x = "<b>"
```

<svg viewBox="0 0 10 10">
  <rect width="10" height="10" fill="var(--accent)"/>
</svg>
"""
    plan = parse_plan(source)
    html = page(plan)
    checks: list[tuple[str, object, object]] = [
        ("title from the first # heading, as plain text", plan.title, "Ship the thing"),
        (
            "outline from ## and ###, not deeper",
            [(h.level, h.anchor) for h in plan.headings],
            [(2, "steps"), (3, "detail-on-query-and-links")],
        ),
        (
            "a heading carries a permalink to its own anchor",
            '<h2 id="steps">Steps<a class="header-anchor" href="#steps" aria-label="Link to this section">#</a></h2>' in plan.body,
            True,
        ),
        ("a heading below the outline is still anchored", '<h4 id="fine-print">Fine print<a class="header-anchor" href="#fine-print"' in plan.body, True),
        ("outline labels carry no permalink", "header-anchor" in html.partition("<nav")[2].partition("</nav>")[0], False),
        ("code in a heading is code in the outline", '<code>Query</code> and links</a>' in html, True),
        ("a heading's backticks never reach the page", "`" in html.partition("<article")[0], False),
        ("code in the title is code in the masthead", '<h1 id="ship-the-thing">Ship the <code>thing</code><a ' in html, True),
        ("tasks counted, either x case", (plan.tasks_done, plan.tasks_total), (2, 3)),
        ("the Artifact line is dropped as text", "Artifact:" in html, False),
        ("the artifact url never reaches the page", "claude.ai/code/artifact/abc" in html, False),
        (
            "the title is anchored by its slug and links to itself",
            '<h1 id="ship-the-thing">Ship the <code>thing</code><a class="header-anchor" href="#ship-the-thing"' in html,
            True,
        ),
        (
            "the outline leads with the title's anchor",
            html.partition("<ol>")[2].startswith('<li><a href="#ship-the-thing">Ship the <code>thing</code></a></li>'),
            True,
        ),
        ("the title comes first on the page", html.partition('<header class="masthead">')[2].startswith("<h1 "), True),
        (
            "a section slugging like the title is deduplicated against it",
            parse_plan("# Same\n\n## Same\n").headings[0].anchor,
            "same-1",
        ),
        (
            "a plan with no title is anchored as Plan, deduplicated too",
            ((untitled := parse_plan("## Plan\n")).title_anchor, untitled.headings[0].anchor),
            ("plan", "plan-1"),
        ),
        ("the title is not repeated in the body", plan.body.count("Ship the"), 0),
        ("mermaid becomes a pre the viewer draws", '<pre class="mermaid">graph TD; A--&gt;B\n</pre>' in plan.body, True),
        ("other code stays code, escaped", "&lt;b&gt;" in plan.body, True),
        ("raw svg passes through", '<rect width="10" height="10" fill="var(--accent)"/>' in plan.body, True),
        ("the page leads with its title", html.startswith("<title>Ship the thing</title>"), True),
        ("the progress chip shows", "2 of 3 done" in html, True),
        ("a plan without wide tables keeps the narrow page", plan.wide, False),
        ("a five-column table widens the page", parse_plan("| a | b | c | d | e |\n|-|-|-|-|-|\n| 1 | 2 | 3 | 4 | 5 |\n").wide, True),
        ("a four-column table does not", parse_plan("| a | b | c | d |\n|-|-|-|-|\n| 1 | 2 | 3 | 4 |\n").wide, False),
        ("a wide figure widens the page", parse_plan('<figure class="map wide">\n<svg viewBox="0 0 9 9"></svg>\n</figure>\n').wide, True),
        ("a figure that isn't wide does not", parse_plan("<figure>\n<svg viewBox=\"0 0 9 9\"></svg>\n</figure>\n").wide, False),
        (
            "an svg with blank lines inside stays one raw block",
            ("<p>" in (spaced := parse_plan("<svg viewBox=\"0 0 9 9\">\n<rect/>\n\n<text>after</text>\n</svg>\n").body), "<text>after</text>\n</svg>" in spaced),
            (False, True),
        ),
        (
            "a figure's style and script pass through whole, blank lines and all",
            (
                (scripted := parse_plan("<figure>\n<style>\n.a { color: red; }\n\n.b { color: blue; }\n</style>\n\n<script>\nlet x = 1;\n\nx += 1;\n</script>\n</figure>\n\nAfter.\n").body).count("<p>"),
                ".b { color: blue; }\n</style>\n<script>\nlet x = 1;\nx += 1;\n</script>\n</figure>" in scripted,
                "<p>After.</p>" in scripted,
            ),
            (1, True, True),
        ),
        (
            "nested svg and figure close the block only at the outer closing tag",
            "<p>" in parse_plan("<figure>\n<svg>\n<svg>\n</svg>\n\ninner words\n</svg>\n\nmore words\n</figure>\n").body,
            False,
        ),
        (
            "blank lines in a code fence showing an svg are kept",
            "&lt;svg&gt;\n\n&lt;/svg&gt;" in parse_plan("```html\n<svg>\n\n</svg>\n```\n").body,
            True,
        ),
        (
            "a fence line with an info string does not close a fence",
            (
                "&lt;svg&gt;\n\n&lt;/svg&gt;" in (refenced := parse_plan("```\n```python\n<svg>\n\n</svg>\n```\n\n<svg>\n<rect/>\n\n<text>x</text>\n</svg>\n").body),
                "<p>" in refenced,
            ),
            (True, False),
        ),
        (
            "a self-closing svg leaves the rest of the plan to markdown",
            ("<h2" in (closed := parse_plan('<svg viewBox="0 0 1 1"/>\n\n## Next\n\none\n\ntwo\n').body), closed.count("<p>")),
            (True, 2),
        ),
        ("a custom element named like svg opens nothing", parse_plan("<svg-icon>\n</svg-icon>\n\none\n\ntwo\n").body.count("<p>"), 2),
        (
            "a figure opened with a blank line holds markdown, a mermaid fence included",
            ('<pre class="mermaid">' in (marked := parse_plan('<figure class="wide">\n\n```mermaid\ngraph TD; A-->B\n```\n\n</figure>\n')).body, marked.wide),
            (True, True),
        ),
        ("a wide class in single quotes widens the page", parse_plan("<figure class='wide'>\n</figure>\n").wide, True),
        ("a class merely containing wide does not", parse_plan('<figure class="not-wide">\n</figure>\n').wide, False),
        (
            "an element never closed is an error",
            isinstance(raises(lambda: parse_plan("<figure>\n<svg>\n</svg>\n\nmore\n")), ValueError),
            True,
        ),
        (
            "an svg mid-paragraph is left to markdown",
            parse_plan("an icon <svg viewBox=\"0 0 1 1\"></svg> here\n\nnext\n").body.count("<p>"),
            2,
        ),
        ("a list without boxes counts no tasks", parse_plan("- one\n- two\n").tasks_total, 0),
        ("a bare url becomes a link", '<a href="https://example.com/x">' in parse_plan("see https://example.com/x\n").body, True),
        (
            "an alert gets its tone class and title",
            '<div class="markdown-alert markdown-alert-warning">\n<p class="markdown-alert-title">Warning</p>' in parse_plan("> [!WARNING]\n> careful\n").body,
            True,
        ),
        (
            "a footnote links to its note, which renders at the end",
            ('href="#fn1"' in (footnoted := parse_plan("claim[^1]\n\n[^1]: the source\n").body), '<li id="fn1"' in footnoted, "the source" in footnoted),
            (True, True, True),
        ),
        (
            "markdown inside details renders",
            "<strong>folded</strong>" in parse_plan("<details><summary>more</summary>\n\n**folded**\n\n</details>\n").body,
            True,
        ),
        ("the page carries the generator mark", GENERATOR in html, True),
        ("a new .html path is written", overwrite_refusal(Path("/tmp/new.html"), None), None),
        ("a page this script wrote is overwritten", overwrite_refusal(Path("/tmp/old.html"), html), None),
        ("a path that isn't .html is refused", overwrite_refusal(Path("/home/me/.zshrc"), None) is not None, True),
        (
            "an existing .html file from elsewhere is refused",
            overwrite_refusal(Path("/tmp/index.html"), "<title>Someone else's page</title>") is not None,
            True,
        ),
    ]
    fails = 0
    for description, got, want in checks:
        if got != want:
            print(f"FAIL {description}: want={want!r} got={got!r}")
            fails = 1
    if not fails:
        print("plan-artifact: all self-tests passed")
    return fails


# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests. This marker line is how
# `claude-hook-selftests` discovers participating scripts, so it has to start at column 0; run
# these with `CLAUDE_HOOK_SELFTEST=1 plan-artifact`.
def main() -> int:
    """Read the plan, write the page, print where it went."""
    if os.environ.get("CLAUDE_HOOK_SELFTEST"):
        return selftest()
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("plan", type=Path, help="the plan's markdown file")
    parser.add_argument("out", type=Path, help="where to write the page's HTML")
    args = parser.parse_args()
    source, out = args.plan, args.out
    try:
        existing: str | None = out.read_text(errors="replace")
    except FileNotFoundError:
        existing = None
    if reason := overwrite_refusal(out, existing):
        parser.error(reason)
    try:
        plan = parse_plan(source.read_text())
    except ValueError as error:
        parser.error(f"{source}: {error}")
    out.write_text(page(plan))
    print(out)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
