#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["without-html==0.0.10", "markdown-it-py==4.2.0", "mdit-py-plugins==0.6.1"]
#
# [tool.uv]
# exclude-newer = "7 days"
# exclude-newer-package = { without-html = false }
# ///
"""
Render a plan's markdown into the HTML page published as its Artifact.

The `.md` is the plan; the page is derived from it every time, never edited by hand, so there is no
second copy to drift and no page source to keep between sessions. Anything visual belongs in the
markdown itself, which keeps a plan self-contained.

What a plan can use:

- GitHub-flavored markdown, so the plan reads the same on GitHub: tables, strikethrough, bare-URL
  autolinks, footnotes (`[^1]`), and alerts (`> [!NOTE]`, `[!TIP]`, `[!IMPORTANT]`, `[!WARNING]`,
  `[!CAUTION]`).
- The first `#` heading is the page's title, at the very top; the outline beside it leads with the
  title, then `##` and `###` headings. Every heading, the title included, has an anchor and a
  faint `#` link beside it, so any section can be linked to as `<artifact-url>#<slug>`, slugged
  the way GitHub does it, and the title's slug is the top of the page.
- Task items (`- [ ]`, `- [x]`) are counted into a progress bar under the title.
- A table with five or more columns, or a `<figure class="wide">`, widens the page, so a catalogue,
  a matrix, or a large diagram isn't squeezed.
- A ```` ```mermaid ```` fence is drawn as a diagram.
- Raw HTML passes through: `<details>`/`<summary>` to fold away detail, `<kbd>`, `<sup>`/`<sub>`,
  `<svg>`, and `<figure>`. An `<svg>` or `<figure>` that starts a line is one raw block through
  its closing tag, with any blank lines inside it dropped (a blank line inside a `<pre>` or a JS
  template literal goes too), and one that is never closed is an error. Any other HTML block ends
  at the first blank line, so to write markdown inside `<details>`, leave a blank line after
  `</summary>` and before `</details>`; a `<figure>` whose opening line is followed by a blank line
  works the same way, which is how a mermaid fence goes inside a `<figure class="wide">`.
- Color an `<svg>` from the page's tokens so it follows the theme: `currentColor`, `var(--ink)`,
  `var(--muted)`, `var(--accent)`, `var(--rule)`, `var(--surface)`, `var(--paper)`.
- A `<figure>` can carry its own `<style>` and `<script>`, for a diagram with its own palette or
  controls. They share the page with everything else, so scope every rule under the figure's own
  class, prefix its custom properties, ids and marker ids (`--net-forge`, `net-arrow`), and never
  style `:root`, `body` or a bare element. Take neutrals from the page's tokens, and theme the
  rest with the page's selectors: values on the figure's class, then again under
  `@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .net { ... } }` and
  `:root[data-theme="dark"] .net { ... }`. Write the markup so the figure is complete before its
  script runs; the script adds interaction, never content.

An `Artifact: <url>` line directly under the title is bookkeeping for whoever republishes, so it is
left out of the page.

The output must be an `.html` path, and an existing file there is overwritten only if it is a page
this script wrote. That keeps a mistyped output path from clobbering an unrelated file, which is
what makes it safe to run without a permission prompt.
"""

from __future__ import annotations

import argparse
import os
import re
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path

from markdown_it import MarkdownIt
from markdown_it.renderer import RendererHTML
from markdown_it.token import Token
from markdown_it.utils import OptionsDict
from markupsafe import Markup, escape
from mdit_py_plugins.anchors import anchors_plugin
from mdit_py_plugins.gfm import gfm_plugin
from without_html import a, article, details, div, header, li, link, meta, nav, ol, render, span, style, summary, title

ARTIFACT_LINE = re.compile(r"^Artifact:\s*(\S+)\s*$")

# Marks a page as this script's, so a rerun may overwrite it and nothing else.
GENERATOR = '<meta name="generator" content="plan-artifact">'

# Drafting-table plan page: an outline rail beside one measured column of prose; collapses to a
# disclosure above the article at phone width.
