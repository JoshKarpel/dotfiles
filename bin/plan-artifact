#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["without-html==0.0.10", "markdown-it-py==4.2.0", "mdit-py-plugins==0.6.1"]
#
# [tool.uv]
# exclude-newer = "7 days"
# exclude-newer-package = { without-html = false }
# ///
"""
Render a plan's markdown into the HTML page published as its Artifact.

The `.md` is the plan; the page is derived from it every time, never edited by hand, so there is no
second copy to drift and no page source to keep between sessions. Anything visual belongs in the
markdown itself, which keeps a plan self-contained:

- a ```` ```mermaid ```` fence becomes `<pre class="mermaid">`, which Artifacts draw natively;
- a raw `<svg>` written into the markdown passes through as-is. Keep blank lines out of it (markdown
  ends an HTML block at the first one), and color it from the page's tokens so it follows the theme:
  `currentColor`, `var(--ink)`, `var(--muted)`, `var(--accent)`, `var(--rule)`, `var(--surface)`.

The `Artifact: <url>` line under the title is bookkeeping for whoever republishes, so it is left out
of the page. Usage: `plan-artifact plans/thing.md <out.html>`.
"""

from __future__ import annotations

import os
import re
import sys
from dataclasses import dataclass
from pathlib import Path

from markdown_it import MarkdownIt
from markdown_it.token import Token
from markupsafe import Markup, escape
from mdit_py_plugins.anchors import anchors_plugin
from mdit_py_plugins.tasklists import tasklists_plugin
from without_html import a, article, details, div, header, li, link, meta, nav, ol, p, render, span, style, summary, title

ARTIFACT_LINE = re.compile(r"^Artifact:\s*\S+\s*$")

# Drafting-table plan page: an outline rail beside one measured column of prose; collapses to a
# disclosure above the article at phone width.
STYLESHEET = """
