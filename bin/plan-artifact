#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["without-html==0.0.10", "markdown-it-py==4.2.0", "mdit-py-plugins==0.6.1"]
#
# [tool.uv]
# exclude-newer = "7 days"
# exclude-newer-package = { without-html = false }
# ///
"""
Render a plan's markdown into the HTML page published as its Artifact.

The `.md` is the plan; the page is derived from it every time, never edited by hand, so there is no
second copy to drift and no page source to keep between sessions. Anything visual belongs in the
markdown itself, which keeps a plan self-contained.

What a plan can use:

- GitHub-flavored markdown, so the plan reads the same on GitHub: tables, strikethrough, bare-URL
  autolinks, footnotes (`[^1]`), and alerts (`> [!NOTE]`, `[!TIP]`, `[!IMPORTANT]`, `[!WARNING]`,
  `[!CAUTION]`).
- The first `#` heading is the page's title; `##` and `###` headings make the outline beside it.
  Every heading from `##` down has an anchor and a faint `#` link beside it, so any section
  can be linked to as `<artifact-url>#<slug>`, slugged the way GitHub does it.
- Task items (`- [ ]`, `- [x]`) are counted into a progress bar under the title.
- A table with five or more columns widens the page, so a catalogue or matrix isn't squeezed.
- A ```` ```mermaid ```` fence is drawn as a diagram.
- Raw HTML passes through: `<details>`/`<summary>` to fold away detail, `<kbd>`, `<sup>`/`<sub>`,
  inline `<svg>`. An HTML block ends at the first blank line, so keep blank lines out of an `<svg>`;
  to write markdown inside `<details>`, leave a blank line after `</summary>` and before
  `</details>`.
- Color an `<svg>` from the page's tokens so it follows the theme: `currentColor`, `var(--ink)`,
  `var(--muted)`, `var(--accent)`, `var(--rule)`, `var(--surface)`.

An `Artifact: <url>` line directly under the title is bookkeeping for whoever republishes, so it is
left out of the page as text. Its URL becomes the title's own `#` link and the outline's first entry,
which link to the page with no section in it; a plan without the line has neither.

The output must be an `.html` path, and an existing file there is overwritten only if it is a page
this script wrote. That keeps a mistyped output path from clobbering an unrelated file, which is
what makes it safe to run without a permission prompt.
"""

from __future__ import annotations

import argparse
import os
import re
from dataclasses import dataclass
from pathlib import Path

from markdown_it import MarkdownIt
from markdown_it.renderer import RendererHTML
from markdown_it.token import Token
from markdown_it.utils import OptionsDict
from markupsafe import Markup, escape
from mdit_py_plugins.anchors import anchors_plugin
from mdit_py_plugins.gfm import gfm_plugin
from without_html import a, article, details, div, header, li, link, meta, nav, ol, p, render, span, style, summary, title

ARTIFACT_LINE = re.compile(r"^Artifact:\s*(\S+)\s*$")

# Marks a page as this script's, so a rerun may overwrite it and nothing else.
GENERATOR = '<meta name="generator" content="plan-artifact">'

# Drafting-table plan page: an outline rail beside one measured column of prose; collapses to a
# disclosure above the article at phone width.
