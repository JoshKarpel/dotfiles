#!/usr/bin/env bash
# Stop hook: warn about untracked files, then stage tracked changes and run pre-commit if configured.
#
# **Untracked files stop the run rather than riding beside it.** `pre-commit run` is told what to
# check by the index, so a file nobody has staged is one the hooks never look at, and a pass reported
# over the rest is a pass over part of the change. Deciding about them first is what makes the run
# that follows cover everything.

# No `-e`: a repository without hooks and a failing run are both expected answers, not faults, and
# this hook's own exit status is read by `claude-stop` as whether the hook itself worked.
set -uo pipefail

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests. This marker
# line is how `claude-hook-selftests` discovers participating hooks. This hook decides
# what Claude sees at stop time (nothing, an untracked-files nudge, or a pre-commit
# failure) from git states real sessions rarely line up on demand; run these with
# `CLAUDE_HOOK_SELFTEST=1 claude-stop-precommit`.
if [[ -n "${CLAUDE_HOOK_SELFTEST:-}" ]]; then
  SELF=$(realpath "$0")
  BIN_DIR=$(dirname "$SELF")
  fails=0
  workdir=$(realpath "$(mktemp -d)")
  trap 'rm -rf "$workdir"' EXIT
  # The hook records what it reported under the git dir, so every case runs in a throwaway repo,
  # with git's own environment unset: during a `git commit` GIT_INDEX_FILE points at the outer
  # repo's index, and the sandbox would read it instead of its own.
  # shellcheck disable=SC2207
  unset_git=($(git rev-parse --local-env-vars | sed 's/^/-u /'))

  mkrepo() {
    local dir="$1"
    mkdir -p "$dir"
    git init -q "$dir"
    git -C "$dir" config user.email "test@example.com"
    git -C "$dir" config user.name "test"
    echo base >"$dir/file"
    git -C "$dir" add file
    git -C "$dir" commit -q -m init
  }

  add_hooks() {
    local dir="$1"
    echo "repos: []" >"$dir/.pre-commit-config.yaml"
    git -C "$dir" add .pre-commit-config.yaml
    git -C "$dir" commit -q -m "add pre-commit config"
  }

  # A `pre-commit-autofix` that records having been called, because the gate and a passing run both
  # print nothing and only the marker tells them apart. Its output is driven by an env var rather
  # than spliced into the stub, so no case's text has to survive being quoted into a script.
  stub_autofix() {
    local dir="$1" code="$2"
    printf '#!/bin/sh\n: > "%s/autofix.called"\nprintf %%s "$STUB_OUTPUT"\nexit %s\n' \
      "$dir" "$code" >"$dir/pre-commit-autofix"
    chmod +x "$dir/pre-commit-autofix"
  }

  # A fresh prompt id per case unless one is given, so each case starts with nothing reported.
  case_number=0
  call() {
    local cwd="$1" path="$2" prompt="${3:-}" output="${4:-}"
    case_number=$((case_number + 1))
    [[ -n "$prompt" ]] || prompt="prompt-$case_number"
    rm -f "$workdir"/*/autofix.called
    EXIT=0
    OUT=$(cd "$cwd" && jq -cn --arg p "$prompt" '{prompt_id: $p}' |
    env "${unset_git[@]}" STUB_OUTPUT="$output" PATH="$path" CLAUDE_HOOK_SELFTEST= "$SELF" 2>&1) ||
    EXIT=$?
    [[ "$EXIT" == 0 ]] ||
    { printf 'FAIL %s: exited %s :: %s\n' "$cwd" "$EXIT" "$OUT"; fails=1; }
  }

  silent() {
    [[ -z "$OUT" ]] || { printf 'FAIL %s: expected no output :: %s\n' "$1" "$OUT"; fails=1; }
  }

  says() {
    local desc="$1" want_message="$2" want_context="$3" got_message got_context
    got_message=$(printf '%s' "$OUT" | jq -r '.systemMessage' 2>/dev/null) || got_message="<not json: $OUT>"
    got_context=$(printf '%s' "$OUT" | jq -r '.hookSpecificOutput.additionalContext' 2>/dev/null) || got_context=""
    [[ "$got_message" == "[claude-stop-precommit] $want_message" ]] ||
    { printf 'FAIL %s: want_message=%q got=%q\n' "$desc" "$want_message" "$got_message"; fails=1; }
    [[ "$got_context" == *"$want_context"* ]] ||
    { printf 'FAIL %s: context missing %q :: %s\n' "$desc" "$want_context" "$got_context"; fails=1; }
  }

  # --- outside any repository: nothing to say ---
  call "$workdir" "$BIN_DIR:$PATH"
  silent "outside any repo"

  # --- untracked files gate the run: the hooks are never reached ---
  gated="$workdir/gated"
  mkrepo "$gated"
  add_hooks "$gated"
  stubs_gate="$workdir/stubs_gate"
  mkdir "$stubs_gate"
  stub_autofix "$stubs_gate" 0
  touch "$gated/stray.txt"
  call "$gated" "$stubs_gate:$BIN_DIR:$PATH"
  says "strays are named" "untracked files" "stray.txt"
  says "strays carry the three ways to settle one" "untracked files" "add it to .gitignore"
  [[ ! -e "$stubs_gate/autofix.called" ]] ||
  { printf 'FAIL strays gate the run: the hooks ran anyway\n'; fails=1; }

  # --- a path git would quote survives as itself, which is what `-z` is for ---
  odd="$workdir/odd"
  mkrepo "$odd"
  touch "$odd/$(printf 'two\nlines.txt')"
  call "$odd" "$BIN_DIR:$PATH"
  says "a newline in a path round-trips" "untracked files" "$(printf 'two\nlines.txt')"

  # --- no strays and no hooks: tracked changes are staged and there is nothing to say ---
  plain="$workdir/plain"
  mkrepo "$plain"
  echo changed >>"$plain/file"
  call "$plain" "$BIN_DIR:$PATH"
  silent "a repo without hooks"
  STAGED=$(git -C "$plain" diff --cached --name-only)
  [[ "$STAGED" == "file" ]] ||
  { printf 'FAIL a repo without hooks: tracked change was not staged :: %s\n' "$STAGED"; fails=1; }

  # --- hooks that pass, after fixing or without ---
  passing="$workdir/passing"
  mkrepo "$passing"
  add_hooks "$passing"
  echo changed >>"$passing/file"
  stubs_pass="$workdir/stubs_pass"
  mkdir "$stubs_pass"
  stub_autofix "$stubs_pass" 0
  call "$passing" "$stubs_pass:$BIN_DIR:$PATH"
  silent "hooks that pass"
  [[ -e "$stubs_pass/autofix.called" ]] ||
  { printf 'FAIL hooks that pass: the hooks never ran\n'; fails=1; }

  # --- hooks still failing: the output is carried, not summarised ---
  stubs_fail="$workdir/stubs_fail"
  mkdir "$stubs_fail"
  stub_autofix "$stubs_fail" 1
  call "$passing" "$stubs_fail:$BIN_DIR:$PATH" "" "trailing whitespace failed"
  says "hooks still failing" "pre-commit failing" "trailing whitespace failed"

  # --- only the last pass is reported: what the first one said is already out of date ---
  stubs_two="$workdir/stubs_two"
  mkdir "$stubs_two"
  cat >"$stubs_two/pre-commit-autofix" <<'EOF'
#!/bin/sh
echo "black....Failed - files were modified by this hook" >&2
echo "mypy....Failed - needs a human"
exit 1
EOF
  chmod +x "$stubs_two/pre-commit-autofix"
  call "$passing" "$stubs_two:$BIN_DIR:$PATH"
  says "only the last pass is reported" "pre-commit failing" "mypy....Failed - needs a human"
  [[ "$OUT" != *"black"* ]] ||
  { printf 'FAIL only the last pass is reported: first pass leaked :: %s\n' "$OUT"; fails=1; }

  # --- the same state is reported once per prompt, not on every stop ---
  # A check that is failing on purpose (a floor on an unreleased version) would otherwise send
  # Claude back on every stop until the user interrupts.
  call "$passing" "$stubs_fail:$BIN_DIR:$PATH" same-prompt "uv-lock....Failed"
  says "a failure is reported the first time" "pre-commit failing" "uv-lock....Failed"
  call "$passing" "$stubs_fail:$BIN_DIR:$PATH" same-prompt "uv-lock....Failed"
  silent "the same failure on the same tree is not reported again"
  echo edited >>"$passing/file"
  call "$passing" "$stubs_fail:$BIN_DIR:$PATH" same-prompt "uv-lock....Failed"
  says "the same failure after an edit is reported again" "pre-commit failing" "uv-lock....Failed"
  call "$passing" "$stubs_fail:$BIN_DIR:$PATH" same-prompt "mypy....Failed"
  says "a different failure on the same tree is reported" "pre-commit failing" "mypy....Failed"
  call "$passing" "$stubs_fail:$BIN_DIR:$PATH" next-prompt "mypy....Failed"
  says "an unchanged failure is reported once to a new prompt" "pre-commit failing" "mypy....Failed"

  if [[ "$fails" == 0 ]]; then
    echo "$(basename "$0"): all self-tests passed"
  fi
  exit "$fails"
fi

INPUT=$(cat)
PROMPT_ID=$(printf '%s' "$INPUT" | jq -r '.prompt_id // ""')

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 1

# Read with `read -d ''` rather than `mapfile -d ''`, which macOS's bash 3.2 has no `-d` for. `-z`
# rather than the readable listing because git quotes and escapes a path with a newline or a
# non-ASCII byte in it, and a quoted path is not one Claude can open.
STRAYS=()
while IFS= read -r -d '' stray; do
  STRAYS+=("$stray")
done < <(git ls-files --others --exclude-standard -z)

if (( ${#STRAYS[@]} > 0 )); then
  MESSAGE="untracked files"
  CONTEXT="There are untracked files.
For each file, decide what to do with it: stage it with git add, add it to .gitignore, or delete it. If you're not sure, ask for help.
Files:

$(printf '%s\n' "${STRAYS[@]}")"
elif ! is-pre-commit-project; then
  git add --update
  exit 0
  # Stdout only, which is where `pre-commit-autofix` puts its last pass; its first pass goes to stderr
  # and is discarded, both because a failure a hook has since fixed is not something to send Claude
  # back over, and because a hook's stderr shows in the TUI. A runner that cannot start says so on
  # both passes, and the last pass folds its stderr into stdout, so that is not what gets dropped.
elif OUTPUT=$(pre-commit-autofix 2>/dev/null); then
  exit 0
else
  MESSAGE="pre-commit failing"
  CONTEXT="pre-commit is still failing after auto-fixing. Fix the issues before committing:

$OUTPUT"
fi

# Report a given state at most once per prompt. Without this a check that cannot pass yet (one
# failing on purpose, or waiting on a release) sends Claude back on every stop, and each reply is
# another "leaving this unchanged". The state is what Claude would act on: the message itself and
# the tree it was reached on, taken after the autofix pass, since that may have just rewritten it. A
# new prompt hears about it once more, so a failure is never silently forgotten.
REPORTED="$(git rev-parse --git-dir)/claude-precommit-reported"
STATE=$(
  {
    printf '%s\n%s\n' "$PROMPT_ID" "$CONTEXT"
    git diff HEAD
    git ls-files --others --exclude-standard
  } | sha1sum | cut -d' ' -f1
)
[[ "$(cat "$REPORTED" 2>/dev/null)" == "$STATE" ]] && exit 0
printf '%s' "$STATE" >"$REPORTED"

jq -n --arg message "[claude-stop-precommit] $MESSAGE" --arg ctx "$CONTEXT" \
  '{systemMessage: $message, hookSpecificOutput: {hookEventName: "Stop", additionalContext: $ctx}}'
