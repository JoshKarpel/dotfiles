#!/usr/bin/env bash
# PreToolUse hook: block shell commands containing #, except in permission modes that
# never prompt. The permission harness treats # as a comment, truncating the rest of the
# command and causing it to fail pattern matching, which requires manual approval.

set -euo pipefail

# CLAUDE_HOOK_SELFTEST: set this env var to run the hook's embedded self-tests. This
# marker line is how `claude-hook-selftests` discovers participating hooks. The tests
# drive the hook through its own stdin interface (exit 2 = block, 0 = allow).
if [[ -n "${CLAUDE_HOOK_SELFTEST:-}" ]]; then
  fails=0
  t() {
    local want="$1" cmd="$2" mode="${3:-manual}" got
    jq -cn --arg c "$cmd" --arg m "$mode" '{permission_mode: $m, tool_input: {command: $c}}' \
      | CLAUDE_HOOK_SELFTEST= "$0" >/dev/null 2>&1 && got=0 || got=$?
    [[ "$got" == "$want" ]] ||
    { printf 'FAIL want=%s got=%s mode=%s :: %s\n' "$want" "$got" "$mode" "$cmd"; fails=1; }
  }
  t 2 'ls -la # show all'
  t 2 '# leading comment'
  t 2 'git commit -m "closes #42"'
  t 0 'echo foo#bar'
  t 0 'curl https://example.com/#section'
  t 0 'ls -la'
  t 2 'ls -la # show all' acceptEdits
  t 2 'ls -la # show all' dontAsk
  t 2 'ls -la # show all' ''
  t 0 'ls -la # show all' auto
  t 0 '# leading comment' bypassPermissions
  if [[ "$fails" == 0 ]]; then
    echo "$(basename "$0"): all self-tests passed"
  fi
  exit "$fails"
fi

INPUT=$(cat)
COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command')
PERMISSION_MODE=$(echo "$INPUT" | jq -r '.permission_mode // ""')

# The block only exists to avoid a manual approval prompt. Modes that never prompt for
# Bash have nothing to lose from truncated pattern matching, so # is harmless there.
case "$PERMISSION_MODE" in
  auto | bypassPermissions) exit 0 ;;
esac

# In bash, # only starts a comment when it begins a word (preceded by whitespace or at the
# start of the command). Quoted # (e.g. in URLs or grep patterns) is technically still
# flagged here since detecting quote context via grep isn't practical; this is an acceptable
# trade-off because those cases are rare and can use a temp file or variable instead.
if echo "$COMMAND" | grep -qE '(^|[[:space:]])#'; then
  echo "Do not use # in shell commands. The permission harness treats an unquoted # as a comment and truncates everything after it, causing the command to fail pattern matching. If you need inline comments or a multi-line script, write it to a temporary file (e.g. /tmp/script_\$\$.sh or /tmp/script_\$\$.py) and run that instead." >&2
  exit 2
fi

exit 0
