#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.15"
# dependencies = ["counterweight==0.2.0"]
#
# [tool.uv]
# exclude-newer = "7 days"
# exclude-newer-package = { counterweight = false, evp = false, waxy = false, without-cli = false, without-logging = false, without-streams = false }
# ///
"""
See this account's own systemd user services and their timers, watch their journals, and start, restart or stop them.

Each row is a service with a unit file in ~/.config/systemd/user, which is where install.sh and the tools it
converges write theirs, folded together with the timer that triggers it: its state, how its last run ended, and when
the timer fires next. Below the rows are the highlighted service's latest journal lines.

Type to narrow the rows to those whose name or description contains the text, ignoring case. Up, Down, Tab,
Shift+Tab, Ctrl+N, Ctrl+P and Ctrl+K move the highlight, and the query edits as a shell's line does (Left, Right,
Ctrl+A, Ctrl+E, Ctrl+W, Ctrl+U and the rest).
Ctrl+S starts the highlighted service, which for one a timer triggers means running it now, Ctrl+R restarts it, and
Ctrl+X stops it, each queued with --no-block, so a long run shows as activating rather than freezing the screen.
Enter opens the service's whole journal in a pager, and quitting the pager comes back here. Escape or Ctrl+C
leaves.

The rows and the journal are read again every second, and the highlight stays on its service while rows come and go
around it.
"""

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests (`_selftest`).
# This marker line is how `claude-hook-selftests` discovers participating scripts.

from __future__ import annotations

import asyncio
import json
import os
import subprocess
import sys
from collections.abc import Callable
from collections.abc import Iterable
from collections.abc import Mapping
from collections.abc import Sequence
from dataclasses import dataclass
from dataclasses import replace
from datetime import UTC
from datetime import datetime
from datetime import timedelta
from pathlib import Path
from typing import Any, assert_never

from counterweight import app
from counterweight.components import component
from counterweight.controls import Quit
from counterweight.controls import ScrollIntoView
from counterweight.controls import Suspend
from counterweight.elements import Div
from counterweight.elements import Text
from counterweight.events import InputEvent
from counterweight.events import InputResponse
from counterweight.events import KeyPressed
from counterweight.events import Pasted
from counterweight.events import Receiver
from counterweight.events import response_controls
from counterweight.focus import ElementHandle
from counterweight.headless import Highlight
from counterweight.headless import TextInput
from counterweight.headless import substring_matches
from counterweight.headless import use_text_input
from counterweight.hooks import get_state
from counterweight.hooks import use_effect
from counterweight.hooks import use_state
from counterweight.keys import Key
from counterweight.programs import Exited
from counterweight.programs import FailedToStart
from counterweight.programs import ProgramOutcome
from counterweight.styles import Style
from counterweight.styles.utilities import *

DOWN_KEYS = frozenset({Key.Down, Key.Tab, Key.ControlN})
UP_KEYS = frozenset({Key.Up, Key.BackTab, Key.ControlP, Key.ControlK})
LEAVE_KEYS = frozenset({Key.Escape, Key.ControlC})
VERBS = {Key.ControlS: "start", Key.ControlR: "restart", Key.ControlX: "stop"}
POLL_INTERVAL = timedelta(seconds=1)
JOURNAL_LINES = 10

UNIT_DIRECTORY = Path.home() / ".config" / "systemd" / "user"
SHOWN_PROPERTIES = (
    "Id",
    "Description",
    "LoadState",
    "ActiveState",
    "SubState",
    "Result",
    "ExecMainStatus",
    "StateChangeTimestamp",
    "Triggers",
)


@dataclass(frozen=True, slots=True)
class Timer:
    """The timer that triggers a service, and when it last fired and fires next, if ever."""

    name: str
    next: datetime | None
    last: datetime | None


@dataclass(frozen=True, slots=True)
class Unit:
    """A row: a service, or a timer whose service has no unit file of its own here, with the timer folded in."""

    name: str
    description: str
    load_state: str
    active_state: str
    sub_state: str
    result: str
    # The main process's exit status, which only a service has.
    exit_status: int | None
    changed: datetime | None
    timer: Timer | None

    @property
    def short_name(self) -> str:
        return self.name.removesuffix(".service")


def unit_name(unit: Unit) -> str:
    """What identifies a row across listings."""
    return unit.name


def searchable(unit: Unit) -> str:
    """The text a query matches a row by."""
    return f"{unit.name} {unit.description}"


def unit_names(filenames: Iterable[str]) -> tuple[str, ...]:
    """
    The services and timers among FILENAMES, as `systemctl show` takes them.

    A template (`name@.service`) is not a unit until it is instantiated, so it is left out, as are the slices and
    `.wants` directories that share the directory.
    """
    return tuple(
        sorted(name for name in filenames if name.endswith((".service", ".timer")) and "@." not in name)
    )


def parse_show(output: str) -> dict[str, dict[str, str]]:
    """Each unit's properties from `systemctl show`, which prints one block of KEY=VALUE lines per unit."""
    blocks = {}
    for block in output.strip().split("\n\n"):
        fields = dict(line.partition("=")[::2] for line in block.splitlines())
        blocks[fields["Id"]] = fields
    return blocks


def from_microseconds(value: int | None) -> datetime | None:
    """A `list-timers` time, where 0 or null means never."""
    return datetime.fromtimestamp(value / 1_000_000, UTC) if value else None


def parse_timers(listing: str) -> dict[str, tuple[datetime | None, datetime | None]]:
    """Each timer's next and last firing, from `systemctl list-timers --all --output=json`."""
    return {
        timer["unit"]: (from_microseconds(timer["next"]), from_microseconds(timer["last"]))
        for timer in json.loads(listing)
    }


def from_unix_timestamp(value: str) -> datetime | None:
    """A `--timestamp=unix` property, `@<seconds>`, where empty means never."""
    return datetime.fromtimestamp(int(value.removeprefix("@")), UTC) if value else None


def build_units(
    show: Mapping[str, Mapping[str, str]], timers: Mapping[str, tuple[datetime | None, datetime | None]]
) -> tuple[Unit, ...]:
    """The rows, by name: each service with the timer that triggers it, and each timer whose service isn't listed."""
    services = {name for name in show if name.endswith(".service")}
    timer_of: dict[str, Timer] = {}
    orphans: list[Timer] = []
    for name, fields in show.items():
        if not name.endswith(".timer"):
            continue
        next_firing, last_firing = timers.get(name, (None, None))
        timer = Timer(name=name, next=next_firing, last=last_firing)
        triggered = [service for service in fields["Triggers"].split() if service in services]
        for service in triggered:
            timer_of[service] = timer
        if not triggered:
            orphans.append(timer)

    def unit(name: str, timer: Timer | None) -> Unit:
        fields = show[name]
        return Unit(
            name=name,
            description=fields["Description"],
            load_state=fields["LoadState"],
            active_state=fields["ActiveState"],
            sub_state=fields["SubState"],
            result=fields["Result"],
            exit_status=int(fields["ExecMainStatus"]) if name.endswith(".service") else None,
            changed=from_unix_timestamp(fields["StateChangeTimestamp"]),
            timer=timer,
        )

    rows = [unit(name, timer_of.get(name)) for name in services] + [unit(timer.name, timer) for timer in orphans]
    return tuple(sorted(rows, key=lambda row: row.name))


def systemctl(*args: str) -> str:
    """systemctl's stdout, for the user manager; a failure raises with its stderr, since this runs under the TUI."""
    result = subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"systemctl --user {' '.join(args)} exited {result.returncode}: {result.stderr.strip()}")
    return result.stdout


def read_units(directory: Path = UNIT_DIRECTORY) -> tuple[Unit, ...]:
    """The rows for the unit files in DIRECTORY, as the user manager sees them now."""
    names = unit_names(path.name for path in directory.iterdir())
    if not names:
        return ()
    show = parse_show(systemctl("show", "--timestamp=unix", f"--property={','.join(SHOWN_PROPERTIES)}", "--", *names))
    return build_units(show, parse_timers(systemctl("list-timers", "--all", "--output=json")))


def read_journal(name: str) -> tuple[str, ...]:
    """The unit's latest journal lines; empty, rather than failing, when the journal has none to show."""
    result = subprocess.run(
        ["journalctl", "--user", "--unit", name, "--lines", str(JOURNAL_LINES), "--no-pager", "--no-hostname"],
        capture_output=True,
        text=True,
    )
    # Lines, not entries: a `-- Boot <id> --` separator between entries is a line of its own.
    return tuple(result.stdout.splitlines()[-JOURNAL_LINES:])


def span(delta: timedelta) -> str:
    """DELTA in the one unit that reads at a glance."""
    seconds = int(abs(delta.total_seconds()))
    if seconds < 90:
        return f"{seconds}s"
    if seconds < 90 * 60:
        return f"{seconds // 60}m"
    if seconds < 36 * 60 * 60:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


def state_text(unit: Unit) -> str:
    """The unit's state as `systemctl status` writes it, the sub-state kept only where it says something."""
    if unit.load_state != "loaded":
        return unit.load_state
    if unit.active_state in ("active", "activating", "deactivating"):
        return f"{unit.active_state} ({unit.sub_state})"
    return unit.active_state


def outcome_text(unit: Unit, now: datetime) -> str:
    """How long a running unit has been up, or how its last run ended and when."""
    if unit.changed is None:
        return "never run"
    ago = span(now - unit.changed)
    if unit.active_state in ("active", "activating", "deactivating"):
        return f"for {ago}"
    if unit.result != "success":
        status = f" ({unit.exit_status})" if unit.exit_status else ""
        return f"{unit.result}{status} {ago} ago"
    return f"ok {ago} ago"


def next_text(unit: Unit, now: datetime) -> str:
    """When the unit's timer fires next, if it has one that will."""
    if unit.timer is None or unit.timer.next is None:
        return ""
    return f"next in {span(unit.timer.next - now)}" if unit.timer.next > now else "next now"


def matching(query: str, units: tuple[Unit, ...]) -> tuple[Unit, ...]:
    """The units whose name or description contains QUERY, ignoring case."""
    return substring_matches(query, units, key=searchable)


@dataclass(frozen=True, slots=True)
class Control:
    """Ask the user manager to apply VERB to UNIT."""

    verb: str
    unit: str


@dataclass(frozen=True, slots=True)
class Page:
    """Hand the terminal to a pager on UNIT's whole journal, taking it back when the pager exits."""

    unit: str


@dataclass(frozen=True, slots=True)
class Leave:
    """Leave the manager."""


type Action = Control | Page | Leave


def pager_argv(unit: str) -> tuple[str, ...]:
    """The command that pages UNIT's journal, opened at its end."""
    return ("journalctl", "--user", "--unit", unit, "--pager-end")


@dataclass(frozen=True, slots=True)
class Journal:
    """The latest journal lines of the unit named UNIT."""

    unit: str
    lines: tuple[str, ...]


@dataclass(frozen=True, slots=True)
class Managing:
    """
    The rows, the query, the highlight, the highlighted unit's journal, and what the last action came to.

    The highlight is held both by its unit's name and by its position. The name keeps it on its unit while the rows
    above come and go; the position is where it lands when its own row goes.
    """

    units: tuple[Unit, ...]
    query: str
    highlight: Highlight
    journal: Journal | None
    notice: str

    @property
    def shown(self) -> tuple[Unit, ...]:
        return matching(self.query, self.units)

    @property
    def highlighted(self) -> Unit | None:
        shown = self.shown
        index = self.highlight.index_in(shown, unit_name)
        return None if index is None else shown[index]

    @property
    def journal_lines(self) -> tuple[str, ...]:
        """The journal shown, which is nothing until the highlighted unit's own has been read."""
        highlighted = self.highlighted
        if self.journal is None or highlighted is None or self.journal.unit != highlighted.name:
            return ()
        return self.journal.lines

    def landed(self) -> Managing:
        """The highlight on the row it is on now, so it follows that row from here."""
        return replace(self, highlight=self.highlight.landed(self.shown, unit_name))

    def edited(self, query: str) -> Managing:
        """A changed query highlights its first match, as the other pickers' does."""
        return self if query == self.query else replace(self, query=query, highlight=Highlight()).landed()


@dataclass(frozen=True, slots=True)
class Refreshed:
    """A new listing arrived."""

    units: tuple[Unit, ...]


@dataclass(frozen=True, slots=True)
class Paged:
    """The pager handed the terminal back, having ended with OUTCOME."""

    outcome: ProgramOutcome


def opening(units: tuple[Unit, ...]) -> Managing:
    """An empty query highlighting the first unit."""
    return Managing(units=units, query="", highlight=Highlight(), journal=None, notice="").landed()


def received(manager: Managing, event: Refreshed | Journal | Paged) -> Managing:
    """The manager after a listing, a journal, or the pager's exit arrives."""
    match event:
        case Refreshed(units=units):
            return replace(manager, units=units).landed()
        case Journal() as journal:
            return replace(manager, journal=journal)
        case Paged(outcome=Exited(status=0)):
            return manager
        case Paged(outcome=Exited(status=status)):
            return replace(manager, notice=f"the pager exited {status}")
        case Paged(outcome=FailedToStart(reason=reason)):
            return replace(manager, notice=f"the pager didn't start: {reason}")
        case _:
            return manager


def step(manager: Managing, event: InputEvent) -> tuple[Managing, Action | None] | None:
    """
    The manager after a key that acts rather than edits, and what it asks to be done, or `None` for an event the
    query's field handles.

    The component carries the action out, keeping this pure.
    """
    match event:
        case KeyPressed(key=key) if key in LEAVE_KEYS:
            return manager, Leave()
        # Enter typed ahead, before the terminal goes raw, has had its \r turned into \n (Ctrl+J) by the tty.
        case KeyPressed(key=Key.Enter | Key.ControlJ) if (unit := manager.highlighted) is not None:
            return manager, Page(unit=unit.name)
        case KeyPressed(key=key) if key in VERBS and (unit := manager.highlighted) is not None:
            return manager, Control(verb=VERBS[key], unit=unit.name)
        case KeyPressed(key=key) if key in DOWN_KEYS:
            return replace(manager, highlight=manager.highlight.moved(manager.shown, 1, unit_name)), None
        case KeyPressed(key=key) if key in UP_KEYS:
            return replace(manager, highlight=manager.highlight.moved(manager.shown, -1, unit_name)), None
        case _:
            return None


def trimmed(event: InputEvent) -> InputEvent:
    """A paste without the line break a copied line ends with, which the field would make a trailing space."""
    return Pasted(text=event.text.rstrip("\r\n")) if isinstance(event, Pasted) else event


def query_row(field: TextInput) -> Div:
    """The query after its prompt, with the cursor drawn over the cell it's in."""
    return Div(
        style=row | overflow_x_scroll | stick_to_end_x,
        children=(
            Text(content="> ", style=text_wrap_none | text_color("slate", 400)),
            Text(content=field.before_cursor, style=text_wrap_none),
            Text(
                content=field.at_cursor,
                handle=field.cursor_cell,
                style=text_wrap_none | text_color("slate", 900) | text_bg("sky", 300),
            ),
            Text(content=field.after_cursor, style=text_wrap_none),
        ),
    )


def send(control: Control) -> str | None:
    """Queue the job with the user manager, returning why it refused, if it did."""
    result = subprocess.run(
        ["systemctl", "--user", "--no-block", control.verb, control.unit], capture_output=True, text=True
    )
    if result.returncode == 0:
        return None
    return result.stderr.strip() or f"systemctl {control.verb} {control.unit} exited {result.returncode}"


STATE_COLORS = {"active": ("green", 400), "failed": ("red", 400), "activating": ("amber", 300)}


@component
def manager_view(
    units: tuple[Unit, ...],
    poll: Callable[[], tuple[Unit, ...]],
    journal_of: Callable[[str], tuple[str, ...]],
    send_control: Callable[[Control], str | None],
    pager: Callable[[str], Sequence[str]],
) -> Div:
    manager, set_manager = use_state(lambda: opening(units))
    row_handle, _ = use_state(ElementHandle)

    def apply(event: Refreshed | Journal | Paged) -> None:
        set_manager(lambda latest: received(latest, event))

    async def refresh() -> None:
        while True:
            await asyncio.sleep(POLL_INTERVAL.total_seconds())
            apply(Refreshed(units=await asyncio.to_thread(poll)))

    use_effect(refresh, deps=())

    highlighted_name = manager.highlighted.name if manager.highlighted else None

    # Restarted, and the old one cancelled, whenever the highlight moves to another unit.
    async def follow_journal() -> None:
        if highlighted_name is None:
            return
        while True:
            lines = await asyncio.to_thread(journal_of, highlighted_name)
            apply(Journal(unit=highlighted_name, lines=lines))
            await asyncio.sleep(POLL_INTERVAL.total_seconds())

    use_effect(follow_journal, deps=(highlighted_name,))

    field = use_text_input(
        manager.query, lambda edit: set_manager(lambda latest: latest.edited(edit(latest.query))).query, auto_focus=True
    )

    def on_input(event: InputEvent, receiver: Receiver) -> InputResponse:
        scroll = ScrollIntoView(row_handle, block="nearest")
        if (handled := step(get_state(set_manager), event)) is None:
            if (controls := response_controls(field.on_input(trimmed(event), receiver))) is None:
                return None
            return (*controls, scroll)
        stepped, action = handled
        match action:
            case Leave():
                return Quit()
            case Page(unit=unit):
                set_manager(stepped)
                return Suspend.to_program(pager(unit), on_exit=lambda outcome: apply(Paged(outcome))), scroll
            case Control() as control:
                failure = send_control(control)
                set_manager(replace(stepped, notice=failure or f"queued {control.verb} of {control.unit}"))
                return scroll
            case None:
                set_manager(stepped)
                return scroll
            case _ as unreachable:
                assert_never(unreachable)

    shown, highlighted = manager.shown, manager.highlighted
    now = datetime.now(UTC)
    name_width = max((len(unit.short_name) for unit in manager.units), default=0)

    def unit_row(unit: Unit) -> Div:
        is_highlighted = unit is highlighted
        name_color = text_color("amber", 300) if is_highlighted else text_color("slate", 300)
        color, shade = STATE_COLORS.get(unit.active_state, ("slate", 400))
        return Div(
            style=row,
            handle=row_handle if is_highlighted else None,
            children=(
                Text(content=f"{unit.short_name.ljust(name_width)}  ", style=text_wrap_none | name_color | (text_bold if is_highlighted else Style())),
                Text(content=f"{state_text(unit):<20}", style=text_wrap_none | text_color(color, shade)),
                Text(content=f"{outcome_text(unit, now):<22}", style=text_wrap_none | text_color("slate", 300)),
                Text(content=f"{next_text(unit, now):<14}", style=text_wrap_none | text_color("sky", 300)),
                Text(content=unit.description, style=text_wrap_none | text_color("slate", 500)),
            ),
        )

    journal = manager.journal_lines
    return Div(
        style=full | col | border | border_lightrounded | border_color("slate", 500) | pad_x(1),
        on_input=on_input,
        children=(
            Text(
                content="Ctrl+S starts, Ctrl+R restarts, Ctrl+X stops, Enter pages the journal, Esc leaves",
                style=text_wrap_none | text_color("slate", 400),
            ),
            query_row(field),
            Div(
                style=col | fill(1) | overflow_y_scroll,
                children=tuple(unit_row(unit) for unit in shown)
                or (
                    Text(
                        content="no unit matches" if manager.units else f"no units in {UNIT_DIRECTORY}",
                        style=text_color("slate", 400),
                    ),
                ),
            ),
            Text(content=manager.notice, style=text_wrap_none | text_color("sky", 300)),
            Text(
                content=f"journal of {highlighted.name}" if highlighted else "",
                style=text_wrap_none | text_bold | text_color("slate", 400),
            ),
            Div(
                # Clipped, since a line wider than the box would otherwise overrun its padding and right border;
                # the rows above are clipped by their own scroll container.
                style=col | height(JOURNAL_LINES) | overflow_x_clip,
                children=tuple(Text(content=line, style=text_wrap_none | text_color("slate", 300)) for line in journal),
            ),
        ),
    )


async def manage(
    units: tuple[Unit, ...],
    poll: Callable[[], tuple[Unit, ...]],
    journal_of: Callable[[str], tuple[str, ...]] = read_journal,
    send_control: Callable[[Control], str | None] = send,
    pager: Callable[[str], Sequence[str]] = pager_argv,
    **app_options: object,
) -> None:
    """Run the manager until it is left."""
    await app(manager_view(units, poll, journal_of, send_control, pager), **app_options)


def _selftest() -> int:
    import tempfile
    from functools import reduce

    from counterweight.autopilot import typed
    from counterweight.controls import Screenshot
    from counterweight.paint import Frame

    show_output = (
        "Id=tidy.service\nDescription=Reclaim disk\nLoadState=loaded\nActiveState=inactive\nSubState=dead\n"
        "Result=success\nExecMainStatus=0\nStateChangeTimestamp=@1700000000\nTriggers=\n\n"
        "Id=tidy.timer\nDescription=Reclaim disk weekly\nLoadState=loaded\nActiveState=active\nSubState=waiting\n"
        "Result=success\nStateChangeTimestamp=@1699990000\nTriggers=tidy.service\n\n"
        "Id=zellij-web.service\nDescription=Serve zellij=web\nLoadState=loaded\nActiveState=active\n"
        "SubState=running\nResult=success\nExecMainStatus=0\nStateChangeTimestamp=@1699996400\nTriggers=\n\n"
        "Id=lonely.timer\nDescription=A timer whose service is elsewhere\nLoadState=loaded\nActiveState=active\n"
        "SubState=waiting\nResult=success\nStateChangeTimestamp=\nTriggers=elsewhere.service\n"
    )
    timers_output = json.dumps(
        [
            {"unit": "tidy.timer", "next": 1_700_086_400_000_000, "last": 1_699_999_000_000_000},
            {"unit": "lonely.timer", "next": 0, "last": None},
        ]
    )
    units = build_units(parse_show(show_output), parse_timers(timers_output))
    by_name = {unit.name: unit for unit in units}
    now = datetime.fromtimestamp(1_700_003_600, UTC)
    tidy, web, lonely = by_name.get("tidy.service"), by_name.get("zellij-web.service"), by_name.get("lonely.timer")

    enter, escape, down, up = (KeyPressed(key=key) for key in (Key.Enter, Key.Escape, Key.Down, Key.Up))

    type Given = InputEvent | Refreshed | Journal | Paged | str

    def stepped(*inputs: Given) -> tuple[Managing, tuple[Action, ...]]:
        """The manager after each input, and the actions they asked for, a string standing for the query typed onto."""
        manager = opening(units)
        actions: tuple[Action, ...] = ()
        for given in inputs:
            match given:
                case str():
                    manager = manager.edited(manager.query + given)
                case Refreshed() | Journal() | Paged():
                    manager = received(manager, given)
                case _ if (handled := step(manager, given)) is not None:
                    manager, action = handled
                    actions += (action,) if action is not None else ()
                case _:
                    pass
        return manager, actions

    def managing(*inputs: Given) -> Managing:
        return stepped(*inputs)[0]

    def acted(*inputs: Given) -> tuple[Action, ...]:
        return stepped(*inputs)[1]

    failed = replace(web, active_state="failed", sub_state="failed", result="exit-code", exit_status=2) if web else None

    cases: list[tuple[str, bool]] = [
        (
            "unit names keep services and timers, leaving out templates, slices and .wants directories",
            unit_names(["a.service", "b@.service", "c.timer", "claude-work.slice", "default.target.wants"]) == ("a.service", "c.timer"),
        ),
        ("a property value keeps any = in it", web is not None and web.description == "Serve zellij=web"),
        ("a timer folds into the service it triggers", tidy is not None and tidy.timer is not None and tidy.timer.name == "tidy.timer"),
        ("a timer whose service isn't listed is its own row", lonely is not None and lonely.timer is not None),
        ("rows are by name, and a folded timer has none of its own", tuple(by_name) == ("lonely.timer", "tidy.service", "zellij-web.service")),
        ("a timer's next firing of 0 means never", lonely is not None and lonely.timer is not None and lonely.timer.next is None),
        ("an empty timestamp means never", lonely is not None and lonely.changed is None),
        ("a timer has no exit status", lonely is not None and lonely.exit_status is None),
        ("spans read in one unit", (span(timedelta(seconds=45)), span(timedelta(minutes=5)), span(timedelta(hours=30)), span(timedelta(days=3))) == ("45s", "5m", "30h", "3d")),
        ("a running service says how long it has been up", web is not None and outcome_text(web, now) == "for 2h"),
        ("a finished oneshot says it went fine and when", tidy is not None and outcome_text(tidy, now) == "ok 60m ago"),
        ("a failed run says how, with its exit status", failed is not None and outcome_text(failed, now) == "exit-code (2) 2h ago"),
        ("a unit that never ran says so", lonely is not None and outcome_text(lonely, now) == "never run"),
        ("the sub-state is kept for an active unit", web is not None and state_text(web) == "active (running)"),
        ("and dropped for an inactive one", tidy is not None and state_text(tidy) == "inactive"),
        ("a unit that failed to load says why", tidy is not None and state_text(replace(tidy, load_state="bad-setting")) == "bad-setting"),
        ("a timer's next firing is shown", tidy is not None and next_text(tidy, now) == "next in 23h"),
        ("a service with no timer has no next firing", web is not None and next_text(web, now) == ""),
        ("typing narrows by description too, ignoring case", managing("DISK").shown == (tidy,)),
        ("Ctrl+S starts the highlighted unit", acted(down, KeyPressed(key=Key.ControlS)) == (Control("start", "tidy.service"),)),
        ("Ctrl+R restarts it", acted(KeyPressed(key=Key.ControlR)) == (Control("restart", "lonely.timer"),)),
        ("Ctrl+X stops it", acted(up, KeyPressed(key=Key.ControlX)) == (Control("stop", "zellij-web.service"),)),
        ("Enter pages the highlighted unit's journal", acted(down, enter) == (Page("tidy.service"),)),
        ("a pager that exits cleanly says nothing", managing(Paged(Exited(status=0))).notice == ""),
        ("a pager that fails says how it exited", managing(Paged(Exited(status=3))).notice == "the pager exited 3"),
        ("a pager that can't start says why", managing(Paged(FailedToStart(reason="gone"))).notice == "the pager didn't start: gone"),
        ("Escape leaves", acted(escape) == (Leave(),)),
        ("the highlighted unit's journal is shown", managing(Journal("lonely.timer", ("a",))).journal_lines == ("a",)),
        ("another unit's journal is not", managing(Journal("lonely.timer", ("a",)), down).journal_lines == ()),
        (
            "the highlight stays on its unit as a row above it goes",
            tidy is not None and web is not None and managing(down, Refreshed(units=(tidy, web))).highlighted == tidy,
        ),
        (
            "when its own row goes, the highlight lands on the row that took its place",
            managing(down, Refreshed(units=tuple(unit for unit in units if unit is not tidy))).highlighted == web,
        ),
    ]

    sent: list[Control] = []
    frames: list[Frame] = []
    with tempfile.TemporaryDirectory() as scratch:
        # The pager leaves a file named for its unit, so the suspension is seen to have run it.
        asyncio.run(
            asyncio.wait_for(
                manage(
                    units, lambda: units, lambda name: (f"{name} says hi {'x' * 200}",), lambda control: sent.append(control),
                    pager=lambda name: ("touch", str(Path(scratch) / name)),
                    headless=True, dimensions=(100, 20),
                    autopilot=[
                        down, KeyPressed(key=Key.ControlS), down, enter, KeyPressed(key=Key.ControlX), Screenshot(frames.append),
                        *typed("wb"), KeyPressed(key=Key.Left), *typed("e"), KeyPressed(key=Key.ControlR), Quit(),
                    ],
                ),
                timeout=timedelta(seconds=30).total_seconds(),
            )
        )
        paged = sorted(path.name for path in Path(scratch).iterdir())
    cases += [
        (
            "the app sends the controls asked for, before and after paging, the query edited at the cursor",
            sent == [Control("start", "tidy.service"), Control("stop", "zellij-web.service"), Control("restart", "zellij-web.service")],
        ),
        ("the app runs the pager on the highlighted unit", paged == ["zellij-web.service"]),
        ("the app says what it queued", bool(frames) and "queued stop of zellij-web.service" in frames[-1].text(ansi=False)),
        (
            "a journal line wider than the box stops at its border",
            bool(frames) and all(line.endswith("│") for line in frames[-1].text(ansi=False).splitlines()[1:-1]),
        ),
    ]

    many = tuple(replace(web, name=f"server-{index:02}.service") for index in range(30)) if web else ()
    frames.clear()
    asyncio.run(
        asyncio.wait_for(
            manage(
                many, lambda: many, lambda name: (), lambda control: None, headless=True, dimensions=(100, 30),
                autopilot=[*(down for _ in range(20)), Screenshot(frames.append), Quit()],
            ),
            timeout=timedelta(seconds=30).total_seconds(),
        )
    )
    screen = frames[0].text(ansi=False) if frames else ""
    cases += [("moving past the rows shown scrolls the highlight into view", "server-20" in screen and "server-00" not in screen)]

    failures = [name for name, passed in cases if not passed]
    for name in failures:
        print(f"FAIL: {name}", file=sys.stderr)
    print(f"manage-units: {len(cases) - len(failures)}/{len(cases)} passed")
    return 1 if failures else 0


def main() -> int:
    if os.environ.get("CLAUDE_HOOK_SELFTEST"):
        return _selftest()

    asyncio.run(manage(read_units(), read_units, title="units"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
