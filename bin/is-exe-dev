#!/usr/bin/env bash
# Check if this machine is an exe.dev VM rather than a laptop

set -euo pipefail

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
  sed -n '2,${/^#/!q;s/^# \{0,1\}//p;}' "$0"
  exit 0
fi
if (($#)); then
  echo "$(basename "$0"): takes no arguments; see --help" >&2
  exit 2
fi

# exe.dev VMs carry the platform's own tooling at /exe.dev, which makes its
# presence the cheapest test: no DNS, no network round trip, and no dependence on
# which integrations happen to be attached.
[[ -d /exe.dev ]]
