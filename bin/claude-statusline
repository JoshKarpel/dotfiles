#!/usr/bin/env bash
# Claude Code status line script
# Receives JSON session data on stdin, outputs formatted text lines

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
  sed -n '2,${/^#/!q;s/^# \{0,1\}//p;}' "$0"
  exit 0
fi
if (($#)); then
  echo "$(basename "$0"): takes no arguments; see --help" >&2
  exit 2
fi

data=$(cat)

model=$(echo "$data" | jq -r '.model.display_name // "unknown"')
context_pct=$(echo "$data" | jq -r '.context_window.used_percentage // 0' | cut -d. -f1)
effort=$(echo "$data" | jq -r '.effort.level // empty')

cwd=$(echo "$data" | jq -r '.workspace.current_dir // .cwd // "."')

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# The branch's open PR, from claude-fetch-pr rather than the payload's `pr`, which
# Claude Code's own lookup leaves empty behind exe.dev's gh proxy. The review
# state is a glyph: draft, awaiting review, approved, changes requested.
pr=$(claude-fetch-pr 2>/dev/null | jq -c 'select(.state == "OPEN")' 2>/dev/null)
if [[ -n "$pr" ]]; then
  pr_number=$(jq -r '.number' <<<"$pr")
  pr_url=$(jq -r '.url' <<<"$pr")
  deploy_url=$(jq -r '.deployment.url // empty' <<<"$pr")
  pr_review_state=$(jq -r '
    if .isDraft then "◌"
    elif .reviewDecision == "APPROVED" then "✓"
    elif .reviewDecision == "CHANGES_REQUESTED" then "✗"
    else "●" end' <<<"$pr")
fi

# The link that opens the session's directory in VS Code in the browser, on an
# exe.dev VM.
vscode_url=$(vscode-link "$cwd" 2>/dev/null)

# Fetch cached usage limits (gracefully skipped if unavailable)
usage=$(claude-fetch-usage 2>/dev/null)

# Format seconds remaining as human-readable string
fmt_remaining() {
  local secs=$1
  if (( secs <= 0 )); then echo "now"; return; fi
  local d=$(( secs / 86400 )) h=$(( (secs % 86400) / 3600 )) m=$(( (secs % 3600) / 60 ))
  if (( d > 0 )); then echo "${d}d${h}h${m}m"
  elif (( h > 0 )); then echo "${h}h${m}m"
else echo "${m}m"; fi
}

# `date -d` is GNU-only and fails silently on macOS's BSD date, which needs `-j -f`
# with an explicit format instead. Try both; print nothing (and return non-zero) if
# neither parses, so a caller can tell "unknown" from a bogus epoch.
resets_epoch() {
  date -d "$1" +%s 2>/dev/null && return
  date -j -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s 2>/dev/null
}

if [[ -n "$usage" ]]; then
  now=$(date +%s)
  five_hour_pct=$(echo "$usage" | jq -r 'if (.five_hour.utilization | type) == "number" then (.five_hour.utilization | floor | tostring) + "%" else empty end' 2>/dev/null)
  seven_day_pct=$(echo "$usage" | jq -r 'if (.seven_day.utilization | type) == "number" then (.seven_day.utilization | floor | tostring) + "%" else empty end' 2>/dev/null)
  five_hour_resets=$(echo "$usage" | jq -r '.five_hour.resets_at // empty' 2>/dev/null)
  seven_day_resets=$(echo "$usage" | jq -r '.seven_day.resets_at // empty' 2>/dev/null)
  if [[ -n "$five_hour_resets" ]] && epoch=$(resets_epoch "$five_hour_resets"); then
    five_hour_remaining=$(fmt_remaining $(( epoch - now )))
  fi
  if [[ -n "$seven_day_resets" ]] && epoch=$(resets_epoch "$seven_day_resets"); then
    seven_day_remaining=$(fmt_remaining $(( epoch - now )))
  fi

  extra_enabled=$(echo "$usage" | jq -r '.extra_usage.is_enabled // false' 2>/dev/null)
  if [[ "$extra_enabled" == "true" ]]; then
    extra_pct=$(echo "$usage" | jq -r '.extra_usage.utilization | floor | tostring' 2>/dev/null)
    extra_used=$(echo "$usage" | jq -r '.extra_usage.used_credits / 100 | floor' 2>/dev/null)
    extra_limit=$(echo "$usage" | jq -r '.extra_usage.monthly_limit / 100' 2>/dev/null)
  fi
fi

# A rate limit shows only once it passes HIGH_PCT, which is also where it turns
# yellow, so it appears exactly when it would have changed color.
HIGH_PCT=60

# Between segments, the middle dot Claude Code's own TUI separates fields with.
SEP=" · "

# Colorize a value: red >80%, yellow >HIGH_PCT
colorize() {
  local val=$1 text=$2
  if (( val > 80 )); then echo "\033[31m${text}\033[0m"
  elif (( val > HIGH_PCT )); then echo "\033[33m${text}\033[0m"
else echo "$text"; fi
}

# A rate limit window as `5h:83% 1h23m`, or nothing while it is below HIGH_PCT.
# Takes the label, the percentage without its sign, and the time to reset.
rate_limit() {
  local label=$1 pct=$2 remaining=$3
  [[ -n "$pct" ]] && (( pct > HIGH_PCT )) || return 0
  colorize "$pct" "${label}:${pct}%${remaining:+ ${remaining}}"
}

# An OSC 8 hyperlink: ESC ] 8 ; ; URL BEL, the text, then an empty one to close.
link() {
  echo "\033]8;;$1\a$2\033]8;;\a"
}

status="${model}${effort:+ ${effort}} $(colorize "$context_pct" "ctx:${context_pct}%")"
rate_limits=$(rate_limit 5h "${five_hour_pct%\%}" "${five_hour_remaining:-}")
seven_day=$(rate_limit 7d "${seven_day_pct%\%}" "${seven_day_remaining:-}")
rate_limits+="${rate_limits:+${seven_day:+ }}${seven_day}"
if [[ -n "$rate_limits" ]]; then
  status+="${SEP}${rate_limits}"
fi
# Extra usage is money rather than a quota, so it shows whenever it is enabled.
if [[ -n "${extra_pct:-}" ]]; then
  status+="${SEP}$(colorize "${extra_pct}" "extra:\$${extra_used}/\$${extra_limit}")"
fi
# The branch and its open PR as one segment, `branch #123 ✓ deploy`: the
# branch and number link to the PR, and `deploy` to its newest live deployment.
if [[ -n "$branch" ]]; then
  if [[ -n "${pr_number:-}" ]]; then
    branch_info="$(link "$pr_url" "${branch} #${pr_number}") ${pr_review_state}"
    if [[ -n "${deploy_url:-}" ]]; then
      branch_info+=" $(link "$deploy_url" deploy)"
    fi
  else
    branch_info="$branch"
  fi
  status+="${SEP}${branch_info}"
fi
if [[ -n "$vscode_url" ]]; then
  status+="${SEP}$(link "$vscode_url" vscode)"
fi
echo -e "$status"
