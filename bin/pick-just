#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.15"
# dependencies = ["counterweight==0.2.0", "typer==0.27.3"]
#
# [tool.uv]
# exclude-newer = "7 days"
# exclude-newer-package = { counterweight = false, evp = false, waxy = false, without-cli = false, without-logging = false, without-streams = false }
# ///
"""
Pick a recipe from the justfile here and run it, with any arguments typed after its name.

Backs `jp` (sources/aliases.sh) and Alt+j in zellij. The recipes are the ones `just --list` shows, private ones left
out, under the same group headings, with a module's recipes listed by their `module::recipe` path.

The picker draws below the prompt, as fzf does, and erases itself when it stops.

The query is the command line. Its first word narrows the recipes to those whose name contains it, ignoring case, and
highlights the one it names exactly, if any; whatever follows the first space is passed to the recipe as arguments,
split as the shell would split them. Enter runs `just <recipe> <arguments>` in this terminal, where the picker was,
so the output stays and a `[confirm]` recipe asks as it would anywhere. A recipe missing a required
argument says which instead of running. Up, Down, Tab, Shift+Tab, Ctrl+N, Ctrl+P and Ctrl+K move the highlight,
the query edits as a shell's line does (Left, Right, Ctrl+A, Ctrl+E, Ctrl+W, Ctrl+U and the rest), and Escape or
Ctrl+C leaves without running anything.

Exits with the recipe's status, or 0 when left.
"""

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests (`_selftest`).
# This marker line is how `claude-hook-selftests` discovers participating scripts.

from __future__ import annotations

import asyncio
import json
import os
import shlex
import subprocess
import sys
import termios
import tty
from collections.abc import Callable
from collections.abc import Mapping
from dataclasses import dataclass
from dataclasses import replace
from datetime import timedelta
from typing import Annotated, Any, assert_never

import typer
from counterweight import Inline
from counterweight import app as counterweight_app
from counterweight.components import component
from counterweight.controls import Quit
from counterweight.controls import ScrollIntoView
from counterweight.elements import Div
from counterweight.elements import Text
from counterweight.events import InputEvent
from counterweight.events import InputResponse
from counterweight.events import KeyPressed
from counterweight.events import Pasted
from counterweight.events import Receiver
from counterweight.events import response_controls
from counterweight.focus import ElementHandle
from counterweight.headless import Highlight
from counterweight.headless import TextInput
from counterweight.headless import substring_matches
from counterweight.headless import use_text_input
from counterweight.hooks import get_state
from counterweight.hooks import use_state
from counterweight.keys import Key
from counterweight.styles import Style
from counterweight.styles.utilities import *

DOWN_KEYS = frozenset({Key.Down, Key.Tab, Key.ControlN})
UP_KEYS = frozenset({Key.Up, Key.BackTab, Key.ControlP, Key.ControlK})
LEAVE_KEYS = frozenset({Key.Escape, Key.ControlC})

KIND_PREFIXES = {"singular": "", "plus": "+", "star": "*"}
# The most rows shown at once; the list scrolls past them, and shrinks to fit a shorter terminal.
SHOWN_ROWS = 16


@dataclass(frozen=True, slots=True)
class Parameter:
    """One of a recipe's parameters, as `just --dump --dump-format json` reports it."""

    name: str
    kind: str
    # A string, an expression just keeps as nested lists, or None when there is no default.
    default: object
    # Given as --long or -s by an `[arg]` attribute, rather than by position.
    is_option: bool

    @property
    def is_required(self) -> bool:
        """Whether the recipe cannot run without an argument for it: `*` takes zero or more, `+` one or more."""
        return self.default is None and self.kind != "star" and not self.is_option

    @property
    def signature(self) -> str:
        """The parameter as `just --list` writes it, an expression default abbreviated to `…`."""
        signature = KIND_PREFIXES[self.kind] + self.name
        match self.default:
            case None:
                return signature
            case str(text):
                return f"{signature}='{text}'"
            case _:
                return f"{signature}=…"


@dataclass(frozen=True, slots=True)
class Recipe:
    """A recipe the picker can run, by the path `just` takes on its command line."""

    path: str
    parameters: tuple[Parameter, ...]
    doc: str | None
    groups: tuple[str, ...]

    @property
    def signature(self) -> str:
        return " ".join((self.path, *(parameter.signature for parameter in self.parameters)))

    def missing(self, argument_count: int) -> tuple[str, ...]:
        """The required parameters ARGUMENT_COUNT arguments leave unfilled; just puts every one before the rest."""
        return tuple(parameter.name for parameter in self.parameters if parameter.is_required)[argument_count:]


def parse_recipe(recipe: Mapping[str, Any]) -> Recipe:
    """One recipe of the dump; a missing field raises rather than defaulting."""
    return Recipe(
        path=recipe["namepath"],
        parameters=tuple(
            Parameter(
                name=parameter["name"],
                kind=parameter["kind"],
                default=parameter["default"],
                is_option=bool(parameter["long"] or parameter["short"]),
            )
            for parameter in recipe["parameters"]
        ),
        doc=recipe["doc"],
        # An attribute is a bare string (`private`) or a one-key object (`{"group": "rust"}`).
        groups=tuple(
            attribute["group"]
            for attribute in recipe["attributes"]
            if isinstance(attribute, dict) and "group" in attribute
        ),
    )


def parse_recipes(justfile: Mapping[str, Any]) -> tuple[Recipe, ...]:
    """The public recipes of the dump and of every module in it, by path."""
    recipes = [parse_recipe(recipe) for recipe in justfile["recipes"].values() if not recipe["private"]]
    for module in justfile["modules"].values():
        recipes += parse_recipes(module)
    return tuple(sorted(recipes, key=lambda recipe: recipe.path))


@dataclass(frozen=True, slots=True)
class Heading:
    """A row naming the group below it, which the highlight skips."""

    title: str


@dataclass(frozen=True, slots=True)
class Listed:
    """A recipe as one row, under GROUP's heading, or under none; a recipe in two groups is two of these."""

    recipe: Recipe
    group: str | None


type Row = Heading | Listed


def command_line(query: str) -> tuple[str, str]:
    """The query's first word, which narrows the recipes, and the rest, which is the recipe's arguments."""
    word, _, arguments = query.lstrip().partition(" ")
    return word, arguments


def recipe_rows(recipes: tuple[Recipe, ...], word: str) -> tuple[Row, ...]:
    """
    The recipes whose path contains WORD, ignoring case, laid out as `just --list` does.

    Ungrouped recipes come first with no heading, then each group under its own, so a recipe in two groups is listed
    under both. Within each, one WORD names exactly comes first.
    """
    matched = substring_matches(word, recipes, key=lambda recipe: recipe.path)
    rows: list[Row] = [Listed(recipe, None) for recipe in matched if not recipe.groups]
    for group in sorted({group for recipe in matched for group in recipe.groups}):
        rows += [Heading(f"[{group}]"), *(Listed(recipe, group) for recipe in matched if group in recipe.groups)]
    return tuple(rows)


def options(rows: tuple[Row, ...]) -> tuple[Listed, ...]:
    """The rows the highlight can land on."""
    return tuple(row for row in rows if isinstance(row, Listed))


@dataclass(frozen=True, slots=True)
class Search:
    """The query, which of the recipes it matches is highlighted, and why Enter last refused to run one."""

    query: str
    highlight: Highlight
    notice: str

    def edited(self, query: str, recipes: tuple[Recipe, ...]) -> Search:
        """
        The query changed to QUERY.

        Only a changed first word moves the highlight, to the recipe it names exactly or else the first match, since
        the old highlight is on a different list. Typing arguments leaves it where it is.
        """
        word = command_line(query)[0]
        if word == command_line(self.query)[0]:
            return replace(self, query=query, notice="")
        exact = next((listed for listed in options(recipe_rows(recipes, word)) if listed.recipe.path == word), None)
        return Search(query=query, highlight=Highlight(key=exact), notice="")


EMPTY_SEARCH = Search(query="", highlight=Highlight(), notice="")


@dataclass(frozen=True, slots=True)
class Finished:
    """The picker is done, having chosen the arguments to `just`, or nothing if it was left."""

    command: tuple[str, ...] | None


type Picking = Search | Finished


def chosen(search: Search, recipe: Recipe) -> Picking:
    """What Enter on RECIPE does: run it with the query's arguments, or say why it cannot."""
    try:
        arguments = shlex.split(command_line(search.query)[1])
    except ValueError as error:
        return replace(search, notice=f"the arguments don't split: {error}")
    if missing := recipe.missing(len(arguments)):
        return replace(search, notice=f"{recipe.path} needs {' '.join(missing)}")
    return Finished(command=(recipe.path, *arguments))


def step(search: Search, event: InputEvent, recipes: tuple[Recipe, ...]) -> Picking | None:
    """
    The picker after a key that picks rather than edits, or `None` for an event the query's field handles.

    The component steps from the latest state, so keys typed faster than the screen redraws (type-ahead while just
    dumps the justfile, say) land as if each had been seen.
    """
    shown = options(recipe_rows(recipes, command_line(search.query)[0]))
    match event:
        case KeyPressed(key=key) if key in LEAVE_KEYS:
            return Finished(command=None)
        # Enter typed ahead, before the terminal goes raw, has had its \r turned into \n (Ctrl+J) by the tty.
        case KeyPressed(key=Key.Enter | Key.ControlJ) if (index := search.highlight.index_in(shown)) is not None:
            return chosen(search, shown[index].recipe)
        case KeyPressed(key=key) if key in DOWN_KEYS:
            return replace(search, highlight=search.highlight.moved(shown, 1))
        case KeyPressed(key=key) if key in UP_KEYS:
            return replace(search, highlight=search.highlight.moved(shown, -1))
        case _:
            return None


def trimmed(event: InputEvent) -> InputEvent:
    """A paste without the line break a copied line ends with, which the field would make a trailing space."""
    return Pasted(text=event.text.rstrip("\r\n")) if isinstance(event, Pasted) else event


def query_row(field: TextInput) -> Div:
    """The query after its prompt, with the cursor drawn over the cell it's in."""
    return Div(
        style=row_style | overflow_x_scroll | stick_to_end_x,
        children=(
            Text(content="> ", style=text_wrap_none | text_color("slate", 400)),
            Text(content=field.before_cursor, style=text_wrap_none),
            Text(
                content=field.at_cursor,
                handle=field.cursor_cell,
                style=text_wrap_none | text_color("slate", 900) | text_bg("sky", 300),
            ),
            Text(content=field.after_cursor, style=text_wrap_none),
        ),
    )


@component
def recipe_picker(recipes: tuple[Recipe, ...], choose: Callable[[tuple[str, ...]], None]) -> Div:
    def start() -> Picking:
        return EMPTY_SEARCH

    picking, set_picking = use_state(start)
    row_handle, _ = use_state(ElementHandle)

    def edit_query(edit: Callable[[str], str]) -> str:
        settled = set_picking(
            lambda latest: latest.edited(edit(latest.query), recipes) if isinstance(latest, Search) else latest
        )
        return settled.query if isinstance(settled, Search) else ""

    field = use_text_input(picking.query if isinstance(picking, Search) else "", edit_query, auto_focus=True)

    def on_input(event: InputEvent, receiver: Receiver) -> InputResponse:
        now = get_state(set_picking)
        # Keys typed ahead of the Quit, after the choice, choose nothing more.
        if isinstance(now, Finished):
            return ()
        scroll = ScrollIntoView(row_handle, block="nearest")
        match step(now, event, recipes):
            case None:
                if (controls := response_controls(field.on_input(trimmed(event), receiver))) is None:
                    return None
                return (*controls, scroll)
            case Finished(command=command) as finished:
                set_picking(finished)
                if command is not None:
                    choose(command)
                return Quit()
            case Search() as moved:
                set_picking(moved)
                return scroll
            case _ as unreachable:
                assert_never(unreachable)

    match picking:
        case Finished():
            return Div()
        case Search(query=query, highlight=highlight, notice=notice):
            word, arguments = command_line(query)
            rows = recipe_rows(recipes, word)
        case _ as unreachable:
            assert_never(unreachable)
    shown = options(rows)
    highlighted = shown[index] if (index := highlight.index_in(shown)) is not None else None

    # Aligned across every recipe rather than the ones shown, so the docs hold still as the query narrows.
    width = max(len(recipe.signature) for recipe in recipes)

    def row_line(row: Row) -> Text | Div:
        match row:
            case Heading(title=title):
                return Text(content=title, style=text_wrap_none | text_bold | text_color("slate", 400))
            case Listed(recipe=Recipe(signature=signature, doc=doc)):
                is_highlighted = row == highlighted
                return Div(
                    style=row_style,
                    handle=row_handle if is_highlighted else None,
                    children=(
                        Text(
                            content=f"  {signature.ljust(width)}",
                            style=text_wrap_none
                            | (text_bold | text_color("amber", 300) if is_highlighted else text_color("slate", 300)),
                        ),
                        Text(content=f"  # {doc}" if doc else "", style=text_wrap_none | text_color("slate", 500)),
                    ),
                )
            case _ as unreachable:
                assert_never(unreachable)

    preview = shlex.join(["just", highlighted.recipe.path]) + (f" {arguments}" if arguments else "") if highlighted else ""
    return Div(
        style=col | min_height(0) | border | border_lightrounded | border_color("slate", 500) | pad_x(1),
        on_input=on_input,
        children=(
            Text(content="a recipe, then any arguments after a space", style=text_wrap_none | text_color("slate", 400)),
            query_row(field),
            Div(
                style=col | min_height(0) | max_height(SHOWN_ROWS) | overflow_y_scroll,
                children=tuple(row_line(row) for row in rows)
                or (Text(content="nothing matches", style=text_color("slate", 400)),),
            ),
            Text(content=notice or preview, style=text_wrap_none | (text_color("red", 400) if notice else text_color("sky", 300))),
        ),
    )


# `row` from the style utilities, renamed so the Row rows above don't read as it.
row_style: Style = row


async def pick(recipes: tuple[Recipe, ...], **app_options: object) -> tuple[str, ...] | None:
    """Run the picker until it quits, and return the arguments to `just` it chose, if any."""
    chosen_commands: list[tuple[str, ...]] = []
    await counterweight_app(recipe_picker(recipes, chosen_commands.append), **app_options)
    return chosen_commands[-1] if chosen_commands else None


def wait_for_key(message: str) -> None:
    """Say MESSAGE and wait for any key, so a pane that closes when this exits can still be read."""
    with open("/dev/tty", "rb", buffering=0) as terminal:
        fd = terminal.fileno()
        original = termios.tcgetattr(fd)
        print(message, end="", flush=True)
        try:
            tty.setcbreak(fd)
            terminal.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, original)
            print()


def run_just(command: tuple[str, ...]) -> int:
    """
    Run just with COMMAND in this terminal and return its status.

    Ctrl+C reaches just as well as this process, and just decides whether the recipe stops, so an interrupt here only
    goes back to waiting. `subprocess.run` would instead kill just a quarter-second later, orphaning the recipe.
    """
    process = subprocess.Popen(["just", *command])
    while True:
        try:
            return process.wait()
        except KeyboardInterrupt:
            continue


def run_picked() -> tuple[int, bool]:
    """
    Pick a recipe and run it, returning its status and whether anything was printed.

    The status is just's own when there is no justfile to read, and 0 when the picker was left, the one outcome that
    prints nothing.
    """
    # stderr passes through, so a missing or broken justfile reads as just's own message.
    dump = subprocess.run(["just", "--dump", "--dump-format", "json"], stdout=subprocess.PIPE, text=True)
    if dump.returncode != 0:
        return dump.returncode, True
    recipes = parse_recipes(json.loads(dump.stdout))
    if not recipes:
        print("pick-just: the justfile has no public recipes", file=sys.stderr)
        return 1, True

    command = asyncio.run(pick(recipes, title="just", viewport=Inline(keep_last_frame=False)))
    if command is None:
        return 0, False
    print(f"$ {shlex.join(['just', *command])}", flush=True)
    return run_just(command), True


def main(
    hold: Annotated[
        bool, typer.Option(help="Wait for a key before exiting, so a pane that closes on exit can still be read.")
    ] = False,
) -> None:
    status, printed = run_picked()
    if hold and printed:
        wait_for_key(f"just exited {status}; press any key to close")
    raise typer.Exit(status)


def _selftest() -> int:
    from counterweight.autopilot import typed
    from counterweight.controls import Screenshot
    from counterweight.paint import Frame

    def parameter(name: str, kind: str = "singular", default: object = None, long: str | None = None) -> dict[str, Any]:
        return {"name": name, "kind": kind, "default": default, "long": long, "short": None}

    def recipe(path: str, *parameters: dict[str, Any], doc: str | None = None, attributes: list[Any] | None = None, private: bool = False) -> dict[str, Any]:
        return {"namepath": path, "parameters": list(parameters), "doc": doc, "attributes": attributes or [], "private": private}

    dump = {
        "recipes": {
            "_hidden": recipe("_hidden", private=True),
            "also-hidden": recipe("also-hidden", attributes=["private"], private=True),
            "bump": recipe("bump", parameter("part", default=["concatenate", "x", ["variable", "v"]]), parameter("args", "star", "")),
            "lint": recipe("lint", doc="Lint everything", attributes=[{"group": "checks"}]),
            "lint-all": recipe("lint-all"),
            "test": recipe(
                "test", parameter("target"), parameter("mode", default="debug"), parameter("jobs", long="jobs"),
                attributes=[{"group": "rust"}, {"group": "checks"}],
            ),
        },
        "modules": {"sub": {"recipes": {"inner": recipe("sub::inner", parameter("x", "plus"))}, "modules": {}}},
    }
    recipes = parse_recipes(dump)
    by_path = {recipe.path: recipe for recipe in recipes}
    enter, escape, down = KeyPressed(key=Key.Enter), KeyPressed(key=Key.Escape), KeyPressed(key=Key.Down)

    def stepped(*inputs: InputEvent | str) -> Picking:
        """The picker after each input, a string standing for the query typed onto."""
        picking: Picking = EMPTY_SEARCH
        for given in inputs:
            if isinstance(picking, Finished):
                break
            if isinstance(given, str):
                picking = picking.edited(picking.query + given, recipes)
            else:
                picking = step(picking, given, recipes) or picking
        return picking

    def shown_paths(word: str) -> tuple[str, ...]:
        return tuple(row.title if isinstance(row, Heading) else row.recipe.path for row in recipe_rows(recipes, word))

    cases: list[tuple[str, bool]] = [
        ("private recipes are left out, and a module's are listed by path", tuple(by_path) == ("bump", "lint", "lint-all", "sub::inner", "test")),
        ("a signature writes a string default quoted and an expression one abbreviated", by_path["bump"].signature == "bump part=… *args=''"),
        ("a signature marks + parameters", by_path["sub::inner"].signature == "sub::inner +x"),
        ("groups are read from attributes, other attributes ignored", by_path["test"].groups == ("rust", "checks")),
        (
            "ungrouped recipes come first, then each group under its heading, a recipe in two under both",
            shown_paths("") == ("bump", "lint-all", "sub::inner", "[checks]", "lint", "test", "[rust]", "test"),
        ),
        ("a heading appears only over a group with matches", shown_paths("LINT") == ("lint-all", "[checks]", "lint")),
        ("only the first word narrows", shown_paths(command_line("sub a b")[0]) == ("sub::inner",)),
        ("a required parameter left out is missing", by_path["test"].missing(0) == ("target",)),
        ("defaulted and option parameters are never missing", by_path["test"].missing(1) == ()),
        ("a + parameter needs one argument", by_path["sub::inner"].missing(0) == ("x",)),
        ("Enter runs a recipe needing nothing", stepped(enter) == Finished(command=("bump",))),
        ("a first word naming a recipe exactly highlights it over earlier matches", stepped("lint", enter) == Finished(command=("lint",))),
        (
            "the words after the first are the recipe's arguments, split as the shell would",
            stepped("test 'a b' -k", enter) == Finished(command=("test", "a b", "-k")),
        ),
        ("typing arguments leaves the highlight where it was", stepped("lin", down, " x", enter) == Finished(command=("lint", "x"))),
        ("a module's recipe runs by its path", stepped("inner x", enter) == Finished(command=("sub::inner", "x"))),
        (
            "Enter on a recipe missing an argument says so and stays",
            isinstance(missing := stepped("test", enter), Search) and missing.notice == "test needs target",
        ),
        (
            "Down moves from a recipe in two groups to its second listing",
            stepped("test", down, " a", enter) == Finished(command=("test", "a"))
            and isinstance(second := stepped("test", down), Search)
            and second.highlight.index_in(options(recipe_rows(recipes, "test"))) == 1,
        ),
        ("arguments that don't split say so", isinstance(stepped("test 'a", enter), Search)),
        ("typing clears the notice", isinstance(cleared := stepped("test", enter, " a"), Search) and cleared.notice == ""),
        ("Down from the last wraps to the first", stepped("lint", down, enter) == Finished(command=("lint-all",))),
        ("Escape leaves without running anything", stepped(escape, enter) == Finished(command=None)),
        ("Enter with nothing matched is left to the field", step(Search("zz", Highlight(), ""), enter, recipes) is None),
    ]

    def picked(*steps: object, picked_from: tuple[Recipe, ...] = recipes, dimensions: tuple[int, int] = (60, 14)) -> tuple[str, ...] | None:
        return asyncio.run(
            asyncio.wait_for(
                pick(
                    picked_from, title="just", headless=True, dimensions=dimensions,
                    viewport=Inline(keep_last_frame=False), autopilot=[*steps, Quit()],
                ),
                timeout=timedelta(seconds=30).total_seconds(),
            )
        )

    many = parse_recipes({"recipes": {f"r{index:02}": recipe(f"r{index:02}") for index in range(30)}, "modules": {}})
    frames: list[Frame] = []
    picked(*(down for _ in range(20)), Screenshot(frames.append), picked_from=many, dimensions=(40, 40))
    screen = frames[0].text(ansi=False) if frames else ""

    cases += [
        ("the app hands back the command chosen", picked(*typed("test a"), enter) == ("test", "a")),
        (
            "the arguments edit at the cursor",
            picked(*typed("test b"), KeyPressed(key=Key.Left), *typed("a "), enter) == ("test", "a", "b"),
        ),
        ("a paste reaches the field without its line break", picked(Pasted(text="sub y\n"), enter) == ("sub::inner", "y")),
        ("the app hands back nothing when left", picked(escape) is None),
        ("the list stops growing at its most rows", len(screen.splitlines()) == SHOWN_ROWS + 5),
        ("moving past the rows shown scrolls the highlight into view", "r20" in screen and "r00" not in screen),
    ]

    failures = [name for name, passed in cases if not passed]
    for name in failures:
        print(f"FAIL: {name}", file=sys.stderr)
    print(f"pick-just: {len(cases) - len(failures)}/{len(cases)} passed")
    return 1 if failures else 0


if __name__ == "__main__":
    if os.environ.get("CLAUDE_HOOK_SELFTEST"):
        sys.exit(_selftest())
    typer.run(main)
