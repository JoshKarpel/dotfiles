#!/usr/bin/env bash
# Stop check, last in `claude-stop`'s sequence: when this prompt changed the repo, ask for the
# turn's report, once per prompt.
#
# Claude holds its report on a turn that changed tracked files (the global CLAUDE.md says so),
# because every check that blocks makes Claude reply, and a report written before them ends up
# buried under the replies. Running last means the report is written once the commit, the land, and
# every other check have settled, so it is the last thing Josh reads. A turn that ends asking Josh
# something never gets here: the question gate in `claude-stop` ends the sequence first.
#
# It keys on whether the prompt changed the repo (`claude-prompt-snapshot changed`), not on whether
# another check fired, since a check that fires once per prompt can skip, and the report would go
# missing on that turn.
#
# It also carries what landing is due, since this is the one turn that is spent anyway: the
# reminder for a branch that has never been landed, and the land request `claude-stop-land` would
# otherwise block for (`claude-stop-land --request`). Carrying that request spends the land check's
# ask, so neither it nor the question gate in `claude-stop` counts it as still to come.

set -euo pipefail

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
  sed -n '2,${/^#/!q;s/^# \{0,1\}//p;}' "$0"
  exit 0
fi
if (($#)); then
  echo "$(basename "$0"): takes no arguments; see --help" >&2
  exit 2
fi

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests. This marker line is how
# `claude-hook-selftests` discovers participating hooks. Whether it asks depends on what the
# snapshot and land state say, both stubbed on PATH; run these with
# `CLAUDE_HOOK_SELFTEST=1 claude-stop-summary`.
if [[ -n "${CLAUDE_HOOK_SELFTEST:-}" ]]; then
  SELF=$(realpath "$0")
  # The stubbed snapshot answers `changed`; the once-per-prompt record is the real one's.
  export REAL_SNAPSHOT
  REAL_SNAPSHOT="$(dirname "$SELF")/claude-prompt-snapshot"
  fails=0
  stubs=$(realpath "$(mktemp -d)")
  repo=$(realpath "$(mktemp -d)")
  trap 'rm -rf "$stubs" "$repo"' EXIT
  # shellcheck disable=SC2207
  unset_git=($(git rev-parse --local-env-vars | sed 's/^/-u /'))
  env "${unset_git[@]}" git init -q "$repo"

  cat >"$stubs/claude-prompt-snapshot" <<'EOF'
#!/bin/sh
[ "$1" = changed ] || exec "$REAL_SNAPSHOT" "$@"
exit "$STUB_CHANGED"
EOF
  cat >"$stubs/git-land" <<'EOF'
#!/bin/sh
[ -n "$STUB_LAND_STATE" ] || exit 1
printf '%s\n' "$STUB_LAND_STATE"
EOF
  chmod +x "$stubs"/*

  NEVER_LANDED=$'path=/x/pr.md\ndraft=no\nlanded=no\nstale=no\ndraft_changed=no\nunlanded=2\npr_failed=no\ndefault=no'
  LANDED=$'path=/x/pr.md\ndraft=yes\nlanded=yes\nstale=no\ndraft_changed=no\nunlanded=0\npr_failed=no\ndefault=no'

  call() {
    local prompt="$1" changed="$2" land_state="${3:-}"
    OUT=$(cd "$repo" && jq -cn --arg p "$prompt" '{prompt_id: $p}' |
      env "${unset_git[@]}" STUB_CHANGED="$changed" STUB_LAND_STATE="$land_state" PATH="$stubs:$(dirname "$SELF"):$PATH" \
      CLAUDE_HOOK_SELFTEST= "$SELF" 2>&1) ||
    { printf 'FAIL exited non-zero :: %s\n' "$OUT"; fails=1; }
  }
  asks() {
    local desc="$1" want="$2" got=no
    [[ "$OUT" == *"write the turn's report"* ]] && got=yes
    [[ "$got" == "$want" ]] || { printf 'FAIL %s: want_ask=%s got=%s :: %s\n' "$desc" "$want" "$got" "$OUT"; fails=1; }
  }

  call p1 1
  asks "a prompt that changed nothing is silent" no
  call p2 0
  asks "a prompt that changed the repo asks" yes
  [[ "$(jq -r .hookSpecificOutput.hookEventName <<<"$OUT")" == Stop ]] ||
  { printf 'FAIL the ask is Stop JSON :: %s\n' "$OUT"; fails=1; }
  call p2 0
  asks "the same prompt is asked once" no
  call p3 0 "$NEVER_LANDED"
  asks "a never-landed branch with commits still asks" yes
  [[ "$OUT" == *"has not been landed"* ]] || { printf 'FAIL never-landed reminder missing :: %s\n' "$OUT"; fails=1; }
  call p4 0 "$LANDED"
  [[ "$OUT" != *"has not been landed"* ]] || { printf 'FAIL a landed branch gets no reminder :: %s\n' "$OUT"; fails=1; }

  # --- the default branch: its unlanded commits are Josh's, so no reminder to land them ---
  call p5 0 "${NEVER_LANDED/default=no/default=yes}"
  asks "the default branch still asks for the report" yes
  [[ "$OUT" != *"has not been landed"* ]] || { printf 'FAIL the default branch gets no reminder :: %s\n' "$OUT"; fails=1; }

  # --- a landed branch with unlanded commits: the land request rides on the report ---
  snapshot() { (cd "$repo" && env "${unset_git[@]}" CLAUDE_HOOK_SELFTEST= "$REAL_SNAPSHOT" "$@"); }
  UNLANDED=${LANDED/unlanded=0/unlanded=2}
  call p6 0 "$UNLANDED"
  asks "a landed branch with unlanded commits asks for the report" yes
  [[ "$OUT" == *"run \`git land\`"* && "$OUT" == *"whether you landed"* ]] ||
  { printf 'FAIL the land request rides on the report :: %s\n' "$OUT"; fails=1; }
  snapshot asked p6 land || { printf 'FAIL carrying the land request spends its ask\n'; fails=1; }
  snapshot ask p7 land
  call p7 0 "$UNLANDED"
  asks "a land check that has asked still gets the report" yes
  [[ "$OUT" != *"run \`git land\`"* ]] || { printf 'FAIL a land already asked for is not asked again :: %s\n' "$OUT"; fails=1; }

  # --- a PR that failed to open reads landed=no, but the branch is on origin ---
  PR_FAILED=${NEVER_LANDED/pr_failed=no/pr_failed=yes}
  snapshot ask p8 land
  call p8 0 "$PR_FAILED"
  asks "a branch whose PR failed to open still gets the report" yes
  [[ "$OUT" != *"has not been landed"* ]] || { printf 'FAIL a failed PR gets no never-landed reminder :: %s\n' "$OUT"; fails=1; }

  if [[ "$fails" == 0 ]]; then
    echo "$(basename "$0"): all self-tests passed"
  fi
  exit "$fails"
fi

INPUT=$(cat)
PROMPT_ID=$(jq -r '.prompt_id // ""' <<<"$INPUT")

git rev-parse --git-dir >/dev/null 2>&1 || exit 0
claude-prompt-snapshot changed "$PROMPT_ID" >/dev/null || exit 0

claude-prompt-snapshot ask "$PROMPT_ID" summary || exit 0

REMINDER=""
LAND_STATE=$(git-land --state 2>/dev/null || true)
# Not on the default branch, whose unlanded commits are Josh's rather than this turn's to publish.
# Nor on a branch whose PR failed to open, which reads `landed=no` but is on origin: what it needs is
# the land request below, and when that has already been asked, nothing.
if grep -qx 'default=no' <<<"$LAND_STATE" && grep -qx 'landed=no' <<<"$LAND_STATE" &&
grep -qx 'pr_failed=no' <<<"$LAND_STATE" && ! grep -qx 'unlanded=0' <<<"$LAND_STATE"; then
  REMINDER=$'\n\n'"This branch has not been landed yet. If the change is now worth showing (a coherent first version whose checks pass locally), write the PR draft to the path \`git land --path\` prints and run \`git land\` before the report, and say in the report that you did. Otherwise do not mention landing."
fi
LAND_REQUEST=$(claude-stop-land --request)
if [[ -n "$LAND_REQUEST" ]] && claude-prompt-snapshot ask "$PROMPT_ID" land; then
  REMINDER=$'\n\n'"Before the report: $LAND_REQUEST Then say in the report whether you landed, and why not if you didn't."
fi

CONTEXT="The checks have settled. Now write the turn's report: what changed, why, and how you checked it, as the reply Josh reads last. Don't restate replies you gave to the checks, and don't end on a question you didn't need to ask.${REMINDER}"

jq -n --arg ctx "$CONTEXT" \
  '{systemMessage: "[claude-stop-summary] report", hookSpecificOutput: {hookEventName: "Stop", additionalContext: $ctx}}'
