#!/usr/bin/env bash
# Check if the current directory is inside a project with pre-commit configured (has a config at repo root)

set -euo pipefail

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
  sed -n '2,${/^#/!q;s/^# \{0,1\}//p;}' "$0"
  exit 0
fi
if (($#)); then
  echo "$(basename "$0"): takes no arguments; see --help" >&2
  exit 2
fi

# Spelled out rather than via the `root` gitconfig alias: this runs from hook subprocesses
# and CI, neither of which is guaranteed to have the dotfiles' gitconfig installed.
root="$(git rev-parse --show-toplevel)"
[[ -f "$root/.pre-commit-config.yaml" || -f "$root/.pre-commit-config.yml" ]]
