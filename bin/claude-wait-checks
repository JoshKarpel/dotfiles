#!/usr/bin/env bash
# Wait, for a bounded time, on the checks of this branch's pull request, and say what happened.
#
# Claude runs this in the background after `git land`, and the harness re-invokes it when it exits.
# `gh pr checks --watch` alone has no deadline, and says the same "no checks reported" for a push
# GitHub hasn't registered yet as for a PR with merge conflicts, which gets no `pull_request` runs at
# all, since GitHub can't build the merge commit they check out. Read as the first, the second turns
# into restarting the watch, or a `sleep` loop, that waits on runs that will never exist. This exits
# on the first state that will not change by waiting longer, and otherwise at the deadline, with a
# verdict and what to do next.
#
# The deadline exists so a long run costs several short waits rather than one that outlives the prompt
# cache (an hour): each wake is a chance to look at the runs still going for anything anomalous before
# waiting again.
#
# It reads the checks of the commit the PR's head points at, and keeps waiting until that is `HEAD`,
# so a wait started straight after a push doesn't report the previous commit's results as this one's.
#
# Beside the verdict it looks for signs of trouble the verdict alone hides: a run slower than the
# default branch's, one queued with no runner, a step stuck far past its usual time, a failure the
# default branch shares or that has needed reruns there before, a workflow that failed without
# reporting a check, a base that has moved on. Each signal prints only when
# something looks off, and says nothing at all when it looks normal: the point is to surface a
# potential problem for Claude to react to, not to report status, and a line saying all is well is
# one more line to read past. A new signal follows the same rule, with its threshold set where a
# normal run doesn't reach it.

set -euo pipefail

usage() {
  cat <<'EOF'
usage: claude-wait-checks [--timeout SECONDS] [--interval SECONDS] [--grace SECONDS]

Poll this branch's PR checks every --interval (default 30) seconds until they settle,
for at most --timeout (default 900) seconds. --grace (default 180) is how long a PR
with no checks at all is given for them to register before that counts as an answer.

Exit status:
  0  every check passed            4  still pending at the deadline
  1  a check failed                5  no checks registered within the grace period
  2  usage error                   6  no open PR for this branch
  3  the PR has merge conflicts    7  HEAD has commits origin lacks
EOF
}

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests. This marker line is how
# `claude-hook-selftests` discovers participating scripts. `gh` is stubbed on PATH and answers from
# environment variables, against a throwaway repo whose `origin` already has `HEAD`; run these with
# `CLAUDE_HOOK_SELFTEST=1 claude-wait-checks`.
if [[ -n "${CLAUDE_HOOK_SELFTEST:-}" ]]; then
  SELF=$(realpath "$0")
  fails=0
  workdir=$(realpath "$(mktemp -d)")
  trap 'rm -rf "$workdir"' EXIT
  # shellcheck disable=SC2046
  unset $(git rev-parse --local-env-vars)
  export GIT_CONFIG_GLOBAL=/dev/null HOME="$workdir" XDG_CONFIG_HOME="$workdir"
  export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
  stubs="$workdir/stubs"
  mkdir -p "$stubs"

  repo="$workdir/repo"
  git init -q --bare "$workdir/origin.git"
  git init -q -b work "$repo"
  git -C "$repo" commit -q --allow-empty -m one
  git -C "$repo" remote add origin "$workdir/origin.git"
  git -C "$repo" push -q origin work
  head=$(git -C "$repo" rev-parse HEAD)

  # An unset GH_PR_JSON reproduces `gh pr view` finding no PR, and an unset GH_CHECKS_JSON
  # `gh pr checks` finding no checks, which it reports as an error rather than an empty list. The
  # `gh run list` variables split by what the script asks for: this commit's runs (GH_RUNS_JSON), the
  # default branch's successful runs (GH_BASELINE_JSON), its latest completed run (GH_LATEST_JSON),
  # and its run history with attempts (GH_HISTORY_JSON). GH_JOBS_<id> is a run's jobs, and
  # GH_COMPARE_JSON the base comparison.
  cat >"$stubs/gh" <<'EOF'
#!/usr/bin/env bash
no_jobs='{"jobs":[]}' even='{"ahead_by":0,"files":[]}'
case "$1 $2" in
  "pr view") [[ -n "${GH_PR_JSON:-}" ]] || { echo 'no pull requests found for branch "work"' >&2; exit 1; }
    printf '%s' "$GH_PR_JSON" ;;
  "pr checks") [[ -n "${GH_CHECKS_JSON:-}" ]] || { echo "no checks reported on the 'work' branch" >&2; exit 1; }
    printf '%s' "$GH_CHECKS_JSON" ;;
  "run list")
    case "$*" in
      *--commit*) printf '%s' "${GH_RUNS_JSON:-[]}" ;;
      *"--status success"*) printf '%s' "${GH_BASELINE_JSON:-[]}" ;;
      *"--status completed"*) printf '%s' "${GH_LATEST_JSON:-[]}" ;;
      *) printf '%s' "${GH_HISTORY_JSON:-[]}" ;;
    esac ;;
  "run view") var="GH_JOBS_$3"; printf '%s' "${!var:-$no_jobs}" ;;
  "repo view") echo main ;;
  "api "*) printf '%s' "${GH_COMPARE_JSON:-$even}" ;;
  *) exit 1 ;;
esac
EOF
  chmod +x "$stubs/gh"

  pr() { printf '{"number":7,"url":"https://example.com/pull/7","state":"%s","mergeable":"%s","headRefOid":"%s","baseRefName":"main"}' "$1" "$2" "$3"; }
  check() { printf '{"name":"%s","workflow":"%s","bucket":"%s","state":"%s","startedAt":"0001-01-01T00:00:00Z","link":"https://example.com/%s"}' "$1" "$1" "$2" "$3" "$1"; }
  # run <id> <workflow> <status> <conclusion> <created> <started> <updated>
  run() { printf '{"databaseId":%s,"workflowName":"%s","status":"%s","conclusion":"%s","createdAt":"%s","startedAt":"%s","updatedAt":"%s","url":"https://example.com/run/%s"}' "$@" "$1"; }

  # t <want-exit> <output-substring> [VAR=value ...]: by default one poll with no time left, so
  # every non-final state reports as the deadline; FLAGS overrides that for a case needing two polls.
  # A substring starting with `!` asserts it is absent instead, which is how the signals' silence on
  # a normal run is pinned.
  t() {
    local want="$1" needle="$2" got out matched
    shift 2
    # shellcheck disable=SC2086
    out=$(cd "$repo" && env -u GH_PR_JSON -u GH_CHECKS_JSON "$@" PATH="$stubs:$PATH" CLAUDE_HOOK_SELFTEST= \
      "$SELF" ${FLAGS:---timeout 0 --grace 0} 2>&1) && got=0 || got=$?
    if [[ "$needle" == '!'* ]]; then
      [[ "$out" != *"${needle#!}"* ]] && matched=1 || matched=0
    else
      [[ "$out" == *"$needle"* ]] && matched=1 || matched=0
    fi
    [[ "$got" == "$want" && "$matched" == 1 ]] ||
    { printf 'FAIL want=%s %q :: got=%s %s\n' "$want" "$needle" "$got" "$out"; fails=1; }
  }

  open=$(pr OPEN MERGEABLE "$head")
  t 0 "All 2 checks passed" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci pass SUCCESS),$(check lint skipping SKIPPED)]"
  t 1 "ci (FAILURE)" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci fail FAILURE),$(check lint pending IN_PROGRESS)]"
  t 1 "https://example.com/ci" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci cancel CANCELLED)]"
  t 4 "lint (IN_PROGRESS)" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci pass SUCCESS),$(check lint pending IN_PROGRESS)]"
  t 5 "No checks registered" GH_PR_JSON="$open"
  # A conflicting PR gets no pull_request checks at all, and GitHub can still report CONFLICTING
  # just after the push that resolved it, so it takes two polls in a row to count.
  FLAGS="--timeout 1 --interval 1 --grace 0" \
    t 3 "merge conflicts" GH_PR_JSON="$(pr OPEN CONFLICTING "$head")" GH_CHECKS_JSON="[$(check ci pending IN_PROGRESS)]"
  FLAGS="--timeout 1 --interval 1 --grace 0" t 3 "resolve-conflicts" GH_PR_JSON="$(pr OPEN CONFLICTING "$head")"
  t 4 "reports merge conflicts" GH_PR_JSON="$(pr OPEN CONFLICTING "$head")" GH_CHECKS_JSON="[$(check ci pending IN_PROGRESS)]"
  t 4 "hasn't reached" GH_PR_JSON="$(pr OPEN CONFLICTING 0000000)"
  # GitHub computes mergeability lazily, so UNKNOWN is a state to wait through, not a verdict.
  t 0 "passed" GH_PR_JSON="$(pr OPEN UNKNOWN "$head")" GH_CHECKS_JSON="[$(check ci pass SUCCESS)]"
  # Checks on a head GitHub hasn't moved to `HEAD` yet belong to the previous push.
  t 4 "hasn't reached" GH_PR_JSON="$(pr OPEN MERGEABLE 0000000)" GH_CHECKS_JSON="[$(check ci pass SUCCESS)]"
  t 6 "MERGED" GH_PR_JSON="$(pr MERGED UNKNOWN "$head")"
  t 6 "No pull request"

  # Signals. Times in 2020 are long past, so anything measured against now is far over its threshold.
  T=2026-01-01T00:00 old=2020-01-01T00:00:00Z
  passed="[$(check ci pass SUCCESS)]" failed="[$(check ci fail FAILURE)]" going="[$(check ci pending IN_PROGRESS)]"
  quick="[$(run 1 ci completed success $T:00Z $T:00Z $T:29Z)]"
  base="[$(run 2 ci completed success $T:00Z $T:00Z $T:30Z),$(run 3 ci completed success $T:00Z $T:00Z $T:33Z),$(run 4 ci completed success $T:00Z $T:00Z 2026-01-01T00:01:06Z)]"
  t 0 "!Worth a look" GH_PR_JSON="$open" GH_CHECKS_JSON="$passed" GH_RUNS_JSON="$quick" GH_BASELINE_JSON="$base"
  t 0 "ci took 3m, slower than any of its last 3 successful runs on main (30s to 66s)" GH_PR_JSON="$open" \
    GH_CHECKS_JSON="$passed" GH_RUNS_JSON="[$(run 1 ci completed success $T:00Z $T:00Z 2026-01-01T00:03:20Z)]" GH_BASELINE_JSON="$base"
  # Too few runs on the default branch to call anything slow.
  t 4 "!slower than" GH_PR_JSON="$open" GH_CHECKS_JSON="$going" GH_RUNS_JSON="[$(run 1 ci in_progress '' $old $old $old)]" \
    GH_BASELINE_JSON="[$(run 2 ci completed success $T:00Z $T:00Z $T:30Z)]"
  t 4 "ci has taken" GH_PR_JSON="$open" GH_CHECKS_JSON="$going" GH_RUNS_JSON="[$(run 1 ci in_progress '' $old $old $old)]" GH_BASELINE_JSON="$base"
  t 4 "lint has been queued for" GH_PR_JSON="$open" GH_CHECKS_JSON="$going" GH_RUNS_JSON="[$(run 5 lint queued '' $old $old $old)]"
  steps_now='{"jobs":[{"name":"build","status":"in_progress","url":"https://example.com/job","steps":[{"name":"test","status":"in_progress","startedAt":"'$old'"}]}]}'
  steps_then='{"jobs":[{"name":"build","status":"completed","steps":[{"name":"test","status":"completed","conclusion":"success","startedAt":"'$T':00Z","completedAt":"'$T':10Z"}]}]}'
  t 4 'build has been on step "test"' GH_PR_JSON="$open" GH_CHECKS_JSON="$going" GH_RUNS_JSON="[$(run 1 ci in_progress '' $old $old $old)]" \
    GH_BASELINE_JSON="$base" GH_JOBS_1="$steps_now" GH_JOBS_2="$steps_then"
  t 4 "at most 10s" GH_PR_JSON="$open" GH_CHECKS_JSON="$going" GH_RUNS_JSON="[$(run 1 ci in_progress '' $old $old $old)]" \
    GH_BASELINE_JSON="$base" GH_JOBS_1="$steps_now" GH_JOBS_2="$steps_then"
  t 1 "ci is failing on main too" GH_PR_JSON="$open" GH_CHECKS_JSON="$failed" GH_LATEST_JSON='[{"conclusion":"failure","url":"https://example.com/main"}]'
  t 1 "!failing on main" GH_PR_JSON="$open" GH_CHECKS_JSON="$failed" GH_LATEST_JSON='[{"conclusion":"success","url":"https://example.com/main"}]'
  t 1 "ci needed a rerun in 1 of its last 2 runs on main" GH_PR_JSON="$open" GH_CHECKS_JSON="$failed" \
    GH_HISTORY_JSON='[{"attempt":1,"url":"https://example.com/a"},{"attempt":2,"url":"https://example.com/b"}]'
  t 1 "!rerun" GH_PR_JSON="$open" GH_CHECKS_JSON="$failed" GH_HISTORY_JSON='[{"attempt":1,"url":"https://example.com/a"}]'
  t 0 "lint concluded startup_failure without reporting a check" GH_PR_JSON="$open" GH_CHECKS_JSON="$passed" \
    GH_RUNS_JSON="[$(run 1 ci completed success $T:00Z $T:00Z $T:29Z),$(run 5 lint completed startup_failure $T:00Z $T:00Z $T:00Z)]"
  t 0 "they change .github/workflows/ci.yml:" GH_PR_JSON="$open" GH_CHECKS_JSON="$passed" \
    GH_COMPARE_JSON='{"ahead_by":3,"files":[{"filename":".github/workflows/ci.yml"},{"filename":"README.md"}]}'
  t 0 "main has 80 commits this branch lacks" GH_PR_JSON="$open" GH_CHECKS_JSON="$passed" GH_COMPARE_JSON='{"ahead_by":80,"files":[]}'
  t 0 "!lacks" GH_PR_JSON="$open" GH_CHECKS_JSON="$passed" GH_COMPARE_JSON='{"ahead_by":3,"files":[{"filename":"README.md"}]}'

  git -C "$repo" commit -q --allow-empty -m two
  t 7 "1 commit" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci pass SUCCESS)]"

  out=$(CLAUDE_HOOK_SELFTEST= "$SELF" --interval 2>&1) && got=0 || got=$?
  [[ "$got" == 2 && "$out" == *usage* ]] || { printf 'FAIL want=2 usage :: got=%s %s\n' "$got" "$out"; fails=1; }
  if [[ "$fails" == 0 ]]; then
    echo "$(basename "$0"): all self-tests passed"
  fi
  exit "$fails"
fi

timeout=900 interval=30 grace=180
while [[ $# -gt 0 ]]; do
  case "$1" in
    --timeout | --interval | --grace)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || { usage >&2; exit 2; }
      declare "${1#--}=$2"
      shift 2
      ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

unlanded=$(git rev-list --count HEAD --not --remotes=origin)
if [[ "$unlanded" -gt 0 ]]; then
  commits="$unlanded commits"
  [[ "$unlanded" != 1 ]] || commits="1 commit"
  echo "HEAD has $commits that origin lacks, so no check can run on it yet. Land them with \`git land\`, then wait again."
  exit 7
fi

# Prints the checks as a JSON array, empty when GitHub has none for the PR's head yet. `gh pr checks`
# reports that case as an error, and its exit status says nothing about the checks under --json.
read_checks() {
  local out err
  err=$(mktemp)
  if out=$(gh pr checks --json name,workflow,bucket,state,startedAt,link 2>"$err"); then
    rm -f "$err"
    printf '%s' "$out"
    return 0
  fi
  if grep -q 'no checks reported' "$err"; then
    rm -f "$err"
    echo '[]'
    return 0
  fi
  cat "$err" >&2
  rm -f "$err"
  return 1
}

# One line per check matching the jq filter, with how long a started one has been running.
describe() {
  jq -r --arg want "$2" '.[] | select(.bucket | IN($want | split(",")[])) |
    "  \(.name) (\(.state))" +
    (if .startedAt | startswith("0001") then "" else
      ", \((now - (.startedAt | fromdate)) / 60 | floor)m since it started" end) +
    (if .link // "" | length > 0 then ": \(.link)" else "" end)' <<<"$1"
}

# Thresholds for the signals below, each set where a normal run doesn't reach it.
SLOWER_THAN_MEDIAN=1.5 # a run is slow past every recent one on the default branch and this multiple of their median
QUEUED_SECONDS=300     # a run queued this long without starting has no runner taking it
STEP_FACTOR=2          # a step is slow past this multiple of its slowest recent successful run...
STEP_FLOOR_SECONDS=60  # ...and past this, so a step that usually takes a second isn't flagged at three
BEHIND_COMMITS=50      # a base this far ahead makes the checks a test against an old one
HISTORY_RUNS=20        # how many of the default branch's runs to look through for reruns

JQ_DEFS='def fmt: if . < 120 then "\(floor)s" else "\(. / 60 | floor)m" end;
  def took: (.updatedAt | fromdate) - (.startedAt | fromdate);
  def age(f): now - (f | fromdate);'

# The workflows behind the checks that failed, one per line.
failed_workflows() {
  jq -r '.[] | select(.bucket | IN("fail", "cancel")) | .workflow // "" | select(. != "")' <<<"$checks" | sort -u
}

# A run that ended badly without a check of its own: a workflow file GitHub rejects fails at startup
# and reports nothing to `gh pr checks`, so the verdict can't see it.
runs_without_checks() {
  jq -r --argjson checks "$checks" '
    ($checks | map(.workflow // "")) as $reported
    | .[] | select(.status == "completed" and (.conclusion | IN("success", "skipped", "neutral") | not))
    | select(.workflowName | IN($reported[]) | not)
    | "  - \(.workflowName) concluded \(.conclusion) without reporting a check, which usually means GitHub rejected its workflow file: \(.url)"' <<<"$runs"
}

# A run slower than every recent successful run of its workflow on the default branch.
slow_runs() {
  local name baseline
  while IFS= read -r name; do
    baseline=$(gh run list --workflow "$name" --branch "$default" --status success --limit 5 --json startedAt,updatedAt) || continue
    jq -r --arg name "$name" --arg default "$default" --argjson base "$baseline" --argjson factor "$SLOWER_THAN_MEDIAN" "$JQ_DEFS"'
      (map(select(.workflowName == $name)) | max_by(.startedAt)) as $run
      | ($base | map(took) | sort) as $b
      | ($run | if .status == "completed" then took else age(.startedAt) end) as $d
      | select(($b | length) >= 3 and $d > $b[-1] and $d > $factor * $b[$b | length / 2 | floor])
      | "  - \($name) \(if $run.status == "completed" then "took" else "has taken" end) \($d | fmt), slower than any of its last \($b | length) successful runs on \($default) (\($b[0] | fmt) to \($b[-1] | fmt)): \($run.url)"
    ' <<<"$runs"
  done < <(jq -r '.[] | select(.status | IN("completed", "in_progress")) | .workflowName' <<<"$runs" | sort -u)
}

# A run waiting to start for longer than a runner normally takes to pick one up.
queued_runs() {
  jq -r --argjson limit "$QUEUED_SECONDS" "$JQ_DEFS"'
    .[] | select(.status | IN("queued", "waiting", "pending", "requested")) | select(age(.createdAt) > $limit)
    | "  - \(.workflowName) has been \(.status) for \(age(.createdAt) | fmt) without starting, so no runner may be taking it (a self-hosted runner offline, a concurrency limit, an environment awaiting approval): \(.url)"' <<<"$runs"
}

# A step running far longer than the same job's step took in recent successful runs on the default
# branch, which says where a slow run is stuck rather than only that it is slow.
slow_steps() {
  local id name jobs past
  while IFS=$'\t' read -r id name; do
    jobs=$(gh run view "$id" --json jobs) || continue
    past=$(gh run list --workflow "$name" --branch "$default" --status success --limit 3 --json databaseId |
    jq -r '.[].databaseId' | while IFS= read -r past_id; do gh run view "$past_id" --json jobs; done | jq -s 'map(.jobs[])') || continue
    jq -r --arg default "$default" --argjson past "$past" --argjson factor "$STEP_FACTOR" --argjson floor "$STEP_FLOOR_SECONDS" "$JQ_DEFS"'
      def step_took: (.completedAt | fromdate) - (.startedAt | fromdate);
      .jobs[] | select(.status == "in_progress") as $job
      | $job.steps[] | select(.status == "in_progress") as $step
      | ($past | map(select(.name == $job.name) | .steps[] | select(.name == $step.name and .conclusion == "success") | step_took) | max) as $usual
      | age($step.startedAt) as $d
      | select($usual != null and $d > $floor and $d > $factor * $usual)
      | "  - \($job.name) has been on step \"\($step.name)\" for \($d | fmt), which took at most \($usual | fmt) in its last few successful runs on \($default): \($job.url)"
    ' <<<"$jobs"
  done < <(jq -r '.[] | select(.status == "in_progress") | [.databaseId, .workflowName] | @tsv' <<<"$runs")
}

# A failed workflow whose latest finished run on the default branch failed too.
failing_on_default() {
  local name latest
  while IFS= read -r name; do
    latest=$(gh run list --workflow "$name" --branch "$default" --status completed --limit 1 --json conclusion,url) || continue
    jq -r --arg name "$name" --arg default "$default" '.[] | select(.conclusion == "failure")
      | "  - \($name) is failing on \($default) too, so this failure may not come from this change: \(.url)"' <<<"$latest"
  done < <(failed_workflows)
}

# A failed workflow that has needed reruns on the default branch.
flaky() {
  local name history
  while IFS= read -r name; do
    history=$(gh run list --workflow "$name" --branch "$default" --limit "$HISTORY_RUNS" --json attempt,url) || continue
    jq -r --arg name "$name" --arg default "$default" '
      [.[] | select(.attempt > 1)] as $reruns | select($reruns != [])
      | "  - \($name) needed a rerun in \($reruns | length) of its last \(length) runs on \($default), so this failure may be flaky: compare it with \($reruns[0].url)"' <<<"$history"
  done < <(failed_workflows)
}

# A base that has moved on: changing CI itself, or by enough that the checks tested an old one.
behind_base() {
  local compare
  compare=$(gh api "repos/{owner}/{repo}/compare/$head...$base") || return 0
  jq -r --arg base "$base" --argjson limit "$BEHIND_COMMITS" '
    [.files[]?.filename | select(test("^\\.github/workflows/|(^|/)action\\.ya?ml$"))] as $ci
    | if $ci != [] then
        "  - \($base) has \(.ahead_by) commits this branch lacks, and they change \($ci | join(", ")): the checks here may differ from what \($base) now runs. Merging it in (the resolve-conflicts skill) brings them."
      elif .ahead_by > $limit then
        "  - \($base) has \(.ahead_by) commits this branch lacks, so these checks tested it against an old base. Merging it in (the resolve-conflicts skill) brings it up to date."
      else empty end' <<<"$compare"
}

# The signals that apply to a verdict, under one heading, or nothing when none fires. A lookup that
# fails leaves its error on stderr and its signal silent, since none of them changes the verdict.
anomalies() {
  local verdict="$1" runs default found
  runs=$(gh run list --commit "$head" --limit 100 \
    --json databaseId,workflowName,status,conclusion,createdAt,startedAt,updatedAt,url) || return 0
  default=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name) || return 0
  found=$(
    runs_without_checks
    case "$verdict" in
      pass) slow_runs; behind_base ;;
      fail) failing_on_default; flaky; slow_runs; behind_base ;;
      timeout) queued_runs; slow_steps; slow_runs; behind_base ;;
    esac
  )
  [[ -n "$found" ]] || return 0
  echo "Worth a look:"
  printf '%s\n' "$found"
}

checks='[]'
start=$(date +%s)
while true; do
  elapsed=$(($(date +%s) - start))

  if ! pr=$(gh pr view --json number,url,state,mergeable,headRefOid,baseRefName 2>&1); then
    if [[ "$pr" == *"no pull requests found"* ]]; then
      echo "No pull request for this branch, so there are no checks to wait on. \`git land\` opens one."
      exit 6
    fi
    echo "$pr" >&2
    exit 1
  fi
  number=$(jq -r .number <<<"$pr")
  state=$(jq -r .state <<<"$pr")
  base=$(jq -r .baseRefName <<<"$pr")
  if [[ "$state" != OPEN ]]; then
    echo "PR #$number is $state, so there is nothing to wait on."
    exit 6
  fi

  # Mergeability is only read once the PR's head is this commit, and only believed when it repeats:
  # GitHub can report the conflict a moment after the push that resolved it.
  head=$(git rev-parse HEAD)
  if [[ "$(jq -r .headRefOid <<<"$pr")" != "$head" ]]; then
    conflicts=0
    pending="PR #$number's head hasn't reached HEAD ($head) yet, so GitHub hasn't registered the push."
  elif [[ "$(jq -r .mergeable <<<"$pr")" == CONFLICTING ]]; then
    conflicts=$((${conflicts:-0} + 1))
    if ((conflicts >= 2)); then
      echo "PR #$number has merge conflicts with its base, so GitHub won't run its pull_request checks until they are resolved, however long this waits. Use the resolve-conflicts skill to merge the base branch in, then \`git land\` and wait again."
      exit 3
    fi
    pending="PR #$number reports merge conflicts; looking once more, since GitHub can lag the push that resolved them."
  else
    conflicts=0
    checks=$(read_checks)
    total=$(jq length <<<"$checks")
    failed=$(describe "$checks" fail,cancel)
    if [[ -n "$failed" ]]; then
      printf 'Checks failed on PR #%s:\n%s\n' "$number" "$failed"
      anomalies fail
      echo "Read the failure (\`gh run view <run-id> --log-failed\`; the debug-gha skill covers it), fix it, and land again."
      exit 1
    fi
    if [[ "$total" == 0 ]]; then
      if ((elapsed >= grace)); then
        echo "No checks registered on PR #$number after ${elapsed}s. The repo may run no CI for this change (path filters, or no workflows at all); \`gh run list --branch $(git branch --show-current)\` says whether anything ran."
        anomalies none
        exit 5
      fi
      pending="No checks have registered on PR #$number yet."
    else
      still=$(describe "$checks" pending)
      if [[ -z "$still" ]]; then
        echo "All $total checks passed on PR #$number."
        anomalies pass
        exit 0
      fi
      pending=$(printf 'Still pending on PR #%s:\n%s' "$number" "$still")
    fi
  fi

  if ((elapsed >= timeout)); then
    printf '%s\n' "$pending"
    anomalies timeout
    echo "Stopped waiting after $((elapsed / 60))m. Look over the runs still going (\`gh run view <run-id>\`) for anything anomalous, starting with whatever is flagged above, then run claude-wait-checks in the background again."
    exit 4
  fi
  sleep "$interval"
done
