#!/usr/bin/env bash
# Wait, for a bounded time, on the checks of this branch's pull request, and say what happened.
#
# Claude runs this in the background after `git land`, and the harness re-invokes it when it exits.
# `gh pr checks --watch` alone has no deadline, and says the same "no checks reported" for a push
# GitHub hasn't registered yet as for a PR with merge conflicts, which gets no `pull_request` runs at
# all, since GitHub can't build the merge commit they check out. Read as the first, the second turns
# into restarting the watch, or a `sleep` loop, that waits on runs that will never exist. This exits
# on the first state that will not change by waiting longer, and otherwise at the deadline, with a
# verdict and what to do next.
#
# The deadline exists so a long run costs several short waits rather than one that outlives the prompt
# cache (an hour): each wake is a chance to look at the runs still going for anything anomalous before
# waiting again.
#
# It reads the checks of the commit the PR's head points at, and keeps waiting until that is `HEAD`,
# so a wait started straight after a push doesn't report the previous commit's results as this one's.

set -euo pipefail

usage() {
  cat <<'EOF'
usage: claude-wait-checks [--timeout SECONDS] [--interval SECONDS] [--grace SECONDS]

Poll this branch's PR checks every --interval (default 30) seconds until they settle,
for at most --timeout (default 900) seconds. --grace (default 180) is how long a PR
with no checks at all is given for them to register before that counts as an answer.

Exit status:
  0  every check passed            4  still pending at the deadline
  1  a check failed                5  no checks registered within the grace period
  2  usage error                   6  no open PR for this branch
  3  the PR has merge conflicts    7  HEAD has commits origin lacks
EOF
}

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests. This marker line is how
# `claude-hook-selftests` discovers participating scripts. `gh` is stubbed on PATH and answers from
# environment variables, against a throwaway repo whose `origin` already has `HEAD`; run these with
# `CLAUDE_HOOK_SELFTEST=1 claude-wait-checks`.
if [[ -n "${CLAUDE_HOOK_SELFTEST:-}" ]]; then
  SELF=$(realpath "$0")
  fails=0
  workdir=$(realpath "$(mktemp -d)")
  trap 'rm -rf "$workdir"' EXIT
  # shellcheck disable=SC2046
  unset $(git rev-parse --local-env-vars)
  export GIT_CONFIG_GLOBAL=/dev/null HOME="$workdir" XDG_CONFIG_HOME="$workdir"
  export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com
  stubs="$workdir/stubs"
  mkdir -p "$stubs"

  repo="$workdir/repo"
  git init -q --bare "$workdir/origin.git"
  git init -q -b work "$repo"
  git -C "$repo" commit -q --allow-empty -m one
  git -C "$repo" remote add origin "$workdir/origin.git"
  git -C "$repo" push -q origin work
  head=$(git -C "$repo" rev-parse HEAD)

  # GH_RUNS_JSON answers `gh run list --commit` (this commit's runs), GH_BASELINE_JSON any other
  # `gh run list` (the default branch's), and both default to no runs. An unset GH_PR_JSON reproduces `gh pr view` finding no PR; an unset GH_CHECKS_JSON reproduces
  # `gh pr checks` finding no checks, which it reports as an error rather than an empty list.
  cat >"$stubs/gh" <<'EOF'
#!/usr/bin/env bash
case "$1 $2" in
  "pr view") [[ -n "${GH_PR_JSON:-}" ]] || { echo 'no pull requests found for branch "work"' >&2; exit 1; }
    printf '%s' "$GH_PR_JSON" ;;
  "pr checks") [[ -n "${GH_CHECKS_JSON:-}" ]] || { echo "no checks reported on the 'work' branch" >&2; exit 1; }
    printf '%s' "$GH_CHECKS_JSON" ;;
  "run list") if [[ "$*" == *--commit* ]]; then printf '%s' "${GH_RUNS_JSON:-[]}"; else printf '%s' "${GH_BASELINE_JSON:-[]}"; fi ;;
  "repo view") echo main ;;
  *) exit 1 ;;
esac
EOF
  chmod +x "$stubs/gh"

  pr() { printf '{"number":7,"url":"https://example.com/pull/7","state":"%s","mergeable":"%s","headRefOid":"%s"}' "$1" "$2" "$3"; }
  check() { printf '{"name":"%s","bucket":"%s","state":"%s","startedAt":"0001-01-01T00:00:00Z","link":"https://example.com/%s"}' "$1" "$2" "$3" "$1"; }

  # t <want-exit> <output-substring> [VAR=value ...]: by default one poll with no time left, so
  # every non-final state reports as the deadline; FLAGS overrides that for a case needing two polls.
  t() {
    local want="$1" needle="$2" got out
    shift 2
    # shellcheck disable=SC2086
    out=$(cd "$repo" && env -u GH_PR_JSON -u GH_CHECKS_JSON "$@" PATH="$stubs:$PATH" CLAUDE_HOOK_SELFTEST= \
      "$SELF" ${FLAGS:---timeout 0 --grace 0} 2>&1) && got=0 || got=$?
    [[ "$got" == "$want" && "$out" == *"$needle"* ]] ||
    { printf 'FAIL want=%s %q :: got=%s %s\n' "$want" "$needle" "$got" "$out"; fails=1; }
  }

  open=$(pr OPEN MERGEABLE "$head")
  t 0 "All 2 checks passed" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci pass SUCCESS),$(check lint skipping SKIPPED)]"
  t 1 "ci (FAILURE)" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci fail FAILURE),$(check lint pending IN_PROGRESS)]"
  t 1 "https://example.com/ci" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci cancel CANCELLED)]"
  t 4 "lint (IN_PROGRESS)" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci pass SUCCESS),$(check lint pending IN_PROGRESS)]"
  t 5 "No checks registered" GH_PR_JSON="$open"
  # A conflicting PR gets no pull_request checks at all, and GitHub can still report CONFLICTING
  # just after the push that resolved it, so it takes two polls in a row to count.
  FLAGS="--timeout 1 --interval 1 --grace 0" \
    t 3 "merge conflicts" GH_PR_JSON="$(pr OPEN CONFLICTING "$head")" GH_CHECKS_JSON="[$(check ci pending IN_PROGRESS)]"
  FLAGS="--timeout 1 --interval 1 --grace 0" t 3 "resolve-conflicts" GH_PR_JSON="$(pr OPEN CONFLICTING "$head")"
  t 4 "reports merge conflicts" GH_PR_JSON="$(pr OPEN CONFLICTING "$head")" GH_CHECKS_JSON="[$(check ci pending IN_PROGRESS)]"
  t 4 "hasn't reached" GH_PR_JSON="$(pr OPEN CONFLICTING 0000000)"
  # GitHub computes mergeability lazily, so UNKNOWN is a state to wait through, not a verdict.
  t 0 "passed" GH_PR_JSON="$(pr OPEN UNKNOWN "$head")" GH_CHECKS_JSON="[$(check ci pass SUCCESS)]"
  # Checks on a head GitHub hasn't moved to `HEAD` yet belong to the previous push.
  t 4 "hasn't reached" GH_PR_JSON="$(pr OPEN MERGEABLE 0000000)" GH_CHECKS_JSON="[$(check ci pass SUCCESS)]"
  t 6 "MERGED" GH_PR_JSON="$(pr MERGED UNKNOWN "$head")"
  t 6 "No pull request"

  # Durations: this commit's run against the default branch's, finished or still going.
  run() { printf '{"workflowName":"%s","status":"%s","startedAt":"%s","updatedAt":"%s"}' "$@"; }
  passed="[$(check ci pass SUCCESS)]"
  runs="[$(run ci completed 2026-01-01T00:00:00Z 2026-01-01T00:00:29Z)]"
  base="[$(run ci completed 2026-01-01T00:00:00Z 2026-01-01T00:01:06Z),$(run ci completed 2026-01-01T00:00:00Z 2026-01-01T00:00:33Z),$(run ci completed 2026-01-01T00:00:00Z 2026-01-01T00:00:30Z)]"
  t 0 "ci: 29s, against 30s to 66s (median 33s)" GH_PR_JSON="$open" GH_CHECKS_JSON="$passed" GH_RUNS_JSON="$runs" GH_BASELINE_JSON="$base"
  t 1 "ci: 29s, against" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci fail FAILURE)]" GH_RUNS_JSON="$runs" GH_BASELINE_JSON="$base"
  t 0 "no successful runs on main" GH_PR_JSON="$open" GH_CHECKS_JSON="$passed" GH_RUNS_JSON="$runs"
  t 4 "so far, against 30s" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci pending IN_PROGRESS)]" \
    GH_RUNS_JSON="[$(run ci in_progress 2026-01-01T00:00:00Z 2026-01-01T00:00:00Z)]" GH_BASELINE_JSON="$base"

  git -C "$repo" commit -q --allow-empty -m two
  t 7 "1 commit" GH_PR_JSON="$open" GH_CHECKS_JSON="[$(check ci pass SUCCESS)]"

  out=$(CLAUDE_HOOK_SELFTEST= "$SELF" --interval 2>&1) && got=0 || got=$?
  [[ "$got" == 2 && "$out" == *usage* ]] || { printf 'FAIL want=2 usage :: got=%s %s\n' "$got" "$out"; fails=1; }
  if [[ "$fails" == 0 ]]; then
    echo "$(basename "$0"): all self-tests passed"
  fi
  exit "$fails"
fi

timeout=900 interval=30 grace=180
while [[ $# -gt 0 ]]; do
  case "$1" in
    --timeout | --interval | --grace)
      [[ "${2:-}" =~ ^[0-9]+$ ]] || { usage >&2; exit 2; }
      declare "${1#--}=$2"
      shift 2
      ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

unlanded=$(git rev-list --count HEAD --not --remotes=origin)
if [[ "$unlanded" -gt 0 ]]; then
  commits="$unlanded commits"
  [[ "$unlanded" != 1 ]] || commits="1 commit"
  echo "HEAD has $commits that origin lacks, so no check can run on it yet. Land them with \`git land\`, then wait again."
  exit 7
fi

# Prints the checks as a JSON array, empty when GitHub has none for the PR's head yet. `gh pr checks`
# reports that case as an error, and its exit status says nothing about the checks under --json.
read_checks() {
  local out err
  err=$(mktemp)
  if out=$(gh pr checks --json name,bucket,state,startedAt,link 2>"$err"); then
    rm -f "$err"
    printf '%s' "$out"
    return 0
  fi
  if grep -q 'no checks reported' "$err"; then
    rm -f "$err"
    echo '[]'
    return 0
  fi
  cat "$err" >&2
  rm -f "$err"
  return 1
}

# One line per check matching the jq filter, with how long a started one has been running.
describe() {
  jq -r --arg want "$2" '.[] | select(.bucket | IN($want | split(",")[])) |
    "  \(.name) (\(.state))" +
    (if .startedAt | startswith("0001") then "" else
      ", \((now - (.startedAt | fromdate)) / 60 | floor)m since it started" end) +
    (if .link // "" | length > 0 then ": \(.link)" else "" end)' <<<"$1"
}

# For each workflow run on HEAD, how long it took (or has taken so far) next to the same workflow's
# last few successful runs on the default branch, so a run drifting slower than usual stands out. It
# is context for the verdict rather than part of it, so a failed lookup says so and changes nothing.
durations() {
  local runs default name baseline
  if ! runs=$(gh run list --commit "$head" --json workflowName,status,startedAt,updatedAt 2>&1) ||
  ! default=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name 2>&1); then
    echo "Couldn't read this commit's run durations: $runs$default"
    return 0
  fi
  [[ "$(jq length <<<"$runs")" -gt 0 ]] || return 0
  echo "How long this commit's workflow runs took, against the last 5 successful runs of each on $default:"
  while IFS= read -r name; do
    baseline=$(gh run list --workflow "$name" --branch "$default" --status success --limit 5 \
      --json startedAt,updatedAt 2>/dev/null) || baseline='[]'
    jq -r --arg name "$name" --arg default "$default" --argjson base "$baseline" '
      def fmt: if . < 120 then "\(floor)s" else "\(. / 60 | floor)m" end;
      def took: (.updatedAt | fromdate) - (.startedAt | fromdate);
      (map(select(.workflowName == $name)) | max_by(.startedAt)) as $run
      | ($base | map(took) | sort) as $b
      | "  \($name): " +
        (if $run.status == "completed" then ($run | took | fmt)
         else "\(now - ($run.startedAt | fromdate) | fmt) so far" end) +
        (if $b == [] then ", with no successful runs on \($default) to compare"
         else ", against \($b[0] | fmt) to \($b[-1] | fmt) (median \($b[$b | length / 2 | floor] | fmt))" end)
    ' <<<"$runs"
  done < <(jq -r '.[].workflowName' <<<"$runs" | sort -u)
}

start=$(date +%s)
while true; do
  elapsed=$(($(date +%s) - start))

  if ! pr=$(gh pr view --json number,url,state,mergeable,headRefOid 2>&1); then
    if [[ "$pr" == *"no pull requests found"* ]]; then
      echo "No pull request for this branch, so there are no checks to wait on. \`git land\` opens one."
      exit 6
    fi
    echo "$pr" >&2
    exit 1
  fi
  number=$(jq -r .number <<<"$pr")
  state=$(jq -r .state <<<"$pr")
  if [[ "$state" != OPEN ]]; then
    echo "PR #$number is $state, so there is nothing to wait on."
    exit 6
  fi

  # Mergeability is only read once the PR's head is this commit, and only believed when it repeats:
  # GitHub can report the conflict a moment after the push that resolved it.
  head=$(git rev-parse HEAD)
  if [[ "$(jq -r .headRefOid <<<"$pr")" != "$head" ]]; then
    conflicts=0
    pending="PR #$number's head hasn't reached HEAD ($head) yet, so GitHub hasn't registered the push."
  elif [[ "$(jq -r .mergeable <<<"$pr")" == CONFLICTING ]]; then
    conflicts=$((${conflicts:-0} + 1))
    if ((conflicts >= 2)); then
      echo "PR #$number has merge conflicts with its base, so GitHub won't run its pull_request checks until they are resolved, however long this waits. Use the resolve-conflicts skill to merge the base branch in, then \`git land\` and wait again."
      exit 3
    fi
    pending="PR #$number reports merge conflicts; looking once more, since GitHub can lag the push that resolved them."
  else
    conflicts=0
    checks=$(read_checks)
    total=$(jq length <<<"$checks")
    failed=$(describe "$checks" fail,cancel)
    if [[ -n "$failed" ]]; then
      printf 'Checks failed on PR #%s:\n%s\n' "$number" "$failed"
      durations
      echo "Read the failure (\`gh run view <run-id> --log-failed\`; the debug-gha skill covers it), fix it, and land again."
      exit 1
    fi
    if [[ "$total" == 0 ]]; then
      if ((elapsed >= grace)); then
        echo "No checks registered on PR #$number after ${elapsed}s. The repo may run no CI for this change (path filters, or no workflows at all); \`gh run list --branch $(git branch --show-current)\` says whether anything ran."
        exit 5
      fi
      pending="No checks have registered on PR #$number yet."
    else
      still=$(describe "$checks" pending)
      if [[ -z "$still" ]]; then
        echo "All $total checks passed on PR #$number."
        durations
        exit 0
      fi
      pending=$(printf 'Still pending on PR #%s:\n%s' "$number" "$still")
    fi
  fi

  if ((elapsed >= timeout)); then
    printf '%s\n' "$pending"
    durations
    echo "Stopped waiting after $((elapsed / 60))m. Look at the runs still going for anything anomalous (a job queued with no runner, a step running far longer than it usually does, an external status that never reports) with \`gh run view <run-id>\`, then run claude-wait-checks in the background again."
    exit 4
  fi
  sleep "$interval"
done
