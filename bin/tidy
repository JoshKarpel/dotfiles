#!/usr/bin/env bash
# Reclaim disk by removing what the tools installed on this machine can get back
# on their own. install.sh schedules it weekly on exe.dev VMs, and `update` runs
# it after install.sh; it is also safe to run by hand.
#
# Every step is user-level, so this never asks for a password. apt and brew are
# the two caches deliberately absent: install.sh already runs those package
# managers under sudo, and clearing their archives belongs in that phase rather
# than dragging root into this one.
#
# Nothing removed here is authoritative: the tool rebuilds, re-downloads, or
# re-installs it on next use. Most of it is a cache; the exceptions are the tool
# versions no config names any more and the server builds no editor reaches for,
# which are installed artifacts rather than cached ones. The one thing nothing
# gets back is the scratch of Claude Code sessions idle for days, which is
# working space rather than a record. What the loss costs varies from seconds
# (cargo re-extracting sources it still has archived) to a gigabyte of download
# (the browser bundles), so each step below says which it is where the answer
# isn't obvious.
#
# `set -e` is deliberately absent: one tool's prune failing, because its daemon
# isn't running or another process holds its cache, must not skip every prune
# after it.
set -uo pipefail

CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"

function have() {
  command -v "$1" > /dev/null 2>&1
}

function available_kb() {
  df -Pk "$HOME" | awk 'NR == 2 { print $4 }'
}

# Not numfmt: it is GNU-only, and macOS ships neither it nor an unprefixed
# coreutils, so the report would come out empty there.
function human_kb() {
  awk -v kb="$1" 'BEGIN {
    split("K M G T", unit)
    i = 1
    while (kb >= 1024 && i < 4) { kb /= 1024; i++ }
    printf "%.1f%s", kb, unit[i]
  }'
}

function step() {
  local label="$1"
  shift

  printf "\n\033[0;30;46m%s\033[0m\n" "$label"
  "$@" || echo "  failed, continuing" >&2
}

# uv locks its cache for the length of a command, so a long-lived `uv run` (a dev
# server, a script running as a service) holds that lock and an unbounded prune
# waits for as long as that process lives. `--force` skips the wait rather than
# the race: it deletes cached environments out from under running processes,
# which breaks them at their next import. Bound the wait and skip the prune
# instead. `timeout` is GNU-only, so macOS keeps the unbounded wait.
function prune_uv() {
  if have timeout; then
    timeout 30 uv cache prune
  else
    uv cache prune
  fi
}

# `cargo clean gc` is nightly-only as of cargo 1.97, so there is no stable
# built-in. Of the three, only registry/cache costs a re-download: registry/src
# is re-extracted from those archives, and git/checkouts re-cloned from git/db,
# which stays.
function prune_cargo() {
  rm -rf "$CARGO_HOME"/registry/{cache,src} "$CARGO_HOME"/git/checkouts
}

# Every path with the given name under the clones in ~/projects and ~/work,
# skipping the trees that cannot hold one and are slow to walk. The Rust steps
# below look through these for target directories and for the toolchain files
# that name what to keep.
#
# The bash-4 parts the script could reach for here (`mapfile`, associative
# arrays) are out: macOS runs this under its bash 3.2.
function find_in_projects() {
  local roots=() root
  for root in "$HOME/projects" "$HOME/work"; do
    [[ -d $root ]] && roots+=("$root")
  done
  ((${#roots[@]})) || return 0

  find "${roots[@]}" \( -name .git -o -name node_modules -o -name .venv \) -prune \
    -o -name "$1" -print
}

# Cargo writes into a target directory only when a build compiles something, so
# its newest entry dates the last real build; a build with nothing to do touches
# nothing. Depth 3 reaches target/<profile>/deps, which every compile writes to.
# A project untouched for three days costs one full rebuild when it is next
# edited. .rustc_info.json, cargo's cache of `rustc -vV`, is what tells cargo's
# target from any other directory named `target`. Not CACHEDIR.TAG: cargo only
# writes that into a target it creates, and maturin creates its own.
function prune_cargo_targets() {
  local dir
  while IFS= read -r dir; do
    grep -qs '"rustc_fingerprint"' "$dir/.rustc_info.json" || continue
    [[ -n $(find "$dir" -maxdepth 3 -mtime -3 -print -quit) ]] && continue

    echo "  removing $dir"
    rm -rf "$dir"
  done < <(find_in_projects target)
}

# The toolchain channels something names: mise, whose `prune` has already run,
# so what it still lists installed some tracked config wants, and every
# rust-toolchain file in a clone. A failed `mise ls` has to fail the step: read
# as an empty list, it would remove every toolchain mise installed.
function named_rust_channels() {
  if have mise; then
    mise ls rust --installed --no-header | awk '{ print $2 }' || return 1
  fi

  local file
  while IFS= read -r file; do
    if grep -q '^\[toolchain\]' "$file"; then
      sed -n 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$file"
    else
      head -n 1 "$file"
    fi
  done < <(find_in_projects 'rust-toolchain.toml'; find_in_projects 'rust-toolchain')
}

# Keep the toolchains something names, plus rustup's default, and remove the
# rest, such as a `cargo +beta` from months ago. A project that runs `cargo
# +nightly` without naming nightly anywhere is a gap to fix in that project. A
# toolchain a process is running from (rust-analyzer, a build) is kept, which
# without pgrep cannot be established, so the step fails rather than guessing.
function prune_rust_toolchains() {
  have pgrep || return 1

  local host
  host=$(rustup show | awk '/^Default host:/ { print $3 }')
  [[ -n $host ]] || return 1

  local keep
  keep=$(named_rust_channels | awk -v host="$host" 'NF { print $0 "-" host }') || return 1

  local name rest
  while read -r name rest; do
    [[ $rest == *default* ]] && continue
    grep -Fxq -- "$name" <<< "$keep" && continue
    pgrep -f "${RUSTUP_HOME:-$HOME/.rustup}/toolchains/$name/" > /dev/null 2>&1 && continue

    echo "  removing $name"
    rustup toolchain uninstall "$name"
  done < <(rustup toolchain list)
}

# Two things behind one name. `prune` drops tool versions no longer named by any
# config mise has seen, which it reads from ~/.local/state/mise/tracked-configs
# rather than from the working directory, so it prunes the same set wherever it
# runs. `cache prune` drops the separate cache of downloads and remote-version
# lookups. Only the first costs a re-download, and only if a config later names
# that version again.
function prune_mise() {
  mise prune --yes && mise cache prune
}

# The CLI downloads a server build per VS Code commit, ~650M each, into one
# directory per flavour: `servers` for Remote-SSH and `serve-web` for `code
# serve-web`. `lru.json` lists every build it has kept, not only the live ones,
# most recently used first, so membership in that list says nothing about whether
# a build will be reached for again; only its head is the build the next connect
# wants. Everything else is kept only while a process runs from it: deleting the
# tree under a live server breaks the editor session attached to it, which is not
# a cost the next connect can undo. Without pgrep there is no way to establish
# that, so the whole step fails rather than guessing.
function prune_vscode_builds() {
  local builds="$1"

  [[ -d $builds ]] || return 0
  have pgrep || return 1

  local newest
  newest=$(grep -o '"[^"]*"' "$builds/lru.json" 2> /dev/null | head -n 1 | tr -d '"')

  local dir name
  for dir in "$builds"/*/; do
    [[ -d $dir ]] || continue

    name=$(basename "$dir")
    [[ $name == "$newest" ]] && continue
    pgrep -f "$dir" > /dev/null 2>&1 && continue

    echo "  removing $name"
    rm -rf "$dir"
  done
}

function prune_vscode_servers() {
  prune_vscode_builds "$HOME/.vscode-server/cli/servers"
  prune_vscode_builds "$HOME/.vscode/cli/serve-web"
}

# Claude Code keeps a directory per session under /tmp/claude-<uid>/<project>/
# (its scratchpad and background-task output) and never removes one. A session
# goes whole once nothing in it, directories included, has been modified for
# three days, which costs a session resumed after that its scratch files.
#
# Judged per session, not per file, because a file's own times say nothing
# about whether its session is live: a venv a session built an hour ago holds
# files hardlinked from the uv cache, whose mtime is the cache copy's, and
# whose ctime moves whenever a link to the inode is added or removed anywhere.
# Building that venv does give its directories a fresh mtime, which is what
# keeps the session.
#
# Only directories named like a session ID go. Claude Code keeps other things
# beside them (bash-edit-diff/, plan/), small enough that nobody has needed to
# learn whether they are safe to age out.
function prune_claude_scratch() {
  local root="/tmp/claude-$(id -u)"
  [[ -d $root ]] || return 0

  local uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
  local session
  for session in "$root"/*/*/; do
    [[ $(basename "$session") =~ $uuid ]] || continue
    [[ -n $(find "$session" -mtime -3 -print -quit) ]] && continue

    # A container run with the scratchpad mounted writes as root, and only root
    # can remove that, so say so once rather than once per file every week.
    if [[ -n $(find "$session" ! -user "$(id -u)" -print -quit) ]]; then
      echo "  skipping ${session#"$root"/}: holds files owned by another user" >&2
      continue
    fi

    echo "  removing ${session#"$root"/}"
    rm -rf "$session"
  done
}

# Neither tool prunes to just the current revision. Playwright's `uninstall
# --all` and `npx @puppeteer/browsers clear` each remove everything, and
# puppeteer's has to fetch its CLI over the network to do it, so removing the
# directories reaches the same state without the download. The cost lands on the
# next test run, which re-fetches a browser bundle per project.
function prune_browser_bundles() {
  rm -rf "$HOME/.cache/ms-playwright" "$HOME/.cache/puppeteer"
}

before=$(available_kb)

have mise && step "Pruning mise..." prune_mise

# Hook environments for repos and revisions no longer referenced by any
# .pre-commit-config.yaml this machine has run.
have pre-commit-run && step "Collecting pre-commit garbage..." pre-commit-run gc

# After pre-commit, not before: where pre-commit-run reaches pre-commit through
# uvx, that leaves an ephemeral cached environment behind that this then
# collects.
have uv && step "Pruning uv cache..." prune_uv

have cargo && step "Pruning cargo registry..." prune_cargo

step "Removing stale cargo target directories..." prune_cargo_targets

# After mise, not before: what mise still lists installed is what its prune kept.
have rustup && step "Removing unnamed rust toolchains..." prune_rust_toolchains

# npm has no prune. `verify` is the closest thing: it garbage-collects expired
# entries and rebuilds the index, rather than emptying the cache the way
# `npm cache clean --force` does.
have npm && step "Verifying npm cache..." npm cache verify

# pip only offers the whole-cache purge; there is no unreferenced-entry prune.
have pip && step "Purging pip cache..." pip cache purge

if have go && [[ -d $(go env GOCACHE) || -d $(go env GOMODCACHE) ]]; then
  step "Cleaning go caches..." go clean -cache -testcache -fuzzcache -modcache
fi

# Not `--volumes`: a dev stack's database often lives in an anonymous volume,
# which becomes unused, and so prunable, the moment its container is stopped.
# Unlike everything else here, nothing re-downloads it.
have docker && step "Pruning docker..." docker system prune --all --force
have podman && step "Pruning podman..." podman system prune --all --force

step "Removing browser bundles..." prune_browser_bundles

step "Removing dead VS Code servers..." prune_vscode_servers

step "Removing idle Claude Code session scratch..." prune_claude_scratch

after=$(available_kb)

printf "\n\033[0;30;46mReclaimed %s\033[0m\n" "$(human_kb "$((after - before))")"
