form { display: grid; gap: 1rem; background: var(--surface); border: 1px solid var(--line);
  border-radius: 0.75rem; padding: 1rem; }
label { display: grid; gap: 0.35rem; font-weight: 600; font-size: 0.9rem; }
select, input, button { font: inherit; padding: 0.7rem 0.75rem; border-radius: 0.5rem;
  border: 1px solid var(--line); background: var(--ground); color: var(--ink); width: 100%; }
button { background: var(--accent); color: var(--accent-ink); border: none; font-weight: 600; }
details { margin-top: 1rem; }
summary { cursor: pointer; color: var(--muted); padding: 0.25rem 0; }
details[open] summary { margin-bottom: 0.5rem; }
.notice { padding: 0.75rem 1rem; border-radius: 0.5rem; margin: 0 0 1rem; overflow-wrap: anywhere;
  background: var(--ok); color: var(--ok-ink); }
