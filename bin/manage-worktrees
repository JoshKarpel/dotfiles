.notice a, .sessions a.button { display: block; margin-top: 0.6rem; text-align: center; text-decoration: none;
  padding: 0.7rem 0.75rem; border-radius: 0.5rem; background: var(--accent); color: var(--accent-ink);
  font-weight: 600; white-space: normal; }
h2 { font-size: 1rem; margin: 1.5rem 0 0.5rem; }
.sessions { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
.sessions a { display: block; padding: 0.7rem 0.9rem; border-radius: 0.5rem; background: var(--surface);
  border: 1px solid var(--line); color: var(--ink); text-decoration: none; overflow-wrap: anywhere; }
.sessions small { display: block; color: var(--muted); }
.empty { color: var(--muted); }
"""

# Off for every field naming a repository or a branch, which a phone would otherwise capitalize and correct.
VERBATIM = {"autocomplete": "off", "autocapitalize": "off", "autocorrect": "off", "spellcheck": "false"}


def notice_element(notice: Notice) -> Element:
    """NOTICE as a paragraph, with its link as a button under the text, asking htmx to replace it while it polls."""
    polling = (
        {}
        if notice.poll is None
        else {"hx-get": notice.poll, "hx-trigger": f"load delay:{int(RECHECK_EVERY.total_seconds())}s", "hx-swap": "outerHTML"}
    )
    return p(
        cls=("notice", "error" if notice.is_error else None),
        attrs={"role": "status", **polling},
        children=[notice.text, None if notice.link is None else a(attrs={"href": notice.link.href}, children=notice.link.text)],
    )


def branches_element(branches: Branches | None) -> Element:
    """The branch field's suggestions, which htmx replaces whole when the repository changes."""
    names = () if branches is None else (*branches.worktrees, *branches.without_worktree)
    return datalist(attrs={"id": "branches"}, children=[option(attrs={"value": name}) for name in names])


def sessions_element(sessions: tuple[RemoteSession, ...]) -> Element:
    """Each running Remote Control session as a link to its claude.ai page, with its status and directory under it."""
    if not sessions:
        return p(cls="empty", children="No Claude session on this box is connected to Remote Control.")
    return ul(
        cls="sessions",
        children=[
            li(
                children=a(
                    attrs={"href": session.url},
                    children=[session.name, small(children=f"{session.status} · {home_relative(session.cwd)}")],
                )
            )
            for session in sessions
        ],
    )


def page_element(
    *,
    box_name: str,
    sections: tuple[Section, ...],
    selected: Path | None,
    branches: Branches | None,
    notice: Notice | None,
    sessions: tuple[RemoteSession, ...],
    filled: Mapping[str, str],
) -> Node:
    """The page: NOTICE, the form opening a branch of SELECTED or another clone, the form cloning one, and the running SESSIONS.

    FILLED holds what was submitted when a submission is refused, so the form
    comes back as it was sent, and the clone form opens when it was the one sent.
    """
    clones = [
        optgroup(
            attrs={"label": section.title},
            children=[
                option(attrs={"value": str(clone), "selected": clone == selected}, children=clone.name)
                for clone in section.clones
            ],
        )
        for section in sections
        if section.clones
    ]
    roots = [
        option(attrs={"value": str(section.root), "selected": str(section.root) == filled.get("root")}, children=section.title)
        for section in sections
    ]
    open_form = form(
        attrs={"method": "post", "action": "/open"},
        children=[
            label(
                children=[
                    "Repository",
                    select(
                        attrs={"name": "repo", "hx-get": "/branches", "hx-include": "this", "hx-target": "#branches", "hx-swap": "outerHTML"},
                        children=clones,
                    ),
                ]
            ),
            label(
                children=[
                    "Branch",
                    input_(
                        attrs={"name": "branch", "list": "branches", "required": True, "enterkeyhint": "go", "value": filled.get("branch"), **VERBATIM}
                    ),
                ]
            ),
            branches_element(branches),
            button(children="Open with Claude"),
        ],
    )
    clone_form = details(
        attrs={"open": "repository" in filled},
        children=[
            summary(children="Clone a repository"),
            form(
                attrs={"method": "post", "action": "/clone"},
                children=[
                    label(
                        children=[
                            "Repository",
                            input_(
                                attrs={
                                    "name": "repository",
                                    "required": True,
                                    "placeholder": "OWNER/REPO or a github.com URL",
                                    "value": filled.get("repository"),
                                    **VERBATIM,
                                }
                            ),
                        ]
                    ),
                    label(children=["Into", select(attrs={"name": "root"}, children=roots)]),
                    button(children="Clone"),
                ],
            ),
        ],
    )
    return [
        DOCTYPE,
        html(
            attrs={"lang": "en"},
            children=[
                head(
                    children=[
                        meta(attrs={"charset": "utf-8"}),
                        meta(attrs={"name": "viewport", "content": "width=device-width, initial-scale=1"}),
                        title(children=f"worktrees · {box_name}"),
                        style(children=Markup(PAGE_STYLE)),
                        script(attrs={"src": HTMX_URL, "integrity": HTMX_INTEGRITY, "crossorigin": "anonymous"}),
                    ]
                ),
                body(
                    children=main(
                        children=[
                            h1(children=["Open a worktree ", small(children=f"on {box_name}")]),
                            None if notice is None else notice_element(notice),
                            open_form,
                            clone_form,
                            h2(children="Remote Control sessions"),
                            sessions_element(sessions),
                        ]
                    )
                ),
            ],
        ),
    ]


def html_response(status: int, node: Node) -> Response:
    """NODE rendered as the response, never cached, since every page reflects the box as it is now."""
    return Response.from_content(status, html_content(render(node)), headers=((b"cache-control", b"no-store"),))


def redirect(location: str, *headers: tuple[bytes, bytes]) -> Response:
    """A See Other to LOCATION, so reloading the page a submission led to does not submit it again."""
    return Response(status=HTTPStatus.SEE_OTHER, headers=((b"location", location.encode()), *headers))


def remember(clone: Path) -> tuple[bytes, bytes]:
    """The Set-Cookie header that has the next page load select CLONE."""
    return (
        b"set-cookie",
        f"{REMEMBERED_COOKIE}={quote(str(clone), safe='')}; Path=/; Max-Age={int(REMEMBER_FOR.total_seconds())}; "
        "SameSite=Lax; HttpOnly; Secure".encode(),
    )


def remembered_clone(cookie_headers: tuple[bytes, ...]) -> str:
    """The clone the cookie `remember` set names, or nothing."""
    jar = SimpleCookie()
    for header in cookie_headers:
        jar.load(header.decode(errors="replace"))
    return unquote(morsel.value) if (morsel := jar.get(REMEMBERED_COOKIE)) is not None else ""


def lowercase_headers(scope: HttpScope) -> dict[str, str]:
    """SCOPE's headers keyed in lowercase, as `same_origin` reads them."""
    return {name.decode().lower(): value.decode(errors="replace") for name, value in scope.headers}


async def page_response(
    box: Box,
    status: int,
    *,
    sections: tuple[Section, ...],
    sessions: tuple[RemoteSession, ...],
    notice: Notice | None,
    filled: Mapping[str, str],
) -> Response:
    """The page, with FILLED's repo selected, or the first clone listed, and that clone's branches suggested."""
    selected = listed_clone(sections, filled.get("repo", "")) or next(
        (clone for section in sections for clone in section.clones), None
    )
    branches = None if selected is None else await asyncio.to_thread(box.read_branches, selected)
    return html_response(
        status,
        page_element(
            box_name=box.name,
            sections=sections,
            selected=selected,
            branches=branches,
            notice=notice,
            sessions=sessions,
            filled=filled,
        ),
    )


async def refused(box: Box, status: int, message: str, sections: tuple[Section, ...], filled: Mapping[str, str]) -> Response:
    """The page again under MESSAGE as an error, with the refused submission's fields as they were sent."""
    sessions = await asyncio.to_thread(box.read_sessions)
    return await page_response(
        box, status, sections=sections, sessions=sessions, notice=Notice(message, is_error=True), filled=filled
    )


TEXT_SCHEMA: Mapping[str, object] = {"type": "string"}
opened_query = query_param("opened", optional(str), schema=TEXT_SCHEMA)
cloned_query = query_param("cloned", optional(str), schema=TEXT_SCHEMA)
name_query = query_param("name", once(str), schema=TEXT_SCHEMA, required=True)
# A count the page itself wrote; one that is not a count starts again from none.
checks_query = query_param("checks", optional(lambda text: int(text) if text.isdigit() else 0), schema={"type": "integer"})
repo_query = query_param("repo", optional(str), schema=TEXT_SCHEMA)
cookie_headers = header_param("cookie", lambda values: values, schema=TEXT_SCHEMA)
form_body = body_extractor(form_fields, schema={"type": "object"}, media_type="application/x-www-form-urlencoded")


@get("/", opened_query, cloned_query, cookie_headers)
async def show_page(box: Box, opened: str | None, cloned: str | None, cookies: tuple[bytes, ...]) -> Response:
    """The page, under what was just opened or cloned when a submission led here."""
    sections, sessions = await asyncio.gather(asyncio.to_thread(box.read_sections), asyncio.to_thread(box.read_sessions))
    notice = None
    if opened:
        notice = opened_notice(opened, remote_control_url(sessions, opened), 0)
    elif cloned and (clone := listed_clone(sections, cloned)) is not None:
        notice = Notice(f"Cloned {home_relative(clone)}. Name a branch to open in it.", is_error=False)
    return await page_response(
        box, HTTPStatus.OK, sections=sections, sessions=sessions, notice=notice, filled={"repo": cloned or remembered_clone(cookies)}
    )


@get("/opened", name_query, checks_query)
async def show_opened(box: Box, name: str, checks: int | None) -> Response:
    """The notice for NAME after one more look for its session, which htmx swaps in over the last one."""
    sessions = await asyncio.to_thread(box.read_sessions)
    return html_response(HTTPStatus.OK, notice_element(opened_notice(name, remote_control_url(sessions, name), checks or 0)))


@get("/branches", repo_query)
async def show_branches(box: Box, repo: str | None) -> Response:
    """The branch suggestions for REPO, which htmx swaps in when the repository changes; none for a clone not listed."""
    sections = await asyncio.to_thread(box.read_sections)
    clone = listed_clone(sections, repo or "")
    return html_response(HTTPStatus.OK, branches_element(None if clone is None else await asyncio.to_thread(box.read_branches, clone)))


@post("/open", http_scope(), form_body)
async def open_worktree(box: Box, scope: HttpScope, fields: dict[str, str]) -> Response:
    """Run `new` with Claude as the tab's command, then go to the page that waits for it to connect."""
    async with box.changing:
        sections = await asyncio.to_thread(box.read_sections)
        match parse_opening(lowercase_headers(scope), fields, sections):
            case Rejection(status=status, message=message):
                return await refused(box, status, message, sections, fields)
            case Opening(clone=clone, branch=branch):
                if error := await box.run("manage-worktrees new", opening_command(clone, branch), NEW_TIMEOUT):
                    return await refused(box, HTTPStatus.INTERNAL_SERVER_ERROR, error, sections, fields)
                return redirect(f"/?opened={quote(tab_name(clone, branch))}", remember(clone))
            case _ as unreachable:
                assert_never(unreachable)


@post("/clone", http_scope(), form_body)
async def clone_repository(box: Box, scope: HttpScope, fields: dict[str, str]) -> Response:
    """Clone a repository with `gh repo clone`, then go to the page with the new clone selected."""
    async with box.changing:
        sections = await asyncio.to_thread(box.read_sections)
        match parse_clone_request(lowercase_headers(scope), fields, sections):
            case Rejection(status=status, message=message):
                return await refused(box, status, message, sections, fields)
            case Cloning() as cloning:
                if error := await box.run("gh repo clone", clone_command(cloning), CLONE_TIMEOUT):
                    return await refused(box, HTTPStatus.INTERNAL_SERVER_ERROR, error, sections, fields)
                return redirect(f"/?cloned={quote(str(cloning.path), safe='')}")
            case _ as unreachable:
                assert_never(unreachable)


def opening_command(clone: Path, branch: str) -> list[str]:
    """The `new` that opens BRANCH of CLONE in a tab running Claude, named for the tab, without taking focus."""
    name = tab_name(clone, branch)
    # The name goes to both flags: `--name` is what the prompt box and
    # /resume show, and `--remote-control` is what the Claude app lists.
    claude = shlex.join(["claude", "--name", name, "--remote-control", name])
    # The script's own interpreter already has its dependencies, so this skips uv entirely.
    return [sys.executable, str(Path(__file__).resolve()), "new", "--command", claude, "--no-focus", "--", str(clone), branch]


async def not_found(box: Box, scope: HttpScope) -> Response:
    """Anything but the page and what it asks for."""
    return Response.from_content(HTTPStatus.NOT_FOUND, html_content(render(p(children=f"Nothing at {scope.path}."))))


async def recover(error: Exception) -> Response | None:
    """A request whose query the page could not have written is the client's error, not the server's."""
    match error:
        case ExtractionError():
            return Response.from_content(HTTPStatus.BAD_REQUEST, html_content(render(p(children=str(error)))))
        case _:
            return None


def web_app(box: Box) -> ASGIApp:
    """The page as an ASGI app acting on BOX."""

    @asynccontextmanager
    async def lifespan() -> AsyncIterator[Box]:
        yield box

    router = Router(
        routes=(show_page, show_opened, show_branches, open_worktree, clone_repository),
        fallback=handle(http_scope(), fn=not_found),
        middleware=catching(recover),
    )
    return make_asgi_app(lifespan, http=router.dispatch)


def _selftest() -> int:
    import tempfile
    from counterweight.autopilot import typed
    from counterweight.controls import Screenshot
    from counterweight.paint import Frame
    from without_asgi import form_content
    from without_http import request
    from without_http.testing import asgi_client

    projects, work = Path("/p"), Path("/w")
    sections = (
        Section(root=projects, clones=(projects / "dotfiles", projects / "ray")),
        Section(root=work, clones=(work / "service",)),
    )
    branches = {
        projects / "dotfiles": Branches(worktrees=("fix-tabs", "wt"), without_worktree=("spike",)),
        projects / "ray": Branches(worktrees=(), without_worktree=()),
        work / "service": Branches(worktrees=("Feature",), without_worktree=()),
    }
    porcelain = (
        "worktree /p/dotfiles\nHEAD 1\nbranch refs/heads/master\n\n"
        "worktree /p/dotfiles.worktrees/feat/x\nHEAD 2\nbranch refs/heads/feat/x\n\n"
        "worktree /p/dotfiles.worktrees/gone\nHEAD 3\ndetached\n\n"
        "worktree /elsewhere/y\nHEAD 4\nbranch refs/heads/y\n"
    )

    with tempfile.TemporaryDirectory() as scratch:
        root = Path(scratch)
        for name in ("clone", "other"):
            (root / name / ".git").mkdir(parents=True)
        (root / "linked").mkdir()
        (root / "linked" / ".git").write_text("gitdir: elsewhere\n")
        (root / "clone.worktrees" / "branch").mkdir(parents=True)
        (root / "plain").mkdir()
        discovered = discover_clones(root)

    enter = KeyPressed(key=Key.Enter)
    escape = KeyPressed(key=Key.Escape)
    down = KeyPressed(key=Key.Down)

    def stepped(*inputs: InputEvent | str) -> Picking:
        """The picker after each input, a string standing for the query typed onto."""
        picking: Picking = ChoosingClone(search=EMPTY_SEARCH)
        for given in inputs:
            if isinstance(picking, Finished):
                break
            if isinstance(given, str):
                picking = queried(picking, lambda query: query + given)
            else:
                picking = step(picking, given, sections, branches) or picking
        return picking

    def opened(clone: Path, branch: str) -> Finished:
        return Finished(chosen=Opening(clone=clone, branch=branch))

    cases: list[tuple[str, bool]] = [
        ("discovery keeps only directories whose .git is a directory", discovered == (root / "clone", root / "other")),
        ("a missing root has no clones", discover_clones(Path("/nonexistent-wt-root")) == ()),
        (
            "only worktrees at <repo>.worktrees/<branch> are listed, nested branches included",
            parse_branches(porcelain, "", projects / "dotfiles").worktrees == ("feat/x",),
        ),
        (
            "branches checked out anywhere are not offered for a worktree, and the rest keep git's order",
            parse_branches(porcelain, "zeta\nmaster\nfeat/x\ny\nalpha\n", projects / "dotfiles").without_worktree
            == ("zeta", "alpha"),
        ),
        (
            "a heading appears only over a section with matches",
            clone_rows(sections, "SERV") == (Heading("~/w"), Option("service", work / "service")),
        ),
        ("an empty query lists every section", len(clone_rows(sections, "")) == 5),
        (
            "an empty query lists every worktree and branch, each under its heading, and no new branch",
            branch_rows(Branches(("wt",), ("old",)), "")
            == (Heading("worktrees"), Option("wt", "wt"), Heading("branches"), Option("old", "old")),
        ),
        ("a blank query offers no new branch", branch_rows(Branches((), ()), "  ") == ()),
        (
            "a query naming no branch is offered as a new branch, after the matches",
            branch_rows(Branches(("fix-tabs", "wt"), ("fixup",)), "fix")
            == (
                Heading("worktrees"),
                Option("fix-tabs", "fix-tabs"),
                Heading("branches"),
                Option("fixup", "fixup"),
                Option("+ new branch fix", "fix"),
            ),
        ),
        (
            "a query naming a worktree exactly is not offered as new",
            branch_rows(Branches(("wt",), ()), "wt") == (Heading("worktrees"), Option("wt", "wt")),
        ),
        (
            "a query naming a branch exactly is not offered as new",
            branch_rows(Branches((), ("old",)), "old") == (Heading("branches"), Option("old", "old")),
        ),
        (
            "Down past the worktrees skips the heading onto a branch",
            stepped(enter, down, down, enter) == opened(projects / "dotfiles", "spike"),
        ),
        ("Enter twice opens the first clone's first worktree", stepped(enter, enter) == opened(projects / "dotfiles", "fix-tabs")),
        ("Down skips the heading between sections", stepped(down, down, enter, enter) == opened(work / "service", "Feature")),
        ("Up from the first clone wraps to the last", stepped(KeyPressed(key=Key.Up), enter, enter) == opened(work / "service", "Feature")),
        (
            "typing a new name opens it as a new branch",
            stepped("ray", enter, "spike", enter) == opened(projects / "ray", "spike"),
        ),
        (
            "keys typed ahead of a step land in it, as if each had been seen",
            stepped("serv", enter, "fea", enter) == opened(work / "service", "Feature"),
        ),
        (
            "Escape from the branches goes back to the clones, query kept",
            stepped("serv", enter, escape, "i", enter, enter) == opened(work / "service", "Feature"),
        ),
        ("Escape from the clones leaves", stepped(escape) == Finished(chosen=None)),
        ("Ctrl+C leaves from the branches", stepped(enter, KeyPressed(key=Key.ControlC)) == Finished(chosen=None)),
        ("keys after finishing change nothing", stepped(escape, enter, enter) == Finished(chosen=None)),
        ("Enter with nothing matched is left to the field", step(ChoosingClone(search=Search("zz", Highlight())), enter, sections, branches) is None),
    ]

    fresh = Repository(owner="octo-org", name="new.repo_2")
    cases += [
        ("OWNER/REPO names a repository", parse_repository(" octo-org/new.repo_2 ") == fresh),
        ("an HTTPS URL names its repository", parse_repository("https://github.com/octo-org/new.repo_2.git") == fresh),
        ("an SSH URL names its repository", parse_repository("git@github.com:octo-org/new.repo_2.git") == fresh),
        ("a URL past the repository names it", parse_repository("https://github.com/octo-org/new.repo_2/tree/main") == fresh),
        ("a name without an owner names no repository", parse_repository("new.repo_2") is None),
        ("another host's URL names no repository", parse_repository("https://gitlab.com/octo-org/new.repo_2") is None),
        ("a repository of .. names none", parse_repository("octo-org/..") is None),
        ("an owner with a leading hyphen, which gh would read as a flag, names none", parse_repository("-u/new.repo_2") is None),
        ("a URL with a fragment names its repository", parse_repository("https://github.com/octo-org/new.repo_2#readme") == fresh),
        ("a URL with a query names its repository", parse_repository("https://www.github.com/octo-org/new.repo_2?tab=x") == fresh),
        (
            "a clone goes under the first root without a clone of that name",
            clone_target("someone/ray", None, sections) == Cloning(Repository("someone", "ray"), work),
        ),
        ("a clone goes under the root asked for", clone_target(" octo-org/new.repo_2 ", work, sections) == Cloning(fresh, work)),
        (
            "a clone under every root's clone of that name is refused",
            clone_target("someone/ray", None, (sections[0], Section(root=work, clones=(work / "ray",))))
            == Rejection(HTTPStatus.CONFLICT, "Every root already has a clone named ray."),
        ),
        (
            "a clone onto one already there is refused",
            clone_target("someone/ray", projects, sections) == Rejection(HTTPStatus.CONFLICT, "~/p already has a clone named ray."),
        ),
        (
            "a clone under a root not listed is refused",
            clone_target("o/r", Path("/tmp"), sections) == Rejection(HTTPStatus.BAD_REQUEST, "Clone under one of ~/p, ~/w, not /tmp."),
        ),
        (
            "a clone naming no repository is refused",
            clone_target("ray", None, sections)
            == Rejection(HTTPStatus.BAD_REQUEST, "Name the repository to clone as OWNER/REPO, or paste its github.com URL."),
        ),
        ("a clone lands under its root by the repository's name", Cloning(fresh, work).path == work / "new.repo_2"),
        (
            "gh is told where the options end, so no repository reads as a flag",
            clone_command(Cloning(fresh, work)) == ["gh", "repo", "clone", "--", "octo-org/new.repo_2", "/w/new.repo_2"],
        ),
    ]

    tabs = [
        {"tab_id": 4, "name": "● dotfiles:a", "active": True},
        {"tab_id": 9, "name": "dotfiles:b", "active": False},
        {"tab_id": 2, "name": "dotfiles:c", "active": False},
    ]

    hook = "#!/usr/bin/env bash\n# start templated\nINSTALL_PYTHON=/home/x/.venv/bin/python\nARGS=(hook-impl)\n"
    cases += [
        ("a hook's pinned interpreter is read from its INSTALL_PYTHON line", pinned_python(hook) == Path("/home/x/.venv/bin/python")),
        ("a quoted pin is unquoted", pinned_python("INSTALL_PYTHON='/a b/python'\n") == Path("/a b/python")),
        ("a hook pre-commit did not write pins nothing", pinned_python("#!/bin/sh\nmake lint\n") is None),
    ]

    cases += [
        ("tabs close with the active one last", closing_order(tabs, ["dotfiles:a", "dotfiles:b", "dotfiles:c"]) == [2, 9, 4]),
        ("a tab already closed is skipped", closing_order(tabs, ["dotfiles:b", "dotfiles:gone"]) == [9]),
    ]

    origin = {
        "origin": "https://box.exe.xyz:3002",
        "x-forwarded-proto": "https",
        "x-forwarded-host": "box.exe.xyz:3002",
    }
    form_sections = (Section(root=projects, clones=(projects / "dotfiles", projects / "ray")), Section(root=work, clones=()))
    page = render(
        page_element(
            box_name="box",
            sections=(Section(root=projects, clones=(projects / "a<b",)),),
            selected=projects / "a<b",
            branches=Branches(worktrees=("x</datalist>",), without_worktree=()),
            notice=Notice("<oops>", is_error=True),
            sessions=(),
            filled={},
        )
    )
    records = [
        {"name": "dotfiles:old", "cwd": "/w/a", "status": "idle", "startedAt": 1, "bridgeSessionId": "session_old"},
        {"name": "dotfiles:new", "cwd": "/w/b", "status": "busy", "startedAt": 2, "bridgeSessionId": "session_new"},
        {"name": "dotfiles:starting", "cwd": "/w/c", "status": "idle", "startedAt": 3},
        {"cwd": "/w/unnamed", "status": "idle", "startedAt": 0, "bridgeSessionId": "session_bare"},
    ]
    sessions = remote_sessions(records)
    cases += [
        (
            "only connected sessions are listed, newest first, an unnamed one by its directory",
            [session.name for session in sessions] == ["dotfiles:new", "dotfiles:old", "unnamed"],
        ),
        ("a session links to its claude.ai page", remote_control_url(sessions, "dotfiles:old") == "https://claude.ai/code/session_old"),
        ("a session not yet connected has no link", remote_control_url(sessions, "dotfiles:starting") is None),
        (
            "a connected session's notice links to it and stops polling",
            opened_notice("r:b", "https://claude.ai/code/s", 3)
            == Notice("Opened r:b.", is_error=False, link=Link("Open in Claude", "https://claude.ai/code/s")),
        ),
        ("while waiting, the notice polls with one more check counted", opened_notice("r:b", None, 4).poll == "/opened?name=r%3Ab&checks=5"),
        (
            "after waiting long enough, the notice stops polling and says so",
            (lambda notice: notice.is_error and notice.poll is None)(opened_notice("r:b", None, 15)),
        ),
    ]
    clients_header = "CLIENT_ID ZELLIJ_PANE_ID RUNNING_COMMAND\n"
    cases += [
        ("a client listing with only its header counts nobody attached", attached_client_count(clients_header) == 0),
        (
            "a client listing counts each client's row",
            attached_client_count(clients_header + "1 terminal_0 claude\n3 terminal_7 bash\n") == 2,
        ),
        ("an empty client listing is no answer rather than nobody attached", attached_client_count("") is None),
    ]
    cases += [
        (
            "a tab with no command opens a shell and takes focus",
            new_tab_command("r:b", Path("/w"), command=None, focus=True)
            == ["zellij", "action", "new-tab", "--name", "r:b", "--layout", "default", "--cwd", "/w"],
        ),
        (
            "a tab's command runs whole through bash, without taking focus",
            new_tab_command("r:b", Path("/w"), command="claude --name 'r:b'", focus=False)[-5:]
            == ["--no-focus", "--", "bash", "-c", "claude --name 'r:b'"],
        ),
        (
            "a submission from the page opens the clone and branch it names",
            parse_opening(origin, {"repo": "/p/ray", "branch": " feat/x "}, form_sections) == Opening(projects / "ray", "feat/x"),
        ),
        (
            "a submission from another origin is refused",
            parse_opening({**origin, "origin": "https://evil.exe.xyz"}, {"repo": "/p/ray", "branch": "x"}, form_sections)
            == Rejection(HTTPStatus.FORBIDDEN, "This page only accepts submissions from itself."),
        ),
        (
            "a submission with no Origin is refused even with no proxy headers to compare",
            isinstance(parse_opening({}, {"repo": "/p/ray", "branch": "x"}, form_sections), Rejection),
        ),
        (
            "a repo the page did not list is refused",
            parse_opening(origin, {"repo": "/etc", "branch": "x"}, form_sections)
            == Rejection(HTTPStatus.BAD_REQUEST, "That repository is not one of the clones listed."),
        ),
        (
            "a blank branch is refused",
            parse_opening(origin, {"repo": "/p/ray", "branch": "  "}, form_sections)
            == Rejection(HTTPStatus.BAD_REQUEST, "Name a branch to open."),
        ),
        (
            "a clone submission names the repository and the root",
            parse_clone_request(origin, {"repository": " https://github.com/octo-org/new.repo_2 ", "root": "/w"}, form_sections)
            == Cloning(fresh, work),
        ),
        (
            "a clone submission from another origin is refused",
            parse_clone_request({}, {"repository": "o/r", "root": "/w"}, form_sections)
            == Rejection(HTTPStatus.FORBIDDEN, "This page only accepts submissions from itself."),
        ),
        ("a repeated form field keeps its first value", form_fields(b"a=1&a=2&b=&c=x+y") == {"a": "1", "b": "", "c": "x y"}),
        ("the page escapes clone names and notices", "a&lt;b" in page and "&lt;oops&gt;" in page and "<oops>" not in page),
        ("a branch name cannot close the suggestions early", "x</datalist>" not in page and "x&lt;/datalist&gt;" in page),
        ("the remembered clone round-trips through its cookie", remembered_clone((remember(projects / "a b")[1].split(b";")[0],)) == "/p/a b"),
        ("no cookie remembers no clone", remembered_clone(()) == ""),
    ]

    async def web_cases() -> list[tuple[str, bool]]:
        """Drive the page in memory, with no socket, against a box whose reads are the fixtures above and whose commands are recorded."""
        ran: list[list[str]] = []
        failing: list[str] = []

        async def recording_run(description: str, command: list[str], timeout: timedelta) -> str | None:
            ran.append(command)
            return failing[0] if failing else None

        box = Box(
            name="box",
            read_sections=lambda: form_sections,
            read_branches=lambda clone: branches.get(clone, Branches(worktrees=(), without_worktree=())),
            read_sessions=lambda: sessions,
            run=recording_run,
            changing=asyncio.Lock(),
        )
        from_page = tuple((name.encode(), value.encode()) for name, value in origin.items())

        async def exchange(
            method: str, target: str, fields: Mapping[str, str] | None = None, headers: tuple[tuple[bytes, bytes], ...] = from_page
        ) -> tuple[int, Mapping[bytes, bytes], str]:
            async with asgi_client(web_app(box)) as client:
                async with request(
                    client, method, f"http://box{target}", headers=headers, body=b"" if fields is None else form_content(fields)
                ) as (head, content):
                    return head.status, dict(head.headers), (await content.read()).decode()

        home = await exchange("GET", "/")
        remembered = await exchange("GET", "/", headers=((b"cookie", remember(projects / "ray")[1].split(b";")[0]),))
        suggestions = await exchange("GET", "/branches?repo=%2Fp%2Fdotfiles")
        polled = await exchange("GET", "/opened?name=dotfiles%3Anew&checks=1")
        waiting = await exchange("GET", "/opened?name=r%3Ab&checks=1")
        unnamed = await exchange("GET", "/opened")
        missing = await exchange("GET", "/elsewhere")
        opened = await exchange("POST", "/open", {"repo": "/p/ray", "branch": "feat/x"})
        opened_ran = list(ran)
        forged = await exchange("POST", "/open", {"repo": "/p/ray", "branch": "x"}, headers=((b"origin", b"https://evil.example"),))
        blank = await exchange("POST", "/open", {"repo": "/p/ray", "branch": " "})
        cloned = await exchange("POST", "/clone", {"repository": "octo-org/new.repo_2", "root": "/w"})
        taken = await exchange("POST", "/clone", {"repository": "someone/ray", "root": "/p"})
        failing.append("fatal: could not read from remote")
        broken = await exchange("POST", "/clone", {"repository": "o/r", "root": "/w"})
        return [
            ("the page lists the clones, the first selected", home[0] == 200 and '<option value="/p/dotfiles" selected>' in home[2]),
            ("the page suggests the selected clone's branches", '<option value="fix-tabs">' in home[2]),
            ("the page loads htmx pinned to its hash", f'integrity="{HTMX_INTEGRITY}"' in home[2]),
            ("the page selects the clone its cookie remembers", '<option value="/p/ray" selected>' in remembered[2]),
            (
                "a repository's suggestions come back alone, for htmx to swap in",
                suggestions[2] == '<datalist id="branches"><option value="fix-tabs"></option><option value="wt"></option><option value="spike"></option></datalist>',
            ),
            ("a poll that finds the session links it, and stops", "session_new" in polled[2] and "hx-get" not in polled[2]),
            ("a poll that does not, asks again", 'hx-get="/opened?name=r%3Ab&amp;checks=2"' in waiting[2]),
            ("a poll naming nothing is the client's error", unnamed[0] == 400),
            ("anything else is not found", missing[0] == 404),
            (
                "opening runs new with Claude in the tab, then goes to the page that waits for it",
                opened[0] == 303
                and opened[1].get(b"location") == b"/?opened=ray%3Afeat/x"
                and opened_ran[0][-3:] == ["--", "/p/ray", "feat/x"]
                and "--no-focus" in opened_ran[0],
            ),
            ("opening remembers the clone", opened[1].get(b"set-cookie", b"").startswith(f"{REMEMBERED_COOKIE}=%2Fp%2Fray;".encode())),
            ("a submission from elsewhere is refused, running nothing", forged[0] == 403 and len(opened_ran) == 1),
            ("a refused submission comes back as sent", blank[0] == 400 and '<option value="/p/ray" selected>' in blank[2]),
            (
                "cloning runs gh, then goes to the page with the clone selected",
                cloned[0] == 303
                and cloned[1].get(b"location") == b"/?cloned=%2Fw%2Fnew.repo_2"
                and ran[-1 if not failing else -2] == clone_command(Cloning(fresh, work)),
            ),
            (
                "a refused clone comes back as sent, its form open",
                taken[0] == 409 and "<details open>" in taken[2] and 'value="someone/ray"' in taken[2],
            ),
            ("a clone that fails says why", broken[0] == 500 and "fatal: could not read from remote" in broken[2]),
        ]

    cases += asyncio.run(web_cases())

    def picked(
        *steps: object,
        picked_from: tuple[Section, ...] = sections,
        branches_of: Mapping[Path, Branches] = branches,
        start: Choosing = ChoosingClone(search=EMPTY_SEARCH),
    ) -> Opening | None:
        return asyncio.run(
            asyncio.wait_for(
                run_chooser(picked_from, branches_of, start, headless=True, dimensions=(50, 12), autopilot=[*steps, Quit()]),
                timeout=timedelta(seconds=30).total_seconds(),
            )
        )

    many = (Section(root=projects, clones=tuple(projects / f"clone-{index:02}" for index in range(30))),)
    frames: list[Frame] = []
    picked(*(down for _ in range(20)), Screenshot(frames.append), picked_from=many, branches_of={})
    screen = frames[0].text(ansi=False) if frames else ""

    cases += [
        ("the app hands back what was chosen", picked(*typed("ray"), enter, *typed("x"), enter) == Opening(projects / "ray", "x")),
        (
            "each step's query edits at the cursor",
            picked(*typed("ra"), KeyPressed(key=Key.Home), *typed("x"), KeyPressed(key=Key.Backspace), enter, *typed("ab"), KeyPressed(key=Key.Left), *typed("-"), enter)
            == Opening(projects / "ray", "a-b"),
        ),
        ("the app hands back nothing when left", picked(escape) is None),
        (
            "the app can start at a clone's branches, as it does after cloning one",
            picked(enter, start=ChoosingBranch(clone_search=EMPTY_SEARCH, clone=work / "service", search=EMPTY_SEARCH))
            == Opening(work / "service", "Feature"),
        ),
        ("moving past the rows shown scrolls the highlight into view", "clone-20" in screen and "clone-00" not in screen),
    ]

    failures = [name for name, passed in cases if not passed]
    for name in failures:
        print(f"FAIL: {name}", file=sys.stderr)
    print(f"manage-worktrees: {len(cases) - len(failures)}/{len(cases)} passed")
    return 1 if failures else 0


if __name__ == "__main__":
    if os.environ.get("CLAUDE_HOOK_SELFTEST"):
        sys.exit(_selftest())
    sys.exit(app())
