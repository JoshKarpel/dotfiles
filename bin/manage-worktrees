app = typer.Typer(help=__doc__)

# Where clones are looked for, each listed under its own heading. sync-branches and manage-git keep the same pair.
CLONE_ROOTS = (Path.home() / "projects", Path.home() / "work")


def worktrees_root(clone: Path) -> Path:
    """Where a clone's worktrees live: beside it, as <repo>.worktrees/.

    Beside rather than inside, so tools run in the clone (rg, pre-commit) never
    descend into them, and under the same root as the clone (~/projects,
    ~/work). sync-branches looks only for a `.git` directory one level under
    each root, which <repo>.worktrees/ has none of, so it is never mistaken for
    a clone.
    """
    return clone.with_name(f"{clone.name}.worktrees")


def tab_name(clone: Path, branch: str) -> str:
    """The tab `new` opens for a branch, which is how `done` finds it again.

    `:` cannot appear in a branch name, so the split is never ambiguous.
    """
    return f"{clone.name}:{branch}"


def find_tab(tabs: list[dict[str, Any]], name: str) -> int | None:
    """The id of the tab called NAME, with or without a status glyph in front.

    claude-tab-status renames the tab to `<glyph> <name>` as the agent works,
    so an exact match alone would miss every tab with an agent in it.
    """
    for tab in tabs:
        if tab["name"] == name or tab["name"].endswith(f" {name}"):
            return int(tab["tab_id"])
    return None


def run(
    *command: str | Path, check: bool = True, cwd: Path | None = None
) -> subprocess.CompletedProcess[str]:
    """Run COMMAND and capture its stdout, exiting with its status if it fails.

    stderr passes through, so a failure reads as the tool's own message rather
    than a traceback from here.
    """
    result = subprocess.run([str(part) for part in command], stdout=subprocess.PIPE, text=True, cwd=cwd)
    if check and result.returncode != 0:
        raise typer.Exit(result.returncode)
    return result


def git(cwd: Path, *args: str | Path, check: bool = True) -> str:
    """Run a git command against the repository at CWD and return its stdout."""
    return run("git", "-C", cwd, *args, check=check).stdout.strip()


def clone_of(path: Path) -> Path:
    """The clone a path belongs to, even when the path is one of its worktrees."""
    return Path(git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")).parent


def fail(message: str) -> typer.Exit:
    """Report MESSAGE on stderr and return the exit to raise."""
    typer.echo(f"manage-worktrees: {message}", err=True)
    return typer.Exit(1)


def new_tab_command(name: str, path: Path, *, command: str | None, focus: bool) -> list[str]:
    """The `zellij action new-tab` that opens the tab NAME at PATH, running the shell command COMMAND in it if given.

    `--layout default` names the built-in layout rather than the session's
    new_tab_template, because a resurrected session's template pins its pane to
    the session's absolute cwd, which overrides `--cwd`.

    COMMAND is the tab's own command rather than keys typed into a shell, so the
    zellij server starts it and is its parent: nothing ties it to whoever ran
    `new`, which returns as soon as the tab exists. Typing it in instead would
    need the pane's id and a wait for its shell to be ready to read.
    """
    new_tab = ["zellij", "action", "new-tab", "--name", name, "--layout", "default", "--cwd", str(path)]
    if not focus:
        new_tab.append("--no-focus")
    if command is not None:
        new_tab += ["--", "bash", "-c", command]
    return new_tab


def attached_client_count(listing: str) -> int | None:
    """How many clients `zellij action list-clients` lists, or None for an empty listing.

    The listing is a header line followed by a row per client, so a header alone
    means nobody is attached. Empty stdout is zellij's occasional exit-0 non-answer
    (the race `list_tabs` retries), and reading it as zero clients would attach a
    second client beside a real one.
    """
    lines = listing.splitlines()
    if not lines:
        return None
    return sum(1 for line in lines[1:] if line.strip())


ATTACH_WAIT = timedelta(seconds=10)


@contextmanager
def some_client_attached(session: str) -> Iterator[None]:
    """Hold a throwaway client on SESSION while nobody is attached to it, so a tab opened meanwhile survives.

    zellij 0.45 sizes a new tab from the clients viewing the session, and with
    none it is 0x0: its layout fails with "Not enough room for panes" (only in
    the zellij log), the empty tab is discarded when a client next attaches, and
    the pane's command keeps running with no tab to reach it through, holding
    every byte it writes (zellij-org/zellij#5594). A client is needed only at
    the moment of creation: the tab keeps the size this one lends it until a real
    client views it and resizes it. Remove this once a release carries the fix
    (zellij-org/zellij#5612).
    """
    for _ in range(3):
        count = attached_client_count(run("zellij", "action", "list-clients").stdout)
        if count is not None:
            break
    else:
        raise fail("zellij action list-clients printed nothing, so whether anyone is attached is unknown")
    if count:
        yield
        return

    controller, terminal = pty.openpty()
    fcntl.ioctl(terminal, termios.TIOCSWINSZ, struct.pack("HHHH", 50, 200, 0, 0))
    # `attach` refuses the session its own ZELLIJ_SESSION_NAME names, as an attempt to nest.
    environment = {
        key: value
        for key, value in os.environ.items()
        if key not in ("ZELLIJ", "ZELLIJ_SESSION_NAME", "ZELLIJ_PANE_ID")
    }
    client = subprocess.Popen(
        ["zellij", "attach", session],
        stdin=terminal,
        stdout=terminal,
        stderr=terminal,
        env=environment | {"TERM": "xterm-256color"},
        start_new_session=True,
    )
    os.close(terminal)
    # The client blocks once the pty's buffer fills with frames nobody reads.
    threading.Thread(target=drain, args=(controller,), daemon=True).start()
    try:
        deadline = time.monotonic() + ATTACH_WAIT.total_seconds()
        while not attached_client_count(run("zellij", "action", "list-clients").stdout):
            if client.poll() is not None or time.monotonic() > deadline:
                raise fail(f"a client could not attach to {session}, so a new tab there would be discarded")
            time.sleep(0.02)
        yield
    finally:
        client.terminate()
        client.wait()
        os.close(controller)


def drain(descriptor: int) -> None:
    """Read DESCRIPTOR until it closes, discarding what arrives."""
    try:
        while os.read(descriptor, 65536):
            pass
    except OSError:
        pass


@app.command()
def new(
    repo: Annotated[Path, typer.Argument(help="Any path in the clone, or in one of its worktrees.")],
    branch: Annotated[str, typer.Argument(help="Branch to work on.")],
    command: Annotated[
        str | None,
        typer.Option(
            help="Shell command the tab runs in place of a shell, through `bash -c`. When it exits, Enter runs it again and Ctrl+C closes the pane."
        ),
    ] = None,
    focus: Annotated[bool, typer.Option(help="Switch to the new tab; --no-focus leaves every client where it is.")] = True,
) -> None:
    """Open BRANCH in a worktree beside the clone, in a new zellij tab.

    The worktree lands at <repo>.worktrees/<branch>. A branch that already exists,
    locally or on origin, is checked out as it is. Any other is created from the
    default branch of the remote `git-base-remote` names, a fork's parent when
    the clone has one, with no upstream, so the first push tracks
    origin/<branch> rather than the default branch. Running this again for a
    worktree that exists opens another tab on it.

    The tab is named <repo>:<branch>, and every pane opened in it, floating
    ones included, starts in the worktree. When the clone has a pre-commit
    config and its git hook is missing, or pinned to an interpreter that is
    gone, a floating pane in the new tab installs it.

    The session is the one ZELLIJ_SESSION_NAME names, which zellij sets in each
    of its panes and `serve`'s unit sets for itself.
    """
    if not os.environ.get("ZELLIJ_SESSION_NAME"):
        raise fail("ZELLIJ_SESSION_NAME is unset, so there is no zellij session to open a tab in")

    clone = clone_of(repo)
    # git's own rules for a branch name, which also refuse `..` and a leading `-`,
    # so the name cannot climb out of <repo>.worktrees/ or read as a flag below.
    branch = git(clone, "check-ref-format", "--branch", branch)
    path = worktrees_root(clone) / branch

    if not path.exists():
        base = git(clone, "base-remote")
        git(clone, "fetch", "--quiet", "--multiple", *dict.fromkeys(("origin", base)))
        exists = any(
            run("git", "-C", clone, "rev-parse", "--verify", "--quiet", ref, check=False).returncode == 0
            for ref in (f"refs/heads/{branch}", f"refs/remotes/origin/{branch}")
        )
        if exists:
            # A branch only on origin gets a local one tracking it, by git's own DWIM.
            git(clone, "worktree", "add", path, branch)
        else:
            git(clone, "worktree", "add", "--no-track", "-b", branch, path, f"{base}/HEAD")

    with some_client_attached(os.environ["ZELLIJ_SESSION_NAME"]):
        # new-tab prints the tab's id.
        tab_id = run(*new_tab_command(tab_name(clone, branch), path, command=command, focus=focus)).stdout.strip()

    # Hooks live in the clone's git dir, shared by every worktree, so one install
    # covers them all. It runs from the clone rather than the worktree because the
    # hook pins the interpreter that installed it, and a worktree's venv is gone
    # after `manage-worktrees done`. That pin is also why a hook can go stale: one installed
    # through uvx pins a uv cache interpreter, gone after `tidy`, and one through mise pins a
    # version gone after an upgrade. A working hook is left alone, since in a
    # uv project the install goes through `uv run`, which syncs the clone's venv.
    # When one is needed it runs in a floating pane of the new tab rather than
    # here, so opening the tab never waits on it and its output lands in the tab
    # it is for; a fresh tab has no hidden floating panes for it to reveal.
    if run("is-pre-commit-project", cwd=clone, check=False).returncode == 0 and not has_working_hook(clone):
        # `zellij run` prints the pane's id, which `run` captures and nothing needs.
        run(
            "zellij", "run", "--tab-id", tab_id, "--floating", "--cwd", clone, "--name", "pre-commit install",
            "--close-on-exit", "--",
            "bash", "-c", "pre-commit-run install || read -rsn1 -p 'pre-commit install failed; press any key to close'",
        )


def pinned_python(hook: str) -> Path | None:
    """The interpreter a git hook that pre-commit installed runs, from its templated INSTALL_PYTHON line."""
    for line in hook.splitlines():
        if line.startswith("INSTALL_PYTHON="):
            return Path(shlex.split(line.removeprefix("INSTALL_PYTHON="))[0])
    return None


def has_working_hook(clone: Path) -> bool:
    """Whether CLONE has pre-commit's git hook, pinned to an interpreter that still exists."""
    hook = Path(git(clone, "rev-parse", "--path-format=absolute", "--git-path", "hooks/pre-commit"))
    if not hook.is_file():
        return False
    python = pinned_python(hook.read_text())
    return python is not None and os.access(python, os.X_OK)


@app.command()
def done(
    worktrees: Annotated[
        list[Path] | None, typer.Argument(help="The worktrees to tear down; the current directory's when none.")
    ] = None,
    delete_unmerged: Annotated[
        bool, typer.Option(help="Delete each branch even when git does not count it merged.")
    ] = False,
) -> None:
    """Remove worktrees, delete their branches if merged, and close their tabs.

    Refuses a worktree with any change, untracked files included, since removing
    it would discard them, and goes on to the rest. A branch git will not delete
    with `-d` is kept, so its commits survive the worktree, and git says why. A
    squash-merged branch is one of those, since git cannot see that its commits
    landed; manage-git passes --delete-unmerged for the branches it has found
    landed, or that were picked by hand.

    Closing a tab ends the agent running in it, and this command too when it is
    run from one of that tab's panes, so the focused tab is closed last.
    """
    closing: list[str] = []
    failed = False
    for worktree in worktrees or [Path(".")]:
        try:
            toplevel = Path(git(worktree, "rev-parse", "--show-toplevel"))
            common = Path(git(worktree, "rev-parse", "--path-format=absolute", "--git-common-dir"))
            if Path(git(worktree, "rev-parse", "--absolute-git-dir")) == common:
                raise fail(f"{toplevel} is a clone, not a linked worktree")
            clone = common.parent
            if branch := tear_down(clone, toplevel, delete_unmerged=delete_unmerged):
                closing.append(tab_name(clone, branch))
        except typer.Exit:
            failed = True
    if closing and os.environ.get("ZELLIJ"):
        close_tabs(closing)
    if failed:
        raise typer.Exit(1)


def tear_down(clone: Path, toplevel: Path, *, delete_unmerged: bool = False) -> str | None:
    """Remove the worktree at TOPLEVEL and delete its branch, returning the branch it had checked out.

    The branch is deleted only if git counts it merged, unless DELETE_UNMERGED says the caller already decided.
    Leaves its tab open, so a caller tearing down several can close them all last, together.
    """
    if git(toplevel, "status", "--porcelain"):
        run("git", "-C", toplevel, "status", "--short", check=False)
        raise fail(f"{toplevel} has changes; commit or discard them first")

    branch = git(toplevel, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)

    git(clone, "worktree", "remove", toplevel)
    typer.echo(f"removed {toplevel}")

    # A branch like feat/x nests a directory per slash, so prune the ones this
    # left empty, up to and including <repo>.worktrees/ itself.
    root = worktrees_root(clone)
    for directory in toplevel.parents:
        if not directory.is_relative_to(root):
            break
        try:
            directory.rmdir()
        except OSError:
            break

    if not branch:
        return None

    delete = "-D" if delete_unmerged else "-d"
    if run("git", "-C", clone, "branch", "--quiet", delete, branch, check=False).returncode == 0:
        typer.echo(f"deleted branch {branch}")
    else:
        typer.echo(f"kept branch {branch}")
    return branch


def close_tabs(names: list[str]) -> None:
    """Close the tabs called NAMES, the focused one last.

    From one of the focused tab's own panes, closing it ends this command, so
    every other tab has to be gone by then.
    """
    tabs = list_tabs()
    if tabs is None:
        raise fail(f"zellij listed no tabs; close {', '.join(names)} yourself")
    for tab_id in closing_order(tabs, names):
        run("zellij", "action", "close-tab-by-id", str(tab_id))


def closing_order(tabs: list[dict[str, Any]], names: list[str]) -> list[int]:
    """The ids of the tabs called NAMES that exist, the active one last."""
    found = {tab_id for name in names if (tab_id := find_tab(tabs, name)) is not None}
    active = {int(tab["tab_id"]) for tab in tabs if tab["active"]}
    return sorted(found - active) + sorted(found & active)


def list_tabs(attempts: int = 3) -> list[dict[str, Any]] | None:
    """The session's tabs, or None if zellij never answered with them.

    `list-tabs` can exit 0 having printed nothing: the CLI client stops waiting
    at whichever of the server's unblock and its output arrives first, so the
    output can lose. That race is transient, so asking again is the remedy.
    """
    for _ in range(attempts):
        stdout = run("zellij", "action", "list-tabs", "--json").stdout
        if stdout.strip():
            return json.loads(stdout)
    return None


@app.callback(invoke_without_command=True)
def pick(context: typer.Context) -> None:
    """With no command, pick a clone, then one of its worktrees, a local branch, or a new branch, and open it as `new` does.

    The local branches listed are those checked out nowhere, most recent first; picking one gives it a worktree.

    Typing narrows each list to the names containing the text, ignoring case, with one the text names
    exactly first, and Enter takes the highlighted one. Up, Down, Tab, Shift+Tab, Ctrl+N, Ctrl+P and
    Ctrl+K move the highlight, and the query edits as a shell's line does (Left, Right, Ctrl+A, Ctrl+E,
    Ctrl+W, Ctrl+U and the rest). Escape goes back from the branches to the clones, and leaves from the
    clones; Ctrl+C leaves from either.
    """
    if context.invoked_subcommand is not None:
        return
    if not os.environ.get("ZELLIJ"):
        raise fail("not inside a zellij session")

    # Read up front, all of them, so stepping the picker never waits on git; it takes milliseconds.
    sections, branches = read_clones()
    opening = asyncio.run(choose_opening(sections, branches, title="worktrees"))
    if opening is None:
        return
    typer.echo(f"opening {tab_name(opening.clone, opening.branch)}")
    new(opening.clone, opening.branch)


def read_clones() -> tuple[tuple[Section, ...], dict[Path, Branches]]:
    """Every clone under CLONE_ROOTS, a section per root, and the branches of each that `new` can open."""
    sections = tuple(Section(title=f"~/{root.name}", clones=discover_clones(root)) for root in CLONE_ROOTS)
    return sections, {clone: read_branches(clone) for section in sections for clone in section.clones}


def discover_clones(root: Path) -> tuple[Path, ...]:
    """The clones directly under ROOT, by the rule sync-branches uses: a `.git` that is a directory.

    That excludes linked worktrees, whose `.git` is a file, and <repo>.worktrees/, which has none.
    A ROOT that does not exist has no clones, since not every machine has both.
    """
    if not root.is_dir():
        return ()
    return tuple(sorted(path for path in root.iterdir() if (path / ".git").is_dir()))


@dataclass(frozen=True, slots=True)
class Branches:
    """The branches of one clone that `new` can open, in the two lists the picker shows."""

    worktrees: tuple[str, ...]
    without_worktree: tuple[str, ...]


def parse_branches(porcelain: str, heads: str, clone: Path) -> Branches:
    """CLONE's branches, from `git worktree list --porcelain` and its local branch names one per line.

    Only a worktree at <repo>.worktrees/<branch> counts, since `new` would put the branch anywhere
    else and fail. CLONE has to be the path git reports, symlinks resolved, for that to match. A
    branch checked out anywhere else, the clone itself included, is in neither list, since git
    refuses a second worktree on it. HEADS keeps its order, which is most recent first.
    """
    root = worktrees_root(clone)
    worktrees = []
    checked_out = set()
    for record in porcelain.strip().split("\n\n"):
        fields = dict(line.partition(" ")[::2] for line in record.splitlines())
        # A detached worktree has no branch line, and is nothing `new` can open by name.
        if not (branch := fields.get("branch", "").removeprefix("refs/heads/")):
            continue
        checked_out.add(branch)
        if Path(fields["worktree"]) == root / branch:
            worktrees.append(branch)
    return Branches(
        worktrees=tuple(sorted(worktrees)),
        without_worktree=tuple(head for head in heads.splitlines() if head and head not in checked_out),
    )


def read_branches(clone: Path) -> Branches:
    """The branches of CLONE that `new` can open: its worktrees' to reopen, and the local ones checked out nowhere."""
    return parse_branches(
        git(clone, "worktree", "list", "--porcelain"),
        # lstrip rather than :short, which disambiguates a branch sharing a tag's name as heads/<name>.
        git(clone, "for-each-ref", "--sort=-committerdate", "--format=%(refname:lstrip=2)", "refs/heads/"),
        clone.resolve(),
    )


@dataclass(frozen=True, slots=True)
class Section:
    """The clones under one root, listed under its heading."""

    title: str
    clones: tuple[Path, ...]


@dataclass(frozen=True, slots=True)
class Opening:
    """What the picker chose: the arguments to `new`."""

    clone: Path
    branch: str


@dataclass(frozen=True, slots=True)
class Heading:
    """A row naming the section below it, which the highlight skips."""

    title: str


@dataclass(frozen=True, slots=True)
class Option[T]:
    """A row the highlight can land on, choosing VALUE."""

    label: str
    value: T


type Row[T] = Heading | Option[T]


def clone_rows(sections: tuple[Section, ...], query: str) -> tuple[Row[Path], ...]:
    """The clones whose name contains QUERY, under the heading of each section that has any."""
    rows: list[Row[Path]] = []
    for section in sections:
        if matched := substring_matches(query, section.clones, key=lambda clone: clone.name):
            rows += [Heading(section.title), *(Option(clone.name, clone) for clone in matched)]
    return tuple(rows)


def branch_rows(branches: Branches, query: str) -> tuple[Row[str], ...]:
    """The branches containing QUERY under the heading of each list that has any, then QUERY as a new branch unless it names one."""
    rows: list[Row[str]] = []
    for title, names in (("worktrees", branches.worktrees), ("branches", branches.without_worktree)):
        if matched := substring_matches(query, names):
            rows += [Heading(title), *(Option(branch, branch) for branch in matched)]
    if (name := query.strip()) and name not in branches.worktrees and name not in branches.without_worktree:
        rows.append(Option(f"+ new branch {name}", name))
    return tuple(rows)


def options[T](rows: tuple[Row[T], ...]) -> tuple[Option[T], ...]:
    """The rows the highlight can land on."""
    return tuple(row for row in rows if isinstance(row, Option))


@dataclass(frozen=True, slots=True)
class Search:
    """A menu's query and which of its options is highlighted, counting options only."""

    query: str
    highlight: Highlight

    def edited(self, query: str) -> Search:
        """A changed query highlights its first option, since the old highlight is on a different list."""
        return self if query == self.query else Search(query=query, highlight=Highlight())


EMPTY_SEARCH = Search(query="", highlight=Highlight())


@dataclass(frozen=True, slots=True)
class Chosen[T]:
    """A menu's answer to Enter on an option."""

    value: T


@dataclass(frozen=True, slots=True)
class Back:
    """A menu's answer to Escape."""


DOWN_KEYS = frozenset({Key.Down, Key.Tab, Key.ControlN})
UP_KEYS = frozenset({Key.Up, Key.BackTab, Key.ControlP, Key.ControlK})


def navigate[T](search: Search, rows: tuple[Row[T], ...], event: InputEvent) -> Search | Chosen[T] | Back | None:
    """What a key that picks does to a menu showing ROWS for SEARCH's query, or `None` for one the query's field edits with."""
    choices = options(rows)
    match event:
        case KeyPressed(key=Key.Escape):
            return Back()
        # Enter typed ahead, before the terminal goes raw, has had its \r turned into \n (Ctrl+J) by the tty.
        case KeyPressed(key=Key.Enter | Key.ControlJ) if (index := search.highlight.index_in(choices)) is not None:
            return Chosen(choices[index].value)
        case KeyPressed(key=key) if key in DOWN_KEYS:
            return replace(search, highlight=search.highlight.moved(choices, 1))
        case KeyPressed(key=key) if key in UP_KEYS:
            return replace(search, highlight=search.highlight.moved(choices, -1))
        case _:
            return None


@dataclass(frozen=True, slots=True)
class ChoosingClone:
    """The first step."""

    search: Search


@dataclass(frozen=True, slots=True)
class ChoosingBranch:
    """The second step, holding the first step's search so Escape returns to it as it was."""

    clone_search: Search
    clone: Path
    search: Search


@dataclass(frozen=True, slots=True)
class Finished:
    """The picker is done, having chosen OPENING, or nothing if it was left."""

    opening: Opening | None


type Picking = ChoosingClone | ChoosingBranch | Finished


def step(
    picking: ChoosingClone | ChoosingBranch,
    event: InputEvent,
    sections: tuple[Section, ...],
    branches: Mapping[Path, Branches],
) -> Picking | None:
    """The picker after a key that picks rather than edits, or `None` for an event the query's field handles.

    The component steps from the latest state, so keys typed faster than the screen redraws (type-ahead
    while the picker starts, say) land as if each had been seen.
    """
    if event == KeyPressed(key=Key.ControlC):
        return Finished(opening=None)

    match picking:
        case ChoosingClone(search=search):
            match navigate(search, clone_rows(sections, search.query), event):
                case Chosen(value=clone):
                    return ChoosingBranch(clone_search=search, clone=clone, search=EMPTY_SEARCH)
                case Back():
                    return Finished(opening=None)
                case Search() as moved:
                    return ChoosingClone(search=moved)
                case None:
                    return None
                case _ as unreachable:
                    assert_never(unreachable)
        case ChoosingBranch(clone_search=clone_search, clone=clone, search=search):
            match navigate(search, branch_rows(branches[clone], search.query), event):
                case Chosen(value=branch):
                    return Finished(opening=Opening(clone=clone, branch=branch))
                case Back():
                    return ChoosingClone(search=clone_search)
                case Search() as moved:
                    return replace(picking, search=moved)
                case None:
                    return None
                case _ as unreachable:
                    assert_never(unreachable)
        case _ as unreachable:
            assert_never(unreachable)


def queried(picking: Picking, edit: Callable[[str], str]) -> Picking:
    """The picker with the current step's query edited; a finished picker has none."""
    match picking:
        case ChoosingClone(search=search):
            return ChoosingClone(search=search.edited(edit(search.query)))
        case ChoosingBranch(search=search):
            return replace(picking, search=search.edited(edit(search.query)))
        case Finished():
            return picking
        case _ as unreachable:
            assert_never(unreachable)


def query_of(picking: Picking) -> str:
    """The current step's query, or nothing once the picker is finished."""
    return "" if isinstance(picking, Finished) else picking.search.query


def trimmed(event: InputEvent) -> InputEvent:
    """A paste without the line break a copied line ends with, which the field would make a trailing space."""
    return Pasted(text=event.text.rstrip("\r\n")) if isinstance(event, Pasted) else event


def query_row(field: TextInput) -> Div:
    """The query after its prompt, with the cursor drawn over the cell it's in."""
    return Div(
        style=row | overflow_x_scroll | stick_to_end_x,
        children=(
            Text(content="> ", style=text_wrap_none | text_color("slate", 400)),
            Text(content=field.before_cursor, style=text_wrap_none),
            Text(
                content=field.at_cursor,
                handle=field.cursor_cell,
                style=text_wrap_none | text_color("slate", 900) | text_bg("sky", 300),
            ),
            Text(content=field.after_cursor, style=text_wrap_none),
        ),
    )


def view(
    picking: ChoosingClone | ChoosingBranch, sections: tuple[Section, ...], branches: Mapping[Path, Branches]
) -> tuple[str, Search, tuple[Row[object], ...]]:
    """The title, search and rows the current step shows."""
    match picking:
        case ChoosingClone(search=search):
            return "a clone", search, clone_rows(sections, search.query)
        case ChoosingBranch(clone=clone, search=search):
            return f"{clone.name}: a worktree, a branch, or type a new one", search, branch_rows(branches[clone], search.query)
        case _ as unreachable:
            assert_never(unreachable)


@component
def chooser(
    sections: tuple[Section, ...], branches: Mapping[Path, Branches], choose: Callable[[Opening], None]
) -> Div:
    def start() -> Picking:
        return ChoosingClone(search=EMPTY_SEARCH)

    picking, set_picking = use_state(start)
    row_handle, _ = use_state(ElementHandle)
    field = use_text_input(
        query_of(picking), lambda edit: query_of(set_picking(lambda latest: queried(latest, edit))), auto_focus=True
    )

    def on_input(event: InputEvent, receiver: Receiver) -> InputResponse:
        now = get_state(set_picking)
        # Keys typed ahead of the Quit, after the choice, choose nothing more.
        if isinstance(now, Finished):
            return ()
        scroll = ScrollIntoView(row_handle, block="nearest")
        match step(now, event, sections, branches):
            case None:
                if (controls := response_controls(field.on_input(trimmed(event), receiver))) is None:
                    return None
                return (*controls, scroll)
            case Finished(opening=opening) as finished:
                set_picking(finished)
                if opening is not None:
                    choose(opening)
                return Quit()
            case ChoosingClone() | ChoosingBranch() as moved:
                set_picking(moved)
                return scroll
            case _ as unreachable:
                assert_never(unreachable)

    if isinstance(picking, Finished):
        return Div(style=full)
    title, search, rows = view(picking, sections, branches)
    choices = options(rows)
    highlighted = choices[index] if (index := search.highlight.index_in(choices)) is not None else None

    def row_text(row: Row[object]) -> Text:
        match row:
            case Heading(title=heading):
                return Text(content=heading, style=text_wrap_none | text_bold | text_color("slate", 400))
            case Option(label=label) if row is highlighted:
                return Text(
                    content=f"  {label}", handle=row_handle, style=text_wrap_none | text_bold | text_color("amber", 300)
                )
            case Option(label=label):
                return Text(content=f"  {label}", style=text_wrap_none | text_color("slate", 300))
            case _ as unreachable:
                assert_never(unreachable)

    return Div(
        style=full | col | border | border_lightrounded | border_color("slate", 500) | pad_x(1),
        on_input=on_input,
        children=(
            Text(content=title, style=text_wrap_none | text_color("slate", 400)),
            query_row(field),
            Div(
                style=col | fill(1) | overflow_y_scroll,
                children=tuple(row_text(row) for row in rows)
                or (Text(content="nothing matches", style=text_color("slate", 400)),),
            ),
        ),
    )


async def choose_opening(
    sections: tuple[Section, ...], branches: Mapping[Path, Branches], **app_options: object
) -> Opening | None:
    """Run the picker until it quits, and return what it chose, if anything."""
    chosen: list[Opening] = []
    await counterweight_app(chooser(sections, branches, chosen.append), **app_options)
    return chosen[-1] if chosen else None


@app.command()
def serve(
    port: Annotated[int, typer.Option(help="Port to listen on.")] = 3002,
    host: Annotated[str, typer.Option(help="Address to bind.")] = "127.0.0.1",
) -> None:
    """Serve a web form that runs `new` with Claude as the tab's command, for opening a worktree from a phone.

    Pick a clone, name a branch, and the tab opens with Claude in it; Remote
    Control then lists that session in the Claude app as <repo>:<branch>. The
    tab opens with `--no-focus`, so whoever is looking at the session stays
    where they are.

    Meant to sit behind the exe.dev HTTPS proxy, which is private, so reaching
    the form takes an exe.dev login with access to the box: the same gate as
    VS Code on 3001, which hands the same people a terminal. A POST is refused
    unless its Origin is the page the proxy served, so a page elsewhere cannot
    submit the form with that login's cookie.

    Requests are handled one at a time, so two submits for one branch cannot
    race each other through `git worktree add`.
    """
    if not os.environ.get("ZELLIJ_SESSION_NAME"):
        raise fail("ZELLIJ_SESSION_NAME is unset, so there is no zellij session to open tabs in")
    with HTTPServer((host, port), OpeningHandler) as server:
        typer.echo(f"manage-worktrees: serving on http://{host}:{port}/ for session {os.environ['ZELLIJ_SESSION_NAME']}", err=True)
        server.serve_forever()


@dataclass(frozen=True, slots=True)
class Rejection:
    """Why a submitted form opens nothing, and the status that says so."""

    status: HTTPStatus
    message: str


def parse_opening(headers: Mapping[str, str], body: str, clones: Iterable[Path]) -> Opening | Rejection:
    """What a form submission asks `new` to open, or why it is refused.

    HEADERS are keyed in lowercase. The repo has to be one of CLONES, so the
    form can only name a clone the page offered, never an arbitrary path. The
    branch is checked by `new` itself, through git.
    """
    expected_origin = f"{headers.get('x-forwarded-proto', '')}://{headers.get('x-forwarded-host', '')}"
    if headers.get("origin") != expected_origin:
        return Rejection(HTTPStatus.FORBIDDEN, "This form only accepts submissions from its own page.")
    fields = parse_qs(body, keep_blank_values=True)
    by_path = {str(clone): clone for clone in clones}
    if (clone := by_path.get(fields.get("repo", [""])[0])) is None:
        return Rejection(HTTPStatus.BAD_REQUEST, "That repository is not one of the clones listed.")
    if not (branch := fields.get("branch", [""])[0].strip()):
        return Rejection(HTTPStatus.BAD_REQUEST, "Name a branch to open.")
    return Opening(clone=clone, branch=branch)


@dataclass(frozen=True, slots=True)
class Link:
    """A button under a notice."""

    text: str
    href: str


@dataclass(frozen=True, slots=True)
class Notice:
    """A line shown above the form: what was opened, or what went wrong, with somewhere to go next."""

    text: str
    is_error: bool
    link: Link | None = None


# Where Claude Code keeps a record per running session, named for its pid and
# removed when it exits. It is Claude Code's own bookkeeping rather than an
# interface (`claude agents --json`, the supported listing, has no Remote
# Control id), so a release can change its shape, and the page then says to
# find the session by name instead of linking it.
CLAUDE_SESSIONS = Path.home() / ".claude" / "sessions"
SESSIONS_PAGE = "https://claude.ai/code"
# How often the page looks again for the Remote Control session it opened, and for how long.
RECHECK_EVERY = timedelta(seconds=2)
RECHECK_FOR = timedelta(seconds=30)


def read_session_records(directory: Path) -> list[dict[str, object]]:
    """The records of Claude's running sessions in DIRECTORY.

    One that cannot be read is skipped: its session starting or exiting can
    catch the file mid-write or just removed.
    """
    records = []
    for path in directory.glob("*.json"):
        try:
            records.append(json.loads(path.read_text()))
        except OSError, json.JSONDecodeError:
            continue
    return records


@dataclass(frozen=True, slots=True)
class RemoteSession:
    """A running Claude that has connected to Remote Control, and its page on claude.ai."""

    name: str
    status: str
    cwd: Path
    started_at: int
    url: str


def remote_sessions(records: Iterable[Mapping[str, object]]) -> tuple[RemoteSession, ...]:
    """The sessions among RECORDS with a Remote Control page, newest first.

    One that has not connected yet has no `bridgeSessionId`, and is left out
    until it does. A session never named is listed by its directory's name.
    """
    sessions = []
    for record in records:
        if not (isinstance(bridge := record.get("bridgeSessionId"), str) and bridge):
            continue
        cwd = Path(str(record.get("cwd", "")))
        name = record.get("name")
        started_at = record.get("startedAt")
        sessions.append(
            RemoteSession(
                name=name if isinstance(name, str) and name else cwd.name,
                status=str(record.get("status", "")),
                cwd=cwd,
                started_at=started_at if isinstance(started_at, int) else 0,
                url=f"{SESSIONS_PAGE}/{quote(bridge)}",
            )
        )
    return tuple(sorted(sessions, key=lambda session: session.started_at, reverse=True))


def remote_control_url(sessions: Iterable[RemoteSession], name: str) -> str | None:
    """The claude.ai page of the session named NAME, once it has connected."""
    return next((session.url for session in sessions if session.name == name), None)


def opened_notice(name: str, url: str | None, checks: int) -> tuple[Notice, str | None]:
    """What the page says after opening NAME, and where it refreshes to, if anywhere, having looked CHECKS times."""
    if url is not None:
        return Notice(f"Opened {name}.", is_error=False, link=Link("Open in Claude", url)), None
    if checks * RECHECK_EVERY < RECHECK_FOR:
        return Notice(f"Opened {name}. Waiting for Claude to connect…", is_error=False), (
            f"/?opened={quote(name)}&checks={checks + 1}"
        )
    return (
        Notice(
            f"Opened {name}, but its Remote Control session has not shown up. Look for {name} in the Claude app.",
            is_error=True,
            link=Link("Claude Code sessions", SESSIONS_PAGE),
        ),
        None,
    )


