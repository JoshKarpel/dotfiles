# Refills the branch suggestions for the clone picked, and remembers that clone,
# since the next thing started from a phone is usually in the same repository.
PAGE_SCRIPT = """
const repo = document.getElementById("repo");
const list = document.getElementById("branches");
function suggest() {
  list.replaceChildren(...(BRANCHES[repo.value] || []).map((name) => new Option(name)));
  try { localStorage.setItem("repo", repo.value); } catch {}
}
try { const last = localStorage.getItem("repo"); if (last && last in BRANCHES) repo.value = last; } catch {}
repo.addEventListener("change", suggest);
suggest();
"""


def render_notice(notice: Notice | None) -> str:
    """NOTICE as a paragraph, with its link as a button under the text, or nothing."""
    if notice is None:
        return ""
    link = "" if notice.link is None else f'<a href="{html.escape(notice.link.href)}">{html.escape(notice.link.text)}</a>'
    return f'<p class="notice{" error" if notice.is_error else ""}" role="status">{html.escape(notice.text)}{link}</p>'


def render_sessions(sessions: tuple[RemoteSession, ...]) -> str:
    """Each running Remote Control session as a link to its claude.ai page, with its status and directory under it."""
    if not sessions:
        return '<p class="empty">No Claude session on this box is connected to Remote Control.</p>'
    home = Path.home()
    items = "".join(
        f'<li><a href="{html.escape(session.url)}">{html.escape(session.name)}'
        f"<small>{html.escape(session.status)} · "
        f"{html.escape(str('~' / session.cwd.relative_to(home)) if session.cwd.is_relative_to(home) else str(session.cwd))}"
        "</small></a></li>"
        for session in sessions
    )
    return f'<ul class="sessions">{items}</ul>'


def render_page(
    sections: tuple[Section, ...],
    branches: Mapping[Path, Branches],
    host: str,
    notice: Notice | None,
    sessions: tuple[RemoteSession, ...],
    refresh_to: str | None,
) -> str:
    """The form, listing each section's clones and suggesting each clone's branches, under NOTICE if there is one.

    The running SESSIONS follow it, and the page reloads at REFRESH_TO after a
    moment when it is waiting on one to connect.
    """
    groups = "".join(
        f'<optgroup label="{html.escape(section.title)}">'
        + "".join(f'<option value="{html.escape(str(clone))}">{html.escape(clone.name)}</option>' for clone in section.clones)
        + "</optgroup>"
        for section in sections
        if section.clones
    )
    suggestions = {
        str(clone): [*branches[clone].worktrees, *branches[clone].without_worktree] for clone in branches
    }
    # `</` would end the script element early, wherever a branch name put it.
    suggestions_json = json.dumps(suggestions).replace("</", "<\\/")
    refresh = (
        ""
        if refresh_to is None
        else f'<meta http-equiv="refresh" content="{int(RECHECK_EVERY.total_seconds())}; url={html.escape(refresh_to)}">'
    )
    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{refresh}
<title>worktrees · {html.escape(host)}</title>
<style>{PAGE_STYLE}</style>
</head>
<body>
<main>
<h1>Open a worktree <span>on {html.escape(host)}</span></h1>
{render_notice(notice)}
<form method="post" action="/open">
<label>Repository<select name="repo" id="repo">{groups}</select></label>
<label>Branch<input name="branch" list="branches" required autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="go"></label>
<datalist id="branches"></datalist>
<button>Open with Claude</button>
</form>
<h2>Remote Control sessions</h2>
{render_sessions(sessions)}
</main>
<script>const BRANCHES = {suggestions_json};{PAGE_SCRIPT}</script>
</body>
</html>
"""


class OpeningHandler(BaseHTTPRequestHandler):
    """The shell around `parse_opening` and `render_page`: reads the clones, runs `new`, and writes the response."""

    def do_GET(self) -> None:
        url = urlsplit(self.path)
        if url.path != "/":
            self.send_error(HTTPStatus.NOT_FOUND)
            return
        query = parse_qs(url.query)
        sessions = remote_sessions(read_session_records(CLAUDE_SESSIONS))
        if not (opened := query.get("opened", [""])[0]):
            self.send_page(HTTPStatus.OK, None, sessions)
            return
        checks = int(checks_text) if (checks_text := query.get("checks", ["0"])[0]).isdigit() else 0
        notice, refresh_to = opened_notice(opened, remote_control_url(sessions, opened), checks)
        self.send_page(HTTPStatus.OK, notice, sessions, refresh_to)

    def do_POST(self) -> None:
        if urlsplit(self.path).path != "/open":
            self.send_error(HTTPStatus.NOT_FOUND)
            return
        body = self.rfile.read(int(self.headers.get("Content-Length", "0"))).decode()
        headers = {key.lower(): value for key, value in self.headers.items()}
        sections, _ = read_clones()
        match parse_opening(headers, body, (clone for section in sections for clone in section.clones)):
            case Rejection(status=status, message=message):
                self.send_page(status, Notice(message, is_error=True), remote_sessions(read_session_records(CLAUDE_SESSIONS)))
            case Opening(clone=clone, branch=branch):
                name = tab_name(clone, branch)
                # The name goes to both flags: `--name` is what the prompt box and
                # /resume show, and `--remote-control` is what the Claude app lists.
                claude = shlex.join(["claude", "--name", name, "--remote-control", name])
                # The script's own interpreter already has its dependencies, so this skips uv entirely.
                result = subprocess.run(
                    [sys.executable, str(Path(__file__).resolve()), "new", "--command", claude, "--no-focus", "--", str(clone), branch],
                    capture_output=True,
                    text=True,
                    timeout=timedelta(minutes=2).total_seconds(),
                )
                if result.returncode != 0:
                    message = result.stderr.strip() or f"manage-worktrees new exited {result.returncode}"
                    self.send_page(
                        HTTPStatus.INTERNAL_SERVER_ERROR,
                        Notice(message, is_error=True),
                        remote_sessions(read_session_records(CLAUDE_SESSIONS)),
                    )
                    return
                # Post/redirect/get, so reloading the page that says it opened does not open it again.
                self.send_response(HTTPStatus.SEE_OTHER)
                self.send_header("Location", f"/?opened={quote(name)}")
                self.send_header("Content-Length", "0")
                self.end_headers()
            case _ as unreachable:
                assert_never(unreachable)

    def send_page(
        self,
        status: HTTPStatus,
        notice: Notice | None,
        sessions: tuple[RemoteSession, ...],
        refresh_to: str | None = None,
    ) -> None:
        sections, branches = read_clones()
        body = render_page(sections, branches, socket.gethostname().split(".")[0], notice, sessions, refresh_to).encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def _selftest() -> int:
    import tempfile
    from counterweight.autopilot import typed
    from counterweight.controls import Screenshot
    from counterweight.paint import Frame

    projects, work = Path("/p"), Path("/w")
    sections = (
        Section(title="~/projects", clones=(projects / "dotfiles", projects / "ray")),
        Section(title="~/work", clones=(work / "service",)),
    )
    branches = {
        projects / "dotfiles": Branches(worktrees=("fix-tabs", "wt"), without_worktree=("spike",)),
        projects / "ray": Branches(worktrees=(), without_worktree=()),
        work / "service": Branches(worktrees=("Feature",), without_worktree=()),
    }
    porcelain = (
        "worktree /p/dotfiles\nHEAD 1\nbranch refs/heads/master\n\n"
        "worktree /p/dotfiles.worktrees/feat/x\nHEAD 2\nbranch refs/heads/feat/x\n\n"
        "worktree /p/dotfiles.worktrees/gone\nHEAD 3\ndetached\n\n"
        "worktree /elsewhere/y\nHEAD 4\nbranch refs/heads/y\n"
    )

    with tempfile.TemporaryDirectory() as scratch:
        root = Path(scratch)
        for name in ("clone", "other"):
            (root / name / ".git").mkdir(parents=True)
        (root / "linked").mkdir()
        (root / "linked" / ".git").write_text("gitdir: elsewhere\n")
        (root / "clone.worktrees" / "branch").mkdir(parents=True)
        (root / "plain").mkdir()
        discovered = discover_clones(root)

    enter = KeyPressed(key=Key.Enter)
    escape = KeyPressed(key=Key.Escape)
    down = KeyPressed(key=Key.Down)

    def stepped(*inputs: InputEvent | str) -> Picking:
        """The picker after each input, a string standing for the query typed onto."""
        picking: Picking = ChoosingClone(search=EMPTY_SEARCH)
        for given in inputs:
            if isinstance(picking, Finished):
                break
            if isinstance(given, str):
                picking = queried(picking, lambda query: query + given)
            else:
                picking = step(picking, given, sections, branches) or picking
        return picking

    def opened(clone: Path, branch: str) -> Finished:
        return Finished(opening=Opening(clone=clone, branch=branch))

    cases: list[tuple[str, bool]] = [
        ("discovery keeps only directories whose .git is a directory", discovered == (root / "clone", root / "other")),
        ("a missing root has no clones", discover_clones(Path("/nonexistent-wt-root")) == ()),
        (
            "only worktrees at <repo>.worktrees/<branch> are listed, nested branches included",
            parse_branches(porcelain, "", projects / "dotfiles").worktrees == ("feat/x",),
        ),
        (
            "branches checked out anywhere are not offered for a worktree, and the rest keep git's order",
            parse_branches(porcelain, "zeta\nmaster\nfeat/x\ny\nalpha\n", projects / "dotfiles").without_worktree
            == ("zeta", "alpha"),
        ),
        (
            "a heading appears only over a section with matches",
            clone_rows(sections, "SERV") == (Heading("~/work"), Option("service", work / "service")),
        ),
        ("an empty query lists every section", len(clone_rows(sections, "")) == 5),
        (
            "an empty query lists every worktree and branch, each under its heading, and no new branch",
            branch_rows(Branches(("wt",), ("old",)), "")
            == (Heading("worktrees"), Option("wt", "wt"), Heading("branches"), Option("old", "old")),
        ),
        ("a blank query offers no new branch", branch_rows(Branches((), ()), "  ") == ()),
        (
            "a query naming no branch is offered as a new branch, after the matches",
            branch_rows(Branches(("fix-tabs", "wt"), ("fixup",)), "fix")
            == (
                Heading("worktrees"),
                Option("fix-tabs", "fix-tabs"),
                Heading("branches"),
                Option("fixup", "fixup"),
                Option("+ new branch fix", "fix"),
            ),
        ),
        (
            "a query naming a worktree exactly is not offered as new",
            branch_rows(Branches(("wt",), ()), "wt") == (Heading("worktrees"), Option("wt", "wt")),
        ),
        (
            "a query naming a branch exactly is not offered as new",
            branch_rows(Branches((), ("old",)), "old") == (Heading("branches"), Option("old", "old")),
        ),
        (
            "Down past the worktrees skips the heading onto a branch",
            stepped(enter, down, down, enter) == opened(projects / "dotfiles", "spike"),
        ),
        ("Enter twice opens the first clone's first worktree", stepped(enter, enter) == opened(projects / "dotfiles", "fix-tabs")),
        ("Down skips the heading between sections", stepped(down, down, enter, enter) == opened(work / "service", "Feature")),
        ("Up from the first clone wraps to the last", stepped(KeyPressed(key=Key.Up), enter, enter) == opened(work / "service", "Feature")),
        (
            "typing a new name opens it as a new branch",
            stepped("ray", enter, "spike", enter) == opened(projects / "ray", "spike"),
        ),
        (
            "keys typed ahead of a step land in it, as if each had been seen",
            stepped("serv", enter, "fea", enter) == opened(work / "service", "Feature"),
        ),
        (
            "Escape from the branches goes back to the clones, query kept",
            stepped("serv", enter, escape, "i", enter, enter) == opened(work / "service", "Feature"),
        ),
        ("Escape from the clones leaves", stepped(escape) == Finished(opening=None)),
        ("Ctrl+C leaves from the branches", stepped(enter, KeyPressed(key=Key.ControlC)) == Finished(opening=None)),
        ("keys after finishing change nothing", stepped(escape, enter, enter) == Finished(opening=None)),
        ("Enter with nothing matched is left to the field", step(ChoosingClone(search=Search("zz", Highlight())), enter, sections, branches) is None),
    ]

    tabs = [
        {"tab_id": 4, "name": "● dotfiles:a", "active": True},
        {"tab_id": 9, "name": "dotfiles:b", "active": False},
        {"tab_id": 2, "name": "dotfiles:c", "active": False},
    ]

    hook = "#!/usr/bin/env bash\n# start templated\nINSTALL_PYTHON=/home/x/.venv/bin/python\nARGS=(hook-impl)\n"
    cases += [
        ("a hook's pinned interpreter is read from its INSTALL_PYTHON line", pinned_python(hook) == Path("/home/x/.venv/bin/python")),
        ("a quoted pin is unquoted", pinned_python("INSTALL_PYTHON='/a b/python'\n") == Path("/a b/python")),
        ("a hook pre-commit did not write pins nothing", pinned_python("#!/bin/sh\nmake lint\n") is None),
    ]

    cases += [
        ("tabs close with the active one last", closing_order(tabs, ["dotfiles:a", "dotfiles:b", "dotfiles:c"]) == [2, 9, 4]),
        ("a tab already closed is skipped", closing_order(tabs, ["dotfiles:b", "dotfiles:gone"]) == [9]),
    ]

    origin = {
        "origin": "https://box.exe.xyz:3002",
        "x-forwarded-proto": "https",
        "x-forwarded-host": "box.exe.xyz:3002",
    }
    clones = (projects / "dotfiles", projects / "ray")
    page = render_page(
        (Section(title="~/projects", clones=(projects / "a<b",)),),
        {projects / "a<b": Branches(worktrees=("x</script>",), without_worktree=())},
        "box",
        Notice("<oops>", is_error=True),
        (),
        None,
    )
    records = [
        {"name": "dotfiles:old", "cwd": "/w/a", "status": "idle", "startedAt": 1, "bridgeSessionId": "session_old"},
        {"name": "dotfiles:new", "cwd": "/w/b", "status": "busy", "startedAt": 2, "bridgeSessionId": "session_new"},
        {"name": "dotfiles:starting", "cwd": "/w/c", "status": "idle", "startedAt": 3},
        {"cwd": "/w/unnamed", "status": "idle", "startedAt": 0, "bridgeSessionId": "session_bare"},
    ]
    sessions = remote_sessions(records)
    cases += [
        (
            "only connected sessions are listed, newest first, an unnamed one by its directory",
            [session.name for session in sessions] == ["dotfiles:new", "dotfiles:old", "unnamed"],
        ),
        ("a session links to its claude.ai page", remote_control_url(sessions, "dotfiles:old") == "https://claude.ai/code/session_old"),
        ("a session not yet connected has no link", remote_control_url(sessions, "dotfiles:starting") is None),
        (
            "a connected session's notice links to it and stops refreshing",
            opened_notice("r:b", "https://claude.ai/code/s", 3)
            == (Notice("Opened r:b.", is_error=False, link=Link("Open in Claude", "https://claude.ai/code/s")), None),
        ),
        ("while waiting, the page refreshes with one more check counted", opened_notice("r:b", None, 4)[1] == "/?opened=r%3Ab&checks=5"),
        (
            "after waiting long enough, the page stops refreshing and says so",
            (lambda notice, refresh: notice.is_error and refresh is None)(*opened_notice("r:b", None, 15)),
        ),
    ]
    clients_header = "CLIENT_ID ZELLIJ_PANE_ID RUNNING_COMMAND\n"
    cases += [
        ("a client listing with only its header counts nobody attached", attached_client_count(clients_header) == 0),
        (
            "a client listing counts each client's row",
            attached_client_count(clients_header + "1 terminal_0 claude\n3 terminal_7 bash\n") == 2,
        ),
        ("an empty client listing is no answer rather than nobody attached", attached_client_count("") is None),
    ]
    cases += [
        (
            "a tab with no command opens a shell and takes focus",
            new_tab_command("r:b", Path("/w"), command=None, focus=True)
            == ["zellij", "action", "new-tab", "--name", "r:b", "--layout", "default", "--cwd", "/w"],
        ),
        (
            "a tab's command runs whole through bash, without taking focus",
            new_tab_command("r:b", Path("/w"), command="claude --name 'r:b'", focus=False)[-5:]
            == ["--no-focus", "--", "bash", "-c", "claude --name 'r:b'"],
        ),
        (
            "a submission from the page opens the clone and branch it names",
            parse_opening(origin, "repo=%2Fp%2Fray&branch=+feat%2Fx+", clones) == Opening(projects / "ray", "feat/x"),
        ),
        (
            "a submission from another origin is refused",
            parse_opening({**origin, "origin": "https://evil.exe.xyz"}, "repo=%2Fp%2Fray&branch=x", clones)
            == Rejection(HTTPStatus.FORBIDDEN, "This form only accepts submissions from its own page."),
        ),
        (
            "a submission with no Origin is refused even with no proxy headers to compare",
            isinstance(parse_opening({}, "repo=%2Fp%2Fray&branch=x", clones), Rejection),
        ),
        (
            "a repo the page did not list is refused",
            parse_opening(origin, "repo=%2Fetc&branch=x", clones)
            == Rejection(HTTPStatus.BAD_REQUEST, "That repository is not one of the clones listed."),
        ),
        (
            "a blank branch is refused",
            parse_opening(origin, "repo=%2Fp%2Fray&branch=++", clones)
            == Rejection(HTTPStatus.BAD_REQUEST, "Name a branch to open."),
        ),
        ("the page escapes clone names and notices", "a&lt;b" in page and "&lt;oops&gt;" in page and "<oops>" not in page),
        ("a branch name cannot close the page's script early", "x</script>" not in page and "x<\\/script>" in page),
    ]

    def picked(
        *steps: object,
        picked_from: tuple[Section, ...] = sections,
        branches_of: Mapping[Path, Branches] = branches,
    ) -> Opening | None:
        return asyncio.run(
            asyncio.wait_for(
                choose_opening(picked_from, branches_of, headless=True, dimensions=(50, 12), autopilot=[*steps, Quit()]),
                timeout=timedelta(seconds=30).total_seconds(),
            )
        )

    many = (Section(title="~/projects", clones=tuple(projects / f"clone-{index:02}" for index in range(30))),)
    frames: list[Frame] = []
    picked(*(down for _ in range(20)), Screenshot(frames.append), picked_from=many, branches_of={})
    screen = frames[0].text(ansi=False) if frames else ""

    cases += [
        ("the app hands back what was chosen", picked(*typed("ray"), enter, *typed("x"), enter) == Opening(projects / "ray", "x")),
        (
            "each step's query edits at the cursor",
            picked(*typed("ra"), KeyPressed(key=Key.Home), *typed("x"), KeyPressed(key=Key.Backspace), enter, *typed("ab"), KeyPressed(key=Key.Left), *typed("-"), enter)
            == Opening(projects / "ray", "a-b"),
        ),
        ("the app hands back nothing when left", picked(escape) is None),
        ("moving past the rows shown scrolls the highlight into view", "clone-20" in screen and "clone-00" not in screen),
    ]

    failures = [name for name, passed in cases if not passed]
    for name in failures:
        print(f"FAIL: {name}", file=sys.stderr)
    print(f"manage-worktrees: {len(cases) - len(failures)}/{len(cases)} passed")
    return 1 if failures else 0


if __name__ == "__main__":
    if os.environ.get("CLAUDE_HOOK_SELFTEST"):
        sys.exit(_selftest())
    sys.exit(app())
