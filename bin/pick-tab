#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.15"
# dependencies = ["counterweight==0.2.0"]
#
# [tool.uv]
# exclude-newer = "7 days"
# exclude-newer-package = { counterweight = false, evp = false, waxy = false, without-cli = false, without-logging = false, without-streams = false }
# ///
"""
Pick a tab of the current zellij session by name and go to it.

Bound to a key in `config/zellij/config.kdl`, which runs it in place of the focused pane.
Type to narrow the tabs to those whose name contains the text, ignoring case, with one the text names exactly first,
then Enter to go to the highlighted one.
Up, Down, Tab, Shift+Tab, Ctrl+N, Ctrl+P and Ctrl+K move the highlight, the query edits as a shell's line does
(Left, Right, Ctrl+A, Ctrl+E, Ctrl+W, Ctrl+U and the rest), a digit goes straight to that tab number, so digits
never narrow, and Escape or Ctrl+C leaves without moving.

The tabs are read once, when it starts, rather than followed as they change:
following them is what made room reset the highlight whenever any tab updated (rvcas/room#28).
"""

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests (`_selftest`).
# This marker line is how `claude-hook-selftests` discovers participating scripts.

from __future__ import annotations

import asyncio
import json
import os
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass
from dataclasses import replace
from datetime import timedelta
from typing import assert_never

from counterweight import app
from counterweight.components import component
from counterweight.controls import Quit
from counterweight.controls import ScrollIntoView
from counterweight.elements import Div
from counterweight.elements import Text
from counterweight.events import InputEvent
from counterweight.events import InputResponse
from counterweight.events import KeyPressed
from counterweight.events import Pasted
from counterweight.events import Receiver
from counterweight.events import response_controls
from counterweight.focus import ElementHandle
from counterweight.headless import Highlight
from counterweight.headless import TextInput
from counterweight.headless import substring_matches
from counterweight.headless import use_text_input
from counterweight.hooks import get_state
from counterweight.hooks import use_state
from counterweight.keys import Key
from counterweight.styles import Style
from counterweight.styles.utilities import *

DOWN_KEYS = frozenset({Key.Down, Key.Tab, Key.ControlN})
UP_KEYS = frozenset({Key.Up, Key.BackTab, Key.ControlP, Key.ControlK})
LEAVE_KEYS = frozenset({Key.Escape, Key.ControlC})


@dataclass(frozen=True, slots=True)
class Tab:
    """One tab of the session, as `zellij action list-tabs --json` reports it."""

    id: int
    position: int
    name: str
    is_active: bool

    @property
    def number(self) -> int:
        """The tab's number in the tab bar, which counts from 1 where `position` counts from 0."""
        return self.position + 1


def parse_tabs(listing: str) -> tuple[Tab, ...]:
    """The tabs in `list-tabs --json` output, in tab bar order; a missing field raises rather than defaulting."""
    tabs = (
        Tab(id=tab["tab_id"], position=tab["position"], name=tab["name"], is_active=tab["active"])
        for tab in json.loads(listing)
    )
    return tuple(sorted(tabs, key=lambda tab: tab.position))


def matching(query: str, tabs: tuple[Tab, ...]) -> tuple[Tab, ...]:
    """The tabs whose name contains `query`, ignoring case, in tab bar order but for one it names exactly, first."""
    return substring_matches(query, tabs, key=lambda tab: tab.name)


def numbered(key: str, tabs: tuple[Tab, ...]) -> Tab | None:
    """The tab a digit key names by its number, whatever the query has narrowed the list to."""
    return next((tab for tab in tabs if str(tab.number) == key), None)


@dataclass(frozen=True, slots=True)
class Search:
    """The query and which of the tabs it matches is highlighted."""

    query: str
    highlight: Highlight

    def edited(self, query: str) -> Search:
        """A changed query highlights its first match, since the old highlight is on a different list."""
        return self if query == self.query else Search(query=query, highlight=Highlight())


@dataclass(frozen=True, slots=True)
class Finished:
    """The picker is done, having chosen `tab`, or nothing if it was left."""

    tab: Tab | None


type Picking = Search | Finished


def opening(tabs: tuple[Tab, ...]) -> Search:
    """An empty query, highlighting the active tab, so Enter straight away stays put."""
    return Search(query="", highlight=Highlight(key=next((tab for tab in tabs if tab.is_active), None)))


def step(search: Search, event: InputEvent, tabs: tuple[Tab, ...]) -> Picking | None:
    """
    The picker after a key that picks rather than edits, or `None` for an event the query's field handles.

    The component steps from the latest state, so keys typed faster than the screen redraws (type-ahead while the
    picker starts, say) land as if each had been seen.
    """
    shown = matching(search.query, tabs)
    match event:
        case KeyPressed(key=key) if key in LEAVE_KEYS:
            return Finished(tab=None)
        # Enter typed ahead, before the terminal goes raw, has had its \r turned into \n (Ctrl+J) by the tty.
        case KeyPressed(key=Key.Enter | Key.ControlJ) if (index := search.highlight.index_in(shown)) is not None:
            return Finished(tab=shown[index])
        case KeyPressed(key=key) if key in DOWN_KEYS:
            return replace(search, highlight=search.highlight.moved(shown, 1))
        case KeyPressed(key=key) if key in UP_KEYS:
            return replace(search, highlight=search.highlight.moved(shown, -1))
        case KeyPressed(key=key) if key.isdigit():
            return Finished(tab=tab) if (tab := numbered(key, tabs)) else search
        case _:
            return None


def for_field(event: InputEvent) -> InputEvent:
    """A paste without its digits, which never narrow, or the line break a copied line ends with."""
    if not isinstance(event, Pasted):
        return event
    return Pasted(text="".join(c for c in event.text.rstrip("\r\n") if not c.isdigit()))


def query_row(field: TextInput) -> Div:
    """The query after its prompt, with the cursor drawn over the cell it's in."""
    return Div(
        style=row | overflow_x_scroll | stick_to_end_x,
        children=(
            Text(content="> ", style=text_wrap_none | text_color("slate", 400)),
            Text(content=field.before_cursor, style=text_wrap_none),
            Text(
                content=field.at_cursor,
                handle=field.cursor_cell,
                style=text_wrap_none | text_color("slate", 900) | text_bg("sky", 300),
            ),
            Text(content=field.after_cursor, style=text_wrap_none),
        ),
    )


@component
def tab_picker(tabs: tuple[Tab, ...], choose: Callable[[Tab], None]) -> Div:
    def start() -> Picking:
        return opening(tabs)

    picking, set_picking = use_state(start)
    row_handle, _ = use_state(ElementHandle)

    def edit_query(edit: Callable[[str], str]) -> str:
        settled = set_picking(lambda latest: latest.edited(edit(latest.query)) if isinstance(latest, Search) else latest)
        return settled.query if isinstance(settled, Search) else ""

    field = use_text_input(picking.query if isinstance(picking, Search) else "", edit_query, auto_focus=True)

    def on_input(event: InputEvent, receiver: Receiver) -> InputResponse:
        now = get_state(set_picking)
        # Keys typed ahead of the Quit, after the choice, choose nothing more.
        if isinstance(now, Finished):
            return ()
        scroll = ScrollIntoView(row_handle, block="nearest")
        match step(now, event, tabs):
            case None:
                if (controls := response_controls(field.on_input(for_field(event), receiver))) is None:
                    return None
                return (*controls, scroll)
            case Finished(tab=tab) as finished:
                set_picking(finished)
                if tab is not None:
                    choose(tab)
                return Quit()
            case Search() as moved:
                set_picking(moved)
                return scroll
            case _ as unreachable:
                assert_never(unreachable)

    match picking:
        case Finished():
            return Div(style=full)
        case Search(query=query, highlight=highlight):
            shown = matching(query, tabs)
            highlighted = highlight.index_in(shown)
        case _ as unreachable:
            assert_never(unreachable)

    def tab_row(index: int, tab: Tab) -> Text:
        return Text(
            content=f"{tab.number:>2}  {tab.name}",
            handle=row_handle if index == highlighted else None,
            style=text_wrap_none
            | (text_bold if tab.is_active else Style())
            | (text_color("amber", 300) if index == highlighted else text_color("slate", 300)),
        )

    return Div(
        style=full | col | border | border_lightrounded | border_color("slate", 500) | pad_x(1),
        on_input=on_input,
        children=(
            query_row(field),
            Div(
                style=col | fill(1) | overflow_y_scroll,
                children=tuple(tab_row(index, tab) for index, tab in enumerate(shown))
                or (Text(content="no tab matches", style=text_color("slate", 400)),),
            ),
        ),
    )


async def pick(tabs: tuple[Tab, ...], **app_options: object) -> Tab | None:
    """Run the picker until it quits, and return the tab chosen, if any."""
    chosen: list[Tab] = []
    await app(tab_picker(tabs, chosen.append), **app_options)
    return chosen[-1] if chosen else None


def _selftest() -> int:
    from counterweight.autopilot import typed
    from counterweight.controls import Screenshot
    from counterweight.paint import Frame

    tabs = (
        Tab(id=7, position=0, name="● dotfiles", is_active=False),
        Tab(id=3, position=1, name="whats-new", is_active=True),
        Tab(id=12, position=2, name="Dotfiles:wt", is_active=False),
    )
    enter = KeyPressed(key=Key.Enter)

    def stepped(*inputs: InputEvent | str) -> Picking:
        """The picker after each input, a string standing for the query typed onto."""
        picking: Picking = opening(tabs)
        for given in inputs:
            if isinstance(picking, Finished):
                break
            picking = picking.edited(picking.query + given) if isinstance(given, str) else step(picking, given, tabs) or picking
        return picking

    cases: list[tuple[str, bool]] = [
        (
            "list-tabs output parses into tab bar order",
            parse_tabs(
                '[{"tab_id": 12, "position": 2, "name": "c", "active": false, "x": 1},'
                ' {"tab_id": 7, "position": 0, "name": "a", "active": true}]'
            )
            == (Tab(id=7, position=0, name="a", is_active=True), Tab(id=12, position=2, name="c", is_active=False)),
        ),
        ("matching ignores case", matching("DOT", tabs) == (tabs[0], tabs[2])),
        ("matching is a substring, not a subsequence", matching("dw", tabs) == ()),
        ("an empty query matches every tab", matching("", tabs) == tabs),
        ("a digit past the last tab names none", numbered("9", tabs) is None),
        ("opening highlights the active tab", opening(tabs).highlight.index_in(tabs) == 1),
        ("an unchanged query keeps its highlight", Search("d", Highlight(index=2)).edited("d") == Search("d", Highlight(index=2))),
        ("Enter straight away chooses the active tab", stepped(enter) == Finished(tab=tabs[1])),
        ("typing narrows, then Enter chooses the first match", stepped("wt", enter) == Finished(tab=tabs[2])),
        ("Down then Enter chooses the next tab", stepped(KeyPressed(key=Key.Down), enter) == Finished(tab=tabs[2])),
        (
            "Up from the top wraps to the last tab",
            stepped("dot", KeyPressed(key=Key.Up), enter) == Finished(tab=tabs[2]),
        ),
        ("a digit jumps without Enter", stepped(KeyPressed(key="1")) == Finished(tab=tabs[0])),
        ("a digit past the last tab does not narrow the query", stepped(KeyPressed(key="9"), enter) == Finished(tab=tabs[1])),
        ("Escape leaves without choosing", stepped(KeyPressed(key=Key.Escape), enter) == Finished(tab=None)),
        ("Enter with nothing matched is left to the field", step(Search("zz", Highlight()), enter, tabs) is None),
        ("a paste reaches the field without its digits or its line break", for_field(Pasted(text=":wt2\n")) == Pasted(text=":wt")),
    ]

    def picked(*steps: object, picked_from: tuple[Tab, ...] = tabs) -> Tab | None:
        return asyncio.run(
            asyncio.wait_for(
                pick(picked_from, headless=True, dimensions=(40, 10), autopilot=[*steps, Quit()]),
                timeout=timedelta(seconds=30).total_seconds(),
            )
        )

    many = tuple(Tab(id=index, position=index, name=f"tab-{index:02}", is_active=index == 0) for index in range(30))
    frames: list[Frame] = []
    picked(*(KeyPressed(key=Key.Down) for _ in range(20)), Screenshot(frames.append), picked_from=many)
    screen = frames[0].text(ansi=False) if frames else ""

    cases += [
        ("the app hands back the tab chosen", picked(*typed("wt"), enter) == tabs[2]),
        ("the query edits at the cursor", picked(*typed("w"), KeyPressed(key=Key.Home), *typed(":"), enter) == tabs[2]),
        ("the app hands back nothing when left", picked(KeyPressed(key=Key.Escape)) is None),
        ("moving past the rows shown scrolls the highlight into view", "tab-20" in screen and "tab-00" not in screen),
    ]

    failures = [name for name, passed in cases if not passed]
    for name in failures:
        print(f"FAIL: {name}", file=sys.stderr)
    print(f"pick-tab: {len(cases) - len(failures)}/{len(cases)} passed")
    return 1 if failures else 0


def list_tabs(attempts: int = 3) -> str:
    """
    `list-tabs --json` output, asking again when it comes back empty.

    `list-tabs` can exit 0 having printed nothing: the CLI client stops waiting at whichever of the server's unblock
    and its output arrives first, so the output can lose. That race is transient, so asking again is the remedy.
    """
    for _ in range(attempts):
        listing = subprocess.run(["zellij", "action", "list-tabs", "--json"], check=True, capture_output=True, text=True)
        if listing.stdout.strip():
            return listing.stdout
    raise SystemExit(f"pick-tab: zellij listed no tabs after {attempts} attempts")


def main() -> int:
    if os.environ.get("CLAUDE_HOOK_SELFTEST"):
        return _selftest()

    tab = asyncio.run(pick(parse_tabs(list_tabs()), title="tabs"))
    if tab is not None:
        subprocess.run(["zellij", "action", "go-to-tab-by-id", str(tab.id)], check=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
