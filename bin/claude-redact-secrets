#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# ///
"""PostToolUse hook: mask secrets in a tool's result before Claude sees it.

Modelled on GitHub Actions' log masking, with two ways of recognising a secret:

  known values  the value of every environment variable whose name marks it as a
                secret (ending in ``TOKEN``, ``SECRET``, ``PASSWORD``, ``API_KEY``,
                ``PRIVATE_KEY``, ...), matched exactly wherever it appears. The hook
                inherits Claude Code's environment, so this is whatever the shell
                that launched it exported.
  patterns      high-confidence token formats (GitHub, Anthropic, AWS, Slack, PEM
                private keys, ...), for secrets that were never in the environment,
                such as one a command reads out of a file or a keyring.

Every string anywhere in ``tool_response`` is masked and the response is handed
back in the same structure, because Claude Code silently discards an
``updatedToolOutput`` that doesn't match the tool's output schema. The hook emits
nothing when nothing matched, so an ordinary call pays only for the scan.

It guards against a secret reaching the model by accident, not against a command
that transforms one (``| base64``) before printing it. It also cannot cover a
failed call: ``PostToolUseFailure`` (which a Bash command exiting non-zero fires)
offers no way to replace output. The original output still reaches telemetry.

Test fixtures build their secrets at runtime rather than spelling them out, so
reading this file through a hooked Read doesn't mask its own tests.
"""

from __future__ import annotations

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests (`_selftest`).
# This marker line is how `claude-hook-selftests` discovers participating hooks.

import json
import os
import re
import sys
from collections.abc import Iterable, Mapping

MASK = "***"

# Shorter values are too likely to occur by coincidence (`true`, a port number) to
# mask wherever they appear.
MIN_KNOWN_VALUE_LENGTH = 8

# Anchored at the end of the name: `PGPASSWORD_FILE`, `GITHUB_TOKEN_PATH`, and
# `GOOGLE_APPLICATION_CREDENTIALS` hold paths to a secret, and masking a path hides
# where the secret lives without hiding the secret. `TOKENIZERS_PARALLELISM` and
# `SSH_AUTH_SOCK` fall out for the same reason.
_SECRET_NAME = re.compile(
    r"(?:TOKEN|SECRET|PASSWORD|PASSWD|APIKEY|(?:API|ACCESS|PRIVATE|SECRET)_KEY)$",
    re.IGNORECASE,
)

_PATTERNS = [
    re.compile(p, re.DOTALL)
    for p in (
        r"-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----.*?-----END (?:[A-Z0-9]+ )*PRIVATE KEY-----",
        r"\bgh[pousr]_[A-Za-z0-9]{36,}",
        r"\bgithub_pat_[A-Za-z0-9_]{40,}",
        r"\bsk-ant-[A-Za-z0-9_-]{20,}",
        r"\bsk-proj-[A-Za-z0-9_-]{20,}",
        r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b",
        r"\bxox[abposr]-[A-Za-z0-9-]{10,}",
        r"\bAIza[0-9A-Za-z_-]{35}",
        r"\b[sr]k_live_[0-9A-Za-z]{20,}",
        r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}",
    )
]


def known_values(environ: Mapping[str, str]) -> list[str]:
    """Secret values from the environment, longest first so a value containing
    another is masked whole rather than leaving its remainder visible."""
    values = {
        value
        for name, value in environ.items()
        if _SECRET_NAME.search(name) and len(value) >= MIN_KNOWN_VALUE_LENGTH
    }
    return sorted(values, key=len, reverse=True)


def mask_text(text: str, values: Iterable[str]) -> tuple[str, int]:
    """Mask every known value and pattern match in ``text``; return it with the
    number of masks applied."""
    count = 0
    for value in values:
        count += text.count(value)
        text = text.replace(value, MASK)
    for pattern in _PATTERNS:
        text, n = pattern.subn(MASK, text)
        count += n
    return text, count


def mask_response(response: object, values: list[str]) -> tuple[object, int]:
    """Mask every string inside a tool response, preserving its structure.

    Only string *values* are rewritten: keys are field names in the tool's
    output schema, and renaming one would get the whole replacement discarded.
    """
    if isinstance(response, str):
        return mask_text(response, values)
    if isinstance(response, list):
        masked = [mask_response(item, values) for item in response]
        return [item for item, _ in masked], sum(n for _, n in masked)
    if isinstance(response, dict):
        masked = {key: mask_response(item, values) for key, item in response.items()}
        return {key: item for key, (item, _) in masked.items()}, sum(
            n for _, n in masked.values()
        )
    return response, 0


def hook_output(response: object, environ: Mapping[str, str]) -> dict | None:
    """The PostToolUse decision for one tool response, or None to leave it alone."""
    masked, count = mask_response(response, known_values(environ))
    if count == 0:
        return None
    return {
        "hookSpecificOutput": {
            "hookEventName": "PostToolUse",
            "updatedToolOutput": masked,
            "additionalContext": (
                f"A hook masked {count} secret(s) in this tool result as {MASK}. "
                "The real values are unchanged wherever they came from: refer to "
                "them by environment variable or file rather than copying them, "
                f"and don't use {MASK} as text to match in an Edit."
            ),
        }
    }


def _fake(prefix: str, length: int) -> str:
    """A secret-shaped fixture assembled at runtime; see the module docstring."""
    return prefix + ("Q7x" * length)[:length]


def _selftest() -> int:
    ghp = _fake("ghp" + "_", 36)
    ant = _fake("sk-" + "ant-api03-", 40)
    aws = "AKIA" + "Q7XQ7XQ7XQ7XQ7XQ"
    pem_begin = "-----BEGIN OPENSSH " + "PRIVATE KEY-----"
    pem_end = "-----END OPENSSH " + "PRIVATE KEY-----"
    jwt = ".".join(_fake("ey" + "J", 20) for _ in range(3))
    env = {
        "MY_SERVICE_TOKEN": "hunter2-correct-horse",
        "OTHER_TOKEN": "hunter2-correct",
        "GITHUBTOKEN": "unsegmented-name-value",
        "PGPASSWORD_FILE": "/run/secrets/postgres",
        "GOOGLE_APPLICATION_CREDENTIALS": "/etc/gcloud/adc.json",
        "DB_PASSWORD": "tr0ub4dor&3xyz",
        "OPENAI_API_KEY": "plainvalue-without-prefix",
        "SHORT_TOKEN": "abc",
        "TOKENIZERS_PARALLELISM": "false-but-long-enough",
        "SSH_AUTH_SOCK": "/tmp/ssh-agent/agent.1234",
        "HOME": "/home/someone-else",
    }

    text_cases: list[tuple[str, str, str]] = [
        # (description, input, expected output)
        ("env TOKEN value", "token is hunter2-correct-horse.", f"token is {MASK}."),
        ("env PASSWORD value", "pw=tr0ub4dor&3xyz", f"pw={MASK}"),
        ("env API_KEY value", "k: plainvalue-without-prefix", f"k: {MASK}"),
        ("value repeated", "hunter2-correct-horse hunter2-correct-horse", f"{MASK} {MASK}"),
        ("value containing another is masked whole", "x hunter2-correct-horse y", f"x {MASK} y"),
        ("name without separators", "v=unsegmented-name-value", f"v={MASK}"),
        ("path to a password file left alone", "/run/secrets/postgres", "/run/secrets/postgres"),
        ("credentials path left alone", "/etc/gcloud/adc.json", "/etc/gcloud/adc.json"),
        ("short env value left alone", "abc abc", "abc abc"),
        ("non-secret name left alone", "false-but-long-enough", "false-but-long-enough"),
        ("SSH_AUTH_SOCK is not a secret", "/tmp/ssh-agent/agent.1234", "/tmp/ssh-agent/agent.1234"),
        ("HOME is not a secret", "/home/someone-else/x", "/home/someone-else/x"),
        ("GitHub token in a remote URL", f"https://x:{ghp}@github.com/o/r", f"https://x:{MASK}@github.com/o/r"),
        ("Anthropic key", f"ANTHROPIC_API_KEY={ant}\n", f"ANTHROPIC_API_KEY={MASK}\n"),
        ("AWS access key id", f"aws_access_key_id = {aws}", f"aws_access_key_id = {MASK}"),
        ("PEM block spans lines", f"a\n{pem_begin}\nAAAA\nBBBB\n{pem_end}\nb", f"a\n{MASK}\nb"),
        ("JWT", f"Bearer {jwt}", f"Bearer {MASK}"),
        ("token prefix alone is not a token", "the ghp" + "_ prefix", "the ghp" + "_ prefix"),
        ("nothing secret", "hello world", "hello world"),
    ]

    failures = 0
    values = known_values(env)
    for description, given, want in text_cases:
        got, _ = mask_text(given, values)
        if got != want:
            failures += 1
            print(f"FAIL {description}: want {want!r} got {got!r}")

    bash = {"stdout": f"t={ghp}\n", "stderr": "", "interrupted": False, "isImage": False}
    out = hook_output(bash, env)
    want_bash = {"stdout": f"t={MASK}\n", "stderr": "", "interrupted": False, "isImage": False}
    if out is None or out["hookSpecificOutput"]["updatedToolOutput"] != want_bash:
        failures += 1
        print(f"FAIL Bash response keeps its shape with stdout masked: got {out!r}")

    read = {"type": "text", "file": {"filePath": "/r/.env", "content": "X=tr0ub4dor&3xyz", "numLines": 1}}
    out = hook_output(read, env)
    want_read = {"type": "text", "file": {"filePath": "/r/.env", "content": f"X={MASK}", "numLines": 1}}
    if out is None or out["hookSpecificOutput"]["updatedToolOutput"] != want_read:
        failures += 1
        print(f"FAIL nested Read response masked in place: got {out!r}")

    mcp = [{"type": "text", "text": "hunter2-correct-horse"}]
    out = hook_output(mcp, env)
    if out is None or out["hookSpecificOutput"]["updatedToolOutput"] != [{"type": "text", "text": MASK}]:
        failures += 1
        print(f"FAIL list-shaped MCP response masked: got {out!r}")

    if hook_output({"stdout": "hello", "stderr": "", "interrupted": False}, env) is not None:
        failures += 1
        print("FAIL a clean response emits no decision")

    if not failures:
        print("claude-redact-secrets: all self-tests passed")
    return 1 if failures else 0


def main() -> int:
    if os.environ.get("CLAUDE_HOOK_SELFTEST"):
        return _selftest()
    data = json.load(sys.stdin)
    output = hook_output(data.get("tool_response"), os.environ)
    if output is not None:
        json.dump(output, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
