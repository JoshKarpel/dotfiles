#!/usr/bin/env bash
# Stop hook orchestrator: run the blocking checks in sequence, then announce the stop
# only if none blocked, so an announcement means Claude is actually stopping rather
# than retrying after a block. (Hooks within a single Stop group run in parallel, so a
# separate announcing hook can't know whether a sibling is about to block this attempt.)

set -uo pipefail

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests. This marker
# line is how `claude-hook-selftests` discovers participating hooks. This hook decides
# what happens at stop time (announce immediately, defer while an agent runs, run a check
# that blocks, propagate a check's error, or announce after every check passes) from
# branches real Claude output
# never exercises directly; run these with `CLAUDE_HOOK_SELFTEST=1 claude-stop`.
if [[ -n "${CLAUDE_HOOK_SELFTEST:-}" ]]; then
  SELF=$(realpath "$0")
  fails=0
  stubs=$(realpath "$(mktemp -d)")
  trap 'rm -rf "$stubs"' EXIT

  # Fixed stub scripts, driven by env vars set per-call in t(), so no test's expected
  # JSON output has to survive being spliced into a generated script's own quoting.
  cat >"$stubs/claude-sound" <<'EOF'
#!/bin/sh
: > "$STUB_DIR/sound.called"
exit 0
EOF
  cat >"$stubs/claude-tab-status" <<'EOF'
#!/bin/sh
cat >/dev/null
: > "$STUB_DIR/tab-$1.called"
exit 0
EOF
  cat >"$stubs/claude-stop-precommit" <<'EOF'
#!/bin/sh
cat >/dev/null
: > "$STUB_DIR/precommit.called"
printf '%s' "$STUB_PRECOMMIT_OUT"
exit "$STUB_PRECOMMIT_EXIT"
EOF
  cat >"$stubs/claude-stop-finish" <<'EOF'
#!/bin/sh
cat >/dev/null
: > "$STUB_DIR/finish.called"
printf '%s' "$STUB_FINISH_OUT"
exit "$STUB_FINISH_EXIT"
EOF
  cat >"$stubs/claude-stop-plan-artifact" <<'EOF'
#!/bin/sh
cat >/dev/null
: > "$STUB_DIR/plan.called"
printf '%s' "$STUB_PLAN_OUT"
exit 0
EOF
  chmod +x "$stubs"/claude-sound "$stubs"/claude-tab-status "$stubs"/claude-stop-precommit "$stubs"/claude-stop-finish \
    "$stubs"/claude-stop-plan-artifact

  t() {
    local desc="$1" precommit_exit="$2" precommit_out="$3" finish_exit="$4" finish_out="$5"
    local message="$6" want_exit="$7" want_out="$8" want_called="$9" plan_out="${10:-}"

    rm -f "$stubs"/*.called
    local out exit_code=0
    out=$(env STUB_DIR="$stubs" \
        STUB_PRECOMMIT_EXIT="$precommit_exit" STUB_PRECOMMIT_OUT="$precommit_out" \
        STUB_FINISH_EXIT="$finish_exit" STUB_FINISH_OUT="$finish_out" STUB_PLAN_OUT="$plan_out" \
      PATH="$stubs:$PATH" CLAUDE_HOOK_SELFTEST= "$SELF" <<<"$message" 2>&1) || exit_code=$?

    local got=""
    [[ -e "$stubs/precommit.called" ]] && got+="${got:+,}precommit"
    [[ -e "$stubs/finish.called" ]] && got+="${got:+,}finish"
    [[ -e "$stubs/plan.called" ]] && got+="${got:+,}plan"
    [[ -e "$stubs/sound.called" ]] && got+="${got:+,}sound"
    [[ -e "$stubs/tab-paused.called" ]] && got+="${got:+,}tab-paused"
    [[ -e "$stubs/tab-finished.called" ]] && got+="${got:+,}tab-finished"

    [[ "$exit_code" == "$want_exit" ]] ||
    { printf 'FAIL %s: want_exit=%s got_exit=%s :: %s\n' "$desc" "$want_exit" "$exit_code" "$out"; fails=1; }
    [[ "$out" == "$want_out" ]] ||
    { printf 'FAIL %s: want_out=%q got_out=%q\n' "$desc" "$want_out" "$out"; fails=1; }
    [[ "$got" == "$want_called" ]] ||
    { printf 'FAIL %s: want_called=%s got_called=%s\n' "$desc" "$want_called" "${got:-none}"; fails=1; }
  }

  # --- a question hands control back to the user: announce, never run the checks ---
  t "question hand-back" \
    0 "" 0 "" \
    '{"last_assistant_message":"Should I proceed?"}' \
    0 "" "sound,tab-finished"

  # --- a question with an agent still running hands back all the same ---
  t "question while an agent runs" \
    0 "" 0 "" \
    '{"last_assistant_message":"Should I proceed?","background_tasks":[{"type":"subagent","status":"running"}]}' \
    0 "" "sound,tab-finished"

  # --- a running background agent: the session is paused, so no check runs and no sound plays ---
  t "running agent defers" \
    0 '{"a":1}' 0 '{"b":2}' \
    '{"last_assistant_message":"Launched.","background_tasks":[{"type":"subagent","status":"running"}]}' \
    0 "" "tab-paused"

  # --- a background shell (a Monitor, a build) doesn't defer, or a server would defer forever, but it pauses ---
  t "running shell pauses without deferring" \
    0 "" 0 "" \
    '{"last_assistant_message":"Done.","background_tasks":[{"type":"shell","status":"running"}]}' \
    0 "" "precommit,finish,plan,sound,tab-paused"

  # --- a task that has ended wakes nothing, so the stop is a finish ---
  t "ended shell finishes" \
    0 "" 0 "" \
    '{"last_assistant_message":"Done.","background_tasks":[{"type":"shell","status":"completed"}]}' \
    0 "" "precommit,finish,plan,sound,tab-finished"

  # --- a scheduled job will wake the session, so the stop is a pause ---
  t "pending cron pauses" \
    0 "" 0 "" \
    '{"last_assistant_message":"Done.","background_tasks":[],"session_crons":[{"id":"c1","recurring":false}]}' \
    0 "" "precommit,finish,plan,sound,tab-paused"

  # --- a question is your turn whatever else is pending ---
  t "question with a cron pending" \
    0 "" 0 "" \
    '{"last_assistant_message":"Should I proceed?","session_crons":[{"id":"c1","recurring":true}]}' \
    0 "" "sound,tab-finished"

  # --- no check blocks: all run in order, then announce ---
  t "nothing blocks" \
    0 "" 0 "" \
    '{"last_assistant_message":"Done."}' \
    0 "" "precommit,finish,plan,sound,tab-finished"

  # --- the first check blocks: its JSON surfaces, the second check and announce never run ---
  t "first check blocks" \
    0 '{"a":1}' 0 "" \
    '{"last_assistant_message":"Done."}' \
    0 '{"a":1}' "precommit"

  # --- the second check blocks: its JSON surfaces, announce never runs ---
  t "second check blocks" \
    0 "" 0 '{"b":2}' \
    '{"last_assistant_message":"Done."}' \
    0 '{"b":2}' "precommit,finish"

  # --- the plan check blocks last, once both others pass: its JSON surfaces, announce never runs ---
  t "plan check blocks" \
    0 "" 0 "" \
    '{"last_assistant_message":"Done."}' \
    0 '{"c":3}' "precommit,finish,plan" '{"c":3}'

  # --- a check errors outright: its exit status propagates, nothing after it runs ---
  t "a check errors" \
    3 "" 0 "" \
    '{"last_assistant_message":"Done."}' \
    3 "" "precommit"

  if [[ "$fails" == 0 ]]; then
    echo "$(basename "$0"): all self-tests passed"
  fi
  exit "$fails"
fi

INPUT=$(cat)

# Every announcement, together, so the two stop paths below can't drift apart.
announce() {
  local state="$1"
  claude-sound stop || true
  echo "$INPUT" | claude-tab-status "$state" || true
}

# Work this session started that will wake it again without you: a background shell
# or Monitor ending (a Monitor's output too), an agent reporting, a scheduled job
# firing. Ending a turn with any of it pending is a pause, not a finish. The payload
# lists a dev server as the same `shell` as a Monitor, so one started from the session
# pauses it too; dev servers run by hand, outside it, are what that trade rests on.
PENDING=$(echo "$INPUT" | jq '[.background_tasks[]? | select(.status == "running")] + [.session_crons[]?] | length')

# If Claude's last message looks like a question, it's handing control back to the user.
# Don't let any check block the stop and force it to keep working — Claude is genuinely
# stopping to await a reply, so announce it and let it stop.
LAST_MESSAGE=$(echo "$INPUT" | jq -r '.last_assistant_message // ""')
if [[ "$LAST_MESSAGE" == *"?"* ]]; then
  announce finished
  exit 0
fi

# A running background agent means the session is paused, not done: the change-set is
# half-built, and a check that blocks here sends Claude to stage or fix files the agent
# still owns. Stop fires again on the turn that delivers each agent's result, so the
# checks run, and the stop is announced, on the one after the last agent reports.
# Background shells don't count: a server running in one would defer the checks forever.
RUNNING_AGENTS=$(echo "$INPUT" | jq '[.background_tasks[]? | select(.status == "running" and (.type == "subagent" or .type == "workflow"))] | length')
if [[ "$RUNNING_AGENTS" -gt 0 ]]; then
  echo "$INPUT" | claude-tab-status paused || true
  exit 0
fi

# The plan page goes last: the finishing pass may itself edit the plan, and the page should be
# rebuilt from what the plan says once it has settled.
for check in claude-stop-precommit claude-stop-finish claude-stop-plan-artifact; do
  STDOUT=$(echo "$INPUT" | "$check")
  STATUS=$?
  if [[ $STATUS -ne 0 ]]; then
    exit "$STATUS"
  fi
  if [[ "${STDOUT:0:1}" == "{" ]]; then
    echo "$STDOUT"
    exit 0
  fi
done

if [[ "$PENDING" -gt 0 ]]; then
  announce paused
else
  announce finished
fi
exit 0
