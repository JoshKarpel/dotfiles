#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.15"
# dependencies = ["counterweight==0.2.0", "typer==0.27.3"]
#
# [tool.uv]
# exclude-newer = "7 days"
# exclude-newer-package = { counterweight = false, evp = false, waxy = false, without-cli = false, without-logging = false, without-streams = false }
# ///
"""Pick a kubectl context, kubeconfig, or namespace, and print its name.

Backs `ktx`, `kfg` and `kns` (sources/kubernetes.sh) when they are given no argument: each runs this under `$(...)`
and applies the name itself, since two of them export KUBECONFIG, which no child of the shell can do. The picker
draws below the prompt on the terminal, as fzf does, and erases itself when it stops; only the name goes to stdout,
so leaving prints nothing and exits 1.

The current one is starred and highlighted when the picker opens, so Enter straight away keeps it. Type to narrow
the names to those containing the text, ignoring case, with one the text names exactly first, then Enter to take
the highlighted one. Up, Down, Tab, Shift+Tab, Ctrl+N, Ctrl+P and Ctrl+K move the highlight, the query edits as a
shell's line does (Left, Right, Ctrl+A, Ctrl+E, Ctrl+W, Ctrl+U and the rest), and Escape or Ctrl+C leaves.
"""

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests (`_selftest`).
# This marker line is how `claude-hook-selftests` discovers participating scripts.

from __future__ import annotations

import asyncio
import os
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass
from dataclasses import replace
from datetime import timedelta
from pathlib import Path
from typing import assert_never

import typer
from counterweight import Inline
from counterweight import app as counterweight_app
from counterweight.components import component
from counterweight.controls import Quit
from counterweight.controls import ScrollIntoView
from counterweight.elements import Div
from counterweight.elements import Text
from counterweight.events import InputEvent
from counterweight.events import InputResponse
from counterweight.events import KeyPressed
from counterweight.events import Pasted
from counterweight.events import Receiver
from counterweight.events import response_controls
from counterweight.focus import ElementHandle
from counterweight.headless import Highlight
from counterweight.headless import TextInput
from counterweight.headless import substring_matches
from counterweight.headless import use_text_input
from counterweight.hooks import get_state
from counterweight.hooks import use_state
from counterweight.keys import Key
from counterweight.styles import Style
from counterweight.styles.utilities import *

app = typer.Typer(help=__doc__)

KUBE_DIR = Path.home() / ".kube"
# Long enough for a cluster behind a VPN, short enough that an unreachable one says so instead of hanging.
REQUEST_TIMEOUT = timedelta(seconds=10)
# The most names shown at once; the list scrolls past them, and shrinks to fit a shorter terminal.
SHOWN_ROWS = 12

DOWN_KEYS = frozenset({Key.Down, Key.Tab, Key.ControlN})
UP_KEYS = frozenset({Key.Up, Key.BackTab, Key.ControlP, Key.ControlK})
LEAVE_KEYS = frozenset({Key.Escape, Key.ControlC})


def kubectl(*args: str) -> subprocess.CompletedProcess[str]:
    """Run kubectl, capturing stdout; stderr passes through, so a failure reads as kubectl's own message."""
    return subprocess.run(["kubectl", *args], stdout=subprocess.PIPE, text=True)


def checked(result: subprocess.CompletedProcess[str]) -> str:
    """RESULT's stdout, exiting with its status if it failed."""
    if result.returncode != 0:
        raise typer.Exit(result.returncode)
    return result.stdout


@app.command()
def context() -> None:
    """Pick a context from the current KUBECONFIG, for `ktx`."""
    names = tuple(checked(kubectl("config", "get-contexts", "--output=name")).split())
    # current-context exits 1 when none is set, which is a state to show rather than a failure.
    current = kubectl("config", "current-context")
    choose("a context", names, current.stdout.strip() if current.returncode == 0 else None)


@app.command()
def config() -> None:
    """Pick a kubeconfig in ~/.kube, for `kfg`."""
    names = tuple(sorted(path.name for path in KUBE_DIR.iterdir() if path.is_file())) if KUBE_DIR.is_dir() else ()
    choose("a kubeconfig in ~/.kube", names, current_config(os.environ.get("KUBECONFIG", ""), KUBE_DIR))


@app.command()
def namespace() -> None:
    """Pick a namespace of the current context's cluster, for `kns`."""
    listing = kubectl("get", "namespaces", "--output=name", f"--request-timeout={REQUEST_TIMEOUT.seconds}s")
    names = tuple(sorted(name.removeprefix("namespace/") for name in checked(listing).split()))
    current = checked(kubectl("config", "view", "--minify", "--output=jsonpath={..namespace}")).strip()
    # A context that names no namespace uses `default`, as kubectl does.
    choose("a namespace", names, current or "default")


def current_config(kubeconfig: str, kube_dir: Path) -> str | None:
    """The name `kfg` would take for KUBECONFIG, if it is a single file directly in KUBE_DIR."""
    if not kubeconfig or os.pathsep in kubeconfig:
        return None
    path = Path(kubeconfig)
    return path.name if path.parent == kube_dir else None


def choose(prompt: str, names: tuple[str, ...], current: str | None) -> None:
    """Run the picker, then print the name chosen, or exit 1 if it was left."""
    if not names:
        typer.echo(f"pick-kube: there is no {prompt.removeprefix('a ')} to pick", err=True)
        raise typer.Exit(1)
    # Under `$(...)` stdout is a pipe, so the picker draws on the terminal itself, which is also what it's sized by.
    with open("/dev/tty", "w") as terminal:
        chosen = asyncio.run(
            pick(prompt, names, current, title="pick-kube", output_stream=terminal, viewport=Inline(keep_last_frame=False))
        )
    if chosen is None:
        raise typer.Exit(1)
    typer.echo(chosen)


@dataclass(frozen=True, slots=True)
class Search:
    """The query and which of the names it matches is highlighted."""

    query: str
    highlight: Highlight

    def edited(self, query: str) -> Search:
        """A changed query highlights its first match, since the old highlight is on a different list."""
        return self if query == self.query else Search(query=query, highlight=Highlight())


@dataclass(frozen=True, slots=True)
class Finished:
    """The picker is done, having chosen `name`, or nothing if it was left."""

    name: str | None


type Picking = Search | Finished


def opening(current: str | None) -> Search:
    """An empty query highlighting the current name, so Enter straight away keeps it."""
    return Search(query="", highlight=Highlight(key=current))


def step(search: Search, event: InputEvent, names: tuple[str, ...]) -> Picking | None:
    """
    The picker after a key that picks rather than edits, or `None` for an event the query's field handles.

    The component steps from the latest state, so keys typed faster than the screen redraws (type-ahead while kubectl
    answers, say) land as if each had been seen.
    """
    shown = substring_matches(search.query, names)
    match event:
        case KeyPressed(key=key) if key in LEAVE_KEYS:
            return Finished(name=None)
        # Enter typed ahead, before the terminal goes raw, has had its \r turned into \n (Ctrl+J) by the tty.
        case KeyPressed(key=Key.Enter | Key.ControlJ) if (index := search.highlight.index_in(shown)) is not None:
            return Finished(name=shown[index])
        case KeyPressed(key=key) if key in DOWN_KEYS:
            return replace(search, highlight=search.highlight.moved(shown, 1))
        case KeyPressed(key=key) if key in UP_KEYS:
            return replace(search, highlight=search.highlight.moved(shown, -1))
        case _:
            return None


def trimmed(event: InputEvent) -> InputEvent:
    """A paste without the line break a copied line ends with, which the field would make a trailing space."""
    return Pasted(text=event.text.rstrip("\r\n")) if isinstance(event, Pasted) else event


def query_row(field: TextInput) -> Div:
    """The query after its prompt, with the cursor drawn over the cell it's in."""
    return Div(
        style=row | overflow_x_scroll | stick_to_end_x,
        children=(
            Text(content="> ", style=text_wrap_none | text_color("slate", 400)),
            Text(content=field.before_cursor, style=text_wrap_none),
            Text(
                content=field.at_cursor,
                handle=field.cursor_cell,
                style=text_wrap_none | text_color("slate", 900) | text_bg("sky", 300),
            ),
            Text(content=field.after_cursor, style=text_wrap_none),
        ),
    )


@component
def name_picker(prompt: str, names: tuple[str, ...], current: str | None, choose: Callable[[str], None]) -> Div:
    def start() -> Picking:
        return opening(current)

    picking, set_picking = use_state(start)
    row_handle, _ = use_state(ElementHandle)

    def edit_query(edit: Callable[[str], str]) -> str:
        settled = set_picking(lambda latest: latest.edited(edit(latest.query)) if isinstance(latest, Search) else latest)
        return settled.query if isinstance(settled, Search) else ""

    field = use_text_input(picking.query if isinstance(picking, Search) else "", edit_query, auto_focus=True)

    def on_input(event: InputEvent, receiver: Receiver) -> InputResponse:
        now = get_state(set_picking)
        # Keys typed ahead of the Quit, after the choice, choose nothing more.
        if isinstance(now, Finished):
            return ()
        scroll = ScrollIntoView(row_handle, block="nearest")
        match step(now, event, names):
            case None:
                if (controls := response_controls(field.on_input(trimmed(event), receiver))) is None:
                    return None
                return (*controls, scroll)
            case Finished(name=name) as finished:
                set_picking(finished)
                if name is not None:
                    choose(name)
                return Quit()
            case Search() as moved:
                set_picking(moved)
                return scroll
            case _ as unreachable:
                assert_never(unreachable)

    match picking:
        case Finished():
            return Div()
        case Search(query=query, highlight=highlight):
            shown = substring_matches(query, names)
            highlighted = highlight.index_in(shown)
        case _ as unreachable:
            assert_never(unreachable)

    def name_row(index: int, name: str) -> Text:
        return Text(
            content=f"{'*' if name == current else ' '} {name}",
            handle=row_handle if index == highlighted else None,
            style=text_wrap_none
            | (text_bold if name == current else Style())
            | (text_color("amber", 300) if index == highlighted else text_color("slate", 300)),
        )

    return Div(
        style=col | min_height(0) | border | border_lightrounded | border_color("slate", 500) | pad_x(1),
        on_input=on_input,
        children=(
            Text(content=prompt, style=text_wrap_none | text_color("slate", 400)),
            query_row(field),
            Div(
                style=col | min_height(0) | max_height(SHOWN_ROWS) | overflow_y_scroll,
                children=tuple(name_row(index, name) for index, name in enumerate(shown))
                or (Text(content="nothing matches", style=text_color("slate", 400)),),
            ),
        ),
    )


async def pick(prompt: str, names: tuple[str, ...], current: str | None, **app_options: object) -> str | None:
    """Run the picker until it quits, and return the name chosen, if any."""
    chosen: list[str] = []
    await counterweight_app(name_picker(prompt, names, current, chosen.append), **app_options)
    return chosen[-1] if chosen else None


def _selftest() -> int:
    from counterweight.autopilot import typed
    from counterweight.controls import Screenshot
    from counterweight.paint import Frame

    names = ("kind-dev", "prod-us-1", "Prod-eu-2")
    enter = KeyPressed(key=Key.Enter)

    def stepped(*inputs: InputEvent | str, current: str | None = "prod-us-1") -> Picking:
        """The picker after each input, a string standing for the query typed onto."""
        picking: Picking = opening(current)
        for given in inputs:
            if isinstance(picking, Finished):
                break
            picking = picking.edited(picking.query + given) if isinstance(given, str) else step(picking, given, names) or picking
        return picking

    kube_dir = Path("/home/x/.kube")
    cases: list[tuple[str, bool]] = [
        ("a kubeconfig directly in ~/.kube is current", current_config("/home/x/.kube/work", kube_dir) == "work"),
        ("a kubeconfig elsewhere is not", current_config("/tmp/work", kube_dir) is None),
        ("a KUBECONFIG listing several files names none", current_config(f"/home/x/.kube/a{os.pathsep}/home/x/.kube/b", kube_dir) is None),
        ("no KUBECONFIG names none", current_config("", kube_dir) is None),
        ("opening highlights the current name", opening("Prod-eu-2").highlight.index_in(names) == 2),
        ("opening with no current name highlights the first", opening(None).highlight.index_in(names) == 0),
        ("opening with a current name not listed highlights the first", opening("gone").highlight.index_in(names) == 0),
        ("Enter straight away keeps the current name", stepped(enter) == Finished(name="prod-us-1")),
        ("typing narrows, ignoring case, then Enter takes the first match", stepped("EU", enter) == Finished(name="Prod-eu-2")),
        ("a name typed whole comes first", stepped("prod-eu-2", enter) == Finished(name="Prod-eu-2")),
        ("Down from the last wraps to the first", stepped(KeyPressed(key=Key.Down), KeyPressed(key=Key.Down), enter) == Finished(name="kind-dev")),
        ("Escape leaves without choosing", stepped(KeyPressed(key=Key.Escape), enter) == Finished(name=None)),
        ("Enter with nothing matched is left to the field", step(Search("zz", Highlight()), enter, names) is None),
    ]

    def picked(*steps: object, picked_from: tuple[str, ...] = names, dimensions: tuple[int, int] = (40, 10)) -> str | None:
        return asyncio.run(
            asyncio.wait_for(
                pick(
                    "a context", picked_from, "prod-us-1", title="pick-kube", headless=True, dimensions=dimensions,
                    viewport=Inline(keep_last_frame=False), autopilot=[*steps, Quit()],
                ),
                timeout=timedelta(seconds=30).total_seconds(),
            )
        )

    many = tuple(f"ns-{index:02}" for index in range(30))
    frames: list[Frame] = []
    picked(*(KeyPressed(key=Key.Down) for _ in range(20)), Screenshot(frames.append), picked_from=many, dimensions=(30, 30))
    screen = frames[0].text(ansi=False) if frames else ""

    cases += [
        ("the app hands back the name chosen", picked(*typed("kind"), enter) == "kind-dev"),
        (
            "the query edits at the cursor",
            picked(*typed("ki-dev"), *(KeyPressed(key=Key.Left) for _ in range(4)), *typed("nd"), enter) == "kind-dev",
        ),
        ("a paste narrows by its text", picked(Pasted(text="eu\n"), enter) == "Prod-eu-2"),
        ("the app hands back nothing when left", picked(KeyPressed(key=Key.Escape)) is None),
        ("the list stops growing at its most rows", len(screen.splitlines()) == SHOWN_ROWS + 4),
        ("moving past the rows shown scrolls the highlight into view", "ns-20" in screen and "ns-00" not in screen),
    ]

    failures = [name for name, passed in cases if not passed]
    for name in failures:
        print(f"FAIL: {name}", file=sys.stderr)
    print(f"pick-kube: {len(cases) - len(failures)}/{len(cases)} passed")
    return 1 if failures else 0


if __name__ == "__main__":
    if os.environ.get("CLAUDE_HOOK_SELFTEST"):
        sys.exit(_selftest())
    sys.exit(app())
