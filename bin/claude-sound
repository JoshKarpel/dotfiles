#!/usr/bin/env bash
# Play a notification sound, cross-platform (macOS + Linux).
# Usage: claude-sound <stop|notify>

set -euo pipefail

role="${1:-stop}"

# A player that is installed but can't reach an audio server fails at playback rather
# than at `command -v`, which is every headless VM (no PulseAudio). This runs as a hook,
# where stderr shows up in the TUI and a non-zero exit reads as a hook error, so a
# missing pair of speakers must stay silent in both senses.
case "$(uname -s)" in
  Darwin)
    command -v afplay >/dev/null 2>&1 || exit 0
    case "$role" in
      stop)   afplay -v 0.40 /System/Library/Sounds/Morse.aiff ;;
      notify) afplay -v 0.35 /System/Library/Sounds/Ping.aiff ;;
    esac
    ;;
  Linux)
    command -v paplay >/dev/null 2>&1 || exit 0
    case "$role" in
      stop)   paplay /usr/share/sounds/freedesktop/stereo/complete.oga ;;
      notify) paplay /usr/share/sounds/freedesktop/stereo/message.oga ;;
    esac
    ;;
esac 2>/dev/null || true
