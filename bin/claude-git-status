#!/usr/bin/env bash
# SessionStart hook: show git status

set -euo pipefail

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
  sed -n '2,${/^#/!q;s/^# \{0,1\}//p;}' "$0"
  exit 0
fi
if (($#)); then
  echo "$(basename "$0"): takes no arguments; see --help" >&2
  exit 2
fi

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests. This marker
# line is how `claude-hook-selftests` discovers participating hooks. The branch-vs-default
# and ahead-vs-even branches are easy to get backwards silently; run these with
# `CLAUDE_HOOK_SELFTEST=1 claude-git-status`.
if [[ -n "${CLAUDE_HOOK_SELFTEST:-}" ]]; then
  SELF=$(realpath "$0")
  # In a real session `bin/` is on PATH, so this hook reaches `git-default-branch` by
  # name. A CI checkout has no such PATH, and without this the nested self-invocation
  # below would die on "command not found" and the self-test would abort silently.
  PATH="$(dirname "$SELF"):$PATH"
  export PATH
  fails=0
  workdir=$(realpath "$(mktemp -d)")
  trap 'rm -rf "$workdir"' EXIT

  repo="$workdir/repo"
  mkdir -p "$repo"
  git init -q -b main "$repo"
  git -C "$repo" config user.email "test@example.com"
  git -C "$repo" config user.name "test"
  echo base >"$repo/file"
  git -C "$repo" add file
  git -C "$repo" commit -q -m init

  call() {
    local cwd="$1"
    OUT=$(cd "$cwd" && CLAUDE_HOOK_SELFTEST= "$SELF" 2>&1)
  }

  check_contains() {
    local desc="$1" needle="$2"
    [[ "$OUT" == *"$needle"* ]] ||
    { printf 'FAIL %s: expected output to contain %q :: %s\n' "$desc" "$needle" "$OUT"; fails=1; }
  }

  check_not_contains() {
    local desc="$1" needle="$2"
    [[ "$OUT" != *"$needle"* ]] ||
    { printf 'FAIL %s: expected output to NOT contain %q :: %s\n' "$desc" "$needle" "$OUT"; fails=1; }
  }

  call "$workdir"
  [[ -z "$OUT" ]] || { printf 'FAIL outside any repo: expected no output :: %s\n' "$OUT"; fails=1; }

  # --- the land state, from a stubbed `git-land --state` ---
  stubs="$workdir/stubs"
  mkdir -p "$stubs"
  printf '#!/bin/sh\n[ -n "${STUB_LAND_STATE:-}" ] || exit 1\nprintf "%%s\\n" "$STUB_LAND_STATE"\n' >"$stubs/git-land"
  # Whether GitHub takes commits on the default branch: STUB_DIRECT (0 = it does).
  printf '#!/bin/sh\nexit "${STUB_DIRECT:-1}"\n' >"$stubs/is-claude-commit-branch"
  chmod +x "$stubs/git-land" "$stubs/is-claude-commit-branch"
  land() {
    OUT=$(cd "$repo" && STUB_LAND_STATE="$1" PATH="$stubs:$PATH" CLAUDE_HOOK_SELFTEST= "$SELF" 2>&1)
  }
  land ""
  check_not_contains "no land state (no origin)" "Landing"
  land $'path=/g/land/b/pr.md\ndraft=yes\nlanded=no\nstale=no\ndraft_changed=yes\nunlanded=2\npr_failed=no\ndefault=no'
  check_contains "a branch with a draft" "PR draft: /g/land/b/pr.md (written)"
  check_contains "a branch with a draft" "Landed before: no"
  check_contains "a branch with unlanded commits" "Unlanded commits (origin lacks them): 2"
  check_contains "a PR branch learns the draft's shape" "inside a \`<details>\` fold"
  check_contains "a PR branch learns to wait on its checks" "claude-wait-checks"
  land $'path=/g/land/b/pr.md\ndraft=yes\nlanded=yes\nstale=no\ndraft_changed=yes\nunlanded=0\npr_failed=no\ndefault=no'
  check_contains "a landed draft that changed" "Landed before: yes, and the draft has changed since"
  land $'path=/g/land/b/pr.md\ndraft=no\nlanded=no\nstale=yes\ndraft_changed=no\nunlanded=1\npr_failed=no\ndefault=no'
  check_contains "a stale land directory" "an earlier branch's of the same name"
  check_contains "no draft" "(not written yet)"
  land $'path=/g/land/b/pr.md\ndraft=yes\nlanded=no\nstale=no\ndraft_changed=yes\nunlanded=0\npr_failed=yes\ndefault=no'
  check_contains "a PR that failed to open" "the PR failed to open"
  land $'path=/g/land/b/pr.md\ndraft=yes\nlanded=yes\nstale=no\ndraft_changed=no\nunlanded=2\npr_failed=no\ndefault=yes'
  check_not_contains "the default branch" "Landing"
  STUB_DIRECT=0 land $'path=/g/land/b/pr.md\ndraft=no\nlanded=no\nstale=no\ndraft_changed=no\nunlanded=2\npr_failed=no\ndefault=yes'
  check_contains "a direct default branch" "without a PR, so commit on it"
  check_contains "a direct default branch's count" "Unlanded commits (origin lacks them): 2"
  check_not_contains "a direct default branch" "PR draft: "
  check_not_contains "a direct default branch waits on no PR checks" "claude-wait-checks"

  call "$repo"
  check_contains "on the default branch" "Current git status:"
  check_not_contains "on the default branch" "Recent commits:"
  check_not_contains "on the default branch" "Net changes vs."

  git -C "$repo" checkout -q -b even
  call "$repo"
  check_contains "on a branch with no commits ahead" "Current git status:"
  check_not_contains "on a branch with no commits ahead" "Recent commits:"
  check_not_contains "on a branch with no commits ahead" "Net changes vs."

  git -C "$repo" checkout -q -b ahead
  echo more >>"$repo/file"
  git -C "$repo" commit -q -am ahead
  call "$repo"
  check_contains "on a branch ahead of default" "Current git status:"
  check_contains "on a branch ahead of default" "Recent commits:"
  check_contains "on a branch ahead of default" "ahead"
  check_contains "on a branch ahead of default" "Net changes vs. main (merge-base):"
  check_contains "on a branch ahead of default" "file"

  if [[ "$fails" == 0 ]]; then
    echo "$(basename "$0"): all self-tests passed"
  fi
  exit "$fails"
fi

STATUS=$(git status --short --branch 2>/dev/null) || exit 0

CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null) || CURRENT_BRANCH=""
DEFAULT_BRANCH=$(git-default-branch)

cat <<EOF
Current git status:

$STATUS
EOF

# Where this branch's landing stands, from `git-land --state`, which owns what each field means,
# and how it lands. This is where a session learns the landing workflow, rather than the global
# CLAUDE.md, so each kind of branch gets only its own: a PR branch the draft and the check wait, a
# default branch GitHub takes commits on without a PR (which only `is-claude-commit-branch` can say,
# by asking GitHub, so a session started on a default branch pays for one call) the push. Nothing
# on any other default branch, whose unlanded commits are Josh's, so reporting them would invite a
# land the stop checks exist to prevent.
LAND_STATE=$(git-land --state 2>/dev/null) || LAND_STATE=""
land_field() { sed -n "s/^$1=//p" <<<"$LAND_STATE"; }
if grep -qx 'default=yes' <<<"$LAND_STATE" && is-claude-commit-branch >/dev/null; then
  cat <<EOF

Landing (\`git land\`):

- This is the default branch, and GitHub takes commits on it without a PR, so commit on it as on any other branch and land each turn's commits with \`git land\`, which pushes and opens no PR. There is no PR draft to write and no PR checks to wait on.
- Unlanded commits (origin lacks them): $(land_field unlanded)
EOF
elif grep -qx 'default=no' <<<"$LAND_STATE"; then
  if [[ "$(land_field draft)" == yes ]]; then
    DRAFT="written"
  else
    DRAFT="not written yet"
  fi
  if [[ "$(land_field landed)" == yes ]]; then
    LANDED="yes"
    [[ "$(land_field draft_changed)" == yes ]] && LANDED+=", and the draft has changed since"
  elif [[ "$(land_field pr_failed)" == yes ]]; then
    LANDED="no (pushed, but the PR failed to open; \`git land\` again opens it)"
  elif [[ "$(land_field stale)" == yes ]]; then
    LANDED="no (the land directory is an earlier branch's of the same name; \`git land --path\` moves it aside)"
  else
    LANDED="no"
  fi
  cat <<EOF

Landing (\`git land\`):

- PR draft: $(land_field path) ($DRAFT)
- Landed before: $LANDED
- Unlanded commits (origin lacks them): $(land_field unlanded)
EOF
  cat <<'EOF'

This branch lands through a pull request, which `git land` opens and updates from the draft:

- Once the change is worth showing (a coherent first version whose checks pass locally), write the PR draft to the path above and run `git land`. The draft is shaped like a commit message: the title, a blank line, then the body. Put what you wrote (the problem, the change, how it was checked) inside a `<details>` fold whose `<summary>` names your model, such as `<summary>Claude Opus 5.5</summary>`, without the effort level: you can't see it, so a stated one is a guess. After that, land again at the end of each turn that committed, so the PR and its CI stay current.
- When the work resolves GitHub issues, link each from the draft with a closing keyword on a line of its own above the fold (`Closes #12`), so the PR appears in the issue's Development sidebar and merging closes it ([linking a pull request to an issue](https://docs.github.com/en/issues/tracking-your-work-with-issues/using-issues/linking-a-pull-request-to-an-issue)). Use the issues Josh named when starting the session; otherwise search the repo's open issues, link those that clearly describe this work, and name the near misses in the report. Work that only advances an issue mentions it without a keyword (`Part of #12`), since a keyword closes the issue on merge. Link only issues the repo's readers can see (the public-record rule).
- Rewrite the draft whenever what the PR is has changed: it is the only way to change your part of the PR description, and the next land carries it.
- After landing, wait for the PR's checks with `claude-wait-checks` in the background, which re-invokes you when it exits, and do what its last lines say. It gives up after 15 minutes so no wait outlives the prompt cache, and exits as soon as waiting can't help, most often for a PR with merge conflicts, whose `pull_request` checks GitHub never runs. Whatever it lists under "Worth a look" (a run slower than the default branch's, a stuck step, a failure the default branch shares) is a possible problem to weigh before acting on the verdict, a pass included; it lists nothing when things look normal. Don't wait with a bare `gh pr checks --watch` or a `sleep` loop around one: the watch has no deadline, and its "no checks reported" means the same for a conflicted PR as for a push GitHub hasn't registered yet.
EOF
fi

if [[ -n "$CURRENT_BRANCH" && -n "$DEFAULT_BRANCH" && "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]]; then
  LOG=$(git log "${DEFAULT_BRANCH}..HEAD" --oneline --stat 2>/dev/null)
  if [[ -n "$LOG" ]]; then
    cat <<EOF

Recent commits:

$LOG
EOF
  fi

  # Net diff vs. the merge-base (three-dot): each file once, cumulative change,
  # collapsing per-commit churn. Orients a cold session on what the branch amounts to.
  DIFFSTAT=$(git diff "${DEFAULT_BRANCH}...HEAD" --stat 2>/dev/null)
  if [[ -n "$DIFFSTAT" ]]; then
    cat <<EOF

Net changes vs. ${DEFAULT_BRANCH} (merge-base):

$DIFFSTAT
EOF
  fi
fi
