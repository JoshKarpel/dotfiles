#!/usr/bin/env bash
# Stop hook: nudge Claude through a single finishing pass before stopping

set -euo pipefail

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests. This marker
# line is how `claude-hook-selftests` discovers participating hooks. This hook decides
# whether Claude sees a finishing-pass nudge from a single branch on
# claude-changeset-guard's exit code; run these with
# `CLAUDE_HOOK_SELFTEST=1 claude-stop-finish`.
if [[ -n "${CLAUDE_HOOK_SELFTEST:-}" ]]; then
  SELF=$(realpath "$0")
  fails=0
  stubs=$(realpath "$(mktemp -d)")
  repo=$(realpath "$(mktemp -d)")
  trap 'rm -rf "$stubs" "$repo"' EXIT
  git init -q "$repo"
  cd "$repo"

  stub_guard() {
    local exit_code="$1" output="$2"
    printf '#!/bin/sh\n: > "%s/guard.called"\nprintf %%s "%s"\nexit %s\n' "$stubs" "$output" "$exit_code" >"$stubs/claude-changeset-guard"
    chmod +x "$stubs/claude-changeset-guard"
  }

  call() {
    local payload="$1"
    rm -f "$stubs/guard.called"
    EXIT=0
    OUT=$(PATH="$stubs:$PATH" CLAUDE_HOOK_SELFTEST= "$SELF" <<<"$payload" 2>&1) || EXIT=$?
  }

  check() {
    local desc="$1" want_exit="$2"
    [[ "$EXIT" == "$want_exit" ]] ||
    { printf 'FAIL %s: want_exit=%s got_exit=%s :: %s\n' "$desc" "$want_exit" "$EXIT" "$OUT"; fails=1; }
  }

  nudged() {
    local desc="$1" want="$2" got=no
    [[ "$OUT" == *"finishing pass triggered"* ]] && got=yes
    [[ "$got" == "$want" ]] ||
    { printf 'FAIL %s: want_nudge=%s got_nudge=%s :: %s\n' "$desc" "$want" "$got" "$OUT"; fails=1; }
  }

  # --- no fresh change-set: the guard suppresses, and this hook stays silent ---
  stub_guard 1 ""
  call '{}'
  check "no change-set to nudge about is silent" 0
  [[ -z "$OUT" ]] ||
  { printf 'FAIL silent pass-through: expected no output :: %s\n' "$OUT"; fails=1; }

  # --- one pass per prompt: a second fresh change-set in the same prompt is silent,
  # but the guard still runs so it records the pass's own edits ---
  stub_guard 0 "M first/prompt.txt"
  call '{"prompt_id":"prompt-7f3a"}'
  nudged "first change-set in a prompt nudges" yes
  call '{"prompt_id":"prompt-7f3a"}'
  check "same prompt again exits cleanly" 0
  nudged "a second change-set in the same prompt is silent" no
  [[ -e "$stubs/guard.called" ]] ||
  { printf 'FAIL suppressed nudge must still run the guard\n'; fails=1; }
  call '{"prompt_id":"prompt-91c4"}'
  nudged "a new prompt nudges again" yes
  call '{"prompt_id":"prompt-7f3a"}'
  nudged "an earlier prompt stays remembered" no

  # --- no prompt id (before the first user input): nudge on every fresh change-set ---
  call '{}'
  nudged "no prompt id nudges" yes
  call '{}'
  nudged "no prompt id nudges again" yes

  # --- a fresh change-set: the guard's porcelain surfaces inside the nudge ---
  stub_guard 0 "M some/file.txt"
  call '{"prompt_id":"prompt-c208"}'
  check "a fresh change-set nudges" 0
  [[ "$OUT" == *"M some/file.txt"* ]] ||
  { printf 'FAIL nudge: output missing porcelain change-set :: %s\n' "$OUT"; fails=1; }
  EVENT=$(jq -r '.hookSpecificOutput.hookEventName' <<<"$OUT" 2>/dev/null)
  [[ "$EVENT" == "Stop" ]] ||
  { printf 'FAIL nudge: hookEventName is %q, want Stop :: %s\n' "$EVENT" "$OUT"; fails=1; }
  [[ "$OUT" == *"finishing pass triggered"* ]] ||
  { printf 'FAIL nudge: output missing systemMessage :: %s\n' "$OUT"; fails=1; }

  if [[ "$fails" == 0 ]]; then
    echo "$(basename "$0"): all self-tests passed"
  fi
  exit "$fails"
fi

INPUT=$(cat)
PROMPT_ID=$(jq -r '.prompt_id // ""' <<<"$INPUT")

# The guard runs even when this prompt was already nudged: it records the fingerprint,
# so the edits the finishing pass itself makes don't read as a fresh change-set on the
# next prompt.
PORCELAIN=$(claude-changeset-guard finish) || exit 0

# At most one pass per user prompt. Without this, every edit the pass makes is a new
# change-set, and each one bought another pass that mostly reported nothing to change.
# A stop-hook continuation keeps the prompt's id; a new prompt (a task notification
# included) gets a fresh one.
if [[ -n "$PROMPT_ID" ]]; then
  NUDGED="$(git rev-parse --git-dir)/claude-finish-nudged-prompts"
  grep -qxsF "$PROMPT_ID" "$NUDGED" && exit 0
  {
    tail -n 19 "$NUDGED" 2>/dev/null || true
    printf '%s\n' "$PROMPT_ID"
  } >"$NUDGED.tmp"
  mv "$NUDGED.tmp" "$NUDGED"
fi

MESSAGE="You made these changes this session:

$PORCELAIN

Before stopping, do a finishing pass on this change-set. Work through these in order,
keeping each scoped to the change you already made (don't start new work or expand
scope):

1. Consistency: update anything the change-set requires to stay in sync, e.g. CLAUDE.md,
   docs, changelogs, justfile recipes, or code comments.
2. Verify: confirm your changes work, e.g. by building, type-checking, and running tests.

Fix what genuinely needs fixing; if a step has nothing to do, move on. When the diff is
consistent and passes, change nothing and stop."

jq -n --arg ctx "$MESSAGE" '{"systemMessage":"[claude-stop-finish] finishing pass triggered","hookSpecificOutput":{"hookEventName":"Stop","additionalContext":$ctx}}'
exit 0
