#!/usr/bin/env bash
# Stop hook: nudge Claude through a single finishing pass before stopping

set -euo pipefail

# CLAUDE_HOOK_SELFTEST: set this env var to run the embedded self-tests. This marker
# line is how `claude-hook-selftests` discovers participating hooks. This hook decides
# whether Claude sees a finishing-pass nudge from whether the prompt changed the repo,
# stubbed here; run these with `CLAUDE_HOOK_SELFTEST=1 claude-stop-finish`.
if [[ -n "${CLAUDE_HOOK_SELFTEST:-}" ]]; then
  SELF=$(realpath "$0")
  # The stubbed snapshot answers `changed`; the once-per-prompt record is the real one's.
  export REAL_SNAPSHOT
  REAL_SNAPSHOT="$(dirname "$SELF")/claude-prompt-snapshot"
  fails=0
  stubs=$(realpath "$(mktemp -d)")
  repo=$(realpath "$(mktemp -d)")
  trap 'rm -rf "$stubs" "$repo"' EXIT
  # shellcheck disable=SC2207
  unset_git=($(git rev-parse --local-env-vars | sed 's/^/-u /'))
  env "${unset_git[@]}" git init -q "$repo"
  cd "$repo"

  # The snapshot answers "did this prompt change the repo", driven by an env var per call.
  cat >"$stubs/claude-prompt-snapshot" <<'STUB'
#!/bin/sh
[ "$1" = changed ] || exec "$REAL_SNAPSHOT" "$@"
: > "$STUB_DIR/snapshot.called"
[ "$STUB_CHANGED" = 0 ] && printf '%s' "$STUB_PORCELAIN"
exit "$STUB_CHANGED"
STUB
  chmod +x "$stubs/claude-prompt-snapshot"

  call() {
    local payload="$1" changed="$2" porcelain="${3:-M some/file.txt}"
    rm -f "$stubs/snapshot.called"
    EXIT=0
    OUT=$(env "${unset_git[@]}" STUB_DIR="$stubs" STUB_CHANGED="$changed" STUB_PORCELAIN="$porcelain" \
      PATH="$stubs:$PATH" CLAUDE_HOOK_SELFTEST= "$SELF" <<<"$payload" 2>&1) || EXIT=$?
  }

  check() {
    local desc="$1" want_exit="$2"
    [[ "$EXIT" == "$want_exit" ]] ||
    { printf 'FAIL %s: want_exit=%s got_exit=%s :: %s\n' "$desc" "$want_exit" "$EXIT" "$OUT"; fails=1; }
  }

  nudged() {
    local desc="$1" want="$2" got=no
    [[ "$OUT" == *"finishing pass triggered"* ]] && got=yes
    [[ "$got" == "$want" ]] ||
    { printf 'FAIL %s: want_nudge=%s got_nudge=%s :: %s\n' "$desc" "$want" "$got" "$OUT"; fails=1; }
  }

  # --- the prompt changed nothing: silent ---
  call '{"prompt_id":"prompt-0a1b"}' 1
  check "a prompt that changed nothing is silent" 0
  [[ -z "$OUT" ]] ||
  { printf 'FAIL silent pass-through: expected no output :: %s\n' "$OUT"; fails=1; }

  # --- one pass per prompt: a second stop in the same prompt is silent ---
  call '{"prompt_id":"prompt-7f3a"}' 0
  nudged "a prompt that changed the repo nudges" yes
  call '{"prompt_id":"prompt-7f3a"}' 0
  check "same prompt again exits cleanly" 0
  nudged "a second stop in the same prompt is silent" no
  call '{"prompt_id":"prompt-91c4"}' 0
  nudged "a new prompt nudges again" yes
  call '{"prompt_id":"prompt-7f3a"}' 0
  nudged "an earlier prompt stays remembered" no

  # --- no prompt id (only before a session's first prompt): nothing to record the pass against ---
  call '{}' 0
  nudged "no prompt id never nudges" no

  # --- a merge or rebase in progress dominates the tree: no pass ---
  touch "$(git rev-parse --git-dir)/MERGE_HEAD"
  call '{"prompt_id":"prompt-e5d6"}' 0
  nudged "a merge in progress is silent" no
  [[ ! -e "$stubs/snapshot.called" ]] ||
  { printf 'FAIL a merge in progress should not consult the snapshot\n'; fails=1; }
  rm "$(git rev-parse --git-dir)/MERGE_HEAD"

  # --- what changed surfaces inside the nudge, as Stop JSON ---
  call '{"prompt_id":"prompt-c208"}' 0 "M other/file.txt"
  check "a changed prompt nudges" 0
  [[ "$OUT" == *"M other/file.txt"* ]] ||
  { printf 'FAIL nudge: output missing what changed :: %s\n' "$OUT"; fails=1; }
  EVENT=$(jq -r '.hookSpecificOutput.hookEventName' <<<"$OUT" 2>/dev/null)
  [[ "$EVENT" == "Stop" ]] ||
  { printf 'FAIL nudge: hookEventName is %q, want Stop :: %s\n' "$EVENT" "$OUT"; fails=1; }

  if [[ "$fails" == 0 ]]; then
    echo "$(basename "$0"): all self-tests passed"
  fi
  exit "$fails"
fi

INPUT=$(cat)
PROMPT_ID=$(jq -r '.prompt_id // ""' <<<"$INPUT")

GIT_DIR=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0

# During a merge or rebase the working tree is dominated by the operation, not session work.
[[ -f "$GIT_DIR/MERGE_HEAD" || -d "$GIT_DIR/rebase-merge" || -d "$GIT_DIR/rebase-apply" ]] && exit 0

# The question is whether this prompt changed the repo, measured against the snapshot taken when
# it arrived, so Josh's own edits between prompts don't count and a turn that ended in a commit
# still does.
CHANGES=$(claude-prompt-snapshot changed "$PROMPT_ID") || exit 0

# At most one pass per user prompt. Without this, every edit the pass makes is a new
# change, and each one bought another pass that mostly reported nothing to change.
# A stop-hook continuation keeps the prompt's id; a new prompt (a task notification
# included) gets a fresh one.
claude-prompt-snapshot ask "$PROMPT_ID" finish || exit 0

MESSAGE="You made these changes this prompt:

$CHANGES

Before stopping, check this change-set for consistency: update anything it requires to stay in sync, e.g. CLAUDE.md, docs, changelogs, skills, justfile recipes, or code comments that describe what you changed. Keep it scoped to the change you already made (don't start new work or expand scope). Don't re-run checks that already passed.

If you changed something, say in a sentence or two what and why. If nothing needed changing, reply with exactly \"Finishing pass: nothing to change.\" and nothing else. Either way, hold the turn's report: the last check asks for it."

jq -n --arg ctx "$MESSAGE" '{"systemMessage":"[claude-stop-finish] finishing pass triggered","hookSpecificOutput":{"hookEventName":"Stop","additionalContext":$ctx}}'
exit 0
