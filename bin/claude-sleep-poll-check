#!/usr/bin/env bash
# PreToolUse hook: block a foreground `sleep` used to wait on background work.
# Backgrounded commands announce their own completion and their output file reads
# mid-flight, so sleeping to wait costs a blocked turn and buys nothing.

set -euo pipefail

# A stall shorter than this is doing something else (letting a port open, pacing a
# loop); past it, the command is waiting, and waiting is the harness's job.
STALL_SECONDS=30

# CLAUDE_HOOK_SELFTEST: set this env var to run the hook's embedded self-tests. This
# marker line is how `claude-hook-selftests` discovers participating hooks. The tests
# drive the hook through its own stdin interface (exit 2 = block, 0 = allow).
if [[ -n "${CLAUDE_HOOK_SELFTEST:-}" ]]; then
  fails=0
  t() {
    local want="$1" cmd="$2" got
    jq -cn --arg c "$cmd" '{tool_input: {command: $c}}' \
      | CLAUDE_HOOK_SELFTEST= "$0" >/dev/null 2>&1 && got=0 || got=$?
    [[ "$got" == "$want" ]] ||
    { printf 'FAIL want=%s got=%s :: %s\n' "$want" "$got" "$cmd"; fails=1; }
  }
  # --- BLOCK: polling a background task's output file ---
  t 2 'sleep 240; tail -8 /tmp/claude-1000/sess/tasks/bqjv6aqim.output'
  t 2 'sleep 60; tail -12 /tmp/claude-1000/sess/tasks/ba2vae6qf.output'
  t 2 'sleep 20 && tail -c 300 /tmp/claude-1000/sess/tasks/bei24vdsq.output'
  t 2 'sleep 5; cat /tmp/claude-1000/sess/tasks/x.output | tail -3'
  # --- BLOCK: a pure stall, with or without a filler echo ---
  t 2 'sleep 540; echo "checked"'
  t 2 'sleep 900'
  t 2 'sleep 30'
  t 2 'sleep 600'
  t 2 'sleep 15m'
  t 2 'echo waiting && sleep 120'
  # --- ALLOW: a short pause in front of real work ---
  t 0 'sleep 5'
  t 0 'sleep 29'
  t 0 'sleep 2 && curl -sS localhost:8000/health'
  t 0 'sleep 0.5; echo go'
  t 0 'sleep 120 && just test'
  t 0 'for i in 1 2 3; do sleep 1; done'
  # --- ALLOW: polling something Claude never started, as long as each wake checks ---
  t 0 'sleep 300 && systemctl status my-cron.service'
  t 0 'while ! systemctl is-active --quiet my-cron.service; do sleep 30; done'
  # --- ALLOW: reading the output file is the recommended progress check ---
  t 0 'tail -8 /tmp/claude-1000/sess/tasks/bqjv6aqim.output'
  t 0 'cat /tmp/claude-1000/sess/tasks/x.output'
  # --- ALLOW: sleep named but not run ---
  t 0 'echo "sleep 900"'
  t 0 'grep -rn "sleep 600" tests/'
  t 0 'ls -la'
  if [[ "$fails" == 0 ]]; then
    echo "$(basename "$0"): all self-tests passed"
  fi
  exit "$fails"
fi

INPUT=$(cat)
COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command')

# Split on the separators that end a command, so `sleep` has to be a command in its
# own right rather than a word inside a string or another command's argument.
SEGMENTS=${COMMAND//&&/$'\n'}
SEGMENTS=${SEGMENTS//||/$'\n'}
SEGMENTS=${SEGMENTS//;/$'\n'}
SEGMENTS=${SEGMENTS//|/$'\n'}

has_sleep=0
has_work=0
long_sleep=0

while IFS= read -r segment; do
  segment="${segment#"${segment%%[![:space:]]*}"}"
  segment="${segment%"${segment##*[![:space:]]}"}"
  [[ -z "$segment" ]] && continue
  if [[ "$segment" =~ ^sleep[[:space:]]+([0-9]+([.][0-9]+)?)([smhd]?)$ ]]; then
    has_sleep=1
    duration="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[3]}"
    # Anything counted in minutes or longer is past the threshold by definition.
    if [[ -n "$unit" && "$unit" != "s" ]]; then
      long_sleep=1
    elif [[ "${duration%%.*}" -ge "$STALL_SECONDS" ]]; then
      long_sleep=1
    fi
    continue
  fi
  # An echo carries no result, so a sleep beside one is still a bare stall.
  [[ "$segment" =~ ^echo([[:space:]]|$) ]] && continue
  has_work=1
done <<< "$SEGMENTS"

[[ "$has_sleep" == 0 ]] && exit 0

reads_task_output=0
if [[ "$COMMAND" == *tasks/* && "$COMMAND" == *.output* ]]; then
  reads_task_output=1
fi

if [[ "$reads_task_output" == 0 && ("$has_work" == 1 || "$long_sleep" == 0) ]]; then
  exit 0
fi

cat >&2 <<'EOF'
Don't sleep to wait on work you started with Bash. Run the command with `run_in_background: true` instead: it returns immediately, keeps running across turns, and re-invokes you when it exits, so you stay free to do other work in the meantime.

To check on it before then, use the Read tool on the output file path the call returned. That file is readable while the command is still running and shows the partial output, which is everything the sleep-then-read was waiting for.

Waiting on something you didn't start, like a cron job or an external deploy, needs a real check, not a bare stall: put it in the same command so each wake does something (`sleep 300 && systemctl status my-service`). If there's nothing to check yet, end the turn and follow up later instead of blocking on it.

Sleeping in the foreground blocks you for the full duration, and the Bash timeout caps at 10 minutes, so a longer sleep is killed having produced nothing.
EOF
exit 2
