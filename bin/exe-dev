#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["typer"]
# ///
"""Reach exe.dev and its VMs over checked host keys, with dev boxes built from this repo."""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Annotated

import typer

LOBBY = "exe.dev"

# Published at https://exe.dev/docs/faq/host-key. exe.dev publishes a
# fingerprint rather than a key, so this is the trust anchor: a scanned key is
# checked against it once, and ssh enforces the pinned result from then on.
#
# It covers `<vm>.exe.xyz` as well as the lobby. Each VM hostname resolves to a
# public address of its own, but exe.dev terminates SSH for all of them at the
# same front door and proxies inward, so one key answers everywhere. A VM's own
# sshd sits behind that hop and admits only the front door, so its key is never
# what a client sees.
PUBLISHED_FINGERPRINT = "SHA256:JJOP/lwiBGOMilfONPWZCXUrfK154cnJFXcqlsi6lPo"

KNOWN_HOSTS = Path.home() / ".ssh" / "known_hosts"

VM_SUFFIX = ".exe.xyz"

# The one place a VM hostname sidesteps the front door: exe.dev points a box's
# own name here at the box itself, so a client running on it meets that VM's
# own sshd rather than the proxy, and a key the published fingerprint will
# never match. Reading the override is what settles which box this is, since
# the override is also what creates the exception.
HOSTS = Path("/etc/hosts")

# Completion runs on every TAB, where a lobby round trip is an order of
# magnitude too slow to sit in the path, so names come from a short-lived cache
# and a stale entry costs at most a name typed out in full.
VM_CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "exe-dev" / "vms"
VM_CACHE_TTL = timedelta(minutes=5)

# Integrations attach by tag, so this tag is what wires a fresh box up to the
# dotfiles and GitHub integrations without any per-VM setup. Scoping the box's
# own account key to it means a compromised box can only see tagged VMs.
TAG = "dev-box"

LOG = "bootstrap.log"

# The line the bootstrap's EXIT trap writes. A follower needs it to know the
# run is over, and it carries the status because a failed run exits there too.
MARKER = "BOOTSTRAP EXIT "

# Every repo on a box lives under ~/projects, and dotfiles is no exception:
# CDPATH already reaches there, one place for checkouts beats a special case at
# the top of $HOME, and it puts the bootstrap's own clone where `clone-repos`
# will find it rather than duplicate it. The bootstrap writes $HOME rather than
# an expanded path, since it runs as the VM's user, not as whoever ran this.
PROJECTS_DIR = "projects"
PROJECTS = Path.home() / PROJECTS_DIR

# Served only inside a VM, which is also the only place these clones belong.
REFLECTION_INTEGRATIONS = "https://reflection.int.exe.xyz/integrations"

CLONE_URL = re.compile(r"https://github\.int\.exe\.xyz/[\w.-]+/([\w.-]+?)\.git")

# Runs once at first boot, unattended and without a TTY. exe.dev caps setup
# scripts at 10KiB, so this stays a bootstrap: clone the repo, hand off to
# install.sh, which is what generates this box's own SSH key.
BOOTSTRAP = f"""#!/usr/bin/env bash
set -euo pipefail

exec </dev/null >>"$HOME/{LOG}" 2>&1

trap 'echo "{MARKER}$?"' EXIT

# apt prompts on config conflicts otherwise, and nothing is here to answer.
export DEBIAN_FRONTEND=noninteractive

dotfiles="$HOME/{PROJECTS_DIR}/dotfiles"

git clone https://github.int.exe.xyz/JoshKarpel/dotfiles.git "$dotfiles"
"$dotfiles/install.sh"

# install.sh installs uv through mise, and nothing has activated mise in this
# shell, so uv reaches exe-dev's shebang only by way of mise's own exec.
"$HOME/.local/bin/mise" exec -- "$dotfiles/bin/exe-dev" clone-repos
"""

app = typer.Typer(no_args_is_help=True, help=__doc__)


def lobby_command(*args: str, pty: bool = False) -> list[str]:
    # Never accept-new: the whole point is that exe.dev's key is published, so
    # an unrecognised one is a reason to stop rather than to learn.
    options = ["-o", "StrictHostKeyChecking=yes"]

    # ssh allocates no terminal when it is handed a command, and every lobby
    # call is one, so the lobby's interactive commands have to ask for it.
    if pty:
        options.append("-t")

    return ["ssh", *options, LOBBY, *args]


def control_plane_command(vm: str, *args: str) -> list[str]:
    """Reach a VM by way of the lobby, whose host key is pinned.

    VMs are isolated from each other with no private network, so a direct
    connection needs a key already registered on the account. Going through
    the lobby works the same whether this runs from a laptop or from another
    devbox, and keeps every hop on the one channel that can be pinned.
    """
    return lobby_command("ssh", vm, *args)


def vm_host(vm: str) -> str:
    return f"{vm}{VM_SUFFIX}"


def vm_name_in_hosts(hosts: str) -> str | None:
    """The VM whose own name HOSTS points at the box itself, if any."""
    for line in hosts.splitlines():
        if line.startswith("#"):
            continue
        for name in line.split()[1:]:
            if name.endswith(VM_SUFFIX):
                return name.removesuffix(VM_SUFFIX)
    return None


def local_vm() -> str | None:
    """The VM this is running on, or None anywhere else."""
    try:
        return vm_name_in_hosts(HOSTS.read_text())
    except OSError:
        return None


def fingerprint(public_key: str) -> str:
    out = subprocess.run(
        ["ssh-keygen", "-lf", "-"], input=public_key, text=True, capture_output=True, check=True
    )
    return out.stdout.split()[1]


def known_hosts_entry(host: str, public_key: str) -> str:
    algorithm, material = public_key.split()[:2]
    return f"{host} {algorithm} {material}\n"


def public_key_in(output: str) -> str | None:
    """The public key somewhere in OUTPUT, or None if there isn't one.

    A VM's login shell writes its own startup chatter to the same stream as the
    command's result, so the key arrives with company. Asking ssh-keygen which
    line parses as a key beats trusting the stream to carry nothing else, and
    beats matching key types this has to keep a list of.
    """
    for line in output.splitlines():
        candidate = line.strip()
        if not candidate:
            continue
        parsed = subprocess.run(
            ["ssh-keygen", "-lf", "-"], input=candidate, text=True, capture_output=True
        )
        if parsed.returncode == 0:
            return candidate
    return None


def pinned_fingerprint(host: str) -> str | None:
    """What known_hosts already records for HOST, if anything."""
    # Named rather than left to the default, which ssh-keygen resolves from the
    # passwd entry while `pin` writes to $HOME, so the two disagree wherever
    # $HOME is overridden. A file that doesn't exist yet reports on stderr and
    # yields no fingerprint, which is the answer wanted anyway.
    out = subprocess.run(
        ["ssh-keygen", "-F", host, "-l", "-f", str(KNOWN_HOSTS)], capture_output=True, text=True
    )
    for line in out.stdout.splitlines():
        if line.startswith("#") or not line.strip():
            continue
        return line.split()[2]
    return None


def pin(host: str, public_key: str) -> None:
    KNOWN_HOSTS.parent.mkdir(mode=0o700, exist_ok=True)
    with KNOWN_HOSTS.open("a") as known_hosts:
        known_hosts.write(known_hosts_entry(host, public_key))


def scanned_key_matching(host: str, want: str) -> str | None:
    # Unreachable and offering-nothing-that-matches are the same answer here,
    # and a machine with no exe.dev account hits the first one, so it gets the
    # caller's message rather than a traceback out of ssh-keyscan.
    scan = subprocess.run(["ssh-keyscan", host], capture_output=True, text=True)
    for line in scan.stdout.splitlines():
        if line.startswith("#") or not line.strip():
            continue
        key = line.split(" ", 1)[1]
        if fingerprint(key) == want:
            return key
    return None


def pin_published(host: str) -> None:
    """Make sure known_hosts agrees with the fingerprint exe.dev publishes.

    Works for `<vm>.exe.xyz` as much as for the lobby, since one front door
    answers for all of them, so a VM needs nothing read off the box itself.
    """
    pinned = pinned_fingerprint(host)
    if pinned == PUBLISHED_FINGERPRINT:
        return

    if pinned is not None:
        typer.echo(
            f"{host} is pinned to {pinned}, not the published {PUBLISHED_FINGERPRINT}", err=True
        )
        # ssh-keygen rewrites the whole file, so it refuses outright while any
        # line in it is malformed, and says so without naming the line.
        typer.echo(f"  drop the stale entry with: ssh-keygen -R {host}", err=True)
        typer.echo(f"  if that reports errors, fix the offending lines in {KNOWN_HOSTS}", err=True)
        raise typer.Exit(1)

    key = scanned_key_matching(host, PUBLISHED_FINGERPRINT)
    if key is None:
        typer.echo(f"{host} presented no key matching {PUBLISHED_FINGERPRINT}", err=True)
        raise typer.Exit(1)

    pin(host, key)
    typer.echo(f"pinned {host} ({PUBLISHED_FINGERPRINT})", err=True)


def register_key(vm: str) -> None:
    """Register the box's own public key so it can drive exe.dev itself.

    The box cannot do this for itself: adding a key needs an already-trusted
    credential, and a fresh box has none. So it happens from here, which is
    authenticated by definition, and only the public half ever moves.
    """
    out = subprocess.run(
        control_plane_command(vm, "cat", ".ssh/id_ed25519.pub"), capture_output=True, text=True, check=True
    )
    public_key = public_key_in(out.stdout)
    if public_key is None:
        typer.echo(f"{vm} returned no public key for .ssh/id_ed25519.pub", err=True)
        raise typer.Exit(1)

    subprocess.run(lobby_command("ssh-key", "add", f"--tag={TAG}", public_key), check=True)
    typer.echo(f"registered {public_key.split()[-1]} scoped to tag {TAG}")


def create_args(name: str, cpu: int, memory: str, disk: str) -> list[str]:
    return lobby_command(
        "new",
        f"--name={name}",
        f"--tag={TAG}",
        f"--cpu={cpu}",
        f"--memory={memory}",
        f"--disk={disk}",
        "--setup-script=/dev/stdin",
    )


def retired_name(canonical: str, when: datetime) -> str:
    """Where CANONICAL's box goes when a new one takes its name.

    Timestamped so repeated cutovers don't collide on the name, since the
    previous retiree may still be around pending a rollback.
    """
    return f"{canonical}-retired-{when:%Y%m%d-%H%M%S}"


def key_label_for_vm(labels: list[str], vm: str) -> str | None:
    """The account key belonging to VM, or None when that can't be settled.

    Keys are labelled from their SSH comment, which install.sh sets to
    `user@hostname`, and a VM's hostname follows its exe.dev name. Two keys
    claiming one VM is ambiguous rather than an error, so leave both alone.
    """
    matches = [label for label in labels if label.endswith(f"@{vm}")]
    return matches[0] if len(matches) == 1 else None


def relabel(label: str, new_vm: str) -> str:
    return f"{label.rsplit('@', 1)[0]}@{new_vm}"


def promotion_plan(
    incoming: str,
    canonical: str,
    retired: str,
    vm_names: list[str],
    key_labels: list[str],
) -> list[tuple[str, str, str]]:
    """The renames to run, in order, as (kind, from, to).

    Retiring comes first so the incoming VM and its key find both the name and
    the label free. When nothing holds CANONICAL this degrades to a plain
    rename, which is the whole point of using it that way.
    """
    plan: list[tuple[str, str, str]] = []

    if canonical in vm_names:
        plan.append(("vm", canonical, retired))
        if (label := key_label_for_vm(key_labels, canonical)) is not None:
            plan.append(("key", label, relabel(label, retired)))

    plan.append(("vm", incoming, canonical))
    if (label := key_label_for_vm(key_labels, incoming)) is not None:
        plan.append(("key", label, relabel(label, canonical)))

    return plan


def invert(plan: list[tuple[str, str, str]]) -> list[tuple[str, str, str]]:
    return [(kind, new, old) for kind, old, new in reversed(plan)]


def rename_args(kind: str, old: str, new: str) -> list[str]:
    verb = ["rename"] if kind == "vm" else ["ssh-key", "rename"]
    return [*verb, old, new]


def rename_command(kind: str, old: str, new: str) -> list[str]:
    return lobby_command(*rename_args(kind, old, new))


def lobby_hint(*args: str) -> str:
    """A lobby command written for a human to paste back, rather than to run here."""
    return f"exe-dev lobby {' '.join(args)}"


def list_vm_names(timeout: float | None = None) -> list[str]:
    out = subprocess.run(
        lobby_command("ls", "--json"), capture_output=True, text=True, check=True, timeout=timeout
    )
    return [vm["vm_name"] for vm in json.loads(out.stdout)["vms"]]


def cached_vm_names() -> list[str]:
    """VM names for completion, refreshed once the cache has aged out.

    Completion must not fail or stall the shell it runs in, so a lobby that is
    unreachable or slow yields no names at all and the name gets typed in full.
    """
    if VM_CACHE.exists():
        age = datetime.now(UTC) - datetime.fromtimestamp(VM_CACHE.stat().st_mtime, UTC)
        if age < VM_CACHE_TTL:
            return VM_CACHE.read_text().split()

    # These dotfiles land on machines with no exe.dev account, where pressing
    # TAB should not be what first calls out to it. A pinned lobby is the mark
    # of a machine where that contact has already been made deliberately.
    if pinned_fingerprint(LOBBY) is None:
        return []

    try:
        names = list_vm_names(timeout=5)
    except (subprocess.SubprocessError, OSError, ValueError, KeyError):
        return []

    VM_CACHE.parent.mkdir(parents=True, exist_ok=True)
    VM_CACHE.write_text("\n".join(names))
    return names


def complete_vm(incomplete: str) -> list[str]:
    # The box's own name is the one this cannot reach, so offering it would
    # only ever complete into an error.
    here = local_vm()
    return [name for name in cached_vm_names() if name.startswith(incomplete) and name != here]


def list_key_labels() -> list[str]:
    out = subprocess.run(
        lobby_command("ssh-key", "list", "--json"), capture_output=True, text=True, check=True
    )
    return [key["name"] for key in json.loads(out.stdout)["ssh_keys"]]


def clone_targets(integrations: list[dict]) -> list[tuple[str, str]]:
    """(clone URL, directory name) for every repo the VM can reach on GitHub.

    Reflection describes a GitHub integration only by the clone command it
    would print, so the URL comes out of that help text rather than a field of
    its own, and every match counts because one integration may cover several
    repos. Two integrations naming the same repo is ordinary rather than an
    error, hence the dedupe.
    """
    targets = [
        (match.group(0), match.group(1))
        for integration in integrations
        if integration["type"] == "github"
        for match in CLONE_URL.finditer(integration["help"])
    ]
    return list(dict.fromkeys(targets))


def origin_url(repo: Path) -> str | None:
    """Where REPO's origin points, or None when it isn't a git repo at all."""
    out = subprocess.run(
        ["git", "-C", str(repo), "remote", "get-url", "origin"], capture_output=True, text=True
    )
    return out.stdout.strip() if out.returncode == 0 else None


def marker_status(line: str) -> int | None:
    """The exit status the bootstrap reported, or None if this isn't the marker."""
    if not line.startswith(MARKER):
        return None
    try:
        return int(line.removeprefix(MARKER).strip())
    except ValueError:
        return None


def wait_for_vm(vm: str) -> None:
    """Block until the VM answers, over the control plane so nothing is trusted
    on first sight. First boot has no bounded duration, so the only sensible
    ceiling is the operator's patience."""
    while True:
        reachable = subprocess.run(control_plane_command(vm, "true"), capture_output=True)
        if reachable.returncode == 0:
            return
        time.sleep(2)


def follow_bootstrap(vm: str) -> int:
    """Stream the bootstrap log until it reports an exit status, and return it."""
    # -F keeps retrying until first boot creates the log. Nothing writes after
    # the marker, so a pipe close would never be noticed; kill tail explicitly.
    tail = subprocess.Popen(
        control_plane_command(vm, f"tail -n +1 -F {LOG} 2>/dev/null"),
        stdout=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    try:
        for line in tail.stdout:  # type: ignore[union-attr]
            typer.echo(line.rstrip("\n"))
            status = marker_status(line)
            if status is not None:
                return status
    finally:
        tail.terminate()
        tail.wait()

    typer.echo(f"log ended without a status marker; check `ssh {vm_host(vm)} cat {LOG}`", err=True)
    return 1


@app.command(context_settings={"allow_extra_args": True, "ignore_unknown_options": True})
def lobby(ctx: typer.Context) -> None:
    """Run a lobby command, checking exe.dev's host key first.

    Stands in for `ssh exe.dev ...` on a machine that has never reached the
    lobby before, where plain ssh would offer an unrecognised key and take a
    yes for verification. Once known_hosts holds the published key ssh does
    the checking itself, so from then on this only forwards.

    Anything after `lobby` goes to the lobby verbatim; `exe-dev lobby help`
    lists what it accepts.
    """
    pin_published(LOBBY)

    # Forward a terminal only when there is one to forward: under a pipe or a
    # redirect a PTY would fold the driver's CRLF translation into `--json`.
    command = lobby_command(*ctx.args, pty=sys.stdin.isatty() and sys.stdout.isatty())

    # exec so the lobby gets the real terminal: its interactive commands page,
    # prompt, and draw, none of which survive being piped through a parent.
    os.execvp(command[0], command)


@app.command(context_settings={"allow_extra_args": True, "ignore_unknown_options": True})
def ssh(
    ctx: typer.Context,
    vm: Annotated[str, typer.Argument(help="VM to connect to.", autocompletion=complete_vm)],
) -> None:
    """Connect to VM, checking its host key against the published one first.

    For the first connection to a VM from a machine, where plain ssh has only
    the key the far end offers and no way to judge it. `<vm>.exe.xyz` answers
    with exe.dev's published key, so this settles it the same way the lobby is
    settled, after which ordinary `ssh <vm>.exe.xyz` works.

    A box's own name is the exception, and is refused: exe.dev points it at
    that box's own sshd, which admits nothing but the front door.

    Anything after VM runs on the box instead of opening a shell.
    """
    if vm == local_vm():
        typer.echo(f"already on {vm}", err=True)
        raise typer.Exit(1)

    pin_published(vm_host(vm))

    # Ordinary ssh straight at the hostname, which is what allocates the
    # terminal an interactive shell needs without being asked for one. Going
    # through the lobby instead would hand ssh a command and get no terminal.
    command = ["ssh", "-o", "StrictHostKeyChecking=yes", vm_host(vm), *ctx.args]
    os.execvp(command[0], command)


@app.command()
def create_devbox(
    name: Annotated[str, typer.Argument(help="Name for the new VM.")],
    cpu: Annotated[int, typer.Option(help="vCPUs to allocate.")] = 2,
    memory: Annotated[str, typer.Option(help="Memory to allocate.")] = "8GB",
    disk: Annotated[str, typer.Option(help="Disk to allocate.")] = "25GB",
) -> None:
    """Create a devbox, install the dotfiles on it, and follow the bootstrap.

    Resources come from a pool shared across every VM on the account, so
    `exe-dev lobby billing plan` is the real ceiling, not these defaults.
    """
    pin_published(LOBBY)

    subprocess.run(create_args(name, cpu, memory, disk), input=BOOTSTRAP, text=True, check=True)

    typer.echo(f"\nwaiting for {name} to answer...")
    wait_for_vm(name)
    pin_published(vm_host(name))

    status = follow_bootstrap(name)
    if status != 0:
        typer.echo(f"\nbootstrap failed with status {status}", err=True)
        raise typer.Exit(status)

    register_key(name)

    typer.echo(f"\n{name} is ready: ssh {vm_host(name)}")


@app.command()
def clone_repos() -> None:
    """Clone every repo this VM reaches through a GitHub integration.

    Runs on the VM, where reflection resolves. Cloning is skipped for anything
    already checked out, so this is both the last step of the bootstrap and the
    way an older box picks up repos granted access after it was built.
    """
    with urllib.request.urlopen(REFLECTION_INTEGRATIONS) as response:
        integrations = json.load(response)["integrations"]

    for url, name in clone_targets(integrations):
        destination = PROJECTS / name
        if not destination.exists():
            subprocess.run(["git", "clone", url, str(destination)], check=True)
            continue

        # Repos are keyed on bare name, so two owners' repos can collide here.
        # Saying so beats silently counting the collision as already cloned.
        origin = origin_url(destination)
        if origin == url:
            typer.echo(f"{destination} is already cloned")
        else:
            typer.echo(f"leaving {url} uncloned: {destination} is {origin or 'not a git repo'}")


@app.command()
def promote(
    incoming: Annotated[str, typer.Argument(help="The freshly built VM.")],
    canonical: Annotated[str, typer.Argument(help="The name it should take over.")],
) -> None:
    """Give INCOMING the name CANONICAL, retiring whatever holds it now.

    When nothing holds CANONICAL this is a plain rename, so it doubles as the
    way to rename a box without leaving its account SSH key labelled for the
    old name.
    """
    if incoming == canonical:
        typer.echo(f"{incoming} already holds that name", err=True)
        raise typer.Exit(1)

    pin_published(LOBBY)

    vm_names = list_vm_names()
    if incoming not in vm_names:
        typer.echo(f"no VM named {incoming}", err=True)
        raise typer.Exit(1)

    retired = retired_name(canonical, datetime.now(UTC))
    plan = promotion_plan(incoming, canonical, retired, vm_names, list_key_labels())

    for kind, old, new in plan:
        typer.echo(f"{kind:>4} {old} -> {new}")
    if not typer.confirm("proceed?"):
        raise typer.Exit(1)

    # Run back to back: a name is unclaimed between the two VM renames, and
    # exe.dev names are globally unique, so anyone could take it in the gap.
    for kind, old, new in plan:
        subprocess.run(rename_command(kind, old, new), check=True)

    typer.echo("\nRoll back with:")
    for kind, old, new in invert(plan):
        typer.echo(f"  {lobby_hint(*rename_args(kind, old, new))}")

    if canonical in vm_names:
        typer.echo("Or finish with:")
        typer.echo(f"  {lobby_hint('rm', retired)}")


if __name__ == "__main__":
    sys.exit(app())
