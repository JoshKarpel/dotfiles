#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["tomlkit>=0.13.3"]
# ///
"""Update the settings in a Codex config.toml owned by link-codex."""

from __future__ import annotations

import argparse
import os
import tempfile
from pathlib import Path

import tomlkit
from tomlkit.items import Table

OLD_HEADER = "# Generated by dotfiles/bin/link-codex. Edit the source, not this file.\n\n"
HEADER = "# Codex configuration. link-codex updates only its own settings.\n\n"


def get_table(document: tomlkit.TOMLDocument, name: str) -> Table:
    value = document.get(name)
    if value is None:
        value = tomlkit.table()
        document[name] = value
    if not isinstance(value, Table):
        raise TypeError(f"{name} must be a TOML table")
    return value


def update_config(path: Path, is_exe_dev: bool) -> str:
    current = path.read_text() if path.exists() else ""
    if current.startswith(OLD_HEADER):
        current = HEADER + current.removeprefix(OLD_HEADER)
    if not current:
        current = HEADER

    document = tomlkit.parse(current)
    document["model_reasoning_effort"] = "high"
    document["sandbox_mode"] = "workspace-write"

    sandbox = get_table(document, "sandbox_workspace_write")
    sandbox["writable_roots"] = [str(Path.home() / ".cache/uv")]

    if is_exe_dev:
        document["model"] = "gpt-5.6-terra"
        document["model_provider"] = "exe-llm"
        provider = get_table(get_table(document, "model_providers"), "exe-llm")
        provider["name"] = "exe-llm"
        provider["base_url"] = "https://llm.int.exe.xyz/v1"
        provider["requires_openai_auth"] = False

    return tomlkit.dumps(document)


def converge(path: Path, content: str) -> None:
    current = path.read_text() if path.exists() else None
    if current == content:
        print(f"unchanged {path}")
        return

    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode="w", dir=path.parent, encoding="utf-8", delete=False
    ) as temporary:
        temporary.write(content)
        temporary.flush()
        os.fsync(temporary.fileno())
        temporary_path = Path(temporary.name)
    os.chmod(temporary_path, 0o644)
    temporary_path.replace(path)
    print(f"wrote {path}")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("path", type=Path)
    parser.add_argument("--exe-dev", action="store_true")
    arguments = parser.parse_args()
    converge(arguments.path, update_config(arguments.path, arguments.exe_dev))


if __name__ == "__main__":
    main()
