#!/usr/bin/env -S uv run --quiet --no-cache --script
# /// script
# requires-python = ">=3.12"
# ///
# `--no-cache` because this runs as a daemon: uv holds a shared lock on its cache
# for the whole life of the command, and `uv cache prune` waits for an exclusive
# one, so a service that never exits blocks every prune on the machine forever.
# There are no dependencies to download, so the cost is rebuilding a bare venv on
# each start.
"""Serve a front door for this exe.dev VM: what is listening, and what to open.

exe.dev forwards ports 3000-9999 to `https://<vm>.exe.xyz:<port>/` with no
configuration, so a dev server started on one already has a URL. What it has no
way to tell you is which ports are live and what is on them. This serves that
list, on the port the bare hostname points at, so `https://<vm>.exe.xyz/` is a
launcher for everything else on the box, alongside the zellij sessions and VS
Code workspaces that have no port of their own.

Written for exe.dev and not portable off it: the proxy's port range, its
authentication headers, and the reflection integration are all assumed.

Listeners are found by polling, because the kernel offers no other way: netlink's
inet_diag answers a query rather than announcing a new socket, and /proc/net/tcp
cannot be watched. A scan costs a few milliseconds, so it runs once a second and
pushes over SSE only when the result changes. A server bound while the page is
open shows up within that second.

Links are built from the browser's own location rather than the VM name, so they
stay correct whether the page was reached through the exe.dev proxy or an SSH
tunnel to the same port.

A zellij web server is the one port not linked directly, because arriving there
without a session named in the path does not land on a picker: it creates a new
session, so a link to its root would litter the box with an empty session per
visit. Its existing sessions are listed individually instead, which is both the
useful destination and the harmless one.

Those session names are shown only to the VM's owner, because a session name is
often a project or client name and the atlas is reachable by anyone the VM is
shared with.
"""

from __future__ import annotations

import html
import json
import os
import pwd
import re
import subprocess
import threading
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from dataclasses import asdict, dataclass
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# The range exe.dev's proxy forwards verbatim. A listener outside it is real but
# unreachable from outside the VM, so listing it would offer a dead link.
ROUTED_PORTS = range(3000, 10_000)

SCAN_INTERVAL_SECONDS = 1.0

# A heartbeat well inside any proxy or load balancer idle timeout, so an open
# page survives a quiet machine.
HEARTBEAT_INTERVAL_SECONDS = 15.0

# A server can hold its port down before it answers on it, which is exactly the
# moment this page is being watched. A port that did not respond is re-probed on
# this cadence until it does, or until the attempts run out.
PROBE_RETRY_SECONDS = 5.0
PROBE_MAX_ATTEMPTS = 6
PROBE_TIMEOUT_SECONDS = 1.5

# Reflection is an exe.dev default integration, and `/email` is the address the
# VM is owned by. Read once at startup rather than per request: it is a remote
# call, it decides an authorization question, and the answer changes about never.
OWNER_URL = "https://reflection.int.exe.xyz/email"
REFLECTION_URL = "https://reflection.int.exe.xyz/"
OWNER_TIMEOUT_SECONDS = 5.0

# What VS Code's Remote-SSH opens, the same form the exe.dev dashboard links.
# The VM name comes from reflection rather than the browser's location, because
# unlike every other link on this page it names a host to SSH to rather than one
# to fetch from: reached through a tunnel, `location.hostname` is `localhost`,
# which is the one machine this must not point at.
VSCODE_URL = "vscode://vscode-remote/ssh-remote+{host}{directory}?windowId=_blank"
VM_SUFFIX = ".exe.xyz"

# Workspaces offered alongside the home directory. Shallow on purpose: one level
# down is a checkout, two levels down is a subdirectory of one, and opening the
# latter as a workspace loses the repo the editor is meant to be looking at.
PROJECTS_DIRECTORY = "projects"

# The proxy sets this from the exe.dev session and overwrites whatever the client
# sent, so a forged value does not survive the hop. It is absent entirely when the
# caller is unauthenticated, which is why the comparison below fails closed.
CALLER_EMAIL_HEADER = "X-ExeDev-Email"

CLOCK_TICKS_PER_SECOND = os.sysconf("SC_CLK_TCK")

LISTEN_PID_PATTERN = re.compile(r"pid=(\d+)")
TITLE_PATTERN = re.compile(r"<title[^>]*>(.*?)</title>", re.IGNORECASE | re.DOTALL)


@dataclass(frozen=True)
class Listener:
    """A port with something bound to it, as the kernel describes it."""

    port: int
    pid: int | None
    addresses: tuple[str, ...]


@dataclass(frozen=True)
class Probe:
    """What the port said when asked for a page."""

    is_http: bool
    status: int | None
    title: str
    server: str
    attempts: int
    at: float


@dataclass(frozen=True)
class Row:
    """Everything known about one listening port, ready to render."""

    port: int
    addresses: list[str]
    pid: int | None
    command_name: str
    command_line: str
    directory: str
    user: str
    started_at: int | None
    is_http: bool | None
    status: int | None
    title: str
    server: str


def parse_listeners(ss_output: str) -> list[Listener]:
    """Turn `ss -tlnpH` output into one Listener per routed port.

    A port bound on both IPv4 and IPv6 arrives as two lines and leaves as one
    row, since it is one service and would be one link.
    """
    pids: dict[int, int | None] = {}
    addresses: dict[int, set[str]] = {}
    for line in ss_output.splitlines():
        fields = line.split(maxsplit=5)
        if len(fields) < 4:
            continue
        address, _, port_text = fields[3].rpartition(":")
        if not port_text.isdigit():
            continue
        port = int(port_text)
        if port not in ROUTED_PORTS:
            continue
        pid_match = LISTEN_PID_PATTERN.search(fields[5] if len(fields) > 5 else "")
        addresses.setdefault(port, set()).add(address.strip("[]"))
        if pid_match and pids.get(port) is None:
            pids[port] = int(pid_match.group(1))
        pids.setdefault(port, None)
    return [
        Listener(port=port, pid=pids[port], addresses=tuple(sorted(addresses[port])))
        for port in sorted(addresses)
    ]


def format_probe_title(body: str) -> str:
    match = TITLE_PATTERN.search(body)
    if not match:
        return ""
    return html.unescape(" ".join(match.group(1).split()))


def read_owner_email() -> str:
    """The address this VM is owned by, or "" if reflection did not answer.

    An empty answer denies rather than defaults: nothing is disclosed on the
    strength of a query that failed.
    """
    try:
        with urllib.request.urlopen(OWNER_URL, timeout=OWNER_TIMEOUT_SECONDS) as response:
            return str(json.load(response).get("email") or "")
    except (urllib.error.URLError, OSError, ValueError):
        return ""


@dataclass(frozen=True)
class Vm:
    """How this machine identifies itself, per exe.dev's reflection integration."""

    name: str
    emoji: str


def read_vm() -> Vm:
    """This VM's name and emoji, or empty strings if reflection did not answer.

    Empty is the honest answer rather than a guess: the page falls back to
    whatever hostname the browser used, keeps the built-in favicon, and offers no
    VS Code links, since Remote-SSH would have no host to reach.
    """
    try:
        with urllib.request.urlopen(REFLECTION_URL, timeout=OWNER_TIMEOUT_SECONDS) as response:
            published = json.load(response)
    except (urllib.error.URLError, OSError, ValueError):
        return Vm(name="", emoji="")

    return Vm(name=str(published.get("name") or ""), emoji=str(published.get("emoji") or ""))


def vscode_url(vm_name: str, directory: str) -> str:
    """A VS Code Remote-SSH workspace link, or "" when there is no VM to name."""
    if not vm_name:
        return ""
    return VSCODE_URL.format(host=f"{vm_name}{VM_SUFFIX}", directory=directory)


def read_workspaces(vm_name: str) -> list[dict[str, str]]:
    """Home, then each checkout under it, as VS Code workspace links.

    Rebuilt every scan rather than at startup so a repo cloned while the page is
    open shows up, which is the same liveness the port list already offers.
    """
    home = pwd.getpwuid(os.getuid()).pw_dir
    workspaces = [{"name": "home", "url": vscode_url(vm_name, home)}]

    root = os.path.join(home, PROJECTS_DIRECTORY)
    try:
        entries = sorted(os.scandir(root), key=lambda entry: entry.name)
    except OSError:
        return workspaces

    workspaces.extend(
        {"name": entry.name, "url": vscode_url(vm_name, entry.path)}
        for entry in entries
        if not entry.name.startswith(".") and entry.is_dir()
    )
    return workspaces


def read_zellij_sessions(row: Row) -> tuple[str, ...]:
    """Session names a zellij web server can serve, newest listing first.

    The socket directory is read from the server's own environment rather than
    from this process's. Zellij derives it from $XDG_RUNTIME_DIR and falls back
    to /tmp/zellij-$UID, and a daemon started by systemd and a shell started by
    sshd disagree about that, so asking our own environment would enumerate a
    different machine-local set than the one the web server is actually serving.
    """
    if row.pid is None:
        return ()

    environ = {}
    try:
        with open(f"/proc/{row.pid}/environ", "rb") as handle:
            for entry in handle.read().decode("utf-8", "replace").split("\0"):
                key, _, value = entry.partition("=")
                if key:
                    environ[key] = value
    except OSError:
        return ()

    try:
        result = subprocess.run(
            ["zellij", "list-sessions", "--short", "--no-formatting"],
            capture_output=True,
            text=True,
            timeout=PROBE_TIMEOUT_SECONDS,
            env={
                "PATH": os.environ.get("PATH", ""),
                "HOME": environ.get("HOME", ""),
                **{
                    key: environ[key]
                    for key in ("ZELLIJ_SOCKET_DIR", "XDG_RUNTIME_DIR", "XDG_CACHE_HOME")
                    if key in environ
                },
            },
        )
    except (OSError, subprocess.SubprocessError):
        return ()

    # A server with no sessions exits non-zero, which is not an error worth
    # distinguishing from one whose sessions we could not read: both render the
    # port as an ordinary row with nothing broken out.
    if result.returncode != 0:
        return ()

    return tuple(line.strip() for line in result.stdout.splitlines() if line.strip())


def is_zellij_web(row: Row) -> bool:
    """Whether this listener is a zellij web server rather than anything else.

    Matched on the process, not the port: the port is configurable and this is
    meant to work on any box running one, not only on a box set up like this one.
    """
    return row.command_name == "zellij" and " web" in f" {row.command_line} "


def read_listeners() -> list[Listener]:
    result = subprocess.run(
        ["ss", "--tcp", "--listening", "--numeric", "--processes", "--no-header"],
        capture_output=True,
        text=True,
        check=True,
    )
    return parse_listeners(result.stdout)


def read_process_details(pid: int | None) -> tuple[str, str, str, str, int | None]:
    """Name, command line, working directory, owner, and start time for a pid.

    Every field is read independently: a process owned by another user hides its
    cwd and command line from us but still has a name, and a process that exits
    mid-scan should cost one blank field rather than the whole row.
    """
    if pid is None:
        return "", "", "", "", None

    def read(path: str) -> str:
        try:
            with open(f"/proc/{pid}/{path}", "rb") as handle:
                return handle.read().decode("utf-8", "replace")
        except OSError:
            return ""

    name = read("comm").strip()
    command_line = " ".join(read("cmdline").split("\0")).strip()

    try:
        directory = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        directory = ""

    try:
        user = pwd.getpwuid(os.stat(f"/proc/{pid}").st_uid).pw_name
    except (OSError, KeyError):
        user = ""

    return name, command_line, directory, user, read_start_time(pid)


def read_start_time(pid: int) -> int | None:
    """Wall-clock epoch second the process started.

    Derived from boot time rather than sent as an age, so the value is stable
    across scans and does not push a change every second just by getting older.
    """
    try:
        with open(f"/proc/{pid}/stat") as handle:
            stat = handle.read()
        with open("/proc/uptime") as handle:
            uptime = float(handle.read().split()[0])
    except (OSError, ValueError, IndexError):
        return None
    # The comm field is parenthesised and may itself contain spaces and
    # parentheses, so the fixed-position fields start after its closing paren.
    try:
        fields = stat[stat.rindex(")") + 2 :].split()
        ticks_since_boot = int(fields[19])
    except (ValueError, IndexError):
        return None
    return round(time.time() - uptime + ticks_since_boot / CLOCK_TICKS_PER_SECOND)


def probe_port(port: int) -> Probe:
    """Ask a port for a page, to tell a web server from a database socket."""
    request = urllib.request.Request(
        f"http://127.0.0.1:{port}/",
        headers={"User-Agent": "exe-dev-atlas", "Accept": "text/html"},
    )
    now = time.time()
    try:
        with urllib.request.urlopen(request, timeout=PROBE_TIMEOUT_SECONDS) as response:
            return describe_response(
                response.status,
                response.headers.get("Content-Type", ""),
                response.headers.get("Server", ""),
                response.read(65_536),
                now,
            )
    except urllib.error.HTTPError as error:
        # A 404 or a 401 is still a web server, and still worth a link.
        return describe_response(
            error.code,
            error.headers.get("Content-Type", "") if error.headers else "",
            error.headers.get("Server", "") if error.headers else "",
            error.read(65_536),
            now,
        )
    except Exception:
        return Probe(is_http=False, status=None, title="", server="", attempts=1, at=now)


def describe_response(
    status: int, content_type: str, server: str, body: bytes, at: float
) -> Probe:
    title = ""
    if "html" in content_type.lower():
        title = format_probe_title(body.decode("utf-8", "replace"))
    return Probe(is_http=True, status=status, title=title, server=server, attempts=1, at=at)


class Probes:
    """Probe results, keyed so a restarted process is asked again.

    Probing happens off the scan loop: a port that accepts a connection and then
    says nothing would otherwise stall every other row behind its timeout.
    """

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._results: dict[tuple[int, int | None], Probe] = {}
        self._in_flight: set[tuple[int, int | None]] = set()
        self._pool = ThreadPoolExecutor(max_workers=8, thread_name_prefix="probe")

    def get(self, listener: Listener) -> Probe | None:
        with self._lock:
            return self._results.get((listener.port, listener.pid))

    def refresh(self, listeners: list[Listener]) -> None:
        live = {(listener.port, listener.pid) for listener in listeners}
        with self._lock:
            for key in list(self._results):
                if key not in live:
                    del self._results[key]
            due = [
                listener
                for listener in listeners
                if self._is_due((listener.port, listener.pid))
            ]
            for listener in due:
                self._in_flight.add((listener.port, listener.pid))
        for listener in due:
            self._pool.submit(self._run, listener)

    def _is_due(self, key: tuple[int, int | None]) -> bool:
        if key in self._in_flight:
            return False
        previous = self._results.get(key)
        if previous is None:
            return True
        if previous.is_http:
            return False
        return (
            previous.attempts < PROBE_MAX_ATTEMPTS
            and time.time() - previous.at >= PROBE_RETRY_SECONDS
        )

    def _run(self, listener: Listener) -> None:
        key = (listener.port, listener.pid)
        probe = probe_port(listener.port)
        with self._lock:
            previous = self._results.get(key)
            if previous is not None and not probe.is_http:
                probe = Probe(
                    is_http=False,
                    status=None,
                    title="",
                    server="",
                    attempts=previous.attempts + 1,
                    at=probe.at,
                )
            self._results[key] = probe
            self._in_flight.discard(key)


def build_rows(listeners: list[Listener], probes: Probes) -> list[Row]:
    rows = []
    for listener in listeners:
        name, command_line, directory, user, started_at = read_process_details(listener.pid)
        probe = probes.get(listener)
        rows.append(
            Row(
                port=listener.port,
                addresses=list(listener.addresses),
                pid=listener.pid,
                command_name=name,
                command_line=command_line,
                directory=directory,
                user=user,
                started_at=started_at,
                is_http=None if probe is None else probe.is_http,
                status=None if probe is None else probe.status,
                title="" if probe is None else probe.title,
                server="" if probe is None else probe.server,
            )
        )
    return rows


class Broadcast:
    """The latest payload, and a way to wait for the next different one.

    Two payloads rather than one, serialized here so the cost is per scan and not
    per connection. They differ only in whether zellij session names are present,
    and which one a connection receives is an authorization decision made in the
    handler that holds the caller's headers.
    """

    def __init__(self) -> None:
        self._condition = threading.Condition()
        self._version = 0
        self._public = "{}"
        self._owner = "{}"

    def publish(self, public: str, owner: str) -> None:
        with self._condition:
            if (public, owner) == (self._public, self._owner):
                return
            self._public = public
            self._owner = owner
            self._version += 1
            self._condition.notify_all()

    def wait(self, seen: int, *, is_owner: bool) -> tuple[int, str]:
        """Block until the payload differs from `seen`, or the heartbeat is due."""
        with self._condition:
            if self._version == seen:
                self._condition.wait(HEARTBEAT_INTERVAL_SECONDS)
            return self._version, (self._owner if is_owner else self._public)


def scan_forever(broadcast: Broadcast, own_port: int, vm: Vm) -> None:
    """Rescan, and publish whenever the result differs from the last one.

    A probe finishing does not push on its own: it lands in the cache and the
    next scan carries it, which costs a title up to a second and saves a probe
    worker from re-entering the scan.
    """
    probes = Probes()
    while True:
        listeners = read_listeners()
        probes.refresh(listeners)
        rows = build_rows(listeners, probes)
        # Flagged for everyone, unlike the session names: it withholds a link
        # rather than disclosing anything, and the command line already says
        # `zellij web` to anyone reading the row.
        public = [
            asdict(row) | {"is_session_server": True} if is_zellij_web(row) else asdict(row)
            for row in rows
        ]
        owner = [
            row_dict | {"sessions": list(read_zellij_sessions(row))}
            if is_zellij_web(row)
            else row_dict
            for row, row_dict in zip(rows, public)
        ]
        # Workspaces are owner-only for the same reason session names are: a
        # checkout name is a project name. Ideally this would follow the VM's
        # sharing grants, but reflection does not publish them, so ownership is
        # the only distinction available to draw.
        # Name and emoji are not owner-only: the name is already in the URL of
        # whoever is reading, and together they title and badge the tab for
        # everyone.
        common = {"own_port": own_port, "vm_name": vm.name, "vm_emoji": vm.emoji}
        broadcast.publish(
            json.dumps(common | {"rows": public}, sort_keys=True),
            json.dumps(
                common | {"rows": owner, "workspaces": read_workspaces(vm.name)},
                sort_keys=True,
            ),
        )
        time.sleep(SCAN_INTERVAL_SECONDS)


