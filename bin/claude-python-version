#!/usr/bin/env bash
# SessionStart hook: if this is a Python project, report the target Python
# version (from .python-version / pyproject.toml) and point Claude at the
# "What's New" docs for looking up changes between versions.

set -euo pipefail

# CLAUDE_HOOK_SELFTEST: set this env var to run the hook's embedded self-tests. This
# marker line is how `claude-hook-selftests` discovers participating hooks. The hook
# always exits 0, so the tests assert on stdout instead: silence for a non-Python
# project, and the right pinned/floor version surfacing for one.
if [[ -n "${CLAUDE_HOOK_SELFTEST:-}" ]]; then
  SELF=$(realpath "$0")
  fails=0
  workdir=$(realpath "$(mktemp -d)")
  trap 'rm -rf "$workdir"' EXIT

  plain="$workdir/plain"
  pinned="$workdir/pinned"
  floor="$workdir/floor"
  both="$workdir/both"
  mkdir -p "$plain" "$pinned" "$floor" "$both"
  echo "3.12" >"$pinned/.python-version"
  printf '[project]\nrequires-python = ">=3.11"\n' >"$floor/pyproject.toml"
  echo "3.13.1" >"$both/.python-version"
  printf '[project]\nrequires-python = ">=3.10"\n' >"$both/pyproject.toml"

  t() {
    local desc="$1" dir="$2" want="$3" out
    out=$(cd "$dir" && CLAUDE_HOOK_SELFTEST= "$SELF" 2>&1)
    if [[ "$want" == "<empty>" ]]; then
      [[ -z "$out" ]] || { printf 'FAIL %s: want empty, got:\n%s\n' "$desc" "$out"; fails=1; }
    else
      [[ "$out" =~ $want ]] || { printf 'FAIL %s: want match /%s/, got:\n%s\n' "$desc" "$want" "$out"; fails=1; }
    fi
  }

  t "non-python project stays silent"      "$plain"  "<empty>"
  t "pinned version surfaces"              "$pinned" 'Pinned interpreter \(\.python-version\): Python 3\.12'
  t "pinned version links whatsnew"        "$pinned" 'whatsnew/3\.12\.html'
  t "requires-python floor surfaces"       "$floor"  'requires-python = ">=3\.11"'
  t "requires-python floor links whatsnew" "$floor"  'whatsnew/3\.11\.html'
  t "pinned wins over floor for whatsnew"  "$both"   'whatsnew/3\.13\.html'

  if [[ "$fails" == 0 ]]; then
    echo "$(basename "$0"): all self-tests passed"
  fi
  exit "$fails"
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || root="$PWD"

pinned=""
if [[ -f "$root/.python-version" ]]; then
  pinned=$(grep -oE '[0-9]+\.[0-9]+' "$root/.python-version" | head -n1 || true)
fi

requires=""
if [[ -f "$root/pyproject.toml" ]]; then
  requires=$(grep -E '^[[:space:]]*requires-python[[:space:]]*=' "$root/pyproject.toml" \
      | head -n1 \
    | sed -E 's/.*requires-python[[:space:]]*=[[:space:]]*["'\'']([^"'\'']*)["'\''].*/\1/' || true)
fi

# Not a Python project (or no version info) — stay silent.
[[ -z "$pinned" && -z "$requires" ]] && exit 0

# Prefer the pinned version for the What's New link; otherwise use the floor
# from requires-python.
whatsnew="$pinned"
if [[ -z "$whatsnew" && -n "$requires" ]]; then
  whatsnew=$(grep -oE '[0-9]+\.[0-9]+' <<<"$requires" | head -n1 || true)
fi

{
  printf 'This is a Python project.'
  [[ -n "$pinned" ]] && printf ' Pinned interpreter (.python-version): Python %s.' "$pinned"
  [[ -n "$requires" ]] && printf ' pyproject.toml requires-python = "%s".' "$requires"
  printf '\n\n'
  printf 'When you need to confirm what changed in a given Python version (new syntax, stdlib additions, deprecations, removals), consult the "What'\''s New" docs instead of relying on memory:\n'
  [[ -n "$whatsnew" ]] && printf -- '- This version: https://docs.python.org/3/whatsnew/%s.html\n' "$whatsnew"
  printf -- '- All versions: https://docs.python.org/3/whatsnew/\n'
}
