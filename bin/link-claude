#!/usr/bin/env bash

set -euo pipefail

BASEDIR="$(dirname "$(dirname "$(realpath "$0")")")"
CLAUDE="$BASEDIR/claude"
BACKUPS=~/.dotfiles-backups

mkdir -p ~/.claude

while IFS= read -r -d '' file; do
  rel="${file#"$CLAUDE"/}"
  target=~/.claude/"$rel"

  mkdir -p "$(dirname "$target")"

  if [[ -e "$target" && ! -L "$target" ]]; then
    mkdir -p "$BACKUPS"
    backup="$BACKUPS/$(basename "$target")"
    echo "mv $target -> $backup"
    mv "$target" "$backup"
  fi

  echo "link $target -> $file"
  ln -sf "$file" "$target"
done < <(find "$CLAUDE" -type f -print0)

# Drop the directories that pruning emptied, walking up from the pruned link.
# rmdir refuses a non-empty directory, which is the stopping condition, and
# ~/.claude itself never matches the pattern so it is never a candidate.
remove_empty_parents() {
  local dir="$1"

  while [[ "$dir" == ~/.claude/* ]]; do
    rmdir "$dir" 2>/dev/null || break
    dir="$(dirname "$dir")"
  done
}

# Prune symlinks that point into $CLAUDE but whose target no longer exists,
# wherever under ~/.claude they landed. Walking the whole tree rather than a
# list of directories to check: a list can only name the directories that exist
# today, and the orphan always turns up in the one just removed from $CLAUDE.
while IFS= read -r -d '' link; do
  if [[ "$(readlink "$link")" == "$CLAUDE"/* && ! -e "$link" ]]; then
    echo "prune $link"
    rm "$link"
    remove_empty_parents "$(dirname "$link")"
  fi
done < <(find ~/.claude -type l -print0)
